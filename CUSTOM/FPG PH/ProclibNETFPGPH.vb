        Temporary_InforceMaster = InforceMaster(ANO, br_Approval_user, BackDatedF, pADate, , True)
    End Function
    Private Function InforceMaster(ByVal ANO As Long, Optional ByVal br_Approval_user As String = "", Optional ByVal BackDatedF As Boolean = False, Optional ByVal pADate As Object = "", Optional ByVal Voucher As String = "", Optional ByVal TemporaryF As Boolean = False) As Boolean
        Dim rs As RemoteSet
        Dim rsAA As RemoteSet
        Dim AType As String
        Dim PID As String
        Dim TOC As String
        Dim pANO As Long
        Dim OANO As Long
        Dim CNO As Long
        Dim OCNO As Long
        Dim RANO As Long
        Dim PolicyType As String
        Dim ISType As String
        Dim ADate As Date
        Dim AName As String
        Dim PolicyNo As String
        Dim RefNo As String
        Dim RegNo As String
        Dim Branch As String
        Dim OpenFlag As Boolean
        Dim SDate As Date
        Dim EDate As Date
        Dim PDate As Date
        Dim PSDate As Date
        Dim PPDate As Date
        Dim ESeqNo As Long
        Dim EESeqNo As Long
        Dim ERSeqNo As Long
        Dim DocNo As String
        Dim BillDate As Date
        Dim DueByEffectiveF As Boolean
        Dim DetailTreatyF As Boolean
        Dim ApplyReinsuranceDepositF As Boolean
        Dim ApplyCommissionDepositF As Boolean
        Dim NetAdjustmentDepositF As Boolean
        Dim AutoParsingFieldF As Boolean
        Dim NoRefundF As Integer
        Dim RefundType As String
        Dim EMethod As String
        Dim BizMapID As String
        Dim Source As String
        Dim CT As String
        Dim MSCode As String
        Dim CProrata As Double
        Dim PPeriod As Integer
        Dim Separator As String
        Dim AStatus As String
        Dim SplitDNCNF As Boolean = False

        On Error GoTo errmsg

        ' Update Current Acceptance Status to Temporary Inforce
        If Not db.Execute("Update Acceptance set AStatus='T', RUserID=Case When AStatus='T' Then RUserID else '" & db_user & "' end, RUserDate=Case When AStatus='T' Then RUserDate else '" & Format(Today.Date, "MM/DD/YYYY") & "' end, RUserTime=Case When AStatus='T' Then RUserTime else '" & Time() & "' end where AStatus in ('W','T') and ANO=" & ANO) Then GoTo errmsg
        If db.RecordsAffected = 0 Then
            StrMsg = "Please Check Policy Data !"
            GoTo errmsg
        End If

        rs = db.OpenRemoteSet("Select DueByEffectiveF, DetailTreatyF, ApplyReinsuranceDepositF, ApplyCommissionDepositF, NetAdjustmentDepositF from SysTab", adOpenForwardonly)
        DueByEffectiveF = toval(rs.fields("DueByEffectiveF"))
        DetailTreatyF = toval(rs.fields("DetailTreatyF"))
        ApplyReinsuranceDepositF = toval(rs.fields("ApplyReinsuranceDepositF"))
        ApplyCommissionDepositF = toval(rs.fields("ApplyCommissionDepositF"))
        NetAdjustmentDepositF = toval(rs.fields("NetAdjustmentDepositF"))

        rs = db.OpenRemoteSet("Select OANO, PANO, CNO, RANO, AType, NoRefundF, RefundType, EMethod, PDate, PPDate, SDate, EDate, BizMapID, MSCode, CT, TOC, CPCT, AStatus, ADate, AName, RefNo, RegNo, Branch, PolicyNo, ESeqNo, EESeqNo, ERSeqNo, SplitDNCNF from Acceptance Where ANO=" & ANO)
        OANO = toval(rs.fields("OANO"))
        pANO = toval(rs.fields("PANO"))
        CNO = toval(rs.fields("CNO"))
        RANO = toval(rs.fields("RANO"))
        AType = tostr(rs.fields("AType"))
        NoRefundF = toval(rs.fields("NoRefundF"))
        RefundType = tostr(rs.fields("RefundType"))
        EMethod = tostr(rs.fields("EMethod"))
        PPDate = todate(rs.fields("PPDate"))
        PSDate = todate(rs.fields("SDate"))
        BizMapID = tostr(rs.fields("BizMapID"))
        Source = Get_BusinessSource(ANO)
        MSCode = tostr(rs.fields("MSCode"))
        CT = tostr(rs.fields("CT"))
        TOC = tostr(rs.fields("TOC"))
        CProrata = toval(rs.fields("CPCT")) / 100
        SplitDNCNF = toval(rs.fields("SplitDNCNF"))
        AStatus = tostr(rs.fields("AStatus"))
        If Not (AStatus = "W" Or AStatus = "T") Then
            StrMsg = "Please Check Policy Data Status !"
            GoTo errmsg
        End If

        If IsDate(pADate) Then
            ADate = pADate
        Else
            ADate = todate(rs.fields("ADate"))
        End If

        ' Change the BillDate Here !
        If AType <> "A" Then ' Not Adjustment 
            ' Change the BillDate here
            If DueByEffectiveF Then
                BillDate = todate(rs.fields("PDate"))
            Else
                BillDate = ADate
            End If
        Else
            BillDate = ADate
        End If

        AName = tostr(rs.fields("AName"))
        RefNo = tostr(rs.fields("RefNo"))
        RegNo = tostr(rs.fields("RegNo"))
        Branch = tostr(rs.fields("Branch"))
        PolicyNo = tostr(rs.fields("PolicyNo"))
        SDate = todate(rs.fields("SDate"))
        EDate = todate(rs.fields("EDate"))
        PDate = todate(rs.fields("PDate"))
        ESeqNo = toval(rs.fields("ESeqNo"))
        EESeqNo = toval(rs.fields("EESeqNo"))
        ERSeqNo = toval(rs.fields("ERSeqNo"))
        rs.CloseRemoteSet()

        rs = db.OpenRemoteSet("Select PolicyType, ISType, OCNO, OpenFlag, PPeriod from Cover Where CNO=" & CNO)
        PolicyType = tostr(rs.fields("PolicyType"))
        ISType = tostr(rs.fields("ISTYpe"))
        OCNO = toval(rs.fields("OCNO"))
        OpenFlag = toval(rs.fields("OpenFlag"))
        PPeriod = toval(rs.fields("PPeriod"))
        rs.CloseRemoteSet()

        Dim PType As String
        If (ISType = "R" Or ISType = "C" Or ISType = "T") Then
            PType = "I" & ISType
        Else
            PType = "DI"
        End If

        rs = db.OpenRemoteSet("Select AutoParsingFieldF from TOC Where TOC='" & TOC & "'")
        AutoParsingFieldF = rs.fields("AutoParsingFieldF")
        rs.CloseRemoteSet()

        If Not TemporaryF Then
            If PolicyNo = "" Then
                Dim BAlias As String
                Dim TAlias As String = ""
                Dim POL_AutoNum As String = ""
                Dim Prefix As String
                Dim InFix As String

                BAlias = Get_Branch_Alias_By_TOC(Branch, TOC, TAlias, POL_AutoNum)
                rs = db.OpenRemoteSet("Select P.Prefix, P.InFix, P.Separator, P.BranchDigit, P.TOCDigit, P.CTDigit, P.CheckDigitF, I.Prefix as IPrefix, I.InFix as IInFix from ISType I Left Join PolicyType P on (P.PolicyType='" & PolicyType & "') Where I.ISType='" & ISType & "'")
                Separator = tostr(rs.fields("Separator"))
                Prefix = IIf(tostr(rs.fields("Prefix")) <> "", tostr(rs.fields("Prefix")), tostr(rs.fields("IPrefix")))
                InFix = IIf(tostr(rs.fields("InFix")) <> "", tostr(rs.fields("InFix")), tostr(rs.fields("IInFix")))
                If Not rs.Eof Then
                    PolicyNo = db.GetNextDocNo(POL_AutoNum, ADate, IIf(Prefix <> "", Prefix & Separator, "") & IIf(rs.fields("BranchDigit") <> 0, Mid(BAlias, 1, rs.fields("BranchDigit")) & Separator, "") & IIf(rs.fields("CTDigit") <> 0, Mid(CT, 1, rs.fields("CTDigit")) & Separator, "") & IIf(InFix <> "", InFix & Separator, "") & IIf(rs.fields("TOCDigit") <> 0, Mid(TAlias, 1, rs.fields("TOCDigit")) & Separator, ""))
                Else
                    PolicyNo = db.GetNextDocNo(POL_AutoNum, ADate, BAlias & Mid(TAlias, 1, 2))
                End If
                If PolicyNo = "" Then
                    StrMsg = "Generate Policy No. Failed !"
                    GoTo errmsg
                End If
                If toval(rs.fields("CheckDigitF")) Then PolicyNo = PolicyNo & CheckDigit(PolicyNo)
            End If
        End If
        DocNo = PolicyNo

        If ESeqNo <> 0 Then
            DocNo = DocNo + "-" + tostr(ESeqNo) + "/" + tostr(EESeqNo)
            If ERSeqNo <> 0 Then
                DocNo = DocNo + "/" + tostr(ERSeqNo)
            End If
        End If

        If Not db.Execute("Delete From AccAss Where ANO=" & ANO) Then GoTo errmsg
        rsAA = db.OpenRemoteSet("Select * from AccAss Where 1<>1")

        'Payor
        rs = db.OpenQueryDef("QPayor", adOpenForwardonly, ANO)
        PID = tostr(rs.fields("ID"))
        rs.CloseRemoteSet()

        ' Update Master Policy No First
        If PolicyNo <> "" Then
            If Not db.Execute("Update Acceptance Set PolicyNo='" & PolicyNo & "' Where PolicyNo<>'" & PolicyNo & "' and AStatus in ('W','T') and ANO=" & ANO) Then GoTo errmsg
            If OpenFlag Then
                If Not db.Execute("Update Acceptance Set PolicyNo='" & PolicyNo & "' Where PolicyNo<>'" & PolicyNo & "' and AStatus in ('W','T') and LANO=" & ANO) Then GoTo errmsg
            End If
        End If

        ' Match previous db.begintrans from Calling Function
        db.Committrans()

        ' Put Here
        StrMsg = ""
        Dim ErrMsg As String
        Dim DetailErrorF As Boolean
        DetailErrorF = False
        If Not OpenFlag Then
            ' Inforce Detail Acceptance
            rs = db.OpenRemoteSet("Select ANO, AStatus, ADate, PolicyNo, CertificateNo from Acceptance Where LANO =" & ANO & " and ANO<>lANO", adOpenForwardonly)
            Do While Not rs.Eof
                ErrMsg = ""
                AStatus = rs.fields("AStatus")
                db.Begintrans()

                If (AStatus = "I" Or AStatus = "T") And rs.fields("PolicyNo") <> PolicyNo Then
                    If Not ReOpen(toval(rs.fields("ANO"))) Then
                        ErrMsg = "Please Check the Policy Data " & rs.fields("PolicyNo") & "-" & rs.fields("CertificateNo") & " " & StrMsg
                    End If
                    If ErrMsg = "" Then AStatus = "W"
                End If

                If ErrMsg = "" Then
                    If AStatus = "W" Or (AStatus = "T" And Not TemporaryF) Then
                        If Not Inforce(toval(rs.fields("ANO")), br_Approval_user, BackDatedF, ADate, , ESeqNo, EESeqNo, BillDate, , PolicyNo, DocNo, AName, TemporaryF, RefNo, ERSeqNo) Then
                            ErrMsg = "Please Check the Policy Data " & rs.fields("PolicyNo") & "-" & rs.fields("CertificateNo") & " " & StrMsg
                        End If
                    Else
                        If DateDiff(DateInterval.Day, rs.fields("ADate"), ADate) <> 0 Then
                            ' Adjust Booking Date
                            If Not db.Execute("Update A1 set ADate='" & Format(ADate, "MM/DD/YYYY") & "' from acceptance a1 where a1.ADate<'" & Format(ADate, "MM/DD/YYYY") & "' and a1.ano=" & toval(rs.fields("ANO"))) Then
                                ErrMsg = "Please Check the Policy Data " & rs.fields("PolicyNo") & "-" & rs.fields("CertificateNo") & " " & db.ErrDesc
                            End If
                            If db.RecordsAffected <> 0 Then
                                If Not db.Execute("Update A2 set Date=A1.ADate from acceptance a1, accass a2 where a2.ano=a1.ano and A2.Date<A1.ADate and a1.ano=" & toval(rs.fields("ANO"))) Then
                                    ErrMsg = "Please Check the Policy Data " & rs.fields("PolicyNo") & "-" & rs.fields("CertificateNo") & " " & db.ErrDesc
                                End If
                            End If
                        End If
                    End If
                End If

                If ErrMsg = "" Then
                    db.Committrans()
                Else
                    DetailErrorF = True
                    db.RollBack()
                End If

                'System.Threading.Thread.Sleep(1000)
                rs.MoveNext()
            Loop
            rs.CloseRemoteSet()
        End If

        db.Begintrans()
        If DetailErrorF OrElse StrMsg <> "" Then GoTo errmsg

        ' Fee & Duty
        If (ISType = "I" Or ISType = "L" Or ISType = "C") Then
            Dim Amount As Double
            rs = db.OpenQueryDef("QFeeDuty", adOpenForwardonly, ANO)
            Do While Not rs.Eof
                Amount = 0
                If toval(rs.fields("Amount")) <> 0 Then
                    If Left(tostr(rs.fields("FDType")), 1) = "O" Then
                        Amount = -toval(rs.fields("Amount"))
                    Else
                        Amount = toval(rs.fields("Amount"))
                    End If
                ElseIf toval(rs.fields("AmountPCT")) <> 0 Or toval(rs.fields("AMOUNTPCTBASED")) = 2 Then
                    If Left(tostr(rs.fields("FDType")), 1) = "O" Then
                        Amount = -Get_Fee_Amount_By_Percentage(ANO, rs.fields("Currency"), Left(tostr(rs.fields("FDType")), 1), toval(rs.fields("AmountPCT")), toval(rs.fields("AMOUNTPCTBASED")), toval(rs.fields("PolicyYear")))
                    Else
                        Amount = Get_Fee_Amount_By_Percentage(ANO, rs.fields("Currency"), Left(tostr(rs.fields("FDType")), 1), toval(rs.fields("AmountPCT")), toval(rs.fields("AMOUNTPCTBASED")), toval(rs.fields("PolicyYear")))
                    End If
                End If

                If Amount <> 0 Then
                    rsAA.AddNew()
                    rsAA.fields("BizMapID") = BizMapID
                    rsAA.fields("Source") = Source
                    rsAA.fields("MSCode") = MSCode
                    rsAA.fields("ANO") = ANO
                    If toval(rs.fields("PolicyYear")) = 0 Then
                        rsAA.fields("SDate") = SDate
                        rsAA.fields("EDate") = EDate
                    Else
                        rsAA.fields("SDate") = DateAdd(DateInterval.Year, toval(rs.fields("PolicyYear")) - 1, SDate)
                        rsAA.fields("EDate") = DateAdd(DateInterval.Year, toval(rs.fields("PolicyYear")), SDate)
                    End If

                    If rs.fields("ID") = "" Or rs.fields("ID") = "<Payor>" Then
                        rsAA.fields("ID") = PID
                    Else
                        rsAA.fields("ID") = rs.fields("ID")
                    End If
                    rsAA.fields("Type") = IIf(Left(tostr(rs.fields("FDType")), 1) = "O", "OP", PType)
                    rsAA.fields("Code") = IIf(Left(tostr(rs.fields("FDType")), 1) = "O", "F", Left(tostr(rs.fields("FDType")), 1))
                    rsAA.fields("CodeExt") = IIf(Len(tostr(rs.fields("FDType"))) > 1, Right(tostr(rs.fields("FDType")), 1), "")
                    rsAA.fields("REFNO") = RefNo
                    rsAA.fields("POLICYNO") = PolicyNo
                    rsAA.fields("DocNo") = DocNo
                    rsAA.fields("DATE") = ADate
                    rsAA.fields("BILLDATE") = BillDate
                    rsAA.fields("TOC") = TOC
                    rsAA.fields("Remarks") = AName
                    rsAA.fields("CAmount") = Amount
                    rsAA.fields("Amount_OC") = toval(rsAA.fields("CAmount"))
                    rsAA.fields("Amount") = toval(rsAA.fields("CAmount"))
                    rsAA.fields("Currency_OC") = tostr(rs.fields("Currency"))
                    rsAA.fields("Currency") = tostr(rs.fields("Currency"))
                    rsAA.fields("Rate") = 1
                    rsAA.fields("AdmNo") = -1
                    rsAA.fields("PProrata") = 1
                    rsAA.fields("AdjustableF") = 0
                    rsAA.fields("Source") = Source
                    If Not rsAA.Update Then GoTo errmsg

                    If toval(rs.fields("ContributionF")) And Left(tostr(rs.fields("FDType")), 1) <> "O" And ISType = "L" Then
                        Dim rsCo As RemoteSet
                        rsCo = db.OpenQueryDef("QCoinsurance", adOpenForwardonly, CNO)
                        Do While Not rsCo.Eof
                            If rsCo.fields("PCollectionF") Then
                                rsAA.AddNew()
                                rsAA.fields("BizMapID") = BizMapID
                                rsAA.fields("MSCode") = MSCode
                                rsAA.fields("Source") = Source
                                If toval(rs.fields("PolicyYear")) = 0 Then
                                    rsAA.fields("SDate") = SDate
                                    rsAA.fields("EDate") = EDate
                                Else
                                    rsAA.fields("SDate") = DateAdd(DateInterval.Year, toval(rs.fields("PolicyYear")) - 1, SDate)
                                    rsAA.fields("EDate") = DateAdd(DateInterval.Year, toval(rs.fields("PolicyYear")), SDate)
                                End If
                                rsAA.fields("ANO") = ANO
                                rsAA.fields("Type") = "CF"
                                rsAA.fields("ID") = tostr(rsCo.fields("ID"))

                                rsAA.fields("Code") = IIf(Left(tostr(rs.fields("FDType")), 1) = "O", "F", Left(tostr(rs.fields("FDType")), 1))
                                rsAA.fields("CodeExt") = IIf(Len(tostr(rs.fields("FDType"))) > 1, Right(tostr(rs.fields("FDType")), 1), "")

                                rsAA.fields("REFNO") = tostr(rsCo.fields("DocNo"))
                                rsAA.fields("POLICYNO") = PolicyNo
                                rsAA.fields("DocNo") = DocNo
                                rsAA.fields("DATE") = ADate
                                rsAA.fields("BILLDATE") = BillDate
                                rsAA.fields("TOC") = TOC
                                rsAA.fields("Remarks") = AName

                                rsAA.fields("CAmount") = -Amount * toval(rsCo.fields("Share")) / 100
                                rsAA.fields("Amount_OC") = toval(rsAA.fields("CAmount"))
                                rsAA.fields("Amount") = toval(rsAA.fields("CAmount"))
                                rsAA.fields("Currency_OC") = tostr(rs.fields("Currency"))
                                rsAA.fields("Currency") = tostr(rs.fields("Currency"))

                                rsAA.fields("Rate") = 1
                                rsAA.fields("AdmNo") = -1
                                rsAA.fields("PProrata") = 1
                                rsAA.fields("AdjustableF") = 0
                                rsAA.fields("AdjMethod") = ""
                                If Not rsAA.Update Then GoTo errmsg
                            End If

                            ' Joint Placement
                            If rsCo.fields("JP") <> 0 Then
                                rsAA.AddNew()
                                rsAA.fields("BizMapID") = BizMapID
                                rsAA.fields("MSCode") = MSCode
                                rsAA.fields("Source") = Source
                                If toval(rs.fields("PolicyYear")) = 0 Then
                                    rsAA.fields("SDate") = SDate
                                    rsAA.fields("EDate") = EDate
                                Else
                                    rsAA.fields("SDate") = DateAdd(DateInterval.Year, toval(rs.fields("PolicyYear")) - 1, SDate)
                                    rsAA.fields("EDate") = DateAdd(DateInterval.Year, toval(rs.fields("PolicyYear")), SDate)
                                End If

                                rsAA.fields("ANO") = ANO
                                rsAA.fields("Type") = "CF"
                                rsAA.fields("ID") = tostr(rsCo.fields("ID"))

                                rsAA.fields("Code") = IIf(Left(tostr(rs.fields("FDType")), 1) = "O", "F", Left(tostr(rs.fields("FDType")), 1))
                                rsAA.fields("CodeExt") = IIf(Len(tostr(rs.fields("FDType"))) > 1, Right(tostr(rs.fields("FDType")), 1), "")

                                rsAA.fields("REFNO") = tostr(rsCo.fields("DocNo"))
                                rsAA.fields("POLICYNO") = PolicyNo
                                rsAA.fields("DocNo") = DocNo
                                rsAA.fields("DATE") = ADate
                                rsAA.fields("BILLDATE") = BillDate
                                rsAA.fields("TOC") = TOC
                                rsAA.fields("Remarks") = AName

                                rsAA.fields("CAmount") = Amount * toval(rsCo.fields("JP")) / 100
                                rsAA.fields("Amount_OC") = toval(rsAA.fields("CAmount"))
                                rsAA.fields("Amount") = toval(rsAA.fields("CAmount"))
                                rsAA.fields("Currency_OC") = tostr(rs.fields("Currency"))
                                rsAA.fields("Currency") = tostr(rs.fields("Currency"))

                                rsAA.fields("Rate") = 1
                                rsAA.fields("AdmNo") = -1
                                rsAA.fields("PProrata") = 1
                                rsAA.fields("AdjustableF") = 0
                                rsAA.fields("AdjMethod") = ""
                                If Not rsAA.Update Then GoTo errmsg
                            End If
                            rsCo.MoveNext()
                        Loop
                        rsCo.CloseRemoteSet()
                    End If
                End If
                rs.MoveNext()
            Loop
            rs.CloseRemoteSet()
        End If

        ' Deposit
        rs = db.OpenQueryDef("QAccDeposit", adOpenForwardonly, ANO)
        If Not rs.Eof AndAlso toval(rs.fields("Amount")) <> 0 Then
            Dim Deposit As Double
            Dim Currency As String
            Deposit = toval(rs.fields("Amount"))
            Currency = tostr(rs.fields("Currency"))
            rsAA.AddNew()
            rsAA.fields("BizMapID") = BizMapID
            rsAA.fields("MSCode") = MSCode
            rsAA.fields("Source") = Source
            rsAA.fields("SDate") = SDate
            rsAA.fields("EDate") = EDate
            rsAA.fields("ANO") = ANO
            rsAA.fields("ID") = PID
            rsAA.fields("Type") = PType
            'If NetAdjustmentDepositF Then
            '    rsAA.fields("Type") = PType
            'Else
            '    rsAA.fields("Type") = "PD"
            'End If
            rsAA.fields("Code") = "J"
            rsAA.fields("REFNO") = RefNo
            rsAA.fields("POLICYNO") = PolicyNo
            rsAA.fields("DocNo") = DocNo
            rsAA.fields("DATE") = ADate
            rsAA.fields("BILLDATE") = BillDate
            rsAA.fields("TOC") = TOC
            rsAA.fields("Remarks") = AName
            rsAA.fields("CAmount") = Deposit
            rsAA.fields("Amount_OC") = toval(rsAA.fields("CAmount"))
            rsAA.fields("Amount") = toval(rsAA.fields("CAmount"))
            rsAA.fields("Currency_OC") = Currency
            rsAA.fields("Currency") = Currency
            rsAA.fields("Rate") = 1
            rsAA.fields("AdmNo") = -1
            rsAA.fields("PProrata") = 1
            rsAA.fields("AdjustableF") = 0
            rsAA.fields("AdjMethod") = ""
            rsAA.fields("DepositF") = True
            If Not rsAA.Update Then GoTo errmsg

            If ApplyCommissionDepositF Then
                rs = db.OpenQueryDef("QACCBS", adOpenForwardonly, ANO)
                Do While Not rs.Eof
                    rsAA.AddNew()
                    rsAA.fields("BizMapID") = BizMapID
                    rsAA.fields("MSCode") = MSCode
                    rsAA.fields("Source") = Source
                    rsAA.fields("SDate") = SDate
                    rsAA.fields("EDate") = EDate
                    rsAA.fields("ANO") = ANO
                    rsAA.fields("ID") = rs.fields("ID")
                    rsAA.fields("Type") = "B" & rs.fields("BSTYPE")
                    rsAA.fields("Code") = "C"
                    rsAA.fields("REFNO") = RefNo
                    rsAA.fields("POLICYNO") = PolicyNo
                    rsAA.fields("DocNo") = DocNo
                    rsAA.fields("DATE") = ADate
                    rsAA.fields("BILLDATE") = BillDate
                    rsAA.fields("TOC") = TOC
                    rsAA.fields("Remarks") = AName
                    rsAA.fields("CAmount") = -Deposit * rs.fields("Fee") / 100  ' Commission 
                    rsAA.fields("Amount_OC") = toval(rsAA.fields("CAmount"))
                    rsAA.fields("Amount") = toval(rsAA.fields("CAmount"))
                    rsAA.fields("Currency_OC") = Currency
                    rsAA.fields("Currency") = Currency
                    rsAA.fields("Rate") = 1
                    rsAA.fields("AdmNo") = -1
                    rsAA.fields("PProrata") = 1
                    rsAA.fields("AdjustableF") = 0
                    rsAA.fields("AdjMethod") = ""
                    rsAA.fields("DepositF") = True
                    If Not rsAA.Update Then GoTo errmsg
                    rs.MoveNext()
                Loop
            End If

            If ApplyReinsuranceDepositF Then
                Dim RDeposit As Double
                Dim RShare As Double
                Dim TShare As Double = 0

                ' Precede Facultative Cession
                rs = db.OpenQueryDef("QDEPOSIT_FACULTATIVE_CESSION", adOpenForwardonly, ANO, "F", 1)
                Do While Not rs.Eof
                    RShare = rs.fields("Share") * rs.fields("RShare") / 100
                    If TShare + RShare > 100 Then RShare = 100 - TShare
                    TShare = TShare + RShare
                    RDeposit = Deposit * RShare / 100 ' Reinsurance Share
                    Dim FType As String

                    Select Case rs.fields("RType")
                        Case "QS", "QP", "S1", "S2", "S3", "CF", "AF", "OP"
                            FType = rs.fields("RType")
                        Case "JP"
                            FType = "IC"
                        Case Else
                            FType = "FO"
                    End Select

                    rsAA.AddNew()
                    rsAA.fields("BizMapID") = BizMapID
                    rsAA.fields("MSCode") = MSCode
                    rsAA.fields("Source") = Source
                    rsAA.fields("SDate") = SDate
                    rsAA.fields("EDate") = EDate
                    rsAA.fields("ANO") = ANO
                    rsAA.fields("ID") = rs.fields("ID")
                    rsAA.fields("Type") = FType
                    rsAA.fields("Code") = "P"
                    rsAA.fields("REFNO") = rs.fields("SlipNo")
                    rsAA.fields("POLICYNO") = PolicyNo
                    rsAA.fields("DocNo") = DocNo
                    rsAA.fields("DATE") = ADate
                    rsAA.fields("BILLDATE") = BillDate
                    rsAA.fields("TOC") = TOC
                    rsAA.fields("Remarks") = AName
                    rsAA.fields("CAmount") = -RDeposit ' Gross Reinsurance Premium
                    rsAA.fields("Amount_OC") = toval(rsAA.fields("CAmount"))
                    rsAA.fields("Amount") = toval(rsAA.fields("CAmount"))
                    rsAA.fields("Currency_OC") = Currency
                    rsAA.fields("Currency") = Currency
                    rsAA.fields("Rate") = 1
                    rsAA.fields("AdmNo") = -1
                    rsAA.fields("PProrata") = 1
                    rsAA.fields("AdjustableF") = 0
                    rsAA.fields("AdjMethod") = ""
                    rsAA.fields("DepositF") = True
                    If Not rsAA.Update Then GoTo errmsg

                    rsAA.AddNew()
