                End If
                rs.MoveNext()
            Loop
        End If

        ' Finally
        If Not rsCA.Eof Then
            If Not rsCA.Update Then GoTo errmsg
        End If
        rsCA.CloseRemoteSet()
        rsClaim.CloseRemoteSet()

        ' Correction or Cancellation
        If ClaimType = "E" Or ClaimType = "C" Then
            If Not Make_Balance_ClaAss("", PCNO, CNO, ADate, DocNo) Then GoTo errmsg
        End If

        ' Copy Temporary Table
        If Not CalculationRoundingF Then
            If Not db.Execute("insert into ClaAss(TYPE,CNO,ID,CODE,CAmount,CURRENCY_OC,AMOUNT_OC,AMOUNT,RATE,CURRENCY,REFNO,DOCNO,DATE,TOC,POSTED,ADMNO,CLAIMNO,BILLDATE,REMARKS,CashLossF,BizMapID,Source,MSCode,CodeExt,RCODE,TOR) Select TYPE,CNO,ID,CODE,CAmount,CURRENCY_OC,AMOUNT_OC,AMOUNT,RATE,CURRENCY,REFNO,DOCNO,DATE,TOC,POSTED,ADMNO,CLAIMNO,BILLDATE,REMARKS,CashLossF,BizMapID,Source,MSCode,CodeExt,RCODE,TOR from #ClaAss") Then GoTo errmsg
        Else
            If Not db.Execute("insert into ClaAss(TYPE,CNO,ID,CODE,CAmount,CURRENCY_OC,AMOUNT_OC,AMOUNT,RATE,CURRENCY,REFNO,DOCNO,DATE,TOC,POSTED,ADMNO,CLAIMNO,BILLDATE,REMARKS,CashLossF,BizMapID,Source,MSCode,CodeExt,RCODE,TOR) Select TYPE,CNO,ID,CODE,CAmount,CURRENCY_OC,dbo.RoundCCY(AMOUNT_OC,CURRENCY_OC) AS AMOUNT_OC,dbo.RoundCCY(AMOUNT,CURRENCY) AS AMOUNT,RATE,CURRENCY,REFNO,DOCNO,DATE,TOC,POSTED,ADMNO,CLAIMNO,BILLDATE,REMARKS,CashLossF,BizMapID,Source,MSCode,CodeExt,RCODE,TOR from #ClaAss") Then GoTo errmsg
        End If
        ' Drop Temporary Table
        If Not db.Execute("Drop table #ClaAss") Then GoTo errmsg

        ' Update Current claim Status to Temporary Approved
        If Not db.Execute("Update Claim set CStatus='T', RUserDate='" & Format(Today.Date, "MM/DD/YYYY") & "', RUserID='" & db_user & "', RUserTime='" & Time() & "', CSDate='" & Format(ADate, "MM/DD/YYYY") & "' where CStatus='P' and CNO=" & CNO) Then GoTo errmsg
        If db.RecordsAffected = 0 Then GoTo errmsg

        Temporary_Approval = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Temporary_Approval = False
    End Function
    Private Function Make_Balance_ClaAss(ByVal QDef As String, ByVal PCNO As Long, ByVal CNO As Long, ByVal ADate As Date, ByVal DocNo As String) As Boolean
        Dim rsAA As RemoteSet
        Dim rsO As RemoteSet
        Dim BillDate As Date

        On Error GoTo errmsg

        rsAA = db.OpenRemoteSet("Select * from #ClaAss Where 1<>1")
        rsO = db.OpenQueryDef("Balance_ClaAss" & QDef, adOpenForwardonly, PCNO)
        Do While Not rsO.Eof
            rsAA.AddNew()
            db.backup_record(rsO, rsAA)
            rsAA.fields("DocNo") = DocNo
            rsAA.fields("CNO") = CNO
            rsAA.fields("CAmount") = 0
            rsAA.fields("Amount_OC") = -toval(rsO.fields("CAmount"))
            rsAA.fields("Amount") = -toval(rsO.fields("CAmount")) * toval(rsO.fields("Rate"))
            rsAA.fields("Posted") = 0
            rsAA.fields("AdmNo") = -1
            If DateDiff(DateInterval.Day, rsAA.fields("Date"), ADate) > 0 Then
                rsAA.fields("Date") = ADate
            End If
            BillDate = DateAdd(DateInterval.Day, toval(rsO.fields("CPDAYS")), ADate)
            If DateDiff(DateInterval.Day, rsAA.fields("BillDate"), BillDate) > 0 Then
                rsAA.fields("BillDate") = BillDate
            End If
            If Not rsAA.UpdateRow Then GoTo errmsg
            rsO.MoveNext()
        Loop
        ' Finally
        If Not rsAA.Eof Then
            If Not rsAA.Update Then GoTo errmsg
        End If
        rsO.CloseRemoteSet()
        rsAA.CloseRemoteSet()

        Make_Balance_ClaAss = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Make_Balance_ClaAss = False
    End Function

    Private Function ReOpenMaster(ByVal ANO As Long) As Boolean
        Dim rs As RemoteSet
        Dim AType As String
        Dim pCNO As Long
        Dim pANO As Long
        Dim OANO As Long
        Dim PDate As Date
        Dim EMethod As String
        Dim AStatus As String
        Dim BackDatedF As Boolean
        Dim RegNo As String
        Dim PolicyNo As String
        Dim CertificateNo As String
        Dim PHolderLimitF As Boolean
        On Error GoTo errmsg

        rs = db.OpenRemoteSet("Select Acceptance.RegNo, Acceptance.PolicyNo, Acceptance.CertificateNo, Acceptance.AStatus, Acceptance.PDate, Acceptance.AType, Acceptance.pANO, Acceptance.LANO, Acceptance.OANO, Acceptance.EMethod, pAcceptance.AType as pAType, Acceptance.BackDatedF, Cover.CNO, Cover.PCNO, Cover.OCNO, Cover.OpenFlag, Acceptance.Renewal from Acceptance Left Join Acceptance pAcceptance on (pAcceptance.ANO=Acceptance.pANO), Cover Where Cover.CNO=Acceptance.CNO and Acceptance.ANO=" & ANO)
        If rs.Eof Then GoTo errmsg
        PDate = todate(rs.fields("PDate"))
        AType = tostr(rs.fields("Atype"))
        pANO = toval(rs.fields("pANO"))
        OANO = toval(rs.fields("OANO"))
        pCNO = toval(rs.fields("CNO"))
        EMethod = tostr(rs.fields("EMethod"))
        AStatus = tostr(rs.fields("AStatus"))
        BackDatedF = toval(rs.fields("BackDatedF"))
        RegNo = tostr(rs.fields("RegNo"))
        PolicyNo = tostr(rs.fields("PolicyNo"))
        CertificateNo = tostr(rs.fields("CertificateNo"))
        rs.CloseRemoteSet()

        If AStatus = "I" Then
            'Create Log Object
            If Not Save_Log_Object("Acceptance", "ANO", ANO, "RegNo", RegNo, "PolicyNo", PolicyNo, "CertificateNo", CertificateNo, "", "", "", "ReOpen") Then GoTo errmsg

            If pANO <> -1 Then
                rs = db.OpenRemoteSet("Select CNO from Acceptance Where ANO=" & pANO)
                pCNO = toval(rs.fields("CNO"))
                rs.CloseRemoteSet()
            End If

            If Not BackDatedF Then
                If Not Undo_Production_To_Adm(ANO) Then GoTo errmsg
            Else
                If Not db.Execute("Delete from AccAss Where ANO=" & ANO) Then GoTo errmsg
            End If

            If AType = "E" Or AType = "C" Then
                If pANO <> -1 Then
                    If Not db.Execute("Update Acceptance Set AStatus='I', PPDate=EDate, CloseDate=Null, CloseTime='', CUserID='' Where AStatus='C' and ANO=" & pANO) Then GoTo errmsg
                    If db.RecordsAffected = 0 Then GoTo errmsg
                End If
                If EMethod = "A" Then
                    If Not db.Execute("Update A1 set A1.PPDate=A2.PDate from Acceptance A1, Acceptance A2 Where A1.PDate>='" & Format(PDate, "MM/DD/YYYY") & "' and A1.PPDate<>A2.PDate and A1.AStatus='C' and A1.ANO=A2.PANO And A2.ANO<>" & ANO & " and A2.OANO=" & OANO) Then GoTo errmsg
                End If
            End If

            If AType = "A" Then
                If Not db.Execute("Update Acceptance Set AdjustableF=1 from Acceptance Where Acceptance.ANO=" & pANO) Then GoTo errmsg
            End If

            ' Update Services
            If Not db.Execute("Update Service Set SStatus='P' Where SType<>'Claim' and SStatus='A' and ANO=" & ANO) Then GoTo errmsg

            ' Update Renewal References
            If AType <> "A" And AType <> "C" And pANO <> -1 Then
                If Not db.Execute("Update Cover set pCNO=" & pCNO & " from Acceptance, Cover Where Cover.CNO=Acceptance.CNO and Acceptance.RANO=" & ANO) Then GoTo errmsg
                If Not db.Execute("Update Acceptance set RANO=" & pANO & " from Acceptance, Cover Where Cover.CNO=Acceptance.CNO and Acceptance.RANO=" & ANO) Then GoTo errmsg
            End If

            ' Update Current Acceptance Status
            If Not db.Execute("Update Acceptance set AStatus='W', BackDatedF=0, AUserDate=Null, AUserTime='', AUserID='', RUserDate=Null, RUserTime='', RUserID='' where AStatus='I' and ANO=" & ANO) Then GoTo errmsg
            If db.RecordsAffected = 0 Then GoTo errmsg

            If Not db.Execute("Update AccCla Set Description=OrgDescription, Description_1=OrgDescription_1 Where AccCla.ANO=" & ANO & " and cast(OrgDescription as varchar(10))<>''") Then GoTo errmsg

            'ReOpen non inherit Child's Acceptance
            rs = db.OpenRemoteSet("Select ANO from Acceptance Where LANO=" & ANO & " and LANO<>ANO and RegNo='" & RegNo & "'")
            Do While Not rs.Eof
                If Not ReOpen(toval(rs.fields("ANO"))) Then GoTo errmsg
                rs.MoveNext()
            Loop
            rs.CloseRemoteSet()

            'Update inherit Child's Acceptance  link ANO  to the previous master
            If Not db.Execute("Update Acceptance set CNO=" & pCNO & ", LANO=" & pANO & " Where LANO=" & ANO & " and LANO<>ANO and RegNo<>'" & RegNo & "'") Then GoTo errmsg

            ' Update Facultative Status
            If Not db.Execute("Update RArrDet Set Status='R' Where Status='A' and ANO=" & ANO) Then GoTo errmsg
        Else
            If Not db.Execute("Delete from AccAss Where ANO=" & ANO) Then GoTo errmsg

            ' Update Current Acceptance Status
            If Not db.Execute("Update Acceptance set AStatus='W', BackDatedF=0, AUserDate=Null, AUserTime='', AUserID='', RUserDate=Null, RUserTime='', RUserID='' where AStatus='T' and ANO=" & ANO) Then GoTo errmsg
            If db.RecordsAffected = 0 Then GoTo errmsg

            If Not db.Execute("Update AccCla Set Description=OrgDescription, Description_1=OrgDescription_1 Where AccCla.ANO=" & ANO & " and cast(OrgDescription as varchar(10))<>''") Then GoTo errmsg

            ' Match previous db.begintrans from Calling Function
            db.Committrans()

            'ReOpen non inherit Child's Acceptance
            rs = db.OpenRemoteSet("Select ANO from Acceptance Where LANO=" & ANO & " and LANO<>ANO and RegNo='" & RegNo & "'")
            Do While Not rs.Eof
                db.Begintrans()
                If Not ReOpen(toval(rs.fields("ANO"))) Then
                    db.RollBack()
                    GoTo errmsg
                Else
                    db.Committrans()
                End If
                rs.MoveNext()
            Loop
            rs.CloseRemoteSet()

            ' Match previous db.begintrans from Calling Function
            db.Begintrans()
        End If

        ReOpenMaster = True

        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        ReOpenMaster = False
    End Function
    Private Function Cancel_Voucher(ByVal Voucher As String, Optional ByVal CheckLockedDateF As Boolean = True) As Boolean
        Try
            If Not db.GetLockedObject("Voucher" & Voucher) Then Throw New Exception(db.ErrDesc)

            Dim rs As RemoteSet

            rs = db.OpenRemoteSet("Select * from nSL Where paymentF=1 and Doc_No='" & Voucher & "'")
            If Not rs.Eof Then
                StrMsg = "Voucher Already Used by WithHolding Voucher No. '" & tostr(rs.fields("Voucher")) & "' !"
                Throw New Exception(StrMsg)
            End If

            rs = db.OpenRemoteSet("Select * from ReminderV where Voucher='" & Voucher & "'")
            If Not rs.Eof Then
                StrMsg = "Voucher Already Used by Reminder No. '" & tostr(rs.fields("PrintNo")) & "' !"
                Throw New Exception(StrMsg)
            End If

            rs = db.OpenRemoteSet("Select * from CollectionV where Voucher='" & Voucher & "'")
            If Not rs.Eof Then
                StrMsg = "Voucher Already Used by Collection No. '" & tostr(rs.fields("CollNo")) & "' !"
                Throw New Exception(StrMsg)
            End If

            rs = db.OpenRemoteSet("Select * from SL_request where PaymentF=1 and Doc_No='" & Voucher & "'")
            If Not rs.Eof Then
                StrMsg = "Voucher Already Used by Payment Request No. '" & tostr(rs.fields("Request")) & "' !"
                Throw New Exception(StrMsg)
            End If

            rs = db.OpenRemoteSet("Select * from pSL where paymentf=1 and Doc_No='" & Voucher & "'")
            If Not rs.Eof Then
                StrMsg = "Voucher Already Used by Voucher No. '" & tostr(rs.fields("Voucher")) & "' !"
                Throw New Exception(StrMsg)
            End If

            rs = db.OpenRemoteSet("Select * from nVoucher Where Voucher='" & Voucher & "'")
            If rs.Eof Then
                StrMsg = "No Voucher Data !"
                Throw New Exception(StrMsg)
            End If
            If Not rs.fields("BackDatedF") And rs.fields("Posting_Flag") = True Then
                StrMsg = "Voucher Already Processed / Posted !"
                Throw New Exception(StrMsg)
            End If
            If rs.fields("nPayment") <> 0 Then
                StrMsg = "Voucher Already Has Payment !"
                Throw New Exception(StrMsg)
            End If
            If Not db.GetPrivileges("ALLOWCANCELVOUCHER") Then
                StrMsg = "No Privileges for Voucher Cancellation !"
                Throw New Exception(StrMsg)
            End If

            If Not Save_Log_Object("nVoucher", "Voucher", Voucher, "ProAcc", rs.fields("ProAcc"), "DocNo", rs.fields("DocNo"), "Remarks", rs.fields("Remarks"), "", "", "", "Delete") Then Throw New Exception("Can't Save to Log !")

            If CheckLockedDateF Then
                Dim LockedDate As Date
                Dim BLLocked As Integer
                LockedDate = GetLockedDate(rs.fields("Branch"))
                BLLocked = GetUserBLLocked(db_user)

                If (DateDiff(DateInterval.Day, LockedDate, rs.fields("Date")) <= 0 And (DateDiff(DateInterval.Day, LockedDate, Today.Date) > BLLocked Or BLLocked = 0)) Then
                    StrMsg = "Please Check The Transaction Closing Period (Locked Date) !"
                    Throw New Exception(StrMsg)
                End If
            End If

            If Not db.Execute("Update Admlink Set VoucherF=0, Voucher='' Where voucher='" & Voucher & "'") Then Throw New Exception(db.ErrDesc)
            If Not db.Execute("Delete from nVoucher where Voucher='" & Voucher & "' and Posting_Flag=0 and Status='U' and nPayment=0") Then Throw New Exception(db.ErrDesc)
            If db.RecordsAffected = 0 Then Throw New Exception("No Record Affected !")

            If Not db.ReleaseLockedObject("Voucher" & Voucher) Then Throw New Exception(db.ErrDesc)
            Return True
        Catch ex As Exception
            StrMsg = ex.Message
            Return False
        End Try

    End Function
    Private Function Undo_Production_To_Adm(ByVal ANO As Long, Optional ByVal UpdateOnlyFlag As Boolean = False) As Boolean
        Dim rs As RemoteSet
        Dim rsAdm As RemoteSet
        Dim PID As String
        Dim Amount As Double
        Dim pCCY As String
        Dim pDate As Date
        Dim AdmNo As Long
        Dim LANO As Long
        Dim SplitDNCNF As Boolean

        rs = db.OpenRemoteSet("Select LANO, SplitDNCNF from Acceptance Where Acceptance.ANO=" & ANO)
        LANO = toval(rs.fields("LANO"))
        SplitDNCNF = toval(rs.fields("SplitDNCNF"))

        rs = db.OpenQueryDef("QUndo_Production_To_Adm", adOpenForwardonly, ANO)
        Do While Not rs.Eof
            AdmNo = rs.fields("AdmNo")
            If Not db.GetLockedObject("ADMLINK_" & AdmNo) Then GoTo errmsg

            rsAdm = db.OpenRemoteSet("Select * from AdmLink Where AdmNo=" & AdmNo)
            If Not rsAdm.Eof Then

                If toval(rsAdm.fields("VoucherF")) Then
                    If Cancel_Voucher(tostr(rsAdm.fields("Voucher"))) Then
                        ' Re Open 
                        rsAdm = db.OpenRemoteSet("Select * from AdmLink Where AdmNo=" & AdmNo)
                    Else
                        GoTo errmsg
                    End If
                End If

                PID = rsAdm.fields("ID")
                pCCY = rsAdm.fields("Currency")
                pDate = rsAdm.fields("Date")

                If Not toval(rsAdm.fields("VoucherF")) Then
                    'Update Tax Table
                    If toval(rsAdm.fields("TaxTableF")) Then
                        If Not Update_Tax_Table(PID, pDate, pCCY, -rsAdm.fields("PNominal_Tax"), -toval(rsAdm.fields("Amount_14"))) Then
                            StrMsg = "Failed in Calculating Vat/Tax !"
                            GoTo errmsg
                        End If
                    End If

                    rsAdm.Edit()

                    rsAdm.fields("TaxTableF") = False

                    ' Case "P"    ' Premium
                    rsAdm.fields("Amount_1") = toval(rsAdm.fields("Amount_1")) - toval(rs.fields("Amount_1"))
                    ' Case "C"    ' Commission
                    rsAdm.fields("Amount_2") = toval(rsAdm.fields("Amount_2")) - toval(rs.fields("Amount_2"))
                    ' Case "F"    ' Fee
                    rsAdm.fields("Amount_3") = toval(rsAdm.fields("Amount_3")) - toval(rs.fields("Amount_3"))
                    ' Case "D"    ' Duty
                    rsAdm.fields("Amount_4") = toval(rsAdm.fields("Amount_4")) - toval(rs.fields("Amount_4"))
                    ' Case "O"    ' Discount/Acquisition Cost
                    rsAdm.fields("Amount_5") = toval(rsAdm.fields("Amount_5")) - toval(rs.fields("Amount_5"))
                    ' Case "A"    ' Claim Amount
                    rsAdm.fields("Amount_6") = toval(rsAdm.fields("Amount_6")) - toval(rs.fields("Amount_6"))
                    ' Case "O1"    ' Premium Adjustment
                    rsAdm.fields("Amount_7") = toval(rsAdm.fields("Amount_7")) - toval(rs.fields("Amount_7"))
                    ' Case "O2"    ' Profit Sharing
                    rsAdm.fields("Amount_8") = toval(rsAdm.fields("Amount_8")) - toval(rs.fields("Amount_8"))
                    ' Case "C1"    ' Overriding COmmission
                    rsAdm.fields("Amount_9") = toval(rsAdm.fields("Amount_9")) - toval(rs.fields("Amount_9"))
                    ' Case "R"    ' Claim Subrogation
                    rsAdm.fields("Amount_10") = toval(rsAdm.fields("Amount_10")) - toval(rs.fields("Amount_10"))
                    ' Case "F3/D3"    ' Others Fee / Stamp Duty #3
                    rsAdm.fields("Amount_12") = toval(rsAdm.fields("Amount_12")) - toval(rs.fields("Amount_12"))
                    ' Case "T"    ' Tax
                    rsAdm.fields("Amount_14") = toval(rsAdm.fields("Amount_14")) - toval(rs.fields("Amount_14"))
                    ' Case "F1/D1"    ' Others Fee / Stamp Duty #1
                    rsAdm.fields("Amount_15") = toval(rsAdm.fields("Amount_15")) - toval(rs.fields("Amount_15"))
                    ' Case "F2/D2"    ' Others Fee / Stamp Duty #2
                    rsAdm.fields("Amount_16") = toval(rsAdm.fields("Amount_16")) - toval(rs.fields("Amount_16"))
                    ' Case "J"    ' Deposit/Reserve/Advance
                    rsAdm.fields("Amount_19") = toval(rsAdm.fields("Amount_19")) - toval(rs.fields("Amount_19"))
                    ' Case "U"    ' Ujroh Fee
                    rsAdm.fields("Amount_20") = toval(rsAdm.fields("Amount_20")) - toval(rs.fields("Amount_20"))

                    Dim VATsubsidies As Double = 0

                    If Abs(rsAdm.fields("Amount_8") + rsAdm.fields("Amount_13")) <= 0.001 Then
                        VATsubsidies = -rsAdm.fields("Amount_8")
                    End If

                    Amount = VATsubsidies + toval(rsAdm.fields("Amount_1")) + toval(rsAdm.fields("Amount_2")) + toval(rsAdm.fields("Amount_3")) + toval(rsAdm.fields("Amount_4")) + toval(rsAdm.fields("Amount_5")) + toval(rsAdm.fields("Amount_6")) + toval(rsAdm.fields("Amount_7")) + toval(rsAdm.fields("Amount_8")) + toval(rsAdm.fields("Amount_9")) + toval(rsAdm.fields("Amount_10")) + toval(rsAdm.fields("Amount_12")) + toval(rsAdm.fields("Amount_15")) + toval(rsAdm.fields("Amount_16")) + toval(rsAdm.fields("Amount_19")) + toval(rsAdm.fields("Amount_20"))
                    rsAdm.fields("Amount") = Amount
                    rsAdm.fields("Amount_8") = toval(rsAdm.fields("Amount_8")) + VATsubsidies
                    rsAdm.fields("Amount_11") = 0
                    rsAdm.fields("Amount_13") = 0
                    rsAdm.fields("Amount_14") = 0
                    rsAdm.fields("Amount_17") = 0
                    rsAdm.fields("Amount_18") = 0

                    rsAdm.fields("LUserID") = db_user
                    rsAdm.fields("LDate") = Today.Date
                    rsAdm.fields("LTime") = Time()
                    If Not rsAdm.Update Then GoTo errmsg
                Else
                    StrMsg = "Voucher Already Created !"
                    GoTo errmsg
                End If
            End If

            If Not Production_To_Adm_Finalize(ANO, LANO, AdmNo, False, SplitDNCNF) Then GoTo errmsg

            If UpdateOnlyFlag Then
                ' Update Only
                If Not db.Execute("Update AccAss Set AdmNo=-1, Posted=0 Where ANO=" & ANO & " and AdmNo=" & AdmNo) Then GoTo errmsg
            Else
                ' Delete AccAss
                If Not db.Execute("Delete from AccAss Where ANO=" & ANO & " and AdmNo=" & AdmNo) Then GoTo errmsg
            End If

            If Not db.Execute("Delete Admlink from admlink Where AdmNo=" & AdmNo & " and WriteF=1 and not exists (Select Top 1 AdmNo from AccAss Where AccAss.AdmNo=Admlink.AdmNo)") Then GoTo errmsg

            If Not db.ReleaseLockedObject("ADMLINK_" & AdmNo) Then GoTo errmsg
            rsAdm.CloseRemoteSet()
            rs.MoveNext()
        Loop
        rs.CloseRemoteSet()

        Undo_Production_To_Adm = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Undo_Production_To_Adm = False
    End Function

    Private Function ReOpen(ByVal ANO As Long) As Boolean
        Dim rs As RemoteSet
        Dim AType As String
        Dim pAType As String
        Dim pCNO As Long
        Dim pANO As Long
        Dim OANO As Long
        Dim PDate As Date
        Dim EMethod As String
        Dim AStatus As String
        Dim BackDatedF As Boolean
        Dim RegNo As String
        Dim PolicyNo As String
        Dim CertificateNo As String
        Dim PHolderLimitF As Boolean

        On Error GoTo errmsg

        rs = db.OpenRemoteSet("Select PHolderLimitF from SysTab")
        PHolderLimitF = rs.fields("PHolderLimitF")

        rs = db.OpenRemoteSet("Select Acceptance.RegNo, Acceptance.PolicyNo, Acceptance.CertificateNo, Acceptance.AStatus, Acceptance.PDate, Acceptance.AType, Acceptance.pANO, Acceptance.LANO, Acceptance.OANO, Acceptance.EMethod, pAcceptance.AType as pAType, Acceptance.BackDatedF, Cover.CNO, Cover.PCNO, Cover.OCNO, Cover.OpenFlag, Acceptance.Renewal from Acceptance Left Join Acceptance pAcceptance on (pAcceptance.ANO=Acceptance.pANO), Cover Where Cover.CNO=Acceptance.CNO and Acceptance.ANO=" & ANO)
        If rs.Eof Then GoTo errmsg
        PDate = todate(rs.fields("PDate"))
        AType = tostr(rs.fields("Atype"))
        pAType = tostr(rs.fields("pAtype"))
        pANO = toval(rs.fields("pANO"))
        OANO = toval(rs.fields("OANO"))
        EMethod = tostr(rs.fields("EMethod"))
        AStatus = tostr(rs.fields("AStatus"))
        BackDatedF = toval(rs.fields("BackDatedF"))
        RegNo = tostr(rs.fields("RegNo"))
        PolicyNo = tostr(rs.fields("PolicyNo"))
        CertificateNo = tostr(rs.fields("CertificateNo"))
        rs.CloseRemoteSet()

        If AStatus = "I" Then
            'Create Log Object
            If Not Save_Log_Object("Acceptance", "ANO", ANO, "RegNo", RegNo, "PolicyNo", PolicyNo, "CertificateNo", CertificateNo, "", "", "", "ReOpen") Then GoTo errmsg

            If pANO <> -1 Then
                rs = db.OpenRemoteSet("Select CNO from Acceptance Where ANO=" & pANO)
                pCNO = toval(rs.fields("CNO"))
                rs.CloseRemoteSet()
            End If

            If Not BackDatedF Then
                ' Check Policy Holder Limit
                If AType = "N" Or AType = "E" Or AType = "C" Then
                    If PHolderLimitF Then
                        If Not db.Execute("QUndoUpdate_PHolder_LimitUsage " & ANO) Then
                            StrMsg = StrMsg & "Undo Updating Policy Holder Limit Usage Failed !" & vbCrLf
                        End If
                    End If
                End If
                If Not Undo_Production_To_Adm(ANO) Then GoTo errmsg
            Else
                If Not db.Execute("Delete from AccAss Where ANO=" & ANO) Then GoTo errmsg
            End If
            ' Update Previous Acceptance Status
            If AType = "E" Or AType = "C" Then
                If Not db.Execute("Update Acceptance Set AStatus='I', PPDate=EDate, CloseDate=Null, CloseTime='', CUserID='' Where AStatus='C' and ANO=" & pANO) Then GoTo errmsg
                If db.RecordsAffected = 0 Then GoTo errmsg
                If EMethod = "A" Then
                    If Not db.Execute("Update A1 set A1.PPDate=A2.PDate from Acceptance A1, Acceptance A2 Where A1.PDate>='" & Format(PDate, "MM/DD/YYYY") & "' and A1.PPDate<>A2.PDate and A1.AStatus='C' and A1.ANO=A2.PANO And A2.ANO<>" & ANO & " and A2.OANO=" & OANO) Then GoTo errmsg
                End If
                If AType = "C" Then
                    If Not db.Execute("Update A1 Set AdjustableF=0 from Acceptance A1, Acceptance A2, ICalc Where A2.AType='A' and A1.ANO=ICalc.SANO and ICalc.ANO=A2.ANO and A2.ANO=" & pANO) Then GoTo errmsg
                    If Not db.Execute("Update A1 Set AdjustableF=0 from Acceptance A1, Acceptance A2 Where A2.AType='A' and A1.ANO=A2.pANO and A2.ANO=" & pANO) Then GoTo errmsg
                End If
            ElseIf AType = "A" Then
                If Not db.Execute("Update A1 Set AdjustableF=1 from Acceptance A1, Acceptance A2, ICalc Where A2.AType='A' and A1.ANO=ICalc.SANO and ICalc.ANO=A2.ANO and A2.ANO=" & ANO) Then GoTo errmsg
                If Not db.Execute("Update A1 Set AdjustableF=1 from Acceptance A1, Acceptance A2 Where A2.AType='A' and A1.ANO=A2.pANO and A2.ANO=" & ANO) Then GoTo errmsg
            End If

            ' Update Services
            If Not db.Execute("Update Service Set SStatus='P' Where SType<>'Claim' and SStatus='A' and ANO=" & ANO) Then GoTo errmsg

            ' Update Renewal References
            If AType <> "A" And AType <> "C" And pANO <> -1 Then
                If Not db.Execute("Update Cover set pCNO=" & pCNO & " from Acceptance, Cover Where Cover.CNO=Acceptance.CNO and Acceptance.RANO=" & ANO) Then GoTo errmsg
                If Not db.Execute("Update Acceptance set RANO=" & pANO & " from Acceptance, Cover Where Cover.CNO=Acceptance.CNO and Acceptance.RANO=" & ANO) Then GoTo errmsg
            End If

            ' Update Scheme Transactions
            If Not db.Execute("Update Scheme_Transaction Set Status='V' Where ANO=" & ANO) Then GoTo errmsg

            If pANO <> -1 And pAType <> "A" And pAType <> "C" Then
                If Not db.Execute("Update Renewal Set ANO=" & pANO & ", PStatus='I' Where ANO=" & ANO) Then GoTo errmsg
            Else
                If Not db.Execute("Delete Renewal Where ANO=" & ANO) Then GoTo errmsg
            End If
            If Not db.Execute("Update Renewal Set Status='R' Where NEWANO=" & ANO) Then GoTo errmsg

            ' Update Current Acceptance Status
            If Not db.Execute("Update Acceptance set AStatus='W', BackDatedF=0, AUserDate=Null, AUserTime='', AUserID='', RUserDate=Null, RUserTime='', RUserID='' where AStatus='I' and ANO=" & ANO) Then GoTo errmsg
            If db.RecordsAffected = 0 Then GoTo errmsg

            ' Update Indemnity
            If EMethod = "R" Then ' Reinstatement
                If Not db.Execute("Update ICover Set Indemnity=ICalc.Indemnity from ICover, ICalc Where ICover.INO=ICalc.INO and ICalc.ANO=" & ANO) Then GoTo errmsg
                If Not db.Execute("Update ICover Set Indemnity=ICalc.Indemnity from ICoverNOC ICover, ICalc Where ICover.INO=ICalc.INO and ICalc.ANO=" & ANO) Then GoTo errmsg
            End If

            ' Update accumulation register & cover limit accumulation
            'If AType <> "A" Then
            '    If AType = "C" Then
            '        If Not UnReleaseAccRegAmount(ANO, True) Then GoTo errmsg
            '    End If
            'End If

            ' Update Facultative Status
            If Not db.Execute("Update RArrDet Set Status='R' Where Status='A' and ANO=" & ANO) Then GoTo errmsg
        ElseIf AStatus = "T" Then
            If Not db.Execute("Delete from AccAss Where ANO=" & ANO) Then GoTo errmsg

            ' Update Current Acceptance Status
            If Not db.Execute("Update Acceptance set AStatus='W', BackDatedF=0, AUserDate=Null, AUserTime='', AUserID='', RUserDate=Null, RUserTime='', RUserID='' where AStatus='T' and ANO=" & ANO) Then GoTo errmsg
            If db.RecordsAffected = 0 Then GoTo errmsg
        End If

        If Not db.Execute("Update AccCla Set Description=OrgDescription, Description_1=OrgDescription_1 Where AccCla.ANO=" & ANO & " and cast(OrgDescription as varchar(10))<>''") Then GoTo errmsg

        ReOpen = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        ReOpen = False
    End Function
    Private Function Posting_SurplusCalculation(ByVal ADate As Date, ByVal Param As Object, Optional ByVal ANO As Long = 0) As Boolean
        Dim rs As RemoteSet
        Dim rsAdm As RemoteSet
        On Error GoTo errmsg

        Dim PYear As Integer
        Dim PID As String
        Dim PCode As String
        Dim PType As String
        Dim PCCY As String
        Dim PRefNo As String
        Dim PADate As Date
        Dim PBillDate As Date
        Dim PSubject As String
        Dim PBRanch As String
        Dim pSegment As String
        Dim pPolicyNo As String
        Dim PDocNo As String
        Dim PolicyNo As String
        Dim VoucherF As Boolean
        Dim TaxTableF As Boolean

        Dim SQL As String

        ' Get Based Currency
        rs = db.OpenRemoteSet("Select Currency, TaxTableF from SysTab")
        PCCY = rs.fields("Currency")
        TaxTableF = rs.fields("TaxTableF")
        If ANO <> 0 Then
            SQL = "Select A1.*, A2.TOC, C.Segment, C.MO, C.RefNo as CRefNo, C.OpenFlag, C.ISType, A2.Branch, A2.Remarks, A2.LANO, A2.SDate, A2.EDate, A2.AID, A2.PolicyNo, A2.CertificateNo, A2.Source, A2.CT, A2.MSCode, A2.BizMapID from AccSurplus A1, Acceptance A2, Cover C Where C.CNO=A2.CNO and A1.Status='R' and A1.ANO=A2.OANO and A2.ANO=" & ANO
            rs = db.OpenRemoteSet(SQL)
            VoucherF = toval(getInParamValue(Param, 8))
        Else
            Dim SDate As Date = todate(getInParamValue(Param, 0))
            Dim EDate As Date = todate(getInParamValue(Param, 1))
            Dim Segment As String = tostr(getInParamValue(Param, 2))
            Dim Branch As String = tostr(getInParamValue(Param, 3))
            Dim TOC As String = tostr(getInParamValue(Param, 4))
            Dim ID As String = tostr(getInParamValue(Param, 5))
            Dim LimitB As Double = toval(getInParamValue(Param, 6))
            Dim LimitU As Double = toval(getInParamValue(Param, 7))
            VoucherF = toval(getInParamValue(Param, 8))

            SQL = "Select A1.*, A2.TOC, C.Segment, C.MO, C.RefNo as CRefNo, C.OpenFlag, C.ISType, A2.Branch, A2.Remarks, A2.LANO, A2.SDate, A2.EDate, A2.AID, A2.PolicyNo, A2.CertificateNo, A2.Source, A2.CT, A2.MSCode, A2.BizMapID from AccSurplus A1, Acceptance A2, Cover C Where C.CNO=A2.CNO and A1.Status='R' and A1.ANO=A2.OANO and A1.PDate Between '" & Format(SDate, "MM/DD/YYYY") & "' and '" & Format(EDate, "MM/DD/YYYY") & "'"
            If Segment <> "" Then
                SQL = SQL & " and C.Segment='" & Segment & "'"
            End If
            If Branch <> "" Then
                SQL = SQL & " and A2.Branch='" & Branch & "'"
            End If
            If TOC <> "" Then
                SQL = SQL & " and A2.TOC='" & TOC & "'"
            End If
            If ID <> "" Then
                SQL = SQL & " and A1.ID='" & ID & "'"
            End If
            If LimitB <> 0 Then
                SQL = SQL & " and A1.Surplus>=" & tovalSF(LimitB)
            End If
            If LimitU <> 0 Then
                SQL = SQL & " and A1.Surplus<=" & tovalSF(LimitU)
            End If
            rs = db.OpenRemoteSet(SQL)
        End If
        Do While Not rs.Eof
            ANO = toval(rs.fields("ANO"))
            PYear = toval(rs.fields("PYear"))
            If Not rs.fields("OpenFlag") Or rs.fields("LANO") = -1 Then
                PolicyNo = rs.fields("PolicyNo")
            Else
                PolicyNo = rs.fields("PolicyNo") & "-" & rs.fields("CertificateNo")
            End If
            PID = rs.fields("ID")
            PCode = rs.fields("TOC")
            PType = "SC"
            PRefNo = PolicyNo
            PDocNo = PolicyNo
            PADate = ADate
            PBillDate = ADate
            PSubject = "SURPLUS"
            PBRanch = rs.fields("Branch")
            pSegment = rs.fields("pSegment")
            pPolicyNo = PolicyNo
            rsAdm = db.OpenQueryDef("QAdmLink", adOpenKeyset, PID, PCode, PType, PCCY, PRefNo, PADate, PBillDate, PDocNo, PSubject, PBRanch, pSegment, pPolicyNo)
            If Not rsAdm.Eof Then
                rsAdm.Edit()
            Else
                rsAdm.AddNew()
                rsAdm.fields("AdmNo") = db.GetIdentity("Admlink") + 1
                rsAdm.fields("ID") = PID
                rsAdm.fields("CODE") = PCode
                rsAdm.fields("TYPE") = PType
                rsAdm.fields("Currency") = PCCY
                rsAdm.fields("Subject") = PSubject
                rsAdm.fields("Branch") = PBRanch
                rsAdm.fields("RefNo") = PRefNo
                rsAdm.fields("DocNo") = PDocNo
                rsAdm.fields("Date") = PADate
                rsAdm.fields("BillDate") = PBillDate
                rsAdm.fields("Segment") = pSegment
                rsAdm.fields("A_PolicyNo") = pPolicyNo
                Dim BankAccount As String
                Dim BankName As String
                Dim Bank As String
                Dim BankBranch As String
                Dim AccountNo As String
                Get_BankAccount(PID, PCCY, Bank, BankBranch, AccountNo, BankAccount, BankName)
                rsAdm.fields("Bank") = Bank
                rsAdm.fields("BankBranch") = BankBranch
                rsAdm.fields("AccountNo") = AccountNo
                rsAdm.fields("BankAccount") = BankAccount
                rsAdm.fields("BankName") = BankName
            End If
            rsAdm.fields("CT") = rs.fields("CT")
            rsAdm.fields("Source") = rs.fields("Source")
            rsAdm.fields("AgentID") = ""
            rsAdm.fields("BrokerID") = ""
            rsAdm.fields("CPAID") = ""
            rsAdm.fields("BatchNo") = ""
            rsAdm.fields("ISType") = rs.fields("ISType")
            rsAdm.fields("WPC") = 0
            rsAdm.fields("MSCODE") = rs.fields("MSCODE")
            rsAdm.fields("BizMapID") = rs.fields("BizMapID")
            rsAdm.fields("A_ID") = rs.fields("AID")
            rsAdm.fields("A_SDate") = rs.fields("SDate")
            rsAdm.fields("A_EDate") = rs.fields("EDate")
            rsAdm.fields("A_MO") = rs.fields("MO")
            rsAdm.fields("A_RefNo") = rs.fields("CRefNo")
            rsAdm.fields("Extra_1") = "SURPLUS"
            rsAdm.fields("Remarks") = tostr(rs.fields("Remarks"))
            rsAdm.fields("Statement") = 0
            rsAdm.fields("VoucherF") = 0
            rsAdm.fields("Amount_1") = toval(rsAdm.fields("Amount_1")) - toval(rs.fields("Surplus"))
            rsAdm.fields("LUserID") = db_user
            rsAdm.fields("LDate") = Today.Date
            rsAdm.fields("LTime") = Time()
            ' Rounding Amount
            Dim Amount As Double
            Dim TAmount As Double

            TAmount = toval(rsAdm.fields("Amount_1")) + toval(rsAdm.fields("Amount_2")) + toval(rsAdm.fields("Amount_3")) + toval(rsAdm.fields("Amount_4")) + toval(rsAdm.fields("Amount_5")) + toval(rsAdm.fields("Amount_6")) + toval(rsAdm.fields("Amount_7")) + toval(rsAdm.fields("Amount_8")) + toval(rsAdm.fields("Amount_9")) + toval(rsAdm.fields("Amount_10")) + toval(rsAdm.fields("Amount_18")) + toval(rsAdm.fields("Amount_19")) + toval(rsAdm.fields("Amount_20"))
            Amount = RoundCCY(TAmount, PCCY) - TAmount - toval(rsAdm.fields("Amount_11"))
            rsAdm.fields("Amount_11") = toval(rsAdm.fields("Amount_11")) + Amount

            Dim PNominal As Double
            Dim VAT As Double
            Dim TAX As Double
            Dim TaxType As String = ""
            Dim pTaxTableF As Boolean = TaxTableF
            PNominal = -toval(rs.fields("Surplus")) + Amount
            If Not Calculate_VAT_TAX(pTaxTableF, PID, PType, PADate, PCCY, PNominal, PNominal, VAT, TAX, TaxType) Then
                StrMsg = "Failed in Calculating Vat/Tax !"
                GoTo errmsg
            End If

            If pTaxTableF And TaxType = "PASAL21" Then
                rsAdm.fields("TaxTableF") = pTaxTableF
            End If

            If toval(rsAdm.fields("TaxTableF")) Then
                If Not Update_Tax_Table(PID, PADate, PCCY, PNominal, TAX) Then
                    StrMsg = "Failed Inserting into Tax Table !"
                    GoTo errmsg
                End If
            End If
            rsAdm.fields("Amount_13") = toval(rsAdm.fields("Amount_13")) + VAT
            rsAdm.fields("Amount_14") = toval(rsAdm.fields("Amount_14")) + TAX
            rsAdm.fields("Amount") = TAmount + toval(rsAdm.fields("Amount_11")) + toval(rsAdm.fields("Amount_13")) + toval(rsAdm.fields("Amount_14"))
            If toval(rsAdm.fields("Amount")) = 0 Then
                rsAdm.fields("WriteF") = 1
            Else
                rsAdm.fields("WriteF") = 0
            End If
            If Not rsAdm.Update Then GoTo errmsg
            If Not db.Execute("Update AccSurplus set Status='P', AdmNo=" & rsAdm.fields("AdmNo") & " Where Status='R' and ANO=" & ANO & " and PYear=" & PYear) Then GoTo errmsg
            If db.RecordsAffected = 0 Then GoTo errmsg
            If VoucherF Then If Create_Voucher(rsAdm.fields("AdmNo"), True) = "" Then GoTo errmsg
            rs.MoveNext()
        Loop

        Posting_SurplusCalculation = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Posting_SurplusCalculation = False
    End Function
    Private Function UnPosting_SurplusCalculation(ByVal Param As Object, Optional ByVal ANO As Long = 0) As Boolean
        Dim rs As RemoteSet
        Dim rsAdm As RemoteSet
        Dim PType As String
        Dim PYear As Integer
        Dim PID As String
        Dim Amount As Double
        Dim pCCY As String
        Dim pDate As Date

        Dim SDate As Date = todate(getInParamValue(Param, 0))
        Dim EDate As Date = todate(getInParamValue(Param, 1))
        Dim Segment As String = tostr(getInParamValue(Param, 2))
        Dim Branch As String = tostr(getInParamValue(Param, 3))
        Dim TOC As String = tostr(getInParamValue(Param, 4))
        Dim ID As String = tostr(getInParamValue(Param, 5))
        Dim LimitB As Double = toval(getInParamValue(Param, 6))
        Dim LimitU As Double = toval(getInParamValue(Param, 7))
        Dim SQL As String

        ' Get Based Currency
        rs = db.OpenRemoteSet("Select Currency from SysTab")
        pCCY = rs.fields("Currency")
        If ANO <> 0 Then
            SQL = "Select A1.*, A2.TOC, C.Segment, C.MO, C.RefNo as CRefNo, C.OpenFlag, C.ISType, A2.Branch, A2.Remarks, A2.LANO, A2.SDate, A2.EDate, A2.AID, A2.PolicyNo, A2.CertificateNo, A2.Source, A2.CT from AccSurplus A1, Acceptance A2, Cover C Where C.CNO=A2.CNO and A1.Status='P' and A1.ANO=A2.OANO and A2.ANO=" & ANO
            rs = db.OpenRemoteSet(SQL)
        Else
            SQL = "Select A1.*, A2.TOC, C.Segment, C.MO, C.RefNo as CRefNo, C.OpenFlag, C.ISType, A2.Branch, A2.Remarks, A2.LANO, A2.SDate, A2.EDate, A2.AID, A2.PolicyNo, A2.CertificateNo, A2.Source, A2.CT from AccSurplus A1, Acceptance A2, Cover C Where C.CNO=A2.CNO and A1.Status='P' and A1.ANO=A2.OANO and A1.PDate Between '" & Format(SDate, "MM/DD/YYYY") & "' and '" & Format(EDate, "MM/DD/YYYY") & "'"
            If Segment <> "" Then
                SQL = SQL & " and C.Segment='" & Segment & "'"
            End If
            If Branch <> "" Then
                SQL = SQL & " and A2.Branch='" & Branch & "'"
            End If
            If TOC <> "" Then
                SQL = SQL & " and A2.TOC='" & TOC & "'"
            End If
            If ID <> "" Then
                SQL = SQL & " and A1.ID='" & ID & "'"
            End If
            If LimitB <> 0 Then
                SQL = SQL & " and A1.Surplus>=" & tovalSF(LimitB)
            End If
            If LimitU <> 0 Then
                SQL = SQL & " and A1.Surplus<=" & tovalSF(LimitU)
            End If
            rs = db.OpenRemoteSet(SQL)
        End If
        Do While Not rs.Eof
            ANO = toval(rs.fields("ANO"))
            PYear = toval(rs.fields("PYear"))
            rsAdm = db.OpenRemoteSet("Select * from AdmLink Where AdmNo=" & rs.fields("AdmNo"))
            If Not rsAdm.Eof Then
                PType = rsAdm.fields("Type")
                PID = rsAdm.fields("ID")
                pCCY = rsAdm.fields("Currency")
                pDate = rsAdm.fields("Date")

                If toval(rsAdm.fields("VoucherF")) = 0 Then
                    rsAdm.Edit()
                    rsAdm.fields("Amount_1") = toval(rsAdm.fields("Amount_1")) + toval(rs.fields("Surplus"))
                    Amount = toval(rsAdm.fields("Amount_1")) + toval(rsAdm.fields("Amount_2")) + toval(rsAdm.fields("Amount_3")) + toval(rsAdm.fields("Amount_4")) + toval(rsAdm.fields("Amount_5")) + toval(rsAdm.fields("Amount_6")) + toval(rsAdm.fields("Amount_18")) + toval(rsAdm.fields("Amount_19")) + toval(rsAdm.fields("Amount_20"))
                    If RoundCCY(Amount, pCCY) = 0 Then
                        'Update Tax Table
                        If toval(rsAdm.fields("TaxTableF")) Then
                            If Not Update_Tax_Table(PID, pDate, pCCY, -(toval(rsAdm.fields("Amount")) - toval(rsAdm.fields("Amount_13")) - toval(rsAdm.fields("Amount_14"))), -toval(rsAdm.fields("Amount_14"))) Then
                                StrMsg = "Failed in Calculating Vat/Tax !"
                                GoTo errmsg
                            End If
                        End If
                        rsAdm.fields("Amount_13") = 0
                        rsAdm.fields("Amount_14") = 0
                        rsAdm.fields("Amount_11") = -(Amount - RoundCCY(Amount, pCCY))
                        Amount = RoundCCY(Amount, pCCY)
                        rsAdm.fields("Amount") = Amount
                    End If
                    If toval(rsAdm.fields("Amount")) = 0 Then
                        rsAdm.fields("WriteF") = 1
                    Else
                        rsAdm.fields("WriteF") = 0
                    End If
                    rsAdm.fields("LUserID") = db_user
                    rsAdm.fields("LDate") = Today.Date
                    rsAdm.fields("LTime") = Time()
                    If Not rsAdm.Update Then GoTo errmsg
                Else
                    StrMsg = "Voucher Already Created !"
                    GoTo errmsg
                End If
            End If
            ' Clean-Up Admlink
            If Not db.Execute("Delete admlink from admlink, AccSurplus Where AccSurplus.AdmNo=Admlink.AdmNo and Admlink.WriteF=1 and AccSurplus.ANO=" & ANO & " and AccSurplus.PYear=" & PYear) Then GoTo errmsg
            If Not db.Execute("Update AccSurplus Set AdmNo=-1, Status='R' Where Status='P' and ANO=" & ANO & " and PYear=" & PYear) Then GoTo errmsg
            If db.RecordsAffected = 0 Then GoTo errmsg
            rsAdm.CloseRemoteSet()
            rs.MoveNext()
        Loop
        rs.CloseRemoteSet()
        UnPosting_SurplusCalculation = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        UnPosting_SurplusCalculation = False
    End Function
    Private Function Posting_InwardTreaty(ByVal ANO As Long, ByVal LANO As Long, ByVal ADate As Date, ByVal BackDatedF As Boolean) As Boolean
        Dim rs As RemoteSet
        On Error GoTo errmsg

        If Not db.Execute("Update Acceptance Set BackDatedF=" & IIf(BackDatedF, 1, 0) & ", AStatus='I', ADate='" & Format(ADate, "MM/DD/YYYY") & "', AUserDate='" & Format(Today.Date, "MM/DD/YYYY") & "', AUserTime='" & Time() & "', AUserID='" & db_user & "' Where AStatus='W' and ANO=" & ANO) Then GoTo errmsg
        If db.RecordsAffected = 0 Then GoTo errmsg

        If Not db.Execute("Update AccAss Set Date='" & Format(ADate, "MM/DD/YYYY") & "' Where ANO=" & ANO) Then GoTo errmsg

        If Not BackDatedF Then
            If Not Production_To_Adm(ANO, LANO) Then GoTo errmsg
            rs = db.OpenRemoteSet("Select distinct Admlink.AdmNo from AccAss, Admlink Where Admlink.AdmNo=AccAss.AdmNo and Admlink.WriteF=0 and AccAss.ANO=" & ANO)
            Do While Not rs.Eof
                If Not Production_To_Adm_Finalize(ANO, LANO, rs.fields("AdmNo")) Then GoTo errmsg
                If Create_Voucher(rs.fields("AdmNo"), True) = "" Then GoTo errmsg
                rs.MoveNext()
            Loop
        End If

        Posting_InwardTreaty = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Posting_InwardTreaty = False
    End Function
    Private Function UnPosting_InwardTreaty(ByVal ANO As Long, ByVal LANO As Long, ByVal ADate As Date, ByVal BackDatedF As Boolean) As Boolean
        Dim rs As RemoteSet
        On Error GoTo errmsg

        rs = db.OpenRemoteSet("Select BackDatedF from Acceptance Where ANO=" & ANO)
        BackDatedF = toval(rs.fields("BackDatedF"))
        If Not BackDatedF Then
            If Not Undo_Production_To_Adm(ANO, True) Then GoTo errmsg
        Else
            If Not db.Execute("Delete from AccAss Where ANO=" & ANO) Then GoTo errmsg
        End If

        If Not db.Execute("Update Acceptance Set BackDatedF=" & IIf(BackDatedF, 1, 0) & ", AStatus='W', ADate='" & Format(ADate, "MM/DD/YYYY") & "' Where AStatus='I' and ANO=" & ANO) Then GoTo errmsg
        If db.RecordsAffected = 0 Then GoTo errmsg

        UnPosting_InwardTreaty = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        UnPosting_InwardTreaty = False
    End Function
    Private Function Premium_Calc_All(ByVal ANO As Long, Optional ByVal ResetF As Boolean = False) As Boolean
        Dim rs As RemoteSet
        On Error GoTo errmsg

        ' Match previous db.begintrans from Calling Function
        db.Committrans()
        If ResetF Then
            rs = db.OpenRemoteSet("Select ANO, PStatus from Acceptance Where AType<>'C' and AStatus='W' and ANO<>LANO and LANO=" & ANO)
        Else
            rs = db.OpenRemoteSet("Select ANO, PStatus from Acceptance Where AType<>'C' and AStatus='W' and pStatus='I' and ANO<>LANO and LANO=" & ANO)
        End If
        Do While Not rs.Eof
            If rs.fields("PStatus") = "I" Or ResetF Then
                db.Begintrans()
                Premium_Calc(rs.fields("ANO"), , ResetF)
                db.Committrans()
            End If
            rs.MoveNext()
        Loop
        db.Begintrans()
        Premium_Calc_All = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Premium_Calc_All = False
    End Function
    Private Function Create_Payment_Schedule(ByVal ANO As Long, ByVal DecreaseF As Boolean, ByVal PremiumDecreaseF As Boolean, ByVal Term As Integer, ByVal IRate As Double, ByRef errmsg As String) As Boolean
        Try
            Dim PayNo As Integer
            Dim PayDate As Date
            Dim LastPayDate As Date

            Dim SI As Double

            Dim rs As RemoteSet

            Dim TotalPremium As Double
            Dim CPRefund As Double
            Dim CPFormula As String
            Dim PPeriod As Integer
            Dim Prorata As Double
            Dim TotalSI As Double

            errmsg = ""
            TotalSI = 0

            rs = db.OpenRemoteSet("Select NumCCY, Gross, Rate, OGross, TSI from fn_PCalc(" & ANO & ")")
            If toval(rs.fields("NumCCY")) = 1 Then
                TotalPremium = toval(rs.fields("Gross")) / toval(rs.fields("Rate"))
            Else
                TotalPremium = toval(rs.fields("Gross"))
            End If

            Dim TSI As Double
            Dim pRate As Double

            ' Annual Rate
            TSI = toval(rs.fields("TSI"))
            pRate = toval(rs.fields("OGross")) / TSI * 100

            Dim Premium As Double
            Dim LastSI As Double
            Dim EXCLUSIVEF As Boolean
            Dim P_STime As String
            Dim P_ETime As String
            Dim ExtRSDate As Date
            Dim ExtREDate As Date
            Dim ExtRPeriod As Integer
            Dim EMethod As String
            Dim SDate As Date
            Dim EDate As Date
            Dim PDate As Date
            Dim ExtPeriod As Integer
            Dim EXTPERIODINDAYSF As Boolean

            rs = db.OpenRemoteSet("Select Top 1 A.SDate, A.EDate, A.PDate, A.STime, A.ETime, A.ExclusiveF, A.ExtPeriod, A.EXTPERIODINDAYSF, A.ExtRPeriod, A.ExtRSDate, A.ExtREDate, A.EMethod, R.CPRefund, R.CPFormula, C.Prorata, C.PPeriod from RCover R, Acceptance A, Cover C Where C.CNO=A.CNO and R.ANO=A.ANO and R.Category='M' and A.ANO=" & ANO)
            SDate = todate(rs.fields("SDate"))
            EDate = todate(rs.fields("EDate"))
            PDate = todate(rs.fields("PDate"))
            ExtPeriod = toval(rs.fields("ExtPeriod"))
            EXTPERIODINDAYSF = toval(rs.fields("EXTPERIODINDAYSF"))
            PPeriod = toval(rs.fields("PPERIOD"))
            Prorata = toval(rs.fields("Prorata"))
            P_STime = tostr(rs.fields("STime"))
            P_ETime = tostr(rs.fields("ETime"))
            EXCLUSIVEF = toval(rs.fields("EXCLUSIVEF"))

            CPRefund = toval(rs.fields("CPRefund"))
            If CPRefund = 0 Then CPRefund = 100
            CPFormula = tostr(rs.fields("CPFormula"))
            ExtRPeriod = toval(rs.fields("ExtRPeriod"))
            ExtRSDate = todate(rs.fields("ExtRSDate"))
            ExtREDate = todate(rs.fields("ExtREDate"))
            EMethod = tostr(rs.fields("EMethod"))

            Dim Tenor1 As Integer
            Dim TenorR As Integer
            Dim Tenor2 As Integer ' Tenor1 + Extended Period
            Dim Tenor As Integer

            If Not EXCLUSIVEF And P_STime < P_ETime Then
                Tenor1 = Premium_Calc_Prorata(SDate, DateAdd(DateInterval.Day, 1, EDate), Prorata, 12, PPeriod, "") * 12 / Term
                Tenor2 = Premium_Calc_Prorata(SDate, DateAdd(DateInterval.Day, 1, IIf(EXTPERIODINDAYSF, DateAdd(DateInterval.Day, ExtPeriod, EDate), DateAdd(DateInterval.Month, ExtPeriod, EDate))), Prorata, 12, PPeriod, "") * 12 / Term
            Else
                Tenor1 = Premium_Calc_Prorata(SDate, EDate, Prorata, 12, PPeriod, "") * 12 / Term
                Tenor2 = Premium_Calc_Prorata(SDate, IIf(EXTPERIODINDAYSF, DateAdd(DateInterval.Day, ExtPeriod, EDate), DateAdd(DateInterval.Month, ExtPeriod, EDate)), Prorata, 12, PPeriod, "") * 12 / Term
            End If

            If EMethod = "S" Then
                If Not EXCLUSIVEF And P_STime < P_ETime Then
                    TenorR = Premium_Calc_Prorata(SDate, DateAdd(DateInterval.Day, 1, PDate), Prorata, 12, PPeriod, "") * 12 / Term
                Else
                    TenorR = Premium_Calc_Prorata(SDate, PDate, Prorata, 12, PPeriod, "") * 12 / Term
                End If
            Else
                TenorR = 0
            End If

            Tenor = Tenor1 - TenorR
            Premium = TotalPremium / Tenor

            If Not db.Execute("Delete from Payor_Schedule where ANO=" & ANO & "") Then Throw New Exception(db.ErrDesc)

            If DecreaseF Then
                Dim rsTerm As RemoteSet
                rsTerm = db.OpenRemoteSet("Select Top 1 A.TOPRO from TOP_RTERM T1, Acceptance A Where A.ANO=" & ANO & " and T1.TOPRO=A.TOPRO")
                If Not rsTerm.Eof Then
                    Dim TOPRO As String
                    TOPRO = rsTerm.fields("TOPRO")
                    rsTerm = db.OpenRemoteSet("Select T1.PTERM, T1.PUnit, T2.* from TOP_RTERM T1, TOP_RTERMDET T2 Where T2.TOPRO=T1.TOPRO and T2.RATE=T1.RATE AND T1.TOPRO='" & TOPRO & "' and T1.Rate='" & tovalSF(IRate) & "' Order by T2.[Month]")
                    If rsTerm.Eof Then
                        errmsg = "No Interest Rate (" & tovalSF(IRate) & ") Defined !"
                        Throw New Exception(errmsg)
                    End If
                    Dim PTerm As Integer
                    Dim PUnit As Integer
                    PTerm = toval(rsTerm.fields("PTerm"))
                    PUnit = toval(rsTerm.fields("PUnit"))
                    LastSI = 0

                    If PTerm = 0 Then 'Annually
                        SI = toval(rsTerm.fields(tostr(Term * Tenor1 / 12))) / PUnit * TSI
                    Else
                        SI = toval(rsTerm.fields(tostr(Term * Tenor1 / PTerm))) / PUnit * TSI
                    End If
                    If SI = 0 Then
                        errmsg = "No Unit Tenor (" & tostr(Tenor1) & ") Defined !"
                        Throw New Exception(errmsg)
                    End If

                    rs = db.OpenRemoteSet("Select * from Payor_Schedule where 1<>1")
                    PayNo = 1
                    Do While PayNo <= (Tenor2 - Tenor1)
                        PayDate = DateAdd(DateInterval.Month, Term * (PayNo - 1), SDate)
                        LastPayDate = DateAdd(DateInterval.Month, Term * (PayNo - 1 + 1), SDate)
                        rs.AddNew()
                        rs.fields("ANO") = ANO
                        rs.fields("InstNo") = PayNo
                        rs.fields("InstDate") = PayDate
                        rs.fields("InstLDate") = LastPayDate
                        rs.fields("InstPCT") = 0
                        rs.fields("InstAmount") = 0
                        rs.fields("InstSI") = SI
                        rs.fields("InstSIPCT") = SI / TSI * 100
                        TotalSI = TotalSI + SI

                        If Not EXCLUSIVEF And P_STime < P_ETime Then
                            Prorata = Calc_Prorata(IIf(LastPayDate < DateAdd(DateInterval.Day, 1, EDate), LastPayDate, DateAdd(DateInterval.Day, 1, EDate)), DateAdd(DateInterval.Day, 1, EDate), SDate, DateAdd(DateInterval.Day, 1, EDate), PPeriod)
                        Else
                            Prorata = Calc_Prorata(IIf(LastPayDate < EDate, LastPayDate, EDate), EDate, SDate, EDate, PPeriod)
                        End If

                        If UCase(CPFormula) = "PRORATE SQ" Then
                            Prorata = CPRefund / 100 * Prorata ^ 2
                        Else
                            Prorata = CPRefund / 100 * Prorata
                        End If
                        rs.fields("CPRefund") = TotalPremium * Prorata
                        If Not rs.UpdateRow Then Throw New Exception(rs.ErrDesc)
                        LastSI = SI
                        PayNo = PayNo + 1
                    Loop

                    Do While Not rsTerm.Eof And toval(rsTerm.fields("Month")) <= Tenor1
                        PayDate = DateAdd(DateInterval.Month, Term * (PayNo - 1), SDate)
                        LastPayDate = DateAdd(DateInterval.Month, Term * (PayNo - 1 + 1), SDate)
                        rs.AddNew()
                        rs.fields("ANO") = ANO
                        rs.fields("InstNo") = PayNo
                        rs.fields("InstDate") = PayDate
                        rs.fields("InstLDate") = LastPayDate
                        rs.fields("InstPCT") = Premium / TotalPremium * 100
                        rs.fields("InstAmount") = Premium
                        If PTerm = 0 Then 'Annually
                            SI = toval(rsTerm.fields(tostr(RoundUp(Term * Tenor1 / 12, 1)))) / PUnit * TSI
                        Else
                            SI = toval(rsTerm.fields(tostr(RoundUp(Term * Tenor1 / PTerm, 1)))) / PUnit * TSI
                        End If
                        If SI = 0 Then SI = LastSI
                        rs.fields("InstSI") = SI
                        rs.fields("InstSIPCT") = SI / TSI * 100
                        TotalSI = TotalSI + SI

                        If Not EXCLUSIVEF And P_STime < P_ETime Then
                            Prorata = Calc_Prorata(IIf(LastPayDate < DateAdd(DateInterval.Day, 1, EDate), LastPayDate, DateAdd(DateInterval.Day, 1, EDate)), DateAdd(DateInterval.Day, 1, EDate), SDate, DateAdd(DateInterval.Day, 1, EDate), PPeriod)
                        Else
                            Prorata = Calc_Prorata(IIf(LastPayDate < EDate, LastPayDate, EDate), EDate, SDate, EDate, PPeriod)
                        End If

                        If UCase(CPFormula) = "PRORATE SQ" Then
                            Prorata = CPRefund / 100 * Prorata ^ 2
                        Else
                            Prorata = CPRefund / 100 * Prorata
                        End If
                        rs.fields("CPRefund") = TotalPremium * Prorata
                        If Not rs.UpdateRow Then Throw New Exception(rs.ErrDesc)
                        LastSI = SI
                        PayNo = PayNo + 1

                        If Not (ExtRPeriod <> 0 And LastPayDate > ExtRSDate And LastPayDate <= ExtREDate) Then
                            rsTerm.MoveNext()
                        End If
                    Loop

                    Do While PayNo <= Tenor2
                        PayDate = DateAdd(DateInterval.Month, Term * (PayNo - 1), SDate)
                        LastPayDate = DateAdd(DateInterval.Month, Term * (PayNo - 1 + 1), SDate)
                        rs.AddNew()
                        rs.fields("ANO") = ANO
                        rs.fields("InstNo") = PayNo
                        rs.fields("InstDate") = PayDate
                        rs.fields("InstLDate") = LastPayDate
                        rs.fields("InstPCT") = 0
                        rs.fields("InstAmount") = 0
                        SI = LastSI
                        rs.fields("InstSI") = SI
                        rs.fields("InstSIPCT") = SI / TSI * 100
                        TotalSI = TotalSI + SI

                        If Not rs.UpdateRow Then Throw New Exception(rs.ErrDesc)
                        PayNo = PayNo + 1
                    Loop
                Else
                    SI = TSI
                    LastSI = 0

                    rs = db.OpenRemoteSet("Select * from Payor_Schedule where 1<>1")

                    PayNo = 1
                    Do While PayNo <= TenorR
                        PayDate = DateAdd(DateInterval.Month, Term * (PayNo - 1), SDate)
                        LastPayDate = DateAdd(DateInterval.Month, Term * (PayNo - 1 + 1), SDate)
                        rs.AddNew()
                        rs.fields("ANO") = ANO
                        rs.fields("InstNo") = PayNo
                        rs.fields("InstDate") = PayDate
                        rs.fields("InstLDate") = LastPayDate
                        rs.fields("InstPCT") = 0
                        rs.fields("InstAmount") = 0
                        rs.fields("InstSI") = SI
                        rs.fields("InstSIPCT") = SI / TSI * 100
                        TotalSI = TotalSI + SI

                        If Not EXCLUSIVEF And P_STime < P_ETime Then
                            Prorata = Calc_Prorata(IIf(LastPayDate < DateAdd(DateInterval.Day, 1, EDate), LastPayDate, DateAdd(DateInterval.Day, 1, EDate)), DateAdd(DateInterval.Day, 1, EDate), SDate, DateAdd(DateInterval.Day, 1, EDate), PPeriod)
                        Else
                            Prorata = Calc_Prorata(IIf(LastPayDate < EDate, LastPayDate, EDate), EDate, SDate, EDate, PPeriod)
                        End If

                        If UCase(CPFormula) = "PRORATE SQ" Then
                            Prorata = CPRefund / 100 * Prorata ^ 2
                        Else
                            Prorata = CPRefund / 100 * Prorata
                        End If
                        rs.fields("CPRefund") = TotalPremium * Prorata
                        If Not rs.UpdateRow Then Throw New Exception(rs.ErrDesc)
                        LastSI = SI
                        PayNo = PayNo + 1
                    Loop

                    Do While PayNo <= Tenor1
                        If PremiumDecreaseF Then
                            If ((PayNo - 1) \ 12) * 12 = (PayNo - 1) Then
                                TotalPremium = SI * pRate / 100
                                If (Tenor1 - (PayNo - 1)) >= 12 Then
                                    Premium = TotalPremium / 12
                                Else
                                    Premium = TotalPremium / (Tenor1 - (PayNo - 1))
                                End If
                            End If
                        End If

                        PayDate = DateAdd(DateInterval.Month, Term * (PayNo - 1), SDate)
                        LastPayDate = DateAdd(DateInterval.Month, Term * (PayNo - 1 + 1), SDate)

                        rs.AddNew()
                        rs.fields("ANO") = ANO
                        rs.fields("InstNo") = PayNo
                        rs.fields("InstDate") = PayDate
                        rs.fields("InstLDate") = LastPayDate
                        rs.fields("InstPCT") = Premium / TotalPremium * 100
                        rs.fields("InstAmount") = Premium
                        rs.fields("InstSI") = SI
                        rs.fields("InstSIPCT") = SI / TSI * 100
                        TotalSI = TotalSI + SI
                        If Not EXCLUSIVEF And P_STime < P_ETime Then
                            Prorata = Calc_Prorata(IIf(LastPayDate < DateAdd(DateInterval.Day, 1, EDate), LastPayDate, DateAdd(DateInterval.Day, 1, EDate)), DateAdd(DateInterval.Day, 1, EDate), SDate, DateAdd(DateInterval.Day, 1, EDate), PPeriod)
                        Else
                            Prorata = Calc_Prorata(IIf(LastPayDate < EDate, LastPayDate, EDate), EDate, SDate, EDate, PPeriod)
                        End If
                        If UCase(CPFormula) = "PRORATE SQ" Then
                            Prorata = CPRefund / 100 * Prorata ^ 2
                        Else
                            Prorata = CPRefund / 100 * Prorata
                        End If
                        rs.fields("CPRefund") = TotalPremium * Prorata
                        If Not rs.UpdateRow Then Throw New Exception(rs.ErrDesc)

                        LastSI = SI
                        SI = SI - (-Pmt(IRate / 100 / 12, Tenor, TSI) - IRate / 100 / 12 * SI)

                        PayNo = PayNo + 1
                    Loop

                    Do While PayNo <= Tenor2
                        PayDate = DateAdd(DateInterval.Month, Term * (PayNo - 1), SDate)
                        LastPayDate = DateAdd(DateInterval.Month, Term * (PayNo - 1 + 1), SDate)
                        rs.AddNew()
                        rs.fields("ANO") = ANO
                        rs.fields("InstNo") = PayNo
                        rs.fields("InstDate") = PayDate
                        rs.fields("InstLDate") = LastPayDate
                        rs.fields("InstPCT") = 0
                        rs.fields("InstAmount") = 0
                        rs.fields("InstSI") = 0
                        rs.fields("InstSIPCT") = 0
                        If Not rs.UpdateRow Then Throw New Exception(rs.ErrDesc)
                        PayNo = PayNo + 1
                    Loop

                End If

            Else
                SI = TSI
                LastSI = 0

                rs = db.OpenRemoteSet("Select * from Payor_Schedule where 1<>1")

                PayNo = 1
                Do While PayNo <= TenorR
                    PayDate = DateAdd(DateInterval.Month, Term * (PayNo - 1), SDate)
                    LastPayDate = DateAdd(DateInterval.Month, Term * (PayNo - 1 + 1), SDate)
                    rs.AddNew()
                    rs.fields("ANO") = ANO
                    rs.fields("InstNo") = PayNo
                    rs.fields("InstDate") = PayDate
                    rs.fields("InstLDate") = LastPayDate
                    rs.fields("InstPCT") = 0
                    rs.fields("InstAmount") = 0
                    rs.fields("InstSI") = SI
                    rs.fields("InstSIPCT") = SI / TSI * 100
                    TotalSI = TotalSI + SI

                    If Not EXCLUSIVEF And P_STime < P_ETime Then
                        Prorata = Calc_Prorata(IIf(LastPayDate < DateAdd(DateInterval.Day, 1, EDate), LastPayDate, DateAdd(DateInterval.Day, 1, EDate)), DateAdd(DateInterval.Day, 1, EDate), SDate, DateAdd(DateInterval.Day, 1, EDate), PPeriod)
                    Else
                        Prorata = Calc_Prorata(IIf(LastPayDate < EDate, LastPayDate, EDate), EDate, SDate, EDate, PPeriod)
                    End If

                    If UCase(CPFormula) = "PRORATE SQ" Then
                        Prorata = CPRefund / 100 * Prorata ^ 2
                    Else
                        Prorata = CPRefund / 100 * Prorata
                    End If
                    rs.fields("CPRefund") = TotalPremium * Prorata
                    If Not rs.UpdateRow Then Throw New Exception(rs.ErrDesc)
                    LastSI = SI
                    PayNo = PayNo + 1
                Loop

                Do While PayNo <= Tenor1
                    PayDate = DateAdd(DateInterval.Month, Term * (PayNo - 1), SDate)
                    LastPayDate = DateAdd(DateInterval.Month, Term * (PayNo - 1 + 1), SDate)

                    rs.AddNew()
                    rs.fields("ANO") = ANO
                    rs.fields("InstNo") = PayNo
                    rs.fields("InstDate") = PayDate
                    rs.fields("InstLDate") = LastPayDate
                    rs.fields("InstPCT") = Premium / TotalPremium * 100
                    rs.fields("InstAmount") = Premium
                    rs.fields("InstSI") = SI
                    rs.fields("InstSIPCT") = SI / TSI * 100
                    TotalSI = TotalSI + SI
                    If Not EXCLUSIVEF And P_STime < P_ETime Then
                        Prorata = Calc_Prorata(IIf(LastPayDate < DateAdd(DateInterval.Day, 1, EDate), LastPayDate, DateAdd(DateInterval.Day, 1, EDate)), DateAdd(DateInterval.Day, 1, EDate), SDate, DateAdd(DateInterval.Day, 1, EDate), PPeriod)
                    Else
                        Prorata = Calc_Prorata(IIf(LastPayDate < EDate, LastPayDate, EDate), EDate, SDate, EDate, PPeriod)
                    End If
                    If UCase(CPFormula) = "PRORATE SQ" Then
                        Prorata = CPRefund / 100 * Prorata ^ 2
                    Else
                        Prorata = CPRefund / 100 * Prorata
                    End If
                    rs.fields("CPRefund") = TotalPremium * Prorata
                    If Not rs.UpdateRow Then Throw New Exception(rs.ErrDesc)
                    LastSI = SI
                    PayNo = PayNo + 1
                Loop
            End If

            rs.MoveFirst()
            If Not rs.Eof Then If Not rs.Update Then Throw New Exception(rs.ErrDesc)

            Dim eFactor As Double
            eFactor = 0
            TotalPremium = 0
            rs.MoveFirst()
            Do While Not rs.Eof
                rs.Edit()
                eFactor = eFactor + toval(rs.fields("InstSI")) / TotalSI
                rs.fields("eFactor") = eFactor

                If PremiumDecreaseF Then
                    TotalPremium = TotalPremium + rs.fields("InstAmount")
                End If

                If Not rs.UpdateRow Then Throw New Exception(rs.ErrDesc)
                rs.MoveNext()
            Loop
            rs.MoveFirst()
            If Not rs.Eof Then If Not rs.Update Then Throw New Exception(rs.ErrDesc)

            If PremiumDecreaseF Then
                If Not db.Execute("Update PCalc Set Gross=" & tovalSF(TotalPremium) & "/Rate, Description='Premium by Decreasing SI' from PCalc Where ANO=" & ANO) Then Throw New Exception(db.ErrDesc)
            End If
            Return True
        Catch ex As Exception
            errmsg = ex.Message
            Return False
        End Try

    End Function
    Private Function CreatePayorSchedule(ByVal ANO As Long, ByVal DecreaseF As Boolean, ByVal PremiumDecreaseF As Boolean, ByVal Term As Integer, ByVal IRate As Double) As Boolean
        Try            
            Dim ErrMsg As String
            If Not Create_Payment_Schedule(ANO, DecreaseF, PremiumDecreaseF, Term, IRate, ErrMsg) Then
                Throw New Exception(ErrMsg)
            End If
            Return True
        Catch ex As Exception
            StrMsg = ex.Message
            Return False
        End Try
    End Function
    Private Function APPLY_BSOPEX(ByVal ANO As Long, ByVal TOC As String, ByVal Source As String) As Boolean
        Try
            Dim rs As RemoteSet
            rs = db.OpenQueryDef("QGet_BSOPEX", adOpenKeyset, ANO, TOC, Source)
            If Not rs.Eof Then
                Dim rsFD As RemoteSet
                rsFD = db.OpenRemoteSet("Select * from ACCFD Where ANO=" & ANO & " and ID='" & Source & "' and FDID='" & rs.fields("FDID") & "'")
                If rsFD.Eof Then
                    rsFD.AddNew()
                    rsFD.fields("ANO") = ANO
                    rsFD.fields("ID") = rs.fields("ID")
                    rsFD.fields("FDID") = rs.fields("FDID")
                    rsFD.fields("REMARK") = rs.fields("REMARK")
                    rsFD.fields("AMOUNT") = rs.fields("AMOUNT")
                    rsFD.fields("Currency") = rs.fields("Currency")
                    rsFD.fields("AmountPCT") = rs.fields("AmountPCT")
                    rsFD.fields("AmountPCTBased") = rs.fields("AmountPCTBased")
                    rsFD.fields("LUserID") = db_user
                    rsFD.fields("LDate") = Today.Date
                    rsFD.fields("AutoGeneratedF") = True
                    If Not rsFD.Update Then Throw New Exception(rs.ErrDesc)
                End If
            End If
            Return True
        Catch ex As Exception
            StrMsg = ex.Message
            Return False
        End Try
    End Function
    Private Function APPLY_AUTOAPPLYFEEDUTY(ByVal ANO As Long) As Boolean
        Try
            Dim rs As RemoteSet
            rs = db.OpenQueryDef("QGet_AutoApplyFeeDuty", adOpenKeyset, ANO)
            If Not rs.Eof Then
                Dim rsFD As RemoteSet
                rsFD = db.OpenRemoteSet("Select * from ACCFD Where ANO=" & ANO & " and exists (Select FDID from FDTAB Where FDTAB.FDID=ACCFD.FDID AND FDTAB.FDTYPE='" & rs.fields("FDTYPE") & "')")
                If rsFD.Eof Then
                    rsFD.AddNew()
                    rsFD.fields("ANO") = ANO
                    rsFD.fields("ID") = "<Payor>"
                    rsFD.fields("FDID") = rs.fields("FDID")
                    rsFD.fields("REMARK") = rs.fields("REMARK")
                    rsFD.fields("Currency") = rs.fields("Currency")
                    rsFD.fields("AMOUNT") = rs.fields("AMOUNT")
                    rsFD.fields("LUserID") = db_user
                    rsFD.fields("LDate") = Today.Date
                    rsFD.fields("AutoGeneratedF") = True
                    If Not rsFD.Update Then Throw New Exception(rs.ErrDesc)
                End If
            End If
            Return True
        Catch ex As Exception
            StrMsg = ex.Message
            Return False
        End Try
    End Function
    Private Function GetReinsuranceRate(ByVal TOC As String, ByVal CCY As String, ByVal SDate As Date, Optional ByVal PHolder As String = "") As Double
        Dim rs As RemoteSet
        Dim CCYTo As String
        Dim BaseCCY As String
        Dim Rate As Double
        Rate = 1
        rs = db.OpenRemoteSet("Select Currency from SysTab", adOpenForwardonly)
        BaseCCY = rs.fields("Currency")
        If CCY.ToUpper <> BaseCCY.ToUpper Then
            CCYTo = CCY
            Do
                CCY = CCYTo
                rs = db.OpenQueryDef("GetReinsuranceRate", adOpenForwardonly, TOC, CCY, SDate, PHolder)
                CCYTo = tostr(rs.fields("CCYTO"))
                Rate = Rate * toval(rs.fields("Rate"))
            Loop While CCYTo.ToUpper <> CCY.ToUpper And CCYTo.ToUpper <> "" And CCYTo.ToUpper <> BaseCCY.ToUpper
        End If
        GetReinsuranceRate = Rate
    End Function
    Private Function Premium_Calc(ByVal ANO As Long, Optional ByVal tPrefix As String = "", Optional ByVal ResetF As Boolean = False, Optional ByRef Gross As Double = 0, Optional ByVal PremiumDescription As String = "", Optional ByVal MinNetPremium As Double = 0, Optional ByVal MinGrossPremium As Double = 0) As Boolean
        Dim rs As RemoteSet
        Dim rsCalc As RemoteSet
        Dim rsICalc As RemoteSet
        Dim rsAcc As RemoteSet
        Dim Premium As Double
        Dim CCode As String
        Dim RCode As String
        Dim Discount As Double
        Dim Loading As Double
        Dim DDiscount As Double
        Dim TPremium As Double
        Dim TDiscount As Double
        Dim TLoading As Double
        Dim TSI As Double
        Dim SI As Double
        Dim Indemnity As Double
        Dim Prorata As Double
        Dim Rate As Double
        Dim NRate As Double
        Dim DRate As Double
        Dim LRate As Double
        Dim PCTLoss As Double
        Dim PADDITION As Double
        Dim PCTADJ As Double
        Dim TOC As String
        Dim TOR As String
        Dim AdjustableF As Boolean
        Dim SDate As Date
        Dim EDate As Date
        Dim AType As String
        Dim SANO As Long
        Dim Branch As String
        Dim BizMapID As String
        Dim portion As Double
        Dim EMethod As String
        Dim Source As String
        Dim nRisk As Integer
        Dim TReinstatement As Double
        Dim Reinstatement As Double
        Dim TemporaryF As Boolean = False
        Dim Ujroh As Double
        Dim WeightedAvgUjrohF As Boolean
        Dim pStatus As String
        Dim CNO As Long
        Dim LANO As Long
        Dim P_SDate As Date
        Dim P_STime As String
        Dim P_EDate As Date
        Dim P_ETime As String
        Dim EXCLUSIVEF As Boolean

        Dim RDate As Date
        Dim PHolder As String
        Dim BusinessResultF As Boolean
        Dim ShariaF As Boolean
        Dim PTerm As Integer

        Dim Share As Double
        Dim Limit As Double
        Dim Excess As Double
        Dim OpenFlag As Boolean
        Dim TOPRO As String

        On Error GoTo errmsg

        If tPrefix <> "" Then
            rsAcc = db.OpenRemoteSet("Select A.AStatus, A.pStatus, A.AType, A.Branch, A.EMethod, A.Source, A.Ujroh, A.WeightedAvgUjrohF, A.CNO, A.LANO, A.SDate, A.EDate, A.STime, A.ETime, A.ExclusiveF, A.TOC, A.SchemeNo, A.BizMapID, A.TOPRO, coalesce(R.RDate, A.SDate) as RDate, A.RegID, A.FLDID, A.ValueID, C.ISType, C.PHolder, C.OpenFlag, I.Share, I.Limit, I.Excess, TOC.IAccReg, TOC.BusinessResultF, TOC.ShariaF, TOC.PTerm from tAcceptance A Inner Join TOC on (TOC.TOC=A.TOC) Inner Join Cover C on (C.CNO=A.CNO) Left Join tRArrHeader R on (R.ANO=A.ANO) Left Join ISource I on (I.CNO=C.CNO) Where A.ANO=" & ANO)
            pStatus = tostr(rsAcc.fields("pStatus"))
            AType = tostr(rsAcc.fields("AType"))
            Branch = tostr(rsAcc.fields("Branch"))
            EMethod = tostr(rsAcc.fields("EMethod"))
            Source = tostr(rsAcc.fields("Source"))
            Ujroh = toval(rsAcc.fields("Ujroh"))
            WeightedAvgUjrohF = toval(rsAcc.fields("WeightedAvgUjrohF"))
            CNO = toval(rsAcc.fields("CNO"))
            LANO = toval(rsAcc.fields("LANO"))
            P_SDate = todate(rsAcc.fields("SDate"))
            P_EDate = todate(rsAcc.fields("EDate"))
            P_STime = tostr(rsAcc.fields("STime"))
            P_ETime = tostr(rsAcc.fields("ETime"))
            EXCLUSIVEF = toval(rsAcc.fields("EXCLUSIVEF"))
            TOC = tostr(rsAcc.fields("TOC"))
            BusinessResultF = toval(rsAcc.fields("BusinessResultF"))
            ShariaF = toval(rsAcc.fields("ShariaF"))
            PTerm = toval(rsAcc.fields("PTerm"))
            If PTerm = 0 Then PTerm = 12
            RDate = todate(rsAcc.fields("RDate"))
            PHolder = tostr(rsAcc.fields("PHolder"))
            OpenFlag = toval(rsAcc.fields("OpenFlag"))
            Share = toval(rsAcc.fields("Share"))
            If Share = 0 Then Share = 100
            Limit = toval(rsAcc.fields("Limit"))
            Excess = toval(rsAcc.fields("Excess"))
            TOPRO = tostr(rsAcc.fields("TOPRO"))

            ' MinNetPremium and MinGrossPremium Passed By Scheme_Verify
            If MinNetPremium = 0 And MinGrossPremium = 0 Then
                Dim SchemeNo As String
                SchemeNo = tostr(rsAcc.fields("SchemeNo"))
                If SchemeNo <> "" Then
                    rs = db.OpenQueryDef("QScheme_Master", adOpenForwardonly, SchemeNo)
                    If Not rs.Eof Then
                        MinNetPremium = toval(rs.fields("MinNetPremium"))
                        MinGrossPremium = toval(rs.fields("MinGrossPremium"))
                    End If
                End If
            End If

            If rsAcc.fields("AStatus") <> "W" Or (pStatus <> "I" And ResetF = False) Then
                Premium_Calc = True
                Exit Function
            End If

            If Not db.Execute("Delete from tRCalc where ANO = " & ANO) Then GoTo errmsg
            If Not db.Execute("Delete from tICalc where ANO = " & ANO) Then GoTo errmsg

            rsCalc = db.OpenRemoteSet("Select * from tRCalc Where 1<>1")
            rsICalc = db.OpenRemoteSet("Select * from tICalc Where 1<>1")
        Else
            rsAcc = db.OpenRemoteSet("Select A.AStatus, A.pStatus, A.AType, A.Branch, A.EMethod, A.Source, A.Ujroh, A.WeightedAvgUjrohF, A.CNO, A.LANO, A.SDate, A.EDate, A.STime, A.ETime, A.ExclusiveF, A.TOC, A.SchemeNo, A.BizMapID, A.TOPRO, coalesce(R.RDate, A.SDate) as RDate, A.RegID, A.FLDID, A.ValueID, C.ISType, C.PHolder, C.OpenFlag, I.Share, I.Limit, I.Excess, TOC.IAccReg, TOC.BusinessResultF, TOC.ShariaF, TOC.PTerm from Acceptance A Inner Join TOC on (TOC.TOC=A.TOC) Inner Join Cover C on (C.CNO=A.CNO) Left Join RArrHeader R on (R.ANO=A.ANO) Left Join ISource I on (I.CNO=C.CNO) Where A.ANO=" & ANO)
            pStatus = tostr(rsAcc.fields("pStatus"))
            AType = tostr(rsAcc.fields("AType"))
            Branch = tostr(rsAcc.fields("Branch"))
            EMethod = tostr(rsAcc.fields("EMethod"))
            Source = tostr(rsAcc.fields("Source"))
            Ujroh = toval(rsAcc.fields("Ujroh"))
            WeightedAvgUjrohF = toval(rsAcc.fields("WeightedAvgUjrohF"))
            CNO = toval(rsAcc.fields("CNO"))
            LANO = toval(rsAcc.fields("LANO"))
            P_SDate = todate(rsAcc.fields("SDate"))
            P_EDate = todate(rsAcc.fields("EDate"))
            P_STime = tostr(rsAcc.fields("STime"))
            P_ETime = tostr(rsAcc.fields("ETime"))
            EXCLUSIVEF = toval(rsAcc.fields("EXCLUSIVEF"))
            TOC = tostr(rsAcc.fields("TOC"))
            BusinessResultF = toval(rsAcc.fields("BusinessResultF"))
            ShariaF = toval(rsAcc.fields("ShariaF"))
            PTerm = toval(rsAcc.fields("PTerm"))
            If PTerm = 0 Then PTerm = 12
            RDate = todate(rsAcc.fields("RDate"))
            PHolder = tostr(rsAcc.fields("PHolder"))
            OpenFlag = toval(rsAcc.fields("OpenFlag"))
            Share = toval(rsAcc.fields("Share"))
            If Share = 0 Then Share = 100
            Limit = toval(rsAcc.fields("Limit"))
            Excess = toval(rsAcc.fields("Excess"))
            TOPRO = tostr(rsAcc.fields("TOPRO"))

            ' MinNetPremium and MinGrossPremium Passed By Scheme_Verify
            If MinNetPremium = 0 And MinGrossPremium = 0 Then
                Dim SchemeNo As String
                SchemeNo = tostr(rsAcc.fields("SchemeNo"))
                If SchemeNo <> "" Then
                    rs = db.OpenQueryDef("QScheme_Master", adOpenForwardonly, SchemeNo)
                    If Not rs.Eof Then
                        MinNetPremium = toval(rs.fields("MinNetPremium"))
                        MinGrossPremium = toval(rs.fields("MinGrossPremium"))
                    End If
                End If
            End If

            If rsAcc.fields("AStatus") <> "W" Or (pStatus <> "I" And ResetF = False) Then
                Premium_Calc = True
                Exit Function
            End If

            If Not PreCalculateConditionsOK(ANO, CNO, tostr(rsAcc.fields("ISType")), toval(rsAcc.fields("IAccReg")), tostr(rsAcc.fields("RegID")), tostr(rsAcc.fields("FLDID")), tostr(rsAcc.fields("ValueID"))) Then
                GoTo errmsg
            End If

            If Not db.Execute("Delete from RCalc where ANO = " & ANO) Then GoTo errmsg
            If Not db.Execute("Delete from ICalc where ANO = " & ANO) Then GoTo errmsg

            rsCalc = db.OpenRemoteSet("Select * from RCalc Where 1<>1")
            rsICalc = db.OpenRemoteSet("Select * from ICalc Where 1<>1")
        End If

        Dim DecreaseF As Boolean = False
        Dim DecreasePremiumF As Boolean = False
        Dim SIScheduleF As Boolean = False
        Dim IRate As Double = 0
        Dim MFactor As Double = 0
        Dim Installment As Integer = 0
        Dim LMFactor As Double = 0
        Dim Term As Integer = 0
        If tPrefix = "" Then
            ' Create Payment Schedule
            If ANO <> LANO Then
                If LANO <> -1 Then
                    rs = db.OpenRemoteSet("Select SIScheduleF, DecreaseF, DecreasePremiumF, IRate, MFactor, Installment, Period from APayor Where ANO=" & ANO)
                Else
                    rs = db.OpenRemoteSet("Select SIScheduleF, DecreaseF, DecreasePremiumF, IRate, MFactor, Installment, Period from Payor Where ANO=" & ANO)
                End If
                SIScheduleF = toval(rs.fields("SIScheduleF"))
                DecreaseF = toval(rs.fields("DecreaseF"))
                DecreasePremiumF = toval(rs.fields("DecreasePremiumF"))
                IRate = toval(rs.fields("IRate"))
                MFactor = toval(rs.fields("MFactor"))
                Installment = toval(rs.fields("Installment"))
                Term = toval(rs.fields("Period"))
            End If
        End If

        ' Installment Loading (Modal Factor)
        If MFactor <> 0 Then
            LMFactor = MFactor * Installment / 100
            If LMFactor = 1 Then LMFactor = 0
        Else
            LMFactor = 0
        End If

        If tPrefix <> "" Then
            If AType <> "A" Then
                rs = db.OpenQueryDef("PCALC01_TEMP", adOpenForwardonly, ANO)
            Else
                rs = db.OpenQueryDef("PCALC01_ADJ_TEMP", adOpenForwardonly, ANO)
            End If
        Else
            If AType <> "A" Then
                rs = db.OpenQueryDef("PCALC01", adOpenForwardonly, ANO)
            Else
                rs = db.OpenQueryDef("PCALC01_ADJ", adOpenForwardonly, ANO)
            End If
        End If

        AdjustableF = False
        Source = Get_BusinessSource(ANO)
        BizMapID = Get_BizMap(ANO, Source)
        If BizMapID = "" Then BizMapID = tostr(rsAcc.fields("BizMapID"))
        PState = 1

        ' Premium Calculation Wording
        Dim sRate As String
        Dim sProrata As String
        Dim SType As String

        Dim DiscPCT As Double

        Do While Not rs.Eof
            CCode = rs.fields("Currency")
            RCode = rs.fields("Code")
            TOR = tostr(rs.fields("TOR"))
            SDate = todate(rs.fields("SDate"))
            EDate = todate(rs.fields("EDate"))

            SANO = toval(rs.fields("SANO"))
            portion = toval(rs.fields("Portion"))
            SType = tostr(rs.fields("SType"))
            DDiscount = toval(rs.fields("DDiscount"))

            DiscPCT = toval(rs.fields("Discount"))
            Rate = toval(rs.fields("Rate"))
            Loading = toval(rs.fields("Loading"))


            Select Case UCase(tostr(rs.fields("Unit")))
                Case "C"
                    NRate = Rate / 100 * (100 - DiscPCT) / 100 * Loading
                    DRate = Rate / 100 * (DiscPCT) / 100
                    LRate = Rate / 100 * (100 - DiscPCT) / 100 * (Loading - 1)
                    sRate = Format(NRate, "##0.000000%")
                Case "M"
                    NRate = Rate / 1000 * (100 - DiscPCT) / 100 * Loading
                    DRate = Rate / 1000 * (DiscPCT) / 100
                    LRate = Rate / 1000 * (100 - DiscPCT) / 100 * (Loading - 1)
                    sRate = Format(NRate, "##0.000000%")
                Case "F"
                    NRate = Rate * (100 - DiscPCT) / 100 * Loading
                    DRate = Rate * (DiscPCT) / 100
                    LRate = Rate * (100 - DiscPCT) / 100 * (Loading - 1)
                    sRate = "Flat"
            End Select

            TPremium = 0
            TDiscount = 0
            TLoading = 0
            TReinstatement = 0
            TSI = 0
            nRisk = 0

            ' Loop to Get Number Of Risk
            Dim Bookmark As Integer
            Bookmark = rs.Bookmark
            Do While Not rs.Eof And CCode = tostr(rs.fields("Currency")) And RCode = tostr(rs.fields("Code")) And TOR = tostr(rs.fields("TOR")) And SDate = todate(rs.fields("SDate")) And SANO = toval(rs.fields("SANO"))
                nRisk = nRisk + 1
                rs.MoveNext()
            Loop
            rs.Bookmark = Bookmark

            Do While Not rs.Eof And CCode = tostr(rs.fields("Currency")) And RCode = tostr(rs.fields("Code")) And TOR = tostr(rs.fields("TOR")) And SDate = todate(rs.fields("SDate")) And SANO = toval(rs.fields("SANO"))
                ' From Risk Cover
                If UCase(tostr(rs.fields("PCalc"))) = "P" And toval(rs.fields("Voyage")) = 0 And tostr(rs.fields("AdjMethod")) <> "OVERLIMIT" Then

                    If AType <> "A" Then
                        If Not EXCLUSIVEF AndAlso P_STime < P_ETime AndAlso EDate = P_EDate Then
                            Prorata = Premium_Calc_Prorata(SDate, DateAdd(DateInterval.Day, 1, EDate), toval(rs.fields("Prorata")), PTerm, toval(rs.fields("PPeriod")), sProrata)
                        Else
                            Prorata = Premium_Calc_Prorata(SDate, EDate, toval(rs.fields("Prorata")), PTerm, toval(rs.fields("PPeriod")), sProrata)
                        End If
                    Else
                        Prorata = 1
                        sProrata = ""
                    End If

                    If toval(rs.fields("PProrata")) <> 0 Then
                        If sProrata <> "" Then
                            Prorata = Prorata * toval(rs.fields("PProrata")) / 100
                            sProrata = sProrata & " x " & Format(toval(rs.fields("PProrata")) / 100, "##0.00%")
                        Else
                            Prorata = toval(rs.fields("PProrata")) / 100
                            sProrata = Format(Prorata, "##0.00%")
                        End If
                    End If
                ElseIf UCase(tostr(rs.fields("PCalc"))) = "S" And toval(rs.fields("Voyage")) = 0 And toval(rs.fields("PProrata")) = 0 Then
                    Prorata = Short_Period_Calc(TOC, SDate, EDate, EDate) / 100
                    sProrata = Format(Prorata, "##0.00%")
                ElseIf toval(rs.fields("PProrata")) <> 0 Then
                    Prorata = toval(rs.fields("PProrata")) / 100
                    sProrata = Format(Prorata, "##0.00%")
                Else
                    Prorata = 1
                    sProrata = ""
                End If

                PCTLoss = toval(rs.fields("PctLoss")) + toval(rs.fields("PAddition"))
                If PCTLoss = 0 Then PCTLoss = 100

                If toval(rs.fields("Adjustable")) = True And AType <> "A" Then
                    AdjustableF = True
                    PCTADJ = IIf(toval(rs.fields("PCTAdj")) = 0, 100, toval(rs.fields("PCTAdj")))
                Else
                    PCTADJ = 100
                End If

                SI = toval(rs.fields("SI")) * PCTLoss / 100

                If UCase(tostr(rs.fields("Unit"))) = "F" Then
                    Premium = NRate * Prorata * IIf(LMFactor <> 0, LMFactor, 1)
                    Discount = DRate * Prorata * IIf(LMFactor <> 0, LMFactor, 1)
                    Loading = LRate * Prorata * IIf(LMFactor <> 0, LMFactor, 1)
                Else
                    Premium = SI * NRate * Prorata * IIf(LMFactor <> 0, LMFactor, 1) * PCTADJ / 100
                    Discount = SI * DRate * Prorata * IIf(LMFactor <> 0, LMFactor, 1) * PCTADJ / 100
                    Loading = SI * LRate * Prorata * IIf(LMFactor <> 0, LMFactor, 1) * PCTADJ / 100
                End If

                If EMethod = "R" And SI <> 0 Then
                    Indemnity = toval(rs.fields("Indemnity"))   ' Claim Indemnity Reinstated
                    Reinstatement = Premium * Indemnity / SI
                Else
                    Indemnity = 0
                    Reinstatement = 0
                End If

                rsICalc.AddNew()
                rsICalc.fields("ANO") = ANO
                rsICalc.fields("Currency") = CCode
                rsICalc.fields("INO") = toval(rs.fields("INO"))
                rsICalc.fields("Code") = RCode
                rsICalc.fields("TOR") = TOR
                rsICalc.fields("TSI") = SI

                If sRate = "Flat" Then
                    rsICalc.fields("Rate") = NRate / nRisk
                    rsICalc.fields("Gross") = Premium / nRisk
                    rsICalc.fields("Discount") = Discount / nRisk
                    rsICalc.fields("Loading") = Loading / nRisk
                    rsICalc.fields("Reinstatement") = Reinstatement / nRisk
                Else
                    rsICalc.fields("Rate") = NRate
                    rsICalc.fields("Gross") = Premium
                    rsICalc.fields("Discount") = Discount
                    rsICalc.fields("Loading") = Loading
                    rsICalc.fields("Reinstatement") = Reinstatement
                End If

                rsICalc.fields("SRate") = sRate
                rsICalc.fields("Prorata") = Prorata
                rsICalc.fields("SProrata") = sProrata
                rsICalc.fields("PctLoss") = IIf(toval(rs.fields("PctLoss")) = 0, 100, toval(rs.fields("PctLoss")))
                rsICalc.fields("PctAdj") = PCTADJ
                rsICalc.fields("Indemnity") = Indemnity

                rsICalc.fields("SDate") = SDate
                rsICalc.fields("EDate") = EDate
                rsICalc.fields("SANO") = SANO
                rsICalc.fields("LMFactor") = LMFactor
                If Not rsICalc.UpdateRow Then GoTo errmsg

                TSI = TSI + SI
                If sRate = "Flat" Then
                    TPremium = TPremium + Premium / nRisk
                    TDiscount = TDiscount + Discount / nRisk
                    TLoading = TLoading + Loading / nRisk
                    TReinstatement = TReinstatement + Reinstatement / nRisk
                Else
                    TPremium = TPremium + Premium
                    TDiscount = TDiscount + Discount
                    TLoading = TLoading + Loading
                    TReinstatement = TReinstatement + Reinstatement
                End If
                rs.MoveNext()
            Loop

            ' Check for Minimum Premium (Rate Table)
            Dim mPremium As Double = 0
            If MinGrossPremium = 0 And TPremium <> 0 Then
                mPremium = Get_minimum_Premium_By_Rate_Code(LANO, RCode, Branch, TOC, CCode, SType, Source, SDate, Prorata, portion)
            End If
            rsCalc.AddNew()
            rsCalc.fields("ANO") = ANO
            rsCalc.fields("Currency") = CCode
            rsCalc.fields("Code") = RCode
            rsCalc.fields("TOR") = TOR
            rsCalc.fields("TSI") = TSI
            rsCalc.fields("Gross") = IIf(mPremium <> 0 And mPremium > TPremium, mPremium, TPremium)
            rsCalc.fields("OGross") = TPremium
            rsCalc.fields("Reinstatement") = TReinstatement
            rsCalc.fields("Discount") = TDiscount
            rsCalc.fields("Loading") = TLoading
            rsCalc.fields("DDiscount") = DDiscount * Prorata
            rsCalc.fields("SDate") = SDate
            rsCalc.fields("EDate") = EDate
            rsCalc.fields("Prorata") = Prorata
            rsCalc.fields("SANO") = SANO
            If Not rsCalc.UpdateRow Then GoTo errmsg
        Loop

        ' Finally
        If Not rsICalc.Eof Then
            If Not rsICalc.Update Then GoTo errmsg
        End If

        ' Finally
        If Not rsCalc.Eof Then
            If Not rsCalc.Update Then GoTo errmsg
        End If
        rsICalc.CloseRemoteSet()
        rsCalc.CloseRemoteSet()
        rs.CloseRemoteSet()

        ' Original Gross Premium
        Dim OPremium As Double

        If tPrefix <> "" Then
            ' Create Temporary Premium Calc
            If Not ResetF Then
                If Not db.Execute("Select * into #tPCalc from tPCalc Where Description not in ('Minimum Premium','Policy Minimum Premium','Deductible DIscount') and ANO=" & ANO) Then GoTo errmsg
                TemporaryF = True
            End If

            If Not db.Execute("Delete from tPCalc where ANO = " & ANO) Then GoTo errmsg
            rsCalc = db.OpenRemoteSet("Select * from tPCalc Where 1<>1")

            If AType <> "A" Then
                rs = db.OpenQueryDef("PCALC02_TEMP", adOpenForwardonly, ANO)
            Else
                rs = db.OpenQueryDef("PCALC02_ADJ_TEMP", adOpenForwardonly, ANO)
            End If
        Else
            ' Create Temporary Premium Calc
            If Not ResetF Then
                If Not db.Execute("Select * into #PCalc from PCalc Where Description not in ('Minimum Premium','Policy Minimum Premium','Deductible DIscount') and ANO=" & ANO) Then GoTo errmsg
                TemporaryF = True
            End If

            If Not db.Execute("Delete from PCalc where ANO = " & ANO) Then GoTo errmsg
            rsCalc = db.OpenRemoteSet("Select * from PCalc Where 1<>1")

            If AType <> "A" Then
                rs = db.OpenQueryDef("PCALC02", adOpenForwardonly, ANO)
            Else
                rs = db.OpenQueryDef("PCALC02_ADJ", adOpenForwardonly, ANO)
            End If
        End If
        TPremium = 0
        Do While Not rs.Eof
            CCode = tostr(rs.fields("Currency"))
            Rate = GetReinsuranceRate(TOC, CCode, RDate, PHolder)
            If Rate = 0 Then
                StrMsg = "No Reinsurance Rate for Currency : '" & rs.fields("Currency") & "' !"
                GoTo errmsg
            End If

            rsCalc.AddNew()
            rsCalc.fields("ANO") = ANO
            rsCalc.fields("Currency") = CCode
            rsCalc.fields("Amount") = toval(rs.fields("Amount"))
            rsCalc.fields("TSI") = toval(rs.fields("TSI"))
            If Limit <> 0 Then
                rsCalc.fields("OurShare") = toval(rs.fields("TSI")) * Limit / (Limit + Excess) * Share / 100
            Else
                rsCalc.fields("OurShare") = toval(rs.fields("TSI")) * Share / 100
            End If

            If tPrefix <> "" Then
                rsICalc = db.OpenQueryDef("PCALC02A_TEMP", adOpenForwardonly, ANO, CCode)
            Else
                rsICalc = db.OpenQueryDef("PCALC02A", adOpenForwardonly, ANO, CCode)
            End If
            Premium = toval(rsICalc.fields("Premium"))
            OPremium = toval(rsICalc.fields("OPremium"))
            Discount = toval(rsICalc.fields("Discount"))
            Loading = toval(rsICalc.fields("loading"))
            DDiscount = toval(rsICalc.fields("DDiscount"))
            rsCalc.fields("OGross") = OPremium
            If Gross <> 0 Then
                Premium = Gross
                rsCalc.fields("Gross") = Premium
                If PremiumDescription = "" Or UCase(PremiumDescription) = "MINIMUM PREMIUM" Or UCase(PremiumDescription) = "POLICY MINIMUM PREMIUM" Then
                    PremiumDescription = "-"
                End If
                rsCalc.fields("Description") = PremiumDescription
            Else
                Premium = Get_minimum_Premium(TOC, TOPRO, Branch, BizMapID, CCode, Premium, MinGrossPremium)
                rsCalc.fields("Gross") = Premium
                If OPremium <> Premium Then
                    If Premium = rsICalc.fields("Premium") Then
                        rsCalc.fields("Description") = "Minimum Premium"
                    Else
                        rsCalc.fields("Description") = "Policy Minimum Premium"
                    End If
                Else
                    rsCalc.fields("Description") = ""
                End If
            End If
            rsCalc.fields("Discount") = Discount
            rsCalc.fields("Loading") = Loading
            rsCalc.fields("DDiscount") = DDiscount
            If rsCalc.fields("Description") = "" And DDiscount <> 0 Then
                rsCalc.fields("Gross") = rsCalc.fields("Gross") - DDiscount
                rsCalc.fields("Description") = "Deductible DIscount"
            End If
            rsCalc.fields("Rate") = Rate
            If toval(rs.fields("TSI")) <> 0 Then
                rsCalc.fields("CRate") = toval(rsCalc.fields("Gross")) / toval(rs.fields("TSI")) * 100
            Else
                rsCalc.fields("CRate") = 0
            End If
            TPremium = TPremium + Premium * Rate
            rsCalc.fields("LMFactor") = LMFactor
            If Not rsCalc.UpdateRow Then GoTo errmsg
            rs.MoveNext()
        Loop
        ' Finally
        If Not rsCalc.Eof Then
            If Not rsCalc.Update Then GoTo errmsg
        End If
        rs.CloseRemoteSet()

        If Not ResetF Then
            If tPrefix <> "" Then
                If Not db.Execute("Update P1 Set P1.Gross=P2.Gross, P1.Description=P2.Description from tPCalc P1, #tPCalc P2 Where P2.ANO=P1.ANO and P2.Currency=P1.Currency and P2.OGross=P1.OGross and P2.TSI=P1.TSI and P2.Description<>'' and P1.ANO=" & ANO) Then GoTo errmsg
                If TemporaryF Then
                    If Not db.Execute("Drop Table #tPCalc") Then GoTo errmsg
                    TemporaryF = False
                End If
            Else
                If Not db.Execute("Update P1 Set P1.Gross=P2.Gross, P1.Description=P2.Description from PCalc P1, #PCalc P2 Where P2.ANO=P1.ANO and P2.Currency=P1.Currency and P2.OGross=P1.OGross and P2.TSI=P1.TSI and P2.Description<>'' and P1.ANO=" & ANO) Then GoTo errmsg
                If TemporaryF Then
                    If Not db.Execute("Drop Table #PCalc") Then GoTo errmsg
                    TemporaryF = False
                End If
            End If
        End If

        ' Added for Passing Min Net Premium (if Only Single Currency)
        If rsCalc.RecordCount = 1 Then
            If tPrefix = "" And MinNetPremium <> 0 Then
                rs = db.OpenRemoteSet("Select Premium, Commission, Discount, VAT from Premium_Calculation(" & ANO & ")")
                If (rs.fields("Premium") - rs.fields("Commission") - rs.fields("Discount") - rs.fields("VAT")) < MinNetPremium Then
                    Premium = MinNetPremium / (1 - (rs.fields("Commission") + rs.fields("Discount") + rs.fields("VAT")) / rs.fields("Premium"))
                    If rsCalc.Eof Then GoTo errmsg
                    rsCalc.Edit()
                    rsCalc.fields("Gross") = Premium
                    rsCalc.fields("Description") = "Minimum Premium"
                    If Not rsCalc.Update Then GoTo errmsg
                End If
            End If
            Gross = rsCalc.fields("Gross")
        End If

        If tPrefix = "" Then
            ' Automatically to Reinsurance
            If AType <> "A" And AType <> "C" Then
                If Not Reinsurance_Cession(ANO) Then GoTo errmsg
                If Not Check_RateCon(ANO) Then GoTo errmsg
            End If

            If ANO = LANO Or LANO = -1 Then
                If Not SetDefaultPayor(ANO) Then
                    StrMsg = "Error Setting Default Payor !"
                    GoTo errmsg
                End If
            End If

            If BusinessResultF Then
                If Not BusinessResult_Calculation(ANO) Then GoTo errmsg
            End If
            If ShariaF AndAlso WeightedAvgUjrohF Then
                Ujroh = GetWeightedAverageUjroh(ANO, TOC)
            End If
        End If

        If tPrefix <> "" Then
            If Not db.Execute("Update A Set pStatus='C', AdjustableF=" & IIf(AdjustableF And AType <> "A", "1", "0") & ", Source='" & Source & "', BizMapID='" & BizMapID & "', Ujroh=" & tovalSF(Ujroh) & ", LDate='" & Format(Today.Date, "MM/DD/YYYY") & "', LTime='" & Time() & "' from tAcceptance A Where A.ANO=" & ANO) Then GoTo errmsg
        Else
            If Not db.Execute("Update A Set pStatus='C', AdjustableF=" & IIf(AdjustableF And AType <> "A", "1", "0") & ", Source='" & Source & "', BizMapID='" & BizMapID & "', Ujroh=" & tovalSF(Ujroh) & ", LDate='" & Format(Today.Date, "MM/DD/YYYY") & "', LTime='" & Time() & "' from Acceptance A Where A.ANO=" & ANO) Then GoTo errmsg
        End If

        If tPrefix = "" Then
            ' Create Payment Schedule
            If ANO <> LANO Then
                If SIScheduleF Then
                    If Not CreatePayorSchedule(ANO, DecreaseF, DecreasePremiumF, Term, IRate) Then
                        StrMsg = "Can't Create Payor Schedule !" & StrMsg
                        GoTo errmsg
                    End If
                End If
            End If

            ' Applying OPEX
            If AType <> "A" Then
                If Not APPLY_BSOPEX(ANO, TOC, Source) Then
                    StrMsg = "Can't Create Business Source OPEX !" & StrMsg
                    GoTo errmsg
                End If
            End If

            ' Applying Auto Fee Duty for New Policy Individual and Single Currency
            If AType = "N" And (LANO = -1 Or (LANO <> -1 And LANO <> ANO And OpenFlag = True)) And rsCalc.RecordCount = 1 Then
                If Not APPLY_AUTOAPPLYFEEDUTY(ANO) Then
                    StrMsg = "Can't Create Fee and Duty !" & StrMsg
                    GoTo errmsg
                End If
            End If
        End If

        Premium_Calc = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        If TemporaryF Then
            If tPrefix <> "" Then
                db.Execute("Drop Table #tPCalc")
            Else
                db.Execute("Drop Table #PCalc")
            End If
        End If
        Premium_Calc = False
    End Function
    Private Function Search_FLDMAP_In_ObjInfo(ByVal ANO As Long, ByVal TOC As String, ByVal ParamArray FLDMAP() As String) As Object
        Dim i As Integer
        Dim j As Integer
        Dim rsTOC As RemoteSet
        Dim rsInfo As RemoteSet
        Dim FLDID As String

        Dim NItem As Integer = FLDMAP.GetUpperBound(0) + 1
        Dim NFound As Integer = 0
        Dim Value(NItem - 1) As Object

        rsTOC = db.OpenQueryDef("QTOC_GENHTAB", adOpenForwardonly, TOC)
        rsInfo = db.OpenRemoteSet("Select * from AInfo where ANO=" & ANO)
        For i = 1 To 15
            FLDID = rsTOC.fields("FLDID" & i)
            If FLDID <> "" Then
                For j = 0 To NItem - 1
                    If UCase(rsTOC.fields("FLDMAP" & i)) = UCase(FLDMAP(j)) AndAlso tostr(Value(j)) = "" Then
                        Value(j) = rsInfo.fields("VALUEID" & i)
                        If tostr(Value(j)) = "" Then
                            Value(j) = rsInfo.fields("VALUEDESC" & i)
                        End If
                        NFound = NFound + 1
                    End If
                Next
                If NFound = NItem Then Exit For
            Else
                Exit For
            End If
        Next

        If NFound <> NItem Then
            rsTOC = db.OpenQueryDef("QTOC_EXT_GENHTAB", adOpenForwardonly, TOC)
            rsInfo = db.OpenRemoteSet("Select * from AInfo_Ext where ANO=" & ANO)
            For i = 16 To 31
                FLDID = rsTOC.fields("FLDID" & i)
                If FLDID <> "" Then
                    For j = 0 To NItem - 1
                        If UCase(rsTOC.fields("FLDMAP" & i)) = UCase(FLDMAP(j)) AndAlso tostr(Value(j)) = "" Then
                            Value(j) = rsInfo.fields("VALUEID" & i)
                            If tostr(Value(j)) = "" Then
                                Value(j) = rsInfo.fields("VALUEDESC" & i)
                            End If
                            NFound = NFound + 1
                        End If
                    Next
                    If NFound = NItem Then Exit For
                Else
                    Exit For
                End If
            Next
        End If

        Search_FLDMAP_In_ObjInfo = Value
    End Function
    Private Function Check_RateCon(ByVal ANO As Long) As Boolean
        Try
            Dim HoldF As Boolean = False
            Dim HoldMessage As String = ""
            Dim CID As String = ""

            Dim rs As RemoteSet
            Dim SQL As String
            SQL = "Select A.TOC, R1.Code, R1.SDate, Max(A.SDate) as Inception, Max(AINFODET.TERMOFPMT) as TERMOFPMT, Max(TERMOFPMTTYPE.TERMOFPMTTYPE) as TERMOFPMTTYPE, Max(TERMOFPMTTYPE.DOCLEVEL) as TERMOFPMTTYPEDOCLEVEL, Max(AINFODET.TERMOFPMT_EXT) as TERMOFPMT_EXT, Max(TERMOFPMTTYPE_EXT.TERMOFPMTTYPE) as TERMOFPMTTYPE_EXT, Max(TERMOFPMTTYPE_EXT.DOCLEVEL) as TERMOFPMTTYPEDOCLEVEL_EXT, Max(A.OANO) as OANO, Max(R1.TSI*CASE WHEN R2.PCTLOSS=0 THEN 100 ELSE R2.PCTLOSS END/(CASE WHEN R2.PCTLOSS+R2.PAddition=0 THEN 100 ELSE R2.PCTLOSS+R2.PAddition END)*P.Rate) as TSI"
            SQL = SQL & " from Acceptance A"
            SQL = SQL & " Inner Join PCalc P on (P.ANO=A.ANO)"
            SQL = SQL & " Inner Join RCalc R1 on (R1.ANO=P.ANO and R1.Currency=P.Currency)"
            SQL = SQL & " Inner Join RCover R2 on (R2.ANO=R1.ANO and R2.Code=R1.Code and R2.SDate=R1.SDate and R2.Category='M')"
            SQL = SQL & " Left Join AInfoDet on (AInfoDet.ANO=A.LANO and AInfoDet.FLDID=A.FLDID and AInfoDet.ValueID=A.ValueID and AInfoDet.Status='A')"
            SQL = SQL & " LEFT JOIN TERMOFPMTTYPE ON (TERMOFPMTTYPE.TERMOFPMTTYPE=AINFODET.TERMOFPMTTYPE)"
            SQL = SQL & " LEFT JOIN TERMOFPMTTYPE TERMOFPMTTYPE_EXT ON (TERMOFPMTTYPE_EXT.TERMOFPMTTYPE=AINFODET.TERMOFPMTTYPE_EXT)"
            SQL = SQL & " Where A.ANO=" & ANO
            SQL = SQL & " Group By A.TOC, R1.Code, R1.SDate"
            rs = db.OpenRemoteSet(SQL)
            If Not rs.Eof Then
                Dim TOC As String = rs.fields("TOC")
                Dim OANO As Long = rs.fields("OANO")
                Dim ValueParam As Object
                Dim MultiplySalary As Double
                Dim Salary As Double
                Dim AggregateLimit As Double
                Dim AggregateTSI As Double

                Dim TermOfPayment As Integer
                Dim TermOfPaymentType As Integer


                ValueParam = Search_FLDMAP_In_ObjInfo(ANO, TOC, "MultiplySalary", "Salary", "ContractDate", "TermOfPayment", "TermOfPaymentType")
                MultiplySalary = toval(ValueParam(0))
                Salary = toval(ValueParam(1))
                AggregateLimit = MultiplySalary * Salary

                Get_RateLoading(ANO, rs.fields("Code"), todate(rs.fields("SDate")), toval(rs.fields("TSI")), HoldF, HoldMessage, CID, AggregateTSI)

                If AggregateLimit <> 0 AndAlso AggregateTSI > AggregateLimit Then
                    HoldF = True
                    HoldMessage = HoldMessage & "Exceeding Aggregate Limit for (Salary x Multiply Salary) !" & vbCrLf
                End If

                If tostr(ValueParam(2)) <> "" And IsDate(ValueParam(2)) Then
                    Dim ContractDate = todate(ValueParam(2))
                    If DateDiff(DateInterval.Day, rs.fields("Inception"), ContractDate) > 0 Then
                        HoldF = True
                        HoldMessage = HoldMessage & "The Inception Date must not precede The Contract Date !" & vbCrLf
                    End If
                End If

                TermOfPayment = toval(ValueParam(3))
                TermOfPaymentType = toval(ValueParam(4))

                Dim TERMOFPMT As Integer
                Dim TERMOFPMTTYPEDOCLEVEL As Integer
                Dim TERMOFPMTTYPE As String

                Dim TERMOFPMT_EXT As Integer
                Dim TERMOFPMTTYPEDOCLEVEL_EXT As Integer
                Dim TERMOFPMTTYPE_EXT As String

                If tostr(rs.fields("TERMOFPMTTYPE")) <> "" Then
                    TERMOFPMT = toval(rs.fields("TERMOFPMT"))
                    TERMOFPMTTYPEDOCLEVEL = toval(rs.fields("TERMOFPMTTYPEDOCLEVEL"))
                    TERMOFPMTTYPE = tostr(rs.fields("TERMOFPMTTYPE"))

                    TERMOFPMT_EXT = toval(rs.fields("TERMOFPMT_EXT"))
                    TERMOFPMTTYPEDOCLEVEL_EXT = toval(rs.fields("TERMOFPMTTYPEDOCLEVEL_EXT"))
                    TERMOFPMTTYPE_EXT = tostr(rs.fields("TERMOFPMTTYPE_EXT"))
                Else
                    TERMOFPMT = toval(rs.fields("TERMOFPMT_EXT"))
                    TERMOFPMTTYPEDOCLEVEL = toval(rs.fields("TERMOFPMTTYPEDOCLEVEL_EXT"))
                    TERMOFPMTTYPE = tostr(rs.fields("TERMOFPMTTYPE_EXT"))

                    TERMOFPMT_EXT = 0
                    TERMOFPMTTYPEDOCLEVEL_EXT = 0
                    TERMOFPMTTYPE_EXT = ""
                End If

                If TERMOFPMTTYPE_EXT = "" Then
                    If TERMOFPMT <> 0 AndAlso TERMOFPMT < TermOfPayment Then
                        HoldF = True
                        HoldMessage = HoldMessage & "The Term of Payment Can't be Greater Than " & TERMOFPMT & " days !" & vbCrLf
                    End If

                    If TERMOFPMTTYPEDOCLEVEL <> 0 AndAlso TERMOFPMTTYPEDOCLEVEL > TermOfPaymentType Then
                        HoldF = True
                        HoldMessage = HoldMessage & "The Term of Payment Type is " & TERMOFPMTTYPE & " !" & vbCrLf
                    End If
                Else
                    If TERMOFPMTTYPEDOCLEVEL = TermOfPaymentType Then
                        If TERMOFPMT <> 0 AndAlso TERMOFPMT < TermOfPayment Then
                            HoldF = True
                            HoldMessage = HoldMessage & "The Term of Payment Can't be Greater Than " & TERMOFPMT & " days !" & vbCrLf
                        End If
                    ElseIf TERMOFPMTTYPEDOCLEVEL_EXT = TermOfPaymentType Then
                        If TERMOFPMT_EXT <> 0 AndAlso TERMOFPMT_EXT < TermOfPayment Then
                            HoldF = True
                            HoldMessage = HoldMessage & "The Term of Payment Can't be Greater Than " & TERMOFPMT_EXT & " days !" & vbCrLf
                        End If
                    Else
                        HoldF = True
                        HoldMessage = HoldMessage & "The Term of Payment Type is either " & TERMOFPMTTYPE & " or " & TERMOFPMTTYPE_EXT & " !" & vbCrLf
                    End If
                End If

                If HoldF Then
                    rs = db.OpenRemoteSet("Select * from RArrHeader Where ANO=" & ANO)
                    rs.Edit()
                    rs.fields("HoldF") = HoldF
                    If rs.fields("Message") = "" Then
                        rs.fields("Message") = HoldMessage
                    Else
                        rs.fields("Message") = rs.fields("Message") & vbCrLf & HoldMessage
                    End If
                    If Not rs.Update Then Throw New Exception("Update Hold Message Error !")
                End If

                If CID <> "" Then
                    Dim aCID() As String = CID.Split("|")
                    Dim sCID As String = ""
                    For Each CID In aCID
                        If CID <> "" Then
                            If sCID = "" Then
                                sCID = "'" & CID & "'"
                            Else
                                sCID = sCID & "," & "'" & CID & "'"
                            End If
                        End If
                    Next
                    If sCID <> "" Then
                        If Not db.Execute("Delete from AccCompSheetH Where ANO=" & OANO & " and Status='R' and CID not in (" & sCID & ")") Then Throw New Exception(rs.ErrDesc)
                    End If
                    For Each CID In aCID

                        If CID <> "" Then
                            Dim PassGrade As Integer
                            Dim IPassGradeF As Boolean
                            rs = db.OpenRemoteSet("Select IPassGradeF, PassGrade from Compliance C Where C.CID='" & CID & "'")
                            IPassGradeF = toval(rs.fields("IPassGradeF"))
                            If IPassGradeF Then
                                PassGrade = toval(rs.fields("PassGrade"))
                            Else
                                PassGrade = toval(rs.fields("PassGrade"))
                            End If

                            rs = db.OpenRemoteSet("Select * from AccCompSheetH Where ANO=" & OANO & " and CID='" & CID & "'")
                            If rs.Eof Then
                                rs.AddNew()
                                rs.fields("ANO") = OANO
                                rs.fields("CID") = CID
                                rs.fields("Status") = "R"
                                rs.fields("CDate") = Today.Date
                                rs.fields("UserID") = db_user
                                rs.fields("LDate") = Today.Date
                                rs.fields("LUserID") = db_user
                                rs.fields("PassGrade") = PassGrade
                                If Not rs.Update Then Throw New Exception(rs.ErrDesc)

                                If Not db.Execute("Delete from AccCompSheetD Where ANO=" & OANO & " and CID='" & CID & "'") Then Throw New Exception(rs.ErrDesc)

                                SQL = "Insert into AccCompSheetD(ANO, CID, RiskNo, RiskDesc, SID, SIDDESC)"
                                SQL = SQL & " Select " & OANO & " as ANO, C1.CID, C1.RiskNo, C1.Description as RiskDesc, S.SID, S.Description as SIDDesc"
                                SQL = SQL & " from ComplianceR C1, ComplianceS C2, Scoring S"
                                SQL = SQL & " Where C2.OptionalF=0 and C1.CID='" & CID & "' and C1.CID=C2.CID and C1.RiskNo=C2.RiskNo and S.SID=C2.SID"

                                If Not db.Execute(SQL) Then Throw New Exception(rs.ErrDesc)

                            End If

                        End If
                    Next
                Else
                    If Not db.Execute("Delete from AccCompSheetH Where ANO=" & OANO & " and Status='R'") Then Throw New Exception(rs.ErrDesc)
                End If
            End If

            Return True
        Catch ex As Exception
            StrMsg = ex.Message
            Return False
        End Try

    End Function
    Private Function SetDefaultPayor(ByVal ANO As Long) As Boolean
        Dim rs As RemoteSet
        On Error GoTo errmsg
        rs = db.OpenRemoteSet("Select D.DefaultPayor, C.PHolder, A.Source, A.AID from Cover C, Acceptance A, DefaultPayor D, Payor P Where D.PolicyType=C.PolicyType and D.Segment=C.Segment and C.CNO=A.CNO and C.ISType='I' and P.ANO=A.ANO and P.DefaultPayorF=1 and A.ANO=" & ANO & "")
        If Not rs.Eof Then
            If UCase(rs.fields("DefaultPayor")) = "PHOLDER" Then
                If Not Create_Payor(ANO, rs.fields("PHolder"), , True) Then GoTo errmsg
            ElseIf UCase(rs.fields("DefaultPayor")) = "INSURED" Then
                If Not Create_Payor(ANO, rs.fields("AID"), , True) Then GoTo errmsg
            Else
                If Not Create_Payor(ANO, rs.fields("Source"), , True) Then GoTo errmsg
            End If
        End If
        SetDefaultPayor = True
        Exit Function
errmsg:
        SetDefaultPayor = False
    End Function
    Private Function Create_Payor(ByVal ANO As Long, ByVal ID As String, Optional ByVal WPC As Integer = 0, Optional ByVal OverWriteF As Boolean = True) As Boolean
        Dim rs As RemoteSet
        Dim rsProfile As RemoteSet

        On Error GoTo ErrMsg
        rsProfile = db.OpenQueryDef("QProfile", adOpenForwardonly, ID)
        If rsProfile.Eof Then GoTo ErrMsg

        rs = db.OpenQueryDef("QPayor", adOpenKeyset, ANO)
        If Not rs.Eof Then
            rs.Edit()
        Else
            rs.AddNew()
            rs.fields("ANO") = ANO
            ' Only Apply for new payor
            rs.fields("Discount") = toval(rsProfile.fields("Disc"))
            rs.fields("WPC") = IIf(WPC = 0, toval(rsProfile.fields("WPC")), WPC)
            rs.fields("Grace") = toval(rsProfile.fields("Grace"))
            rs.fields("DefaultPayorF") = True
        End If
        If rs.editmode = AdEditAdd Or OverWriteF Then
            rs.fields("ID") = tostr(rsProfile.fields("ID"))
            rs.fields("Address_1") = tostr(rsProfile.fields("Address_1"))
            rs.fields("Address_2") = tostr(rsProfile.fields("Address_2"))
            rs.fields("Address_3") = tostr(rsProfile.fields("Address_3"))
        End If
        If Not rs.Update Then GoTo ErrMsg

        Create_Payor = True
        Exit Function
ErrMsg:
        StrMsg = StrError(StrMsg)
        Create_Payor = False
    End Function
    Private Function GetWeightedAverageUjroh(ByVal ANO As Long, ByVal TOC As String) As Double
        Dim rsRA As RemoteSet
        Dim rs As RemoteSet
        Dim UjrohCedant As Double
        Dim ORShare As Double

        rsRA = db.OpenQueryDef("QRArrHeader", adOpenForwardonly, ANO)
        ORShare = 100
        UjrohCedant = 0

        ' Compulsory 
        If tostr(rsRA.fields("CID")) <> "" Then
            rs = db.OpenRemoteSet("Select R1.UjrohCedant from Reinsurance R1 Where R1.RID='" & tostr(rsRA.fields("CID")) & "'")
            If toval(rs.fields("UjrohCedant")) <> 0 Then
                UjrohCedant = UjrohCedant + rsRA.fields("CShare") / 100 * rs.fields("UjrohCedant")
                ORShare = ORShare - rsRA.fields("CShare")
            End If
        End If

        ' Decree
        If tostr(rsRA.fields("DID")) <> "" Then
            rs = db.OpenRemoteSet("Select R1.UjrohCedant from Reinsurance R1 Where R1.RID='" & tostr(rsRA.fields("DID")) & "'")
            If toval(rs.fields("UjrohCedant")) <> 0 Then
                UjrohCedant = UjrohCedant + rsRA.fields("DShare") / 100 * rs.fields("UjrohCedant")
                ORShare = ORShare - rsRA.fields("DShare")
            End If
        End If

        ' Mai-Park
        If tostr(rsRA.fields("XPID")) <> "" Then
            rs = db.OpenRemoteSet("Select R1.UjrohCedant from Reinsurance R1 Where R1.RID='" & tostr(rsRA.fields("XPID")) & "'")
            If toval(rs.fields("UjrohCedant")) <> 0 Then
                UjrohCedant = UjrohCedant + rsRA.fields("XPShare") / 100 * rs.fields("UjrohCedant")
                ORShare = ORShare - rsRA.fields("XPShare")
            End If
        End If

        ' Quota Share
        If tostr(rsRA.fields("QID")) <> "" Then
            rs = db.OpenRemoteSet("Select R1.UjrohCedant from Reinsurance R1 Where R1.RID='" & tostr(rsRA.fields("QID")) & "'")
            If toval(rs.fields("UjrohCedant")) <> 0 Then
                UjrohCedant = UjrohCedant + rsRA.fields("QShare") / 100 * rs.fields("UjrohCedant")
                ORShare = ORShare - rsRA.fields("QShare")
            End If
        End If

        ' Surplus #1
        If tostr(rsRA.fields("SP1ID")) <> "" Then
            rs = db.OpenRemoteSet("Select R1.UjrohCedant from Reinsurance R1 Where R1.RID='" & tostr(rsRA.fields("SP1ID")) & "'")
            If toval(rs.fields("UjrohCedant")) <> 0 Then
                UjrohCedant = UjrohCedant + rsRA.fields("SP1Share") / 100 * rs.fields("UjrohCedant")
                ORShare = ORShare - rsRA.fields("SP1Share")
            End If
        End If

        ' Surplus #2
        If tostr(rsRA.fields("SP2ID")) <> "" Then
            rs = db.OpenRemoteSet("Select R1.UjrohCedant from Reinsurance R1 Where R1.RID='" & tostr(rsRA.fields("SP2ID")) & "'")
            If toval(rs.fields("UjrohCedant")) <> 0 Then
                UjrohCedant = UjrohCedant + rsRA.fields("SP2Share") / 100 * rs.fields("UjrohCedant")
                ORShare = ORShare - rsRA.fields("SP2Share")
            End If
        End If

        ' Surplus #3
        If tostr(rsRA.fields("SP3ID")) <> "" Then
            rs = db.OpenRemoteSet("Select R1.UjrohCedant from Reinsurance R1 Where R1.RID='" & tostr(rsRA.fields("SP3ID")) & "'")
            If toval(rs.fields("UjrohCedant")) <> 0 Then
                UjrohCedant = UjrohCedant + rsRA.fields("SP3Share") / 100 * rs.fields("UjrohCedant")
                ORShare = ORShare - rsRA.fields("SP3Share")
            End If
        End If

        ' Auto Facultative
        If tostr(rsRA.fields("AID")) <> "" Then
            rs = db.OpenRemoteSet("Select R1.UjrohCedant from Reinsurance R1 Where R1.RID='" & tostr(rsRA.fields("AID")) & "'")
            If toval(rs.fields("UjrohCedant")) <> 0 Then
                UjrohCedant = UjrohCedant + rsRA.fields("AShare") / 100 * rs.fields("UjrohCedant")
                ORShare = ORShare - rsRA.fields("AShare")
            End If
        End If

        If tostr(rsRA.fields("FShare")) <> "" Then
            rs = db.OpenRemoteSet("Select R.Share*F.Share/100 as Share, R.UjrohCedant, F.Comm from RArrDet R, FPart F Where F.ANO=R.ANO and F.FID=R.FID and R.Status<>'O' and R.ANO=" & ANO)
            Do While Not rs.Eof
                If toval(rs.fields("UjrohCedant")) + toval(rs.fields("Comm")) <> 0 Then
                    UjrohCedant = UjrohCedant + rs.fields("Share") / 100 * (rs.fields("UjrohCedant") + rs.fields("Comm"))
                    ORShare = ORShare - rs.fields("Share")
                End If
                rs.MoveNext()
            Loop
        End If
        rs = db.OpenRemoteSet("Select coalesce(I.UjrohCedant, Case When coalesce(mA.Ujroh,0)<>0 Then coalesce(mA.Ujroh,0) Else TOC.Ujroh End) as UjrohCedant from Acceptance A Left Join Acceptance mA on (mA.ANO=A.LANO) Inner Join Cover C on (C.CNO=A.CNO) Left Join ISource I on (I.CNO=C.CNO) Inner join TOC on (TOC.TOC=A.TOC) Where A.ANO=" & ANO)
        UjrohCedant = UjrohCedant + ORShare / 100 * rs.fields("UjrohCedant")

        GetWeightedAverageUjroh = UjrohCedant
    End Function

    Private Function Reinsurance_Cession(ByVal ANO As Long, Optional ByVal RLimit As Double = 0, Optional ByVal CLimit As Double = 0, Optional ByVal ReAllocF As Boolean = False, Optional ByVal ATSI As Double = 0, Optional ByVal ShortFallF As Boolean = False) As Boolean
        Try
            Dim rs As RemoteSet
            Dim rsR As RemoteSet
            Dim OurShare As Double
            Dim TSI As Double
            Dim Gross As Double
            Dim PctShare As Double
            Dim PCTLOSS As Double
            Dim RDate As Date
            Dim MShare As Double
            Dim MAmount As Double
            Dim FAmount As Double
            Dim PreCedeFAmount As Double
            Dim TLimit As Double
            Dim CRLimit As Double
            Dim CCLimit As Double
            Dim Saldo As Double
            Dim Share As Double
            Dim AType As String
            Dim RANO As Long
            Dim ISType As String
            Dim Holdf As Boolean
            Dim ManualF As Boolean
            Dim Message As String
            Dim TOC As String
            Dim REGID As String
            Dim FLDID As String
            Dim VALUEID As String
            Dim RYear As Integer = 0
            Dim RShare As Double
            Dim CANO As Long
            Dim ConjunctionF As Boolean
            Dim ReLimitRTypeF As Boolean
            Dim ProformaF As Boolean
            Dim CStatus As String
            Dim PLimit As Double
            Dim RPLimit As Double = 0

            Dim R_PDate As Date
            Dim R_PPDate As Date
            Dim CleanCutF As Boolean = False
            Dim AssessmentExInwardF As Boolean
            Dim NoRiskAccumulationF As Boolean
            Dim RiskAccumulationByTreatyYearF As Boolean

            rs = db.OpenRemoteSet("Select RiskAccumulationByTreatyYearF from SysTab")
            RiskAccumulationByTreatyYearF = toval(rs.fields("RiskAccumulationByTreatyYearF"))

            rs = db.OpenRemoteSet("Select A.CANO, A.ConjunctionF, A.AType, A.REGID, A.FLDID, A.VALUEID, A.NoRiskAccumulationF, R.ManualF, R.RDate, R.Status, A.RANO, C.ISType, A.TOC, C.ProformaF, C.CStatus, P.RYear, P.AMOUNT/P.NUMRISK as TSI, P.Gross/P.NUMRISK as Gross, P.PCTShare from Acceptance A, RArrheader R, Cover C, FN_PCalc(" & ANO & ") P where P.ANO=A.ANO and C.CNO=A.CNO and A.ANO=R.ANO and A.ANO=" & ANO, adOpenForwardonly)
            RDate = rs.fields("RDate")
            AType = rs.fields("AType")
            RANO = rs.fields("RANO")
            ISType = rs.fields("ISType")
            Holdf = False
            Message = ""
            ManualF = toval(rs.fields("ManualF"))
            REGID = tostr(rs.fields("REGID"))
            FLDID = tostr(rs.fields("FLDID"))
            VALUEID = tostr(rs.fields("VALUEID"))
            TOC = tostr(rs.fields("TOC"))
            CANO = toval(rs.fields("CANO"))
            ConjunctionF = toval(rs.fields("ConjunctionF"))
            ProformaF = toval(rs.fields("ProformaF"))
            CStatus = tostr(rs.fields("CStatus"))
            TSI = toval(rs.fields("TSI"))
            Gross = toval(rs.fields("Gross"))
            PctShare = toval(rs.fields("PctShare"))
            NoRiskAccumulationF = toval(rs.fields("NoRiskAccumulationF"))
            If RiskAccumulationByTreatyYearF Then
                RYear = toval(rs.fields("RYear"))
            End If

            ' Get Limit Of Liability and PML
            Dim Amount As Double
            Dim PML As Double
            If Get_Reinsurance_Limit_Of_Liability(ANO, RDate, Amount, PML, PCTLOSS) Then
                If Amount <> 0 Then
                    TSI = Amount
                End If
            End If
            If PML <> 0 Then
                TSI = TSI * PML / 100
            End If

            OurShare = TSI * PctShare / 100

            If ISType = "L" Then
                MShare = GetPctMShare(ANO)
                MAmount = OurShare * MShare / 100
            Else
                MShare = 0
                MAmount = 0
            End If

            TSI = TSI * PctShare / 100 * (100 - MShare) / 100

            ' ATSI Passing by Treaty_Adjustment Function
            If ATSI <> 0 Then TSI = ATSI

            Dim FShare As Double
            Dim PrecedeFShare As Double

            GetFacCessionShare(ANO, FShare, PrecedeFShare)
            FAmount = OurShare * FShare / 100
            PreCedeFAmount = OurShare * PrecedeFShare / 100
            Saldo = OurShare - MAmount

            If Not ManualF AndAlso MShare <> 100 Then
                ' Get Reinsurance Limit By Reinsurance Type
                rs = db.OpenRemoteSet("Select ReLimitRTypeF from TOC Where TOC='" & TOC & "'")
                ReLimitRTypeF = toval(rs.fields("ReLimitRTypeF"))

                If ConjunctionF Then
                    Dim rsC As RemoteSet
                    rsC = db.OpenQueryDef("QRarrHeader", adOpenForwardonly, CANO)
                    ' Cession Limit
                    CCLimit = toval(rsC.fields("CLimit"))
                    ' Risk Limit
                    CRLimit = toval(rsC.fields("Limit"))
                    Holdf = toval(rsC.fields("HoldF"))
                    Message = tostr(rsC.fields("Message"))
                End If

                ' Hold if PML not 100%
                If PML <> 100 Then
                    Holdf = True
                    If Message <> "" Then Message = Message & Chr(13) & Chr(10)
                    Message = Message & "PML : " & tostr(PML) & "%"
                End If

                Treaty_Excluded_Clauses(ANO, Holdf, Message)

                ' Risk Limit
                If RLimit = 0 Then
                    ' Table Of Limit from Conjunction Policy
                    If ConjunctionF And (CRLimit <> 0) Then
                        RLimit = CRLimit
                    Else
                        RLimit = RiskAssLimit(ANO, "", Holdf, Message, RShare, RPLimit)
                    End If
                End If

                ' Cession Limit
                If CLimit = 0 Then
                    ' Table Of Limit from Conjunction Policy
                    If ConjunctionF And (CCLimit <> 0) Then
                        CLimit = CCLimit
                    Else
                        CLimit = CessionLimit(ANO, Holdf, Message, PctShare - MShare, TSI / (PctShare / 100 * (100 - MShare) / 100)) / 100
                    End If
                End If

                ' Treaty Limit
                TLimit = RLimit * CLimit
            End If

            Dim PrevPCTShare As Double
            Dim PrevMShare As Double
            Dim PrevPCTLOSS As Double
            Dim SPRAmount As Double = 0
            rs = db.OpenQueryDef("QRArrHeader", adOpenKeyset, ANO)
            If Not rs.Eof Then
                If ManualF Then
                    CLimit = rs.fields("CLimit")
                    RLimit = rs.fields("Limit")
                    TLimit = RLimit * CLimit
                End If
                PrevPCTShare = toval(rs.fields("PCTShare"))
                If PrevPCTShare = 0 Then PrevPCTShare = 100
                PrevMShare = toval(rs.fields("MShare"))
                PrevPCTLOSS = toval(rs.fields("PCTLOSS"))
                If PrevPCTLOSS = 0 Then PrevPCTLOSS = 100
                'Unbooked first
                If rs.fields("Status") = "A" Then
                    If Not UnReleaseAccRegAmount(ANO, True) Then Throw New Exception("Reinsurance Cession - Release/UnRelease Accumulation Register !")
                    ' Re-Open Data
                    rs = db.OpenQueryDef("QRArrHeader", adOpenKeyset, ANO)
                End If
                RDate = rs.fields("RDate")

                Saldo = Saldo - PreCedeFAmount

                rs.Edit()

                ' Get the Compulsory
                rsR = db.OpenQueryDef("QReinsurance_Cession", adOpenForwardonly, ANO, RDate, "C", TSI, tostr(rs.fields("CID")), 0, Gross)
                If Not rsR.Eof Then
                    If Not ManualF AndAlso MShare <> 100 Then
                        PLimit = IIf(toval(rsR.fields("AssessmentF")), RPLimit, 1)
                        If ISType <> "R" And ISType <> "T" Then
                            ' Direct Business
                            rs.fields("CID") = tostr(rsR.fields("RID"))
                            TLimit = 1
                        Else
                            ' In-Direct Business
                            rs.fields("CID") = ""
                            TLimit = 0
                        End If

                        If ProformaF OrElse NoRiskAccumulationF Then
                            Share = rsR.fields("Limit") * TLimit
                        Else
                            Share = rsR.fields("Limit") * TLimit - Get_Accumulation(REGID, FLDID, VALUEID, "C", RYear) + PrevAccRegAmount(ANO, "C") / (PrevPCTShare / 100 * PrevPCTLOSS / 100 * (100 - PrevMShare) / 100)
                        End If
                        Share = IIf(Share < 0, 0, Share)

                        ' Policy Cession Limit Applicable
                        If PLimit <> 0 Then
                            If toval(rsR.fields("PLimit")) <> 0 Then
                                If Share > PLimit * toval(rsR.fields("PLimit")) Then
                                    Share = PLimit * toval(rsR.fields("PLimit"))
                                End If
                            End If
                        End If

                        'If Share > Saldo * toval(rsr.Fields("Share")) / 100 Then
                        '    Share = Saldo * toval(rsr.Fields("Share")) / 100
                        'End If

                        ' New Code for BPPDAN Cession
                        '
                        '
                        If Share > OurShare / (PctShare / 100 * PCTLOSS / 100) * toval(rsR.fields("Share")) / 100 Then
                            Share = OurShare / (PctShare / 100 * PCTLOSS / 100) * toval(rsR.fields("Share")) / 100
                        End If
                        Share = Share * (PctShare / 100 * PCTLOSS / 100 * (100 - MShare) / 100)
                        '
                        '
                        ' End New Code for BPPDAN Cession

                        If Share > Saldo Then Share = Saldo
                    Else
                        rs.fields("CID") = tostr(rsR.fields("RID"))
                        Share = rs.fields("CAmount")
                        If Share > Saldo Then Share = Saldo
                    End If
                    rs.fields("CShare") = Share / OurShare * 100
                    rs.fields("CAmount") = Share

                    Saldo = Saldo - Share
                Else
                    rs.fields("CID") = ""
                    rs.fields("CShare") = 0
                    rs.fields("CAmount") = 0
                End If

                ' Get the Excess Priority (Set to PRGBI)
                rsR = db.OpenQueryDef("QReinsurance_Cession", adOpenForwardonly, ANO, RDate, "XP", TSI, tostr(rs.fields("XPID")), 0, Gross)
                If Not rsR.Eof Then
                    AssessmentExInwardF = toval(rsR.fields("AssessmentExInwardF"))
                    If Not ManualF AndAlso MShare <> 100 Then
                        PLimit = IIf(toval(rsR.fields("AssessmentF")), RPLimit, 1)
                        If ISType <> "R" And ISType <> "T" Then
                            ' Direct Business
                            rs.fields("XPID") = tostr(rsR.fields("RID"))
                            ' Always Risk Limit by Reinsurance Type
                            TLimit = IIf(toval(rsR.fields("CessionF")), CLimit, 1)
                            If Saldo <> 0 Then
                                If toval(rsR.fields("AssessmentF")) And (InStr("RT", ISType) = 0 Or Not AssessmentExInwardF) Then
                                    TLimit = TLimit * RiskAssLimit(ANO, "XP", Holdf, Message, RShare, PLimit)
                                End If
                            Else
                                If toval(rsR.fields("AssessmentF")) And (InStr("RT", ISType) = 0 Or Not AssessmentExInwardF) Then
                                    TLimit = TLimit * RLimit
                                End If
                            End If
                            ' Overwrite MaiPark no Table of limit
                            TLimit = 1
                        Else
                            ' In-Direct Business
                            rs.fields("XPID") = ""
                            TLimit = 0
                        End If

                        If ProformaF OrElse NoRiskAccumulationF Then
                            Share = rsR.fields("Limit") * TLimit
                        Else
                            Share = rsR.fields("Limit") * TLimit - Get_Accumulation(REGID, FLDID, VALUEID, "XP", RYear) + PrevAccRegAmount(ANO, "XP") / (PrevPCTShare / 100 * PrevPCTLOSS / 100 * (100 - PrevMShare) / 100)
                        End If
                        Share = IIf(Share < 0, 0, Share)

                        ' Policy Cession Limit Applicable
                        If PLimit <> 0 Then
                            If toval(rsR.fields("PLimit")) <> 0 Then
                                If Share > PLimit * toval(rsR.fields("PLimit")) Then
                                    Share = PLimit * toval(rsR.fields("PLimit"))
                                End If
                            End If
                        End If

                        If RShare <> 0 Then
                            If Share > OurShare / (PctShare / 100 * PCTLOSS / 100) * RShare / 100 Then
                                Share = OurShare / (PctShare / 100 * PCTLOSS / 100) * RShare / 100
                            End If
                        Else
                            If Share > OurShare / (PctShare / 100 * PCTLOSS / 100) * toval(rsR.fields("Share")) / 100 Then
                                Share = OurShare / (PctShare / 100 * PCTLOSS / 100) * toval(rsR.fields("Share")) / 100
                            End If
                        End If

                        Share = Share * (PctShare / 100 * PCTLOSS / 100 * (100 - MShare) / 100)

                        If Share > Saldo Then Share = Saldo
                    Else
                        rs.fields("XPID") = tostr(rsR.fields("RID"))
                        Share = rs.fields("XPAmount")
                        If Share > Saldo Then Share = Saldo
                    End If
                    rs.fields("XPShare") = Share / OurShare * 100
                    rs.fields("XPAmount") = Share

                    Saldo = Saldo - Share
                Else
                    rs.fields("XPID") = ""
                    rs.fields("XPShare") = 0
                    rs.fields("XPAmount") = 0
                End If

                ' Get the Decree/Consortium
                rsR = db.OpenQueryDef("QReinsurance_Cession", adOpenForwardonly, ANO, RDate, "D", TSI, tostr(rs.fields("DID")), 0, Gross)
                If Not rsR.Eof Then
                    AssessmentExInwardF = toval(rsR.fields("AssessmentExInwardF"))
                    If Not ManualF AndAlso MShare <> 100 Then
                        PLimit = IIf(toval(rsR.fields("AssessmentF")), RPLimit, 1)
                        'If (ISType <> "R" And ISType <> "T") Or Not toval(rsR.fields("DirectF")) Then
                        '    ' Direct Business
                        '    rs.fields("DID") = tostr(rsR.fields("RID"))
                        '    TLimit = IIf(toval(rsR.fields("CessionF")), CLimit, 1) * IIf(toval(rsR.fields("AssessmentF")), RLimit, 1)
                        'Else
                        '    ' In-Direct Business
                        '    rs.fields("DID") = ""
                        '    TLimit = 0
                        'End If

                        'If ProformaF OrElse NoRiskAccumulationF Then
                        '    Share = rsR.fields("Limit") * TLimit
                        'Else
                        '    Share = rsR.fields("Limit") * TLimit - Get_Accumulation(REGID, FLDID, VALUEID, "D",RYear) + PrevAccRegAmount(ANO, "D")
                        'End If
                        'Share = IIf(Share < 0, 0, Share)

                        'If IIf(toval(rsR.fields("PShare")) = 0, 100, toval(rsR.fields("PShare"))) / 100 * Saldo < Share Then
                        '    Share = IIf(toval(rsR.fields("PShare")) = 0, 100, toval(rsR.fields("PShare"))) / 100 * Saldo
                        'End If

                        'If Share > Saldo * toval(rsR.fields("Share")) / 100 Then
                        '    Share = Saldo * toval(rsR.fields("Share")) / 100
                        'End If

                        ' New Code for DC Cession
                        '
                        '
                        If (ISType <> "R" And ISType <> "T") Or Not toval(rsR.fields("DirectF")) Then
                            ' Direct Business
                            rs.fields("DID") = tostr(rsR.fields("RID"))

                            ' Always Risk Limit by Reinsurance Type
                            TLimit = IIf(toval(rsR.fields("CessionF")), CLimit, 1)
                            If Saldo <> 0 Then
                                If toval(rsR.fields("AssessmentF")) And (InStr("RT", ISType) = 0 Or Not AssessmentExInwardF) Then
                                    TLimit = TLimit * RiskAssLimit(ANO, "D", Holdf, Message, RShare, PLimit)
                                End If
                            Else
                                If toval(rsR.fields("AssessmentF")) And (InStr("RT", ISType) = 0 Or Not AssessmentExInwardF) Then
                                    TLimit = TLimit * RLimit
                                End If
                            End If
                        Else
                            ' In-Direct Business
                            rs.fields("DID") = ""
                            TLimit = 0
                        End If

                        If ProformaF OrElse NoRiskAccumulationF Then
                            Share = rsR.fields("Limit") * TLimit
                        Else
                            Share = rsR.fields("Limit") * TLimit - Get_Accumulation(REGID, FLDID, VALUEID, "D", RYear) + PrevAccRegAmount(ANO, "D") / (PrevPCTShare / 100 * PrevPCTLOSS / 100 * (100 - PrevMShare) / 100)
                        End If
                        Share = IIf(Share < 0, 0, Share)

                        ' Policy Cession Limit Applicable
                        If PLimit <> 0 Then
                            If toval(rsR.fields("PLimit")) <> 0 Then
                                If Share > PLimit * toval(rsR.fields("PLimit")) Then
                                    Share = PLimit * toval(rsR.fields("PLimit"))
                                End If
                            End If
                        End If

                        If Share > OurShare / (PctShare / 100 * PCTLOSS / 100) * toval(rsR.fields("Share")) / 100 Then
                            Share = OurShare / (PctShare / 100 * PCTLOSS / 100) * toval(rsR.fields("Share")) / 100
                        End If
                        Share = Share * (PctShare / 100 * PCTLOSS / 100 * (100 - MShare) / 100)
                        '
                        '
                        ' End New Code for DC Cession

                        If Share > Saldo Then Share = Saldo
                    Else
                        rs.fields("DID") = tostr(rsR.fields("RID"))
                        Share = rs.fields("DAmount")
                        If Share > Saldo Then Share = Saldo
                    End If
                    rs.fields("DShare") = Share / OurShare * 100
                    rs.fields("DAmount") = Share
                    Saldo = Saldo - Share
                Else
                    rs.fields("DID") = ""
                    rs.fields("DShare") = 0
                    rs.fields("DAmount") = 0
                End If

                ' Get the QuotaShare
                Dim ORLimit As Double = 0
                Dim ShortFallLimit As Double = 0
                rsR = db.OpenQueryDef("QReinsurance_Cession", adOpenForwardonly, ANO, RDate, "Q", TSI, tostr(rs.fields("QID")), 0, Gross)
                If Not rsR.Eof Then
                    ORLimit = rsR.fields("Limit")
                    ShortFallLimit = rsR.fields("ShortFallLimit")
                    AssessmentExInwardF = toval(rsR.fields("AssessmentExInwardF"))

                    ' Clean Cut
                    R_PDate = todate(rsR.fields("SDate"))
                    R_PPDate = DateAdd(DateInterval.Day, 1, todate(rsR.fields("EDate")))
                    CleanCutF = toval(rsR.fields("CleanCutF"))

                    If Not ManualF AndAlso MShare <> 100 Then
                        PLimit = IIf(toval(rsR.fields("AssessmentF")), RPLimit, 1)
                        If (ISType <> "R" And ISType <> "T") Or Not toval(rsR.fields("DirectF")) Then
                            ' Direct Business
                            rs.fields("QID") = tostr(rsR.fields("RID"))

                            ' Risk Limit by Reinsurance Type
                            TLimit = IIf(toval(rsR.fields("CessionF")), CLimit, 1)
                            If Not ConjunctionF And ReLimitRTypeF And Saldo <> 0 Then
                                If toval(rsR.fields("AssessmentF")) And (InStr("RT", ISType) = 0 Or Not AssessmentExInwardF) Then
                                    TLimit = TLimit * RiskAssLimit(ANO, "Q", Holdf, Message, RShare, PLimit)
                                End If
                            Else
                                If toval(rsR.fields("AssessmentF")) And (InStr("RT", ISType) = 0 Or Not AssessmentExInwardF) Then
                                    TLimit = TLimit * RLimit
                                End If
                            End If

                        Else
                            ' In-Direct Business
                            rs.fields("QID") = ""
                            TLimit = 0
                        End If

                        If ProformaF OrElse NoRiskAccumulationF Then
                            Share = rsR.fields("Limit") * TLimit
                        Else
                            Share = rsR.fields("Limit") * TLimit - Get_Accumulation(REGID, FLDID, VALUEID, "Q", RYear) + PrevAccRegAmount(ANO, "Q")
                        End If

                        Share = IIf(Share < 0, 0, Share)

                        ' Policy Cession Limit Applicable
                        If PLimit <> 0 Then
                            If toval(rsR.fields("PLimit")) <> 0 Then
                                If Share > PLimit * toval(rsR.fields("PLimit")) Then
                                    Share = PLimit * toval(rsR.fields("PLimit"))
                                End If
                            End If
                        End If

                        If IIf(toval(rsR.fields("PShare")) = 0, 100, toval(rsR.fields("PShare"))) / 100 * (OurShare - rs.fields("CAmount") - rs.fields("XPAmount") - rs.fields("DAmount")) < Share Then
                            Share = IIf(toval(rsR.fields("PShare")) = 0, 100, toval(rsR.fields("PShare"))) / 100 * (OurShare - rs.fields("CAmount") - rs.fields("XPAmount") - rs.fields("DAmount"))
                        End If

                        If Share > Saldo Then Share = Saldo

                        If Share <> 0 Then
                            Treaty_Hold_Risk_Cession(rsR.fields("RID"), ANO, Holdf, Message)
                        End If
                    Else
                        rs.fields("QID") = tostr(rsR.fields("RID"))
                        Share = rs.fields("QAmount") + rs.fields("QSRAmount")
                        If Share > Saldo Then Share = Saldo
                    End If

                    If Not (Not ConjunctionF And ReLimitRTypeF And (InStr("RT", ISType) = 0 Or Not AssessmentExInwardF)) Then
                        RShare = toval(rsR.fields("Share"))
                    End If
                    rs.fields("QShare") = Share / OurShare * 100 * RShare / 100
                    rs.fields("QAmount") = Share * RShare / 100
                    rs.fields("QSRet") = (100 - RShare)
                    rs.fields("QSRAmount") = Share * (100 - RShare) / 100

                    Saldo = Saldo - Share
                Else
                    rs.fields("QID") = ""
                    rs.fields("QShare") = 0
                    rs.fields("QAmount") = 0
                    rs.fields("QSRet") = 0
                    rs.fields("QSRAmount") = 0
                End If

                If ORLimit <> 0 OrElse ReAllocF Then
                    ' Get the Surplus #1
                    rsR = db.OpenQueryDef("QReinsurance_Cession", adOpenForwardonly, ANO, RDate, "S1", TSI, tostr(rs.fields("SP1ID")), 0, Gross)
                    If Not rsR.Eof Then
                        AssessmentExInwardF = toval(rsR.fields("AssessmentExInwardF"))
                        If Not ManualF AndAlso MShare <> 100 Then
                            PLimit = IIf(toval(rsR.fields("AssessmentF")), RPLimit, 1)
                            If (ISType <> "R" And ISType <> "T") Or Not toval(rsR.fields("DirectF")) Then
                                ' Direct Business
                                rs.fields("SP1ID") = tostr(rsR.fields("RID"))

                                ' Risk Limit by Reinsurance Type
                                TLimit = IIf(toval(rsR.fields("CessionF")), CLimit, 1)
                                If Not ConjunctionF And ReLimitRTypeF And Saldo <> 0 Then
                                    If toval(rsR.fields("AssessmentF")) And (InStr("RT", ISType) = 0 Or Not AssessmentExInwardF) Then
                                        TLimit = TLimit * RiskAssLimit(ANO, "S1", Holdf, Message, RShare, PLimit)
                                    End If
                                Else
                                    If toval(rsR.fields("AssessmentF")) And (InStr("RT", ISType) = 0 Or Not AssessmentExInwardF) Then
                                        TLimit = TLimit * RLimit
                                    End If
                                End If

                            Else
                                ' In-Direct Business
                                rs.fields("SP1ID") = ""
                                TLimit = 0
                            End If

                            If ProformaF OrElse NoRiskAccumulationF Then
                                Share = rsR.fields("Limit") * TLimit
                            Else
                                Share = rsR.fields("Limit") * TLimit - Get_Accumulation(REGID, FLDID, VALUEID, "S1", RYear) + PrevAccRegAmount(ANO, "S1")
                            End If

                            Share = IIf(Share < 0, 0, Share)

                            ' Policy Cession Limit Applicable
                            If PLimit <> 0 Then
                                If toval(rsR.fields("PLimit")) <> 0 Then
                                    If Share > PLimit * toval(rsR.fields("PLimit")) Then
                                        Share = PLimit * toval(rsR.fields("PLimit"))
                                    End If
                                End If
                            End If

                            If IIf(toval(rsR.fields("PShare")) = 0, 100, toval(rsR.fields("PShare"))) / 100 * (OurShare - rs.fields("CAmount") - rs.fields("XPAmount") - rs.fields("DAmount")) < Share Then
                                Share = IIf(toval(rsR.fields("PShare")) = 0, 100, toval(rsR.fields("PShare"))) / 100 * (OurShare - rs.fields("CAmount") - rs.fields("XPAmount") - rs.fields("DAmount"))
                            End If

                            If Share > Saldo Then Share = Saldo

                            ' Check Number Of Line OR for ORSurplus
                            If ORLimit <> 0 And Not ReAllocF Then
                                If Share > (rs.fields("QAmount") + rs.fields("QSRamount")) * (rsR.fields("Limit") / ORLimit) Then
                                    Share = (rs.fields("QAmount") + rs.fields("QSRamount")) * (rsR.fields("Limit") / ORLimit)
                                End If
                            End If
                            If Share <> 0 Then
                                Treaty_Hold_Risk_Cession(rsR.fields("RID"), ANO, Holdf, Message)
                            End If
                        Else
                            rs.fields("SP1ID") = tostr(rsR.fields("RID"))
                            Share = rs.fields("SP1Amount")
                            If Share > Saldo Then Share = Saldo
                        End If

                        rs.fields("SP1SHARE") = Share / OurShare * 100
                        rs.fields("SP1AMOUNT") = Share
                        SPRAmount = SPRAmount + Share * (100 - toval(rsR.fields("RShare"))) / 100
                        Saldo = Saldo - Share
                    Else
                        rs.fields("SP1ID") = ""
                        rs.fields("SP1SHARE") = 0
                        rs.fields("SP1AMOUNT") = 0
                    End If

                    ' Get the Surplus #2
                    rsR = db.OpenQueryDef("QReinsurance_Cession", adOpenForwardonly, ANO, RDate, "S2", TSI, tostr(rs.fields("SP2ID")), 0, Gross)
                    If Not rsR.Eof Then
                        AssessmentExInwardF = toval(rsR.fields("AssessmentExInwardF"))
                        If Not ManualF AndAlso MShare <> 100 Then
                            PLimit = IIf(toval(rsR.fields("AssessmentF")), RPLimit, 1)
                            If (ISType <> "R" And ISType <> "T") Or Not toval(rsR.fields("DirectF")) Then
                                ' Direct Business
                                rs.fields("SP2ID") = tostr(rsR.fields("RID"))

                                ' Risk Limit by Reinsurance Type
                                TLimit = IIf(toval(rsR.fields("CessionF")), CLimit, 1)
                                If Not ConjunctionF And ReLimitRTypeF And Saldo <> 0 Then
                                    If toval(rsR.fields("AssessmentF")) And (InStr("RT", ISType) = 0 Or Not AssessmentExInwardF) Then
                                        TLimit = TLimit * RiskAssLimit(ANO, "S2", Holdf, Message, RShare, PLimit)
                                    End If
                                Else
                                    If toval(rsR.fields("AssessmentF")) And (InStr("RT", ISType) = 0 Or Not AssessmentExInwardF) Then
                                        TLimit = TLimit * RLimit
                                    End If
                                End If

                            Else
                                ' In-Direct Business
                                rs.fields("SP2ID") = ""
                                TLimit = 0
                            End If

                            If ProformaF OrElse NoRiskAccumulationF Then
                                Share = rsR.fields("Limit") * TLimit
                            Else
                                Share = rsR.fields("Limit") * TLimit - Get_Accumulation(REGID, FLDID, VALUEID, "S2", RYear) + PrevAccRegAmount(ANO, "S2")
                            End If

                            Share = IIf(Share < 0, 0, Share)

                            ' Policy Cession Limit Applicable
                            If PLimit <> 0 Then
                                If toval(rsR.fields("PLimit")) <> 0 Then
                                    If Share > PLimit * toval(rsR.fields("PLimit")) Then
                                        Share = PLimit * toval(rsR.fields("PLimit"))
                                    End If
                                End If
                            End If

                            If IIf(toval(rsR.fields("PShare")) = 0, 100, toval(rsR.fields("PShare"))) / 100 * (OurShare - rs.fields("CAmount") - rs.fields("XPAmount") - rs.fields("DAmount")) < Share Then
                                Share = IIf(toval(rsR.fields("PShare")) = 0, 100, toval(rsR.fields("PShare"))) / 100 * (OurShare - rs.fields("CAmount") - rs.fields("XPAmount") - rs.fields("DAmount"))
                            End If

                            If Share > Saldo Then Share = Saldo

                            ' Check Number Of Line OR for ORSurplus
                            If ORLimit <> 0 And Not ReAllocF Then
                                If Share > (rs.fields("QAmount") + rs.fields("QSRamount")) * (rsR.fields("Limit") / ORLimit) Then
                                    Share = (rs.fields("QAmount") + rs.fields("QSRamount")) * (rsR.fields("Limit") / ORLimit)
                                End If
                            End If
                            If Share <> 0 Then
                                Treaty_Hold_Risk_Cession(rsR.fields("RID"), ANO, Holdf, Message)
                            End If
                        Else
                            rs.fields("SP2ID") = tostr(rsR.fields("RID"))
                            Share = rs.fields("SP2Amount")
                            If Share > Saldo Then Share = Saldo
                        End If
                        rs.fields("SP2SHARE") = Share / OurShare * 100
                        rs.fields("SP2AMOUNT") = Share
                        SPRAmount = SPRAmount + Share * (100 - toval(rsR.fields("RShare"))) / 100
                        Saldo = Saldo - Share
                    Else
                        rs.fields("SP2ID") = ""
                        rs.fields("SP2SHARE") = 0
                        rs.fields("SP2AMOUNT") = 0
                    End If

                    ' Get the Surplus #3
                    rsR = db.OpenQueryDef("QReinsurance_Cession", adOpenForwardonly, ANO, RDate, "S3", TSI, tostr(rs.fields("SP3ID")), 0, Gross)
                    If Not rsR.Eof Then
                        AssessmentExInwardF = toval(rsR.fields("AssessmentExInwardF"))
                        If Not ManualF AndAlso MShare <> 100 Then
                            PLimit = IIf(toval(rsR.fields("AssessmentF")), RPLimit, 1)
                            If (ISType <> "R" And ISType <> "T") Or Not toval(rsR.fields("DirectF")) Then
                                ' Direct Business
                                rs.fields("SP3ID") = tostr(rsR.fields("RID"))

                                ' Risk Limit by Reinsurance Type
                                TLimit = IIf(toval(rsR.fields("CessionF")), CLimit, 1)
                                If Not ConjunctionF And ReLimitRTypeF And Saldo <> 0 Then
                                    If toval(rsR.fields("AssessmentF")) And (InStr("RT", ISType) = 0 Or Not AssessmentExInwardF) Then
                                        TLimit = TLimit * RiskAssLimit(ANO, "S3", Holdf, Message, RShare, PLimit)
                                    End If
                                Else
                                    If toval(rsR.fields("AssessmentF")) And (InStr("RT", ISType) = 0 Or Not AssessmentExInwardF) Then
                                        TLimit = TLimit * RLimit
                                    End If
                                End If

                            Else
                                ' In-Direct Business
                                rs.fields("SP3ID") = ""
                                TLimit = 0
                            End If

                            If ProformaF OrElse NoRiskAccumulationF Then
                                Share = rsR.fields("Limit") * TLimit
                            Else
                                Share = rsR.fields("Limit") * TLimit - Get_Accumulation(REGID, FLDID, VALUEID, "S3", RYear) + PrevAccRegAmount(ANO, "S3")
                            End If

                            Share = IIf(Share < 0, 0, Share)

                            ' Policy Cession Limit Applicable
                            If PLimit <> 0 Then
                                If toval(rsR.fields("PLimit")) <> 0 Then
                                    If Share > PLimit * toval(rsR.fields("PLimit")) Then
                                        Share = PLimit * toval(rsR.fields("PLimit"))
                                    End If
                                End If
                            End If

                            If IIf(toval(rsR.fields("PShare")) = 0, 100, toval(rsR.fields("PShare"))) / 100 * (OurShare - rs.fields("CAmount") - rs.fields("XPAmount") - rs.fields("DAmount")) < Share Then
                                Share = IIf(toval(rsR.fields("PShare")) = 0, 100, toval(rsR.fields("PShare"))) / 100 * (OurShare - rs.fields("CAmount") - rs.fields("XPAmount") - rs.fields("DAmount"))
                            End If

                            If Share > Saldo Then Share = Saldo

                            ' Check Number Of Line OR for ORSurplus
                            If ORLimit <> 0 And Not ReAllocF Then
                                If Share > (rs.fields("QAmount") + rs.fields("QSRamount")) * (rsR.fields("Limit") / ORLimit) Then
                                    Share = (rs.fields("QAmount") + rs.fields("QSRamount")) * (rsR.fields("Limit") / ORLimit)
                                End If
                            End If
                            If Share <> 0 Then
                                Treaty_Hold_Risk_Cession(rsR.fields("RID"), ANO, Holdf, Message)
                            End If
                        Else
                            rs.fields("SP3ID") = tostr(rsR.fields("RID"))
                            Share = rs.fields("SP3Amount")
                            If Share > Saldo Then Share = Saldo
                        End If
                        rs.fields("SP3SHARE") = Share / OurShare * 100
                        rs.fields("SP3AMOUNT") = Share
                        SPRAmount = SPRAmount + Share * (100 - toval(rsR.fields("RShare"))) / 100
                        Saldo = Saldo - Share
                    Else
                        rs.fields("SP3ID") = ""
                        rs.fields("SP3SHARE") = 0
                        rs.fields("SP3AMOUNT") = 0
                    End If
                Else
                    rs.fields("SP1ID") = ""
                    rs.fields("SP1SHARE") = 0
                    rs.fields("SP1AMOUNT") = 0
                    rs.fields("SP2ID") = ""
                    rs.fields("SP2SHARE") = 0
                    rs.fields("SP2AMOUNT") = 0
                    rs.fields("SP3ID") = ""
                    rs.fields("SP3SHARE") = 0
                    rs.fields("SP3AMOUNT") = 0
                End If

                ' Get the Auto Fac
                rsR = db.OpenQueryDef("QReinsurance_Cession", adOpenForwardonly, ANO, RDate, "A", TSI, tostr(rs.fields("AID")), 0, Gross)
                If Not rsR.Eof Then
                    AssessmentExInwardF = toval(rsR.fields("AssessmentExInwardF"))
                    If Not ManualF AndAlso MShare <> 100 Then
                        PLimit = IIf(toval(rsR.fields("AssessmentF")), RPLimit, 1)
                        If (ISType <> "R" And ISType <> "T") Or Not toval(rsR.fields("DirectF")) Then
                            ' Direct Business
                            rs.fields("AID") = tostr(rsR.fields("RID"))

                            ' Risk Limit by Reinsurance Type
                            TLimit = IIf(toval(rsR.fields("CessionF")), CLimit, 1)
                            If Not ConjunctionF And ReLimitRTypeF And Saldo <> 0 Then
                                If toval(rsR.fields("AssessmentF")) And (InStr("RT", ISType) = 0 Or Not AssessmentExInwardF) Then
                                    TLimit = TLimit * RiskAssLimit(ANO, "A", Holdf, Message, RShare, PLimit)
                                End If
                            Else
                                If toval(rsR.fields("AssessmentF")) And (InStr("RT", ISType) = 0 Or Not AssessmentExInwardF) Then
                                    TLimit = TLimit * RLimit
                                End If
                            End If

                        Else
                            ' In-Direct Business
                            rs.fields("AID") = ""
                            TLimit = 0
                        End If

                        If ProformaF OrElse NoRiskAccumulationF Then
                            Share = rsR.fields("Limit") * TLimit
                        Else
                            Share = rsR.fields("Limit") * TLimit - Get_Accumulation(REGID, FLDID, VALUEID, "A", RYear) + PrevAccRegAmount(ANO, "A")
                        End If

                        Share = IIf(Share < 0, 0, Share)

                        ' Policy Cession Limit Applicable
                        If PLimit <> 0 Then
                            If toval(rsR.fields("PLimit")) <> 0 Then
                                If Share > PLimit * toval(rsR.fields("PLimit")) Then
                                    Share = PLimit * toval(rsR.fields("PLimit"))
                                End If
                            End If
                        End If

                        If IIf(toval(rsR.fields("PShare")) = 0, 100, toval(rsR.fields("PShare"))) / 100 * (OurShare - rs.fields("CAmount") - rs.fields("XPAmount") - rs.fields("DAmount")) < Share Then
                            Share = IIf(toval(rsR.fields("PShare")) = 0, 100, toval(rsR.fields("PShare"))) / 100 * (OurShare - rs.fields("CAmount") - rs.fields("XPAmount") - rs.fields("DAmount"))
                        End If

                        If Share > Saldo Then Share = Saldo

                        If Share <> 0 Then
                            Treaty_Hold_Risk_Cession(rsR.fields("RID"), ANO, Holdf, Message)
                        End If
                    Else
                        rs.fields("AID") = tostr(rsR.fields("RID"))
                        Share = rs.fields("AAMOUNT") + rs.fields("AFRAmount")
                        If Share > Saldo Then Share = Saldo
                    End If

                    If Not (Not ConjunctionF And ReLimitRTypeF And (InStr("RT", ISType) = 0 Or Not AssessmentExInwardF)) Then
                        RShare = toval(rsR.fields("Share"))
                    End If
                    rs.fields("ASHARE") = Share / OurShare * 100 * RShare / 100
                    rs.fields("AAMOUNT") = Share * RShare / 100
                    rs.fields("AFRet") = (100 - RShare)
                    rs.fields("AFRAmount") = Share * (100 - RShare) / 100
                    Saldo = Saldo - Share
                Else
                    rs.fields("AID") = ""
                    rs.fields("ASHARE") = 0
                    rs.fields("AAMOUNT") = 0
                    rs.fields("AFRet") = 0
                    rs.fields("AFRAmount") = 0
                End If

                ' Set the Retention
                rs.fields("RAmount") = Saldo - (FAmount - PreCedeFAmount) - toval(rs.fields("SAmount"))

                If -rs.fields("RAmount") <= rs.fields("SAmount") AndAlso rs.fields("RAmount") < 0 Then
                    rs.fields("SAmount") = rs.fields("SAmount") + rs.fields("RAmount")
                    rs.fields("RAmount") = 0
                End If

                If ShortFallF OrElse (ShortFallLimit <> 0 AndAlso rs.fields("SAmount") + rs.fields("RAmount") <= ShortFallLimit) Then
                    rs.fields("SAmount") = rs.fields("SAmount") + rs.fields("RAmount")
                    rs.fields("RAmount") = 0
                End If

                rs.fields("Retention") = rs.fields("RAmount") / OurShare * 100
                rs.fields("ShortFall") = rs.fields("SAmount") / OurShare * 100
                rs.fields("TAmount") = OurShare
                rs.fields("TShare") = 100
                rs.fields("PCTShare") = PctShare
                rs.fields("MShare") = MShare
                rs.fields("PCTLOSS") = PCTLOSS
                rs.fields("MAmount") = MAmount
                rs.fields("FShare") = FShare
                rs.fields("FAmount") = FAmount
                rs.fields("CLimit") = CLimit
                rs.fields("Limit") = RLimit
                If Holdf Then
                    rs.fields("HoldF") = Holdf
                    If rs.fields("Message") = "" Then
                        rs.fields("Message") = Message
                    Else
                        rs.fields("Message") = rs.fields("Message") & vbCrLf & Message
                    End If
                Else
                    rs.fields("HoldF") = False
                    rs.fields("Message") = ""
                End If
                rs.fields("ManualF") = ManualF
                If CleanCutF Then
                    rs.fields("PDate") = R_PDate
                    rs.fields("PPDate") = R_PPDate
                Else
                    rs.fields("PDate") = rs.fields("RDate")
                    rs.fields("PPDate") = rs.fields("NRDate")
                End If
                rs.fields("SPRShare") = SPRAmount / OurShare * 100
                rs.fields("SPRAmount") = SPRAmount
                If Not rs.Update Then Throw New Exception(db.ErrDesc)

                ' Adjust Facultative Amount
                If Not db.Execute("Update RArrDet Set Amount=RArrDet.Share/100*Case When RArrDet.Limit<>0 then RArrDet.Limit else RArrHeader.TAmount end from RArrDet, RArrHeader Where RArrHeader.ANO=" & ANO & " and RArrHeader.TAmount<>0 and RArrDet.ANO=RArrHeader.ANO and round(RArrDet.Amount,2)<>round(RArrDet.Share/100*Case When RArrDet.Limit<>0 then RArrDet.Limit else RArrHeader.TAmount end,2)") Then Throw New Exception(db.ErrDesc)
            End If

            ' Check if Renewed Policy already Closed
            If AType = "N" And RANO <> -1 Then
                rs = db.OpenRemoteSet("Select AStatus from Acceptance Where ANO=" & RANO)
                If rs.fields("AStatus") <> "C" Then
                    Reinsurance_Cession = True
                    Exit Function
                End If
            End If

            'Immediately Booked The Accumulation
            If Not ReleaseAccRegAmount(ANO, True) Then Throw New Exception("Reinsurance Cession - Release/UnRelease Accumulation Register !")
            Return True

        Catch ex As Exception
            StrMsg = ex.Message
            Return False
        End Try
    End Function
    Private Sub GetFacCessionShare(ByVal ANO As Long, ByRef FShare As Double, ByRef PrecedeFShare As Double)
        Dim rs As RemoteSet
        rs = db.OpenQueryDef("QFacCessionShare", adOpenForwardonly, ANO)
        FShare = toval(rs.fields("FShare"))
        PrecedeFShare = toval(rs.fields("PrecedeFShare"))
    End Sub
    Private Function ReleaseAccRegAmount(ByVal ANO As Long, ByVal PreviousF As Boolean) As Boolean
        Dim rs As RemoteSet
        Dim Amount As Double
        Dim TAmount As Double
        Dim REGID As String
        Dim FLDID As String
        Dim VALUEID As String
        Dim AType As String
        Dim AStatus As String
        Dim pANO As Long
        Dim RegNo As Long
        Dim RYear As Integer

        On Error GoTo errmsg
        Dim NoRiskAccumulationF As Boolean

        rs = db.OpenQueryDef("QACCREG", adOpenForwardonly, ANO)
        REGID = tostr(rs.fields("REGID"))
        FLDID = tostr(rs.fields("FLDID"))
        VALUEID = tostr(rs.fields("ValueID"))
        AType = tostr(rs.fields("AType"))
        AStatus = tostr(rs.fields("AStatus"))
        pANO = toval(rs.fields("pANO"))
        RYear = toval(rs.fields("RYEAR"))

        NoRiskAccumulationF = toval(rs.fields("NoRiskAccumulationF"))
        rs.CloseRemoteSet()

        If (AStatus = "W" Or AStatus = "T") And pANO <> -1 And PreviousF Then
            If Not UnReleaseAccRegAmount(pANO, False) Then GoTo errmsg
        End If

        If Not NoRiskAccumulationF Then
            Dim PctShare As Double
            Dim MShare As Double
            Dim PCTLOSS As Double

            rs = db.OpenQueryDef("QRARRHEADER", adOpenKeyset, ANO)
            If tostr(rs.fields("Status")) = "R" And AType <> "C" And AType <> "A" Then
                PctShare = rs.fields("PCTShare")
                MShare = rs.fields("MShare")
                PCTLOSS = rs.fields("PCTLOSS")
                rs.Edit()
                If FLDID <> "" And VALUEID <> "" AndAlso MShare <> 100 Then
                    TAmount = toval(rs.fields("TAmount"))

                    ' Compulsory
                    Amount = toval(rs.fields("CAMOUNT") - toval(rs.fields("CCAMOUNT")))
                    If tostr(rs.fields("CID")) <> "" Then
                        RegNo = toval(PutAccRegAmount(REGID, FLDID, VALUEID, RYear, "C", Amount / (PctShare / 100 * PCTLOSS / 100 * (100 - MShare) / 100), TAmount / (PctShare / 100 * PCTLOSS / 100)))
                        If RegNo = -1 Then GoTo errmsg
                        rs.fields("CRegNo") = RegNo
                    End If

                    ' Excess Priority/MaiPark
                    Amount = toval(rs.fields("XPAMOUNT")) - toval(rs.fields("CXPAMOUNT"))
                    If tostr(rs.fields("XPID")) <> "" Then
                        RegNo = toval(PutAccRegAmount(REGID, FLDID, VALUEID, RYear, "XP", Amount / (PctShare / 100 * PCTLOSS / 100 * (100 - MShare) / 100), TAmount / (PctShare / 100 * PCTLOSS / 100)))
                        If RegNo = -1 Then GoTo errmsg
                        rs.fields("XPRegNo") = RegNo
                    End If

                    ' Decree
                    Amount = toval(rs.fields("DAMOUNT") - toval(rs.fields("CDAMOUNT")))
                    If tostr(rs.fields("DID")) <> "" Then
                        RegNo = toval(PutAccRegAmount(REGID, FLDID, VALUEID, RYear, "D", Amount / (PctShare / 100 * PCTLOSS / 100 * (100 - MShare) / 100), TAmount / (PctShare / 100 * PCTLOSS / 100)))
                        If RegNo = -1 Then GoTo errmsg
                        rs.fields("DRegNo") = RegNo
                    End If

                    ' Quota Share
                    Amount = toval(rs.fields("QAMOUNT") + toval(rs.fields("QSRAMOUNT")) - toval(rs.fields("CQAMOUNT")))
                    If rs.fields("QID") <> "" Then
                        RegNo = toval(PutAccRegAmount(REGID, FLDID, VALUEID, RYear, "Q", Amount, TAmount * ((100 - MShare) / 100)))
                        If RegNo = -1 Then GoTo errmsg
                        rs.fields("QRegNo") = RegNo
                    End If

                    ' 1st Surplus
                    Amount = toval(rs.fields("SP1AMOUNT")) - toval(rs.fields("CSP1AMOUNT"))
                    If tostr(rs.fields("SP1ID")) <> "" Then
                        RegNo = toval(PutAccRegAmount(REGID, FLDID, VALUEID, RYear, "S1", Amount, TAmount * ((100 - MShare) / 100)))
                        If RegNo = -1 Then GoTo errmsg
                        rs.fields("SP1RegNo") = RegNo
                    End If

                    ' 2nd Surplus
                    Amount = toval(rs.fields("SP2AMOUNT")) - toval(rs.fields("CSP2AMOUNT"))
                    If tostr(rs.fields("SP2ID")) <> "" Then
                        RegNo = toval(PutAccRegAmount(REGID, FLDID, VALUEID, RYear, "S2", Amount, TAmount * ((100 - MShare) / 100)))
                        If RegNo = -1 Then GoTo errmsg
                        rs.fields("SP2RegNo") = RegNo
                    End If

                    ' 3rd Surplus
                    Amount = toval(rs.fields("SP3AMOUNT")) - toval(rs.fields("CSP3AMOUNT"))
                    If tostr(rs.fields("SP3ID")) <> "" Then
                        RegNo = toval(PutAccRegAmount(REGID, FLDID, VALUEID, RYear, "S3", Amount, TAmount * ((100 - MShare) / 100)))
                        If RegNo = -1 Then GoTo errmsg
                        rs.fields("SP3RegNo") = RegNo
                    End If

                    ' Auto Facultative
                    Amount = toval(rs.fields("AAMOUNT") + toval(rs.fields("AFRAMOUNT")) - toval(rs.fields("CAAMOUNT")))
                    If tostr(rs.fields("AID")) <> "" Then
                        RegNo = toval(PutAccRegAmount(REGID, FLDID, VALUEID, RYear, "A", Amount, TAmount * ((100 - MShare) / 100)))
                        If RegNo = -1 Then GoTo errmsg
                        rs.fields("ARegNo") = RegNo
                    End If
                End If

                rs.fields("Status") = "A"
                If Not rs.Update Then GoTo errmsg

                rs.CloseRemoteSet()

                ' Also Update Cover Limit
                'Set rs = db.OpenRemoteSet("select Cover.*, PCalc.Rate from Cover, Acceptance, PCALC where Cover.CNO=Acceptance.CNO and PCALC.ANO=Acceptance.ANO and Acceptance.ANO=" & ANO)
                'If Not rs.EOF Then
                '   TAmount = TAmount / toval(rs.fields("Rate"))
                'End If
            End If
        End If

        ReleaseAccRegAmount = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        ReleaseAccRegAmount = False
    End Function

    Private Function UnReleaseAccRegAmount(ByVal ANO As Long, ByVal PreviousF As Boolean) As Boolean
        Dim rs As RemoteSet
        Dim Amount As Double
        Dim TAmount As Double
        Dim REGID As String
        Dim FLDID As String
        Dim VALUEID As String
        Dim AType As String
        Dim AStatus As String
