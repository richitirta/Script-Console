    Private Function SchemeTemporary_Process() As Boolean
        On Error GoTo ErrMsg
        Dim ANO As Long
        Dim rs As RemoteSet
        Dim rsAcc As RemoteSet
        rs = db.OpenRemoteSet("Select * from Scheme_Transaction Where Status='T'", adOpenForwardonly)
        Do While Not rs.Eof
            ANO = toval(rs.fields("ANO"))
            ' Check If in Temporary Table
            rsAcc = db.OpenQueryDef("QtAcceptance", adOpenKeyset, ANO)
            If Not rsAcc.Eof Then
                ' Insert Statement Here
                If Not CopyAccTemp("Acceptance", ANO) Then GoTo ErrMsg
                If Not CopyAccTemp("AInfo", ANO) Then GoTo ErrMsg
                If Not CopyAccTemp("AInfo_Ext", ANO) Then GoTo ErrMsg
                If Not CopyAccTemp("RArrHeader", ANO) Then GoTo ErrMsg
                If Not CopyAccTemp("RCover", ANO) Then GoTo ErrMsg
                If Not CopyInterestTemp(ANO) Then GoTo ErrMsg
                If Not CopyAccTemp("ICoverDet", ANO) Then GoTo ErrMsg
                If Not CopyAccTemp("APayor", ANO) Then GoTo ErrMsg
                If Not CopyAccTemp("APayorDet", ANO) Then GoTo ErrMsg
                If Not CopyAccTemp("PCalc", ANO) Then GoTo ErrMsg
                If Not CopyAccTemp("RCalc", ANO) Then GoTo ErrMsg
                If Not CopyAccTemp("ICalc", ANO) Then GoTo ErrMsg
                If Not CopyAccTemp("AccDed", ANO) Then GoTo ErrMsg
                If Not CopyAccTemp("AccCla", ANO) Then GoTo ErrMsg
                If Not CopyAccTemp("AccEx", ANO) Then GoTo ErrMsg
                If Not CopyAccTemp("AccCon", ANO) Then GoTo ErrMsg
                If Not CopyAccTemp("AccFD", ANO) Then GoTo ErrMsg

                ' Delete Temporary
                If Not rsAcc.Delete Then GoTo ErrMsg
            End If
            If Not Inforce(ANO) Then GoTo ErrMsg
            rs.MoveNext()
        Loop

        SchemeTemporary_Process = True
        Exit Function
ErrMsg:
        StrMsg = StrError(StrMsg)
        SchemeTemporary_Process = False
    End Function

    Private Function PolicyLapse_Process(ByVal COB As String, ByVal SDate As Date, ByVal EDate As Date) As Boolean
        On Error GoTo ErrMsg
        Dim ANO As Long
        Dim LANO As Long
        Dim OpenFlag As Boolean
        Dim CNO As Long
        Dim SQL As String
        SQL = "Select Acceptance.ANO, Acceptance.LANO, Cover.OpenFlag, Cover.CNO, Acceptance.EDate from Acceptance, Cover, TOC "
        SQL = SQL & " Where TOC.TOC=Acceptance.TOC and (Cover.CNO = Acceptance.CNO And (Acceptance.LANO = -1 Or (Cover.OpenFlag = 1 And Acceptance.LANO <> Acceptance.ANO) Or (Cover.OpenFlag = 0 And Acceptance.LANO=Acceptance.ANO)))"
        SQL = SQL & " and Acceptance.AStatus='I' and Acceptance.AType not in ('C','A') and Acceptance.EDate Between '" & Format(SDate, "MM/DD/YYYY") & "' and '" & Format(EDate, "MM/DD/YYYY") & "'"
        SQL = SQL & " and Not Exists (Select PANO from Acceptance EA Where EA.PANO=Acceptance.ANO)"
        If COB <> "<All>" Then
            SQL = SQL & " and TOC.COB='" & COB & "'"
        End If

        Dim rs As RemoteSet

        rs = db.OpenRemoteSet(SQL, adOpenForwardonly)
        Do While Not rs.Eof
            ANO = toval(rs.fields("ANO"))
            LANO = toval(rs.fields("LANO"))
            OpenFlag = toval(rs.fields("OpenFlag"))
            CNO = toval(rs.fields("CNO"))
            If ANO = LANO And Not OpenFlag Then
                If Not ExpireMaster(ANO, CNO, todate(rs.fields("EDate"))) Then GoTo ErrMsg
            Else
                If Not Expire(ANO, CNO, todate(rs.fields("EDate"))) Then GoTo ErrMsg
            End If
            rs.MoveNext()
        Loop

        PolicyLapse_Process = True
        Exit Function
ErrMsg:
        StrMsg = StrError(StrMsg)
        PolicyLapse_Process = False
    End Function
    Private Function PolicyUndoLapse_Process(ByVal COB As String, ByVal SDate As Date, ByVal EDate As Date) As Boolean
        On Error GoTo ErrMsg
        Dim ANO As Long
        Dim LANO As Long
        Dim OpenFlag As Boolean
        Dim CNO As Long
        Dim SQL As String
        SQL = "Select Acceptance.ANO, Acceptance.LANO, Cover.OpenFlag, Cover.CNO, Acceptance.EDate from Acceptance, Cover, TOC "
        SQL = SQL & " Where (Cover.CNO = Acceptance.CNO And (Acceptance.LANO = -1 Or (Cover.OpenFlag = 1 And Acceptance.LANO <> Acceptance.ANO) Or (Cover.OpenFlag = 0 And Acceptance.LANO=Acceptance.ANO)))"
        SQL = SQL & " and TOC.TOC=Acceptance.TOC and Acceptance.AStatus='C' and Cover.CStatus<>'C' and Not (Cover.ASource='MKT' and Acceptance.AType='N') and Acceptance.AType not in ('C','A') and Acceptance.EDate Between '" & Format(SDate, "MM/DD/YYYY") & "' and '" & Format(EDate, "MM/DD/YYYY") & "'"
        SQL = SQL & " and Not Exists (Select EA.RANO from Acceptance EA Left Join Acceptance pEA on (pEA.ANO=EA.PANO) Where EA.AType in ('N','E') and EA.AStatus in ('C') and pEA.ANO is null and EA.RANO=Acceptance.ANO)"
        SQL = SQL & " and Not Exists (Select EA.PANO from Acceptance EA Where EA.PANO=Acceptance.ANO)"
        If COB <> "<All>" Then
            SQL = SQL & " and TOC.COB='" & COB & "'"
        End If

        Dim rs As RemoteSet
        rs = db.OpenRemoteSet(SQL, adOpenForwardonly)
        Do While Not rs.Eof
            ANO = toval(rs.fields("ANO"))
            LANO = toval(rs.fields("LANO"))
            OpenFlag = toval(rs.fields("OpenFlag"))
            CNO = toval(rs.fields("CNO"))
            If ANO = LANO And Not OpenFlag Then
                If Not UndoExpireMaster(ANO, CNO, todate(rs.fields("EDate"))) Then GoTo ErrMsg
            Else
                If Not UndoExpire(ANO, CNO, todate(rs.fields("EDate"))) Then GoTo ErrMsg
            End If
            rs.MoveNext()
        Loop

        PolicyUndoLapse_Process = True
        Exit Function
ErrMsg:
        StrMsg = StrError(StrMsg)
        PolicyUndoLapse_Process = False
    End Function
