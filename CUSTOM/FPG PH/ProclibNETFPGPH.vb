    Private Function Short_Period_Calc(ByVal TOC As String, ByVal SDate As Date, ByVal EDate As Date, ByVal PDate As Date) As Double
        If DateDiff(DateInterval.Day, DateAdd(DateInterval.Day, -1, EDate), DateAdd(DateInterval.Month, 1, SDate)) > 0 Then
            ' Short Period Policy
            Short_Period_Calc = Short_Period_Prorata(TOC, SDate, PDate, "D")
        Else
            Short_Period_Calc = Short_Period_Prorata(TOC, SDate, PDate, "M")
        End If
    End Function
    Private Function Short_Period_Prorata(ByVal TOC As String, ByVal SDate As Date, ByVal EDate As Date, ByVal Basis As String) As Double
        Dim rsP As RemoteSet
        Dim NOP As Double
        Dim diff As Integer

        'M
        If Basis = "M" Then
            NOP = DateDiff(DateInterval.Month, SDate, EDate)

            diff = DateDiff(DateInterval.Day, DateAdd(DateInterval.Month, NOP, SDate), EDate)
            NOP = NOP + diff / 30
            rsP = db.OpenQueryDef("QPREMIUM_SCALE", adOpenForwardonly, TOC, "M", NOP)
            If Not rsP.Eof Then
                Short_Period_Prorata = rsP.fields("PCT")
            Else
                Short_Period_Prorata = 0
            End If
        Else
            NOP = DateDiff(DateInterval.Day, SDate, EDate)
            rsP = db.OpenQueryDef("QPREMIUM_SCALE", adOpenForwardonly, TOC, "D", NOP)
            If Not rsP.Eof Then
                Short_Period_Prorata = rsP.fields("PCT")
            Else
                Short_Period_Prorata = 0
            End If
        End If
    End Function
    Private Function InforceBulk(ByVal ListANO As Object, Optional ByVal br_Approval_user As String = "", Optional ByVal BackDatedF As Boolean = False, Optional ByVal pADate As Object = "", Optional ByVal BulkF As Boolean = True) As Boolean
        Dim rs As RemoteSet
        Dim ANO As Long
        Dim LANO As Long
        On Error GoTo ErrMsg

        Dim DetailTreatyF As Boolean
        rs = db.OpenRemoteSet("Select DetailTreatyF from SysTab", adOpenForwardonly)
        DetailTreatyF = rs.fields("DetailTreatyF")

        For Each ANO In ListANO
            rs = db.OpenRemoteSet("Select A.LANO, A.RANO, mA.PolicyNo, mA.ESeqNo, mA.EESeqNo, mA.ERSeqNo, A.SplitDNCNF from Acceptance A Left Join Acceptance mA on (mA.ANO=A.LANO) Where A.AStatus in ('W','T') and A.ANO=" & ANO)
            If Not rs.Eof Then
                If BulkF Then
                    Dim PolicyNo As String = rs.fields("PolicyNo")
                    Dim DocNo As String = PolicyNo
                    Dim ESeqNo As Integer = toval(rs.fields("ESeqNo"))
                    Dim EESeqNo As Integer = toval(rs.fields("EESeqNo"))
                    Dim ERSeqNo As Integer = toval(rs.fields("ERSeqNo"))
                    Dim SplitDNCNF As Boolean = toval(rs.fields("SplitDNCNF"))
                    LANO = toval(rs.fields("LANO"))

                    If ESeqNo <> 0 Then
                        DocNo = DocNo + "-" + tostr(ESeqNo) + "/" + tostr(EESeqNo)
                        If ERSeqNo <> 0 Then
                            DocNo = DocNo + "/" + tostr(ERSeqNo)
                        End If
                    End If
                    If Not Inforce(ANO, br_Approval_user, BackDatedF, pADate, "", ESeqNo, EESeqNo, pADate, BulkF, PolicyNo, DocNo, , , , ERSeqNo) Then GoTo ErrMsg
                    If Not BackDatedF Then
                        If rs.fields("RANO") <> -1 Then
                            Dim Param(8) As Object
                            Param(8) = False ' Create Voucher
                            If Not Posting_SurplusCalculation(pADate, Param, rs.fields("RANO")) Then GoTo errmsg
                        End If
                        If Not Production_To_Adm(ANO, LANO, BulkF, DetailTreatyF, , SplitDNCNF) Then GoTo errmsg
                    End If
                Else
                    If Not Inforce(ANO, br_Approval_user, BackDatedF, pADate, , , , , BulkF) Then GoTo ErrMsg
                End If
            End If
        Next
        ' Only For Bulk Process
        If Not BackDatedF And BulkF Then

            For Each ANO In ListANO
                rs = db.OpenRemoteSet("Select distinct Acceptance.LANO, Acceptance.SplitDNCNF, Admlink.ID, TOC.COB, TOC.ConsortiumF, AccAss.CommPoolF, Admlink.TYPE, Admlink.CURRENCY, Admlink.REFNO, Admlink.DATE, Admlink.BILLDATE, Admlink.DOCNO, Admlink.Subject, Admlink.BRANCH, Admlink.Segment, Admlink.A_PolicyNo from Acceptance, AccAss, Admlink, TOC Where Acceptance.ANO=AccAss.ANO and TOC.TOC=Admlink.Code and Admlink.VoucherF=0 and Admlink.AdmNo=AccAss.AdmNo and Admlink.WriteF=0 and AccAss.ANO=" & ANO)
                Do While Not rs.Eof
                    LANO = toval(rs.fields("LANO"))
                    Dim SplitDNCNF As Boolean = toval(rs.fields("SplitDNCNF"))
                    Dim rsAdmNo As RemoteSet
                    Dim sAdmNo As String = ""
                    rsAdmNo = db.OpenRemoteSet("Select A.AdmNo from Admlink A, TOC T Where A.Code=T.TOC and A.VoucherF=0 and A.WriteF=0 and A.ID='" & rs.fields("ID") & "' and T.COB='" & rs.fields("COB") & "' and A.Type='" & rs.fields("Type") & "' and A.Currency='" & rs.fields("Currency") & "' and A.RefNo='" & rs.fields("RefNo") & "' and A.Date='" & Format(rs.fields("Date"), "MM/DD/YYYY") & "' and A.BillDate='" & Format(rs.fields("BillDate"), "MM/DD/YYYY") & "' and A.DocNo='" & rs.fields("DocNo") & "' and A.Subject='" & rs.fields("Subject") & "' and A.Branch='" & rs.fields("Branch") & "' and A.Segment='" & rs.fields("Segment") & "' and A.A_PolicyNo='" & rs.fields("A_PolicyNo") & "'")
                    If Not rsAdmNo.Eof Then
                        Do While Not rsAdmNo.Eof
                            If sAdmNo = "" Then
                                sAdmNo = tostr(rsAdmNo.fields("AdmNo"))
                            Else
                                sAdmNo = sAdmNo & "," & tostr(rsAdmNo.fields("AdmNo"))
                            End If
                            rsAdmNo.MoveNext()
                        Loop
                        If Not Production_To_Adm_Finalize(ANO, LANO, sAdmNo, , SplitDNCNF) Then GoTo errmsg
                        If Not toval(rs.fields("CommPoolF")) And (DetailTreatyF Or toval(rs.fields("ConsortiumF")) Or InStr("DIIRITIXICJPCFFOFPBBBABOBCBPBDOPDCCPXPAFDPDR", rs.fields("Type")) <> 0) Then
                            If Create_Voucher(sAdmNo, True) = "" Then GoTo errmsg
                        End If
                    End If

                    rs.MoveNext()
                Loop

                rs = db.OpenRemoteSet("Select Distinct A1.AdmNo from AccSurplus A1, Acceptance A2, Admlink A3 where A3.AdmNo=A1.AdmNo and A3.VoucherF=0 and A1.ANO=A2.RANO and A1.Status='P' and A2.ANO=" & ANO)
                Do While Not rs.Eof
                    If Create_Voucher(rs.fields("AdmNo"), True) = "" Then GoTo errmsg
                    rs.MoveNext()
                Loop
            Next
        End If

        InforceBulk = True
        Exit Function
ErrMsg:
        StrMsg = StrError(StrMsg)
        InforceBulk = False
    End Function
