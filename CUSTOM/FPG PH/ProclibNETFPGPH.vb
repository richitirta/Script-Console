    Private Sub Get_Profile_VAT_TAX(ByVal PID As String, ByVal PDate As Date, ByVal PType As String, ByRef VAT As Double, ByRef TAX As Double, Optional ByRef VATSubsidiesF As Boolean = False)
        Try
            Dim rs As RemoteSet
            Dim SQL As String
            SQL = "Select "
            SQL = SQL & " Case When datediff(day,mParam.Effective, '" & Format(PDate, "MM/DD/YYYY") & "')<0 then MParam.VatOLD else MParam.VAT End*(Case When Profile.VATF=1 Then 1 else 0 end)"
            SQL = SQL & " as VAT,"
            SQL = SQL & " Case "
            SQL = SQL & " When TaxType.MTaxType='PASAL21' then MParam.PASAL21*(100-MParam.TAXDISCOUNT)/100"
            SQL = SQL & " When TaxType.MTaxType='PASAL23' then MParam.PASAL23"
            SQL = SQL & " When TaxType.MTaxType='PASAL26' then MParam.Pasal26"
            SQL = SQL & " When TaxType.MTaxType='PASAL4' then MParam.PASAL4"
            SQL = SQL & " else 0"
            SQL = SQL & " End"
            SQL = SQL & " *(Case When Profile.TaxPCT=0 Then 1 else Profile.TaxPCT/100 end)"
            SQL = SQL & " *(Case When Profile.TaxF=1 Then 1 else 0 end)"
            SQL = SQL & " as TAX,"
            SQL = SQL & " Profile.VATSubsidiesF"
            SQL = SQL & " from Profile"
            SQL = SQL & " Left Join TaxType on (TaxType.TaxType=Profile.TaxType) "
            SQL = SQL & " Inner Join MParam on (Mparam.Type='" & PType & "')"
            SQL = SQL & " Where Profile.ID='" & PID & "'"

            rs = db.OpenRemoteSet(SQL, adOpenForwardonly)
            If Not rs.Eof Then
                VAT = toval(rs.fields("VAT"))
                TAX = toval(rs.fields("TAX"))
                VATSubsidiesF = VATSubsidiesF Or toval(rs.fields("VATSubsidiesF"))
            Else
                VAT = 0
                TAX = 0
            End If
        Catch ex As Exception
            VAT = 0
            TAX = 0
        End Try
    End Sub

    Private Function PreCalculateConditionsOK(ByVal ANO As Long, ByVal CNO As Long, ByVal ISType As String, ByVal IAccReg As Integer, ByVal RegID As String, ByVal FLDID As String, ByVal ValueID As String) As Boolean
        Dim rs As RemoteSet

        StrMsg = ""

        If ISType = "L" Then
            rs = db.OpenRemoteSet("Select Top 1 CNO from Coinsurance Where CNO=" & CNO)
            If rs.Eof Then
                StrMsg = StrMsg & "Incomplete Coinsurance's Member Data !" & vbCrLf
            End If
            rs.CloseRemoteSet()
        End If

        If ISType = "R" Or ISType = "C" Or ISType = "T" Then
            rs = db.OpenRemoteSet("Select Top 1 CNO from ISource Where CNO=" & CNO)
            If rs.Eof Then
                StrMsg = StrMsg & "Incomplete Insurance Source Data !" & vbCrLf
            End If
            rs.CloseRemoteSet()
        End If

        If IAccReg <> 0 And (RegID = "" Or FLDID = "" Or ValueID = "") Then
            StrMsg = StrMsg & "Incorrect Accumulation Register (Please Check Register ID or Field ID or Value ID) !" & vbCrLf
        End If

        'Check Interest Or Risk that do not have Coverage
        rs = db.OpenQueryDef("QCheck_Coverage", adOpenForwardonly, ANO)
        If Not rs.Eof Then
            StrMsg = StrMsg & "Please Check These Interest(s) Or Risk(s) for their Coverages !" & vbCrLf & vbCrLf
            Do Until rs.Eof
                StrMsg = StrMsg & tostr(rs.fields("Type")) & " - " & tostr(rs.fields("Remark")) & vbCrLf
                rs.MoveNext()
            Loop
        End If

        rs = db.OpenQueryDef("QOverlapped_Risk", adOpenForwardonly, ANO)
        If Not rs.Eof Then
            StrMsg = StrMsg & "One or more main risk have their period overlapping each other." & vbCrLf
        End If

        rs = db.OpenQueryDef("QMissing_Risk", adOpenForwardonly, ANO)
        If Not rs.Eof Then
            StrMsg = StrMsg & "Missing Main Risk Coverage Within Period. " & vbCrLf
        End If

        rs = db.OpenQueryDef("QMissing_Interest", adOpenForwardonly, ANO)
        If rs.Eof Then
            StrMsg = StrMsg & "Missing Main Interest. " & vbCrLf
        End If

        If StrMsg <> "" Then
            StrMsg = StrMsg & "Please correct them first !" & vbCrLf
            GoTo errmsg
        End If

        PreCalculateConditionsOK = True
        Exit Function
errmsg:
        PreCalculateConditionsOK = False
    End Function

    Private Function Copy_Master_ICoverNOC(ByVal LANO As Long, ByVal ANO As Long, ByVal INO As Long, ByVal TOI As String, Optional ByVal TPrefix As String = "") As Boolean
        Dim rsSrc As RemoteSet
        Dim rsDst As RemoteSet

        On Error GoTo errmsg

        If Not db.Execute("Delete from " & TPrefix & "ICoverNOC Where INO=" & INO) Then GoTo errmsg

        rsSrc = db.OpenRemoteSet("Select I2.* from " & TPrefix & "ICover I1, " & TPrefix & "ICoverNOC I2 Where I2.INO=I1.INO and I2.ANO=I1.ANO and I1.ANO=" & LANO & " and I1.TOI='" & TOI & "'")
        If Not rsSrc.Eof Then
            rsDst = db.OpenRemoteSet("Select * from " & TPrefix & "ICoverNOC Where 1<>1")
            Do While Not rsSrc.Eof
                rsDst.AddNew()
                If Not rsDst.PutRecord(rsSrc.GetRecord()) Then GoTo errmsg
                rsDst.fields("INO") = INO
                rsDst.fields("ANO") = ANO
                If Not rsDst.Update Then GoTo errmsg
                rsSrc.MoveNext()
            Loop
        End If
        Copy_Master_ICoverNOC = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Copy_Master_ICoverNOC = False
    End Function

    Private Function GetCertificateNo(ByVal CNO As Long, Optional ByVal CertNum As Long = 0) As Long
        Try
            Dim rs As RemoteSet
            Dim rsAcc As RemoteSet
            Dim CertificateF As Boolean

            If Not db.GetLockedObject("CERTNUM" & CNO, True) Then Throw New Exception(db.ErrDesc)
            rs = db.OpenRemoteSet("Select CertNum from Cover Where CNO=" & CNO)
            If CertNum = 0 Or CertNum > toval(rs.fields("CertNum")) Then
                CertificateF = True
            Else
                rsAcc = db.OpenRemoteSet("Select Top 1 CertificateNo from Acceptance Where CertificateNo='" & Format(CertNum, "000000") & "' and CNO=" & CNO)
                If Not rsAcc.Eof Then ' Already Used
                    Throw New Exception("Duplicate Certificate No !")
                Else
                    CertificateF = False
                End If
            End If
            ' Get Certificate Number
            If CertificateF Then
                If CertNum <= toval(rs.fields("CertNum")) Then
                    CertNum = toval(rs.fields("CertNum")) + 1
                End If

                If Not db.Execute("Update Cover Set CertNum=" & CertNum & " Where CNO=" & CNO) Then Throw New Exception(db.ErrDesc)
            End If
            If Not db.ReleaseLockedObject("CERTNUM" & CNO) Then Throw New Exception(db.ErrDesc)
            GetCertificateNo = CertNum

        Catch ex As Exception
            StrMsg = ex.Message
            GetCertificateNo = 0
        Finally
            If db.CheckLockedObject("CERTNUM" & CNO) Then db.ReleaseLockedObject("CERTNUM" & CNO)
        End Try
    End Function

