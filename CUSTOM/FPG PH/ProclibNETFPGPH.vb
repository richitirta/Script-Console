    Private Function Facultative_Gross_Premium(ByVal SANO As Long, ByVal ANO As Long, ByVal FID As String, ByVal CCode As String, ByVal SDate As Date, ByVal EDate As Date, ByVal RCode As String, ByVal Adjustable As Boolean) As Double
        Dim rs As RemoteSet
