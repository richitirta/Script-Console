                rsd.fields("OrderNo") = tostr(rss.fields("OrderNo"))
                rsd.fields("ShortDesc") = tostr(rss.fields("ShortDesc"))
                rsd.fields("Description") = tostr(rss.fields("Description"))
                rsd.fields("ShortDesc_1") = tostr(rss.fields("ShortDesc_1"))
                rsd.fields("Description_1") = tostr(rss.fields("Description_1"))
                If Not rsd.Update Then GoTo errmsg
            End If
            rss.MoveNext()
        Loop

        ' Update Banker Clause
        If (BankersClause <> "" Or NewBankersClause <> "") And BankersClause <> NewBankersClause Then
            Dim SQL As String
            If Trim(BankersClause) <> "" Then
                SQL = "Update AccCla Set Description=replace(cast(Description as varchar(8000)),'" & BankersClause & "','<<BANKERS CLAUSE>>'), Description_1=replace(cast(Description_1 as varchar(8000)),'" & BankersClause & "','<<BANKERS CLAUSE>>') from " & tPrefix & "AccCla AccCla Where ANO=" & ANO
                If Not db.Execute(SQL) Then GoTo errmsg
            End If
            If Trim(NewBankersClause) <> "" Then
                SQL = "Update AccCla Set Description=replace(cast(Description as varchar(8000)),'<<BANKERS CLAUSE>>','" & NewBankersClause & "'), Description_1=replace(cast(Description_1 as varchar(8000)),'<<BANKERS CLAUSE>>','" & NewBankersClause & "') from " & tPrefix & "AccCla AccCla Where ANO=" & ANO
                If Not db.Execute(SQL) Then GoTo errmsg
            End If
        End If

        ' Scheme Payor to Alternate Payor
        ' Get Virtual Account No. 
        Dim V_AccountNo As String = ""
        Dim V_BankName As String = ""
        If V_Bank <> "" Then
            If Not Get_Scheme_Virtual_Account(ANO, V_Bank, V_AccountNo, V_BankName) Then
                StrMsg = "Can't Allocate Virtual Account Number for Bank Code : " & V_Bank & " !"
                GoTo errmsg
            End If
        End If

        TOI = ""
        i = 1
        rss = db.OpenRemoteSet("Select * from " & tPrefix & "Scheme_TransactionDet Where TRNO=" & TrNo & " Order by TOI")
        rsd = db.OpenRemoteSet("Select * from " & tPrefix & "ICoverDet Where 1<>1")
        Do While Not rss.Eof
            If TOI <> rss.fields("TOI") Then
                TOI = rss.fields("TOI")
                i = 1
                rs = db.OpenRemoteSet("Select * from " & tPrefix & "ICover Where ANO=" & ANO & " and TOI='" & TOI & "'")
            End If
            If Not rs.Eof Then
                rsd.AddNew()
                rsd.fields("ANO") = ANO
                rsd.fields("DPERIOD") = 0
                rsd.fields("INO") = rs.fields("INO")
                rsd.fields("OrderNo") = i
                rsd.fields("Description") = rss.fields("Description")
                rsd.fields("QTY") = rss.fields("QTY")
                rsd.fields("UNIT") = rss.fields("UNIT")
                rsd.fields("UVALUE") = rss.fields("UVALUE")
                rsd.fields("AMOUNT") = rss.fields("AMOUNT")
                If Not rsd.Update Then
                    StrMsg = "Interest Detail : " & rsd.ErrDesc
                    GoTo errmsg
                End If
            End If

            i = i + 1
            rss.MoveNext()
        Loop

        If Not rs.Eof Then
            rsd = db.OpenRemoteSet("Select * from " & tPrefix & "ACCCA Where ANO=" & ANO)
            If rsd.Eof Then
                rsd.AddNew()
            Else
                rsd.Edit()
            End If
            db.backup_record(rs, rsd)
            rsd.fields("ANO") = ANO
            If Not rsd.Update Then
                StrMsg = "Correspondence Address : " & rsd.ErrDesc
                GoTo errmsg
            End If
        End If

        rs = db.OpenRemoteSet("Select * from " & tPrefix & "Scheme_CA Where TRNO=" & TrNo)
        If Not rs.Eof Then
            rsd = db.OpenRemoteSet("Select * from " & tPrefix & "ACCCA Where ANO=" & ANO)
            If rsd.Eof Then
                rsd.AddNew()
            Else
                rsd.Edit()
            End If
            db.backup_record(rs, rsd)
            rsd.fields("ANO") = ANO
            If Not rsd.Update Then
                StrMsg = "Correspondence Address : " & rsd.ErrDesc
                GoTo errmsg
            End If
        End If

        rs = db.OpenRemoteSet("Select * from " & tPrefix & "Scheme_Payor Where TrNo=" & TrNo)
        If Not rs.Eof Or V_AccountNo <> "" Then
            If rs.Eof Then
                rs = db.OpenRemoteSet("Select * from " & tPrefix & "Payor Where ANO=" & LANO)
            End If
            If Not rs.Eof Then
                rsd = db.OpenRemoteSet("Select * from " & tPrefix & "APayor Where 1<>1")
                rsd.AddNew()
                db.backup_record(rs, rsd)
                rsd.fields("ANO") = ANO

                ' Virtual Account
                If V_AccountNo <> "" Then
                    rsd.fields("RefType") = "VIRTUAL"
                    rsd.fields("AccountNo") = V_AccountNo
                    rsd.fields("Bank") = V_Bank
                    rsd.fields("BankName") = V_BankName
                End If

                If Not rsd.Update Then
                    StrMsg = "Alternate Payor : " & rsd.ErrDesc
                    GoTo errmsg
                End If

                rs = db.OpenRemoteSet("Select * from " & tPrefix & "Scheme_PayorDet Where TrNo=" & TrNo)
                If Not rs.Eof Or V_AccountNo <> "" Then
                    If rs.Eof Then
                        rs = db.OpenRemoteSet("Select * from " & tPrefix & "PayorDet Where ANO=" & LANO)
                    End If
                    If Not rs.Eof Then
                        rsd = db.OpenRemoteSet("Select * from " & tPrefix & "APayorDet Where 1<>1")
                        rsd.AddNew()
                        db.backup_record(rs, rsd)
                        rsd.fields("ANO") = ANO
                        If Not rsd.Update Then
                            StrMsg = "Alternate Payor Detail : " & rsd.ErrDesc
                            GoTo errmsg
                        End If
                    End If
                End If
            End If
        End If

        If AgentID <> "" Then
            rsd = db.OpenRemoteSet("Select * from " & tPrefix & "AAccBS Where ANO=" & ANO & " and ID='" & AgentID & "' and BSType='A'")
            If rsd.Eof Then
                rsd.AddNew()
                rsd.fields("ANO") = ANO
                rsd.fields("ID") = AgentID
                rsd.fields("BSType") = "A"
                If rsd.fields("OBSType") = "" Then rsd.fields("OBSType") = rsd.fields("BSType")
            Else
                rsd.Edit()
            End If
            rsd.fields("Fee") = AgentFee
            rsd.fields("FeeAmount") = AgentFeeAmount
            rsd.fields("LUserID") = db_user
            rsd.fields("LDate") = Today.Date
            If Not rsd.Update Then GoTo errmsg
        End If

        If OtherID <> "" Then
            rsd = db.OpenRemoteSet("Select * from " & tPrefix & "AAccBS Where ANO=" & ANO & " and ID='" & OtherID & "' and BSType='O'")
            If rsd.Eof Then
                rsd.AddNew()
                rsd.fields("ANO") = ANO
                rsd.fields("ID") = OtherID
                rsd.fields("BSType") = "O"
                If rsd.fields("OBSType") = "" Then rsd.fields("OBSType") = rsd.fields("BSType")
            Else
                rsd.Edit()
            End If
            rsd.fields("Fee") = OtherFee
            rsd.fields("FeeAmount") = OtherFeeAmount
            rsd.fields("LUserID") = db_user
            rsd.fields("LDate") = Today.Date
            If Not rsd.Update Then GoTo errmsg
        End If

        If BSID <> "" Then
            rsd = db.OpenRemoteSet("Select * from " & tPrefix & "AAccBS Where ANO=" & ANO & " and ID='" & BSID & "' and BSType='" & IIf(BSType = "", "B", BSType) & "'")
            If rsd.Eof Then
                rsd.AddNew()
                rsd.fields("ANO") = ANO
                rsd.fields("ID") = BSID
                rsd.fields("BSType") = IIf(BSType = "", "B", BSType)
                If rsd.fields("OBSType") = "" Then rsd.fields("OBSType") = rsd.fields("BSType")
            Else
                rsd.Edit()
            End If
            rsd.fields("Fee") = BSFee
            rsd.fields("FeeAmount") = BSFeeAmount
            rsd.fields("UPFee") = BSUPFee
            rsd.fields("UPFeeAmount") = BSUPFeeAmount
            rsd.fields("LUserID") = db_user
            rsd.fields("LDate") = Today.Date
            If Not rsd.Update Then GoTo errmsg
        End If

        If OPID <> "" Then
            If OPFDID <> "" Then
                rs = db.OpenRemoteSet("Select top 1 FDID, Description from FDTAB F Where ATYPE ='N' and LEFT(FDType,1) = 'O' and currency = '" & CCY & "' and FDID='" & OPFDID & "'")
            Else
                rs = db.OpenRemoteSet("Select top 1 FDID, Description from FDTAB F Where ATYPE ='N' and LEFT(FDType,1) = 'O' and currency = '" & CCY & "'")
            End If
            If rs.Eof Then
                StrMsg = "OP Fee Not Found !"
                GoTo errmsg
            End If
            OPFDID = rs.fields("FDID")

            rsd = db.OpenRemoteSet("Select * from " & tPrefix & "AccFD Where 1<>1")
            rsd.AddNew()
            rsd.fields("ANO") = ANO
            rsd.fields("ID") = OPID
            rsd.fields("FDID") = OPFDID
            rsd.fields("Currency") = CCY
            rsd.fields("Amount") = OPFeeAmount
            rsd.fields("AmountPCT") = OPFee
            rsd.fields("Remark") = rs.fields("Description")
            rsd.fields("PolicyYear") = 0
            rsd.fields("ContributionF") = True
            rsd.fields("CessionF") = False
            rsd.fields("LUserID") = db_user
            rsd.fields("LDate") = Today.Date
            rsd.fields("AutoGeneratedF") = False
            If Not rsd.Update Then GoTo errmsg
        End If

        ' Cleansing Risk Coverage
        If Not db.Execute("Delete RCover FROM #RCover RCover WHERE RCover.ANO=" & ANO & " and Not Exists (Select RateCov.Code from RateCov, " & tPrefix & "ICover ICover, PClass Where ICover.SI<>0 and RateCov.Code=RCover.Code and PClass.TOI=ICover.TOI and PClass.TOR=RateCov.TOR and RCover.ANO=ICover.ANO)") Then
            StrMsg = "Risk Cover : " & db.ErrDesc
            GoTo errmsg
        End If

        ' Adjustment for Premium Rate with Additional Interest 
        rsd = db.OpenRemoteSet("Select * from #RCover RCover Where RCover.ANO=" & ANO & " and RCover.Category='M' and InclAddInterestF=1")
        Do While Not rsd.Eof
            Dim TPremium As Double
            If rsd.fields("Unit") = "F" Then
                TPremium = toval(rsd.fields("Rate"))
            ElseIf rsd.fields("Unit") = "C" Then
                TPremium = (toval(rsd.fields("Rate")) / 100 * ((toval(rsd.fields("PCTLOSS")) + toval(rsd.fields("PADDITION"))) / 100 * toval(rsd.fields("Loading")))) * TSI
            Else
                TPremium = (toval(rsd.fields("Rate")) / 1000 * ((toval(rsd.fields("PCTLOSS")) + toval(rsd.fields("PADDITION"))) / 100 * toval(rsd.fields("Loading")))) * TSI
            End If

            Dim SQL As String
            SQL = "Select DISTINCT RCOVER.CODE, RCOVER.SDATE, RCOVER.EDATE, RCOVER.UNIT, RCOVER.RATE, RCOVER.RATEMAX, RCOVER.PCTLOSS, RCOVER.PADDITION, RCOVER.LOADING, ICOVER.TOI, ICOVER.SI"
            SQL = SQL & " FROM RCLASS, RATECOV, #RCOVER RCOVER, PCLASS, " & tPrefix & "ICOVER ICover, TOI, " & tPrefix & "ACCEPTANCE ACCEPTANCE, COVER"
            SQL = SQL & " WHERE ACCEPTANCE.ANO = " & ANO
            SQL = SQL & " And COVER.CNO=ACCEPTANCE.CNO    "
            SQL = SQL & " And RCLASS.TOC=ACCEPTANCE.TOC    "
            SQL = SQL & " And RCOVER.ANO=ACCEPTANCE.ANO    "
            SQL = SQL & " And ICOVER.ANO=ACCEPTANCE.ANO    "
            SQL = SQL & " And RATECOV.CODE=RCOVER.CODE    "
            SQL = SQL & " And RCLASS.TOR=RATECOV.TOR    "
            SQL = SQL & " And PCLASS.TOR=RATECOV.TOR    "
            SQL = SQL & " And PCLASS.TOI=ICOVER.TOI    "
            SQL = SQL & " And TOI.TOI=ICOVER.TOI    "
            SQL = SQL & " And ICover.Category='A' and RCover.Category='A'"
            SQL = SQL & " And RCover.SDate='" & Format(rsd.fields("SDate"), "MM/DD/YYYY") & "'"
            SQL = SQL & " ORDER BY RCOVER.CODE, RCOVER.SDATE, RCOVER.EDATE, RCOVER.RATE, ICOVER.TOI, ICOVER.SI"

            rs = db.OpenRemoteSet(SQL)
            Do While Not rs.Eof
                If rs.fields("Unit") = "F" Then
                    TPremium = TPremium - toval(rs.fields("Rate"))
                ElseIf rs.fields("Unit") = "C" Then
                    TPremium = TPremium - (toval(rs.fields("Rate")) / 100 * ((toval(rs.fields("PCTLOSS")) + toval(rs.fields("PADDITION"))) / 100 * toval(rs.fields("Loading")))) * toval(rs.fields("SI"))
                Else
                    TPremium = TPremium - (toval(rs.fields("Rate")) / 1000 * ((toval(rs.fields("PCTLOSS")) + toval(rs.fields("PADDITION"))) / 100 * toval(rs.fields("Loading")))) * toval(rs.fields("SI"))
                End If
                rs.MoveNext()
            Loop

            rsd.Edit()

            If rsd.fields("Unit") = "F" Then
                rsd.fields("Rate") = TPremium
            ElseIf rsd.fields("Unit") = "C" Then
                rsd.fields("Rate") = TPremium / (((toval(rsd.fields("PCTLOSS")) + toval(rsd.fields("PADDITION"))) / 100 * toval(rsd.fields("Loading"))) * TSI) * 100
            Else
                rsd.fields("Rate") = TPremium / (((toval(rsd.fields("PCTLOSS")) + toval(rsd.fields("PADDITION"))) / 100 * toval(rsd.fields("Loading"))) * TSI) * 1000
            End If
            If Not rsd.Update Then GoTo errmsg
            rsd.MoveNext()
        Loop

        ' Floating Rate Adjustment (in %)
        If toval(rsTr.fields("Rate")) <> 0 Then
            Dim TotalRateMin As Double = 0
            Dim TotalRateMax As Double = 0
            Dim TRate As Double
            TRate = toval(rsTr.fields("Rate"))

            Dim SQL As String
            SQL = "Select DISTINCT RCOVER.CODE, RCOVER.SDATE, RCOVER.EDATE, RCOVER.UNIT, RCOVER.RATE, RCOVER.RATEMAX, RCOVER.PCTLOSS, RCOVER.PADDITION, RCOVER.LOADING, ICOVER.TOI, ICOVER.SI"
            SQL = SQL & " FROM RCLASS, RATECOV, #RCOVER RCOVER, PCLASS, " & tPrefix & "ICOVER ICOVER, TOI, " & tPrefix & "ACCEPTANCE ACCEPTANCE, COVER"
            SQL = SQL & " WHERE ACCEPTANCE.ANO = " & ANO
            SQL = SQL & " And COVER.CNO=ACCEPTANCE.CNO    "
            SQL = SQL & " And RCLASS.TOC=ACCEPTANCE.TOC    "
            SQL = SQL & " And RCOVER.ANO=ACCEPTANCE.ANO    "
            SQL = SQL & " And ICOVER.ANO=ACCEPTANCE.ANO    "
            SQL = SQL & " And RATECOV.CODE=RCOVER.CODE    "
            SQL = SQL & " And RCLASS.TOR=RATECOV.TOR    "
            SQL = SQL & " And PCLASS.TOR=RATECOV.TOR    "
            SQL = SQL & " And PCLASS.TOI=ICOVER.TOI    "
            SQL = SQL & " And TOI.TOI=ICOVER.TOI    "
            SQL = SQL & " ORDER BY RCOVER.CODE, RCOVER.SDATE, RCOVER.EDATE, RCOVER.RATE, ICOVER.TOI, ICOVER.SI"

            rsd = db.OpenRemoteSet(SQL)
            Do While Not rsd.Eof
                If toval(rsd.fields("Rate")) = toval(rsd.fields("RateMax")) AndAlso TSI <> 0 Then
                    Dim TPremium As Double
                    If rsd.fields("Unit") = "F" Then
                        TPremium = toval(rsd.fields("Rate"))
                    ElseIf rsd.fields("Unit") = "C" Then
                        TPremium = (toval(rsd.fields("Rate")) / 100 * ((toval(rsd.fields("PCTLOSS")) + toval(rsd.fields("PADDITION"))) / 100 * toval(rsd.fields("Loading")))) * toval(rsd.fields("SI"))
                    Else
                        TPremium = (toval(rsd.fields("Rate")) / 1000 * ((toval(rsd.fields("PCTLOSS")) + toval(rsd.fields("PADDITION"))) / 100 * toval(rsd.fields("Loading")))) * toval(rsd.fields("SI"))
                    End If

                    TRate = TRate - TPremium / TSI * 100
                Else
                    TotalRateMin = TotalRateMin + toval(rsd.fields("Rate")) * ((toval(rsd.fields("PCTLOSS")) + toval(rsd.fields("PADDITION"))) / 100 * toval(rsd.fields("Loading")))
                    TotalRateMax = TotalRateMax + toval(rsd.fields("RateMax")) * ((toval(rsd.fields("PCTLOSS")) + toval(rsd.fields("PADDITION"))) / 100 * toval(rsd.fields("Loading")))
                End If
                rsd.MoveNext()
            Loop

            Dim VarPCT As Double
            VarPCT = (TRate - TotalRateMin) / (TotalRateMax - TotalRateMin)

            rsd = db.OpenRemoteSet("Select * from #RCover RCover Where ANO = " & ANO)
            Do While Not rsd.Eof
                If Not (toval(rsd.fields("Rate")) = toval(rsd.fields("RateMax")) AndAlso TSI <> 0) Then
                    rsd.Edit()
                    Rate = toval(rsd.fields("Rate")) + (toval(rsd.fields("RateMax")) - toval(rsd.fields("Rate"))) * VarPCT
                    If toval(Rate, 6) < toval(rsd.fields("Rate"), 6) Or toval(Rate, 6) > toval(rsd.fields("RateMax"), 6) Then
                        StrMsg = "Risk Cover : Rate-" & rsd.fields("Code") & " (" & Format(Rate, "0.0000") & ") is outside Minimum or Maximum Rate (" & Format(toval(rsd.fields("Rate")), "0.0000") & " and " & Format(toval(rsd.fields("RateMax")), "0.0000") & ") !"
                        GoTo errmsg
                    End If
                    rsd.fields("Rate") = Rate
                    If Not rsd.UpdateRow Then
                        StrMsg = "Risk Cover : " & rsd.ErrDesc
                        GoTo errmsg
                    End If
                End If
                rsd.MoveNext()
            Loop
            rsd.MoveFirst()
            If Not rsd.Update Then
                StrMsg = "Risk Cover : " & rsd.ErrDesc
                GoTo errmsg
            End If
        End If

        If Not db.Execute("Alter Table #RCover Drop Column RateMax") Then GoTo errmsg
        If Not db.Execute("Alter Table #RCover Drop Column InclAddInterestF") Then GoTo errmsg

        rsd = db.OpenRemoteSet("Select * from " & tPrefix & "RCover Where 1<>1")
        rss = db.OpenRemoteSet("Select * from #RCover Where ANO=" & ANO)
        Do While Not rss.Eof
            rsd.AddNew()
            If Not rsd.PutRecord(rss.GetRecord()) Then GoTo errmsg

            If Not RoundUpF Then
                If Voyage Then ' Voyage
                    rsd.fields("PCalc") = "F"
                ElseIf pTerm <> 0 Then
                    If Day(rsd.fields("SDate")) <> Day(rsd.fields("EDate")) Then
                        rsd.fields("PCalc") = "P"
                    Else
                        Select Case DateDiff(DateInterval.Month, rsd.fields("SDate"), rsd.fields("EDate"))
                            Case Is < pTerm
                                rsd.fields("PCalc") = "P"
                            Case pTerm
                                If DateAdd(DateInterval.Month, pTerm, rsd.fields("SDate")) <> rsd.fields("EDate") Then
                                    rsd.fields("PCalc") = "P"
                                Else
                                    rsd.fields("PCalc") = "F"
                                End If
                            Case Is > pTerm
                                If (DateDiff(DateInterval.Month, rsd.fields("SDate"), rsd.fields("EDate")) \ pTerm) * pTerm <> DateDiff(DateInterval.Month, rsd.fields("SDate"), rsd.fields("EDate")) Then
                                    rsd.fields("PCalc") = "P"
                                Else
                                    rsd.fields("PCalc") = "F"
                                End If
                        End Select
                    End If
                End If

                If rsd.fields("PCalc") = "P" Then
                    If Not ExclusiveF AndAlso STime < ETime AndAlso rsd.fields("EDate") = EDate Then
                        rsd.fields("Rate") = toval(rsd.fields("Rate")) / Premium_Calc_Prorata(rsd.fields("SDate"), DateAdd(DateInterval.Day, 1, rsd.fields("EDate")), DaysProrata, pTerm, PPeriod, "")
                    Else
                        rsd.fields("Rate") = toval(rsd.fields("Rate")) / Premium_Calc_Prorata(rsd.fields("SDate"), rsd.fields("EDate"), DaysProrata, pTerm, PPeriod, "")
                    End If
                End If
            End If

            If Not rsd.Update Then GoTo errmsg

            ' Creating Default Rate Table Clauses
            Dim rss1 As RemoteSet
            Dim rsd1 As RemoteSet
            rss1 = db.OpenRemoteSet("Select * from RateTabCla Where Code='" & rss.fields("Code") & "'")
            If Not rss1.Eof Then
                Do While Not rss1.Eof
                    rsd1 = db.OpenRemoteSet("Select * from " & tPrefix & "AccCLA Where ANO=" & ANO & " and OrderNo='" & tostr(rss1.fields("OrderNo")) & "'")
                    If rsd1.Eof Then
                        rsd1.AddNew()
                        rsd1.fields("ANO") = ANO
                        rsd1.fields("Section") = tostr(rss1.fields("Section"))
                        rsd1.fields("OrderNo") = tostr(rss1.fields("OrderNo"))
                        rsd1.fields("ShortDesc") = tostr(rss1.fields("ShortDesc"))
                        rsd1.fields("Description") = tostr(rss1.fields("Description"))
                        rsd1.fields("ShortDesc_1") = tostr(rss1.fields("ShortDesc_1"))
                        rsd1.fields("Description_1") = tostr(rss1.fields("Description_1"))
                        If Not rsd1.Update Then GoTo errmsg
                    End If
                    rss1.MoveNext()
                Loop

                If tPrefix = "" Then
                    ' Insert into Section Table
                    Dim SQL As String
                    SQL = "Insert into AccSection(ANO, Section, ShortDesc, Description)"
                    SQL = SQL & " Select DISTINCT A2.ANO, A2.Section, S.ShortDesc, CAST(S.Description AS VARCHAR(8000))"
                    SQL = SQL & " from Acceptance A1 "
                    SQL = SQL & " Inner Join AccCla A2 on (A2.ANO=A1.ANO)"
                    SQL = SQL & " Inner join Section S on (S.TOC=A1.TOC and S.Section=A2.Section)"
                    SQL = SQL & " Left join AccSection A3 on (A3.ANO=A1.ANO and A3.Section=S.section)"
                    SQL = SQL & " Where A1.ANO=" & ANO & " and A3.Section Is null"
                    If Not db.Execute(SQL) Then GoTo errmsg
                End If
            End If

            rss.MoveNext()
        Loop
        rsd.CloseRemoteSet()
        rss.CloseRemoteSet()

        If tPrefix = "" Then
            rs = db.OpenRemoteSet("Select top 1 ANO from RArrDet Where ANO=" & ANO)
            If rs.Eof Then If Not Copy_Facultative_Master(LANO, ANO) Then GoTo errmsg
        End If

        If Not Premium_Calc(ANO, tPrefix, , Premium, "", MinNetPremium, MinGrossPremium) Then
            StrMsg = "Failed in Premium Calculation !"
            GoTo errmsg
        End If

        If HoldMessage <> "" Then
            rsd = db.OpenRemoteSet("Select * from " & tPrefix & "RArrHeader Where ANO=" & ANO)
            rsd.Edit()
            rsd.fields("HoldF") = True
            If rsd.fields("Message") <> "" Then
                HoldMessage = rsd.fields("Message") & Chr(13) & Chr(10) & HoldMessage
            End If
            rsd.fields("Message") = HoldMessage
            If Not rsd.Update Then
                StrMsg = "Risk Arrangement : " & rsd.ErrDesc
                GoTo errmsg
            End If
        End If

        If BlanketNo <> "" Then
            rsd = db.OpenRemoteSet("Select * from Blanket Where BlanketType='POLICY' and BlanketTypeVer=" & BlanketTypeVer & " and BlanketNo='" & BlanketNo & "'")
            If rsd.Eof Then
                rsd.AddNew()
                rsd.fields("BlanketType") = "POLICY"
                rsd.fields("BlanketTypeVer") = BlanketTypeVer
                rsd.fields("BlanketNo") = BlanketNo
                rsd.fields("UserID") = db_user
                rsd.fields("CDate") = Today.Date
            Else
                If rsd.fields("Status") <> "0" And rsd.fields("DocNo") <> "" And rsd.fields("DocNo") <> PolicyNo & "-" & CertificateNo Then
                    StrMsg = "Blanket Number Already Used by Another Policy/Certificate !"
                    GoTo errmsg
                End If
                rsd.Edit()
            End If
            rsd.fields("pStatus") = tostr(rsd.fields("Status"))
            rsd.fields("Status") = 1  ' Allocated
            rsd.fields("DocNo") = PolicyNo & "-" & CertificateNo
            rsd.fields("Remarks") = ""
            rsd.fields("LUserID") = db_user
            rsd.fields("LDate") = Today.Date
            If Not rsd.Update Then GoTo errmsg
        End If

        rsTr.Edit()
        rsTr.fields("Status") = "V"  ' Verified
        rsTr.fields("ANO") = ANO
        rsTr.fields("CNO") = CNO
        rsTr.fields("LANO") = LANO
        rsTr.fields("CertificateNo") = CertificateNo
        rsTr.fields("Premium") = Premium
        rsTr.fields("FDAMOUNT_1") = FDAMOUNT_1
        rsTr.fields("FDAMOUNT_2") = FDAMOUNT_2
        If Not rsTr.Update Then
            StrMsg = "Failed To Save : " & rsTr.ErrDesc
            GoTo errmsg
        End If

        If Not OverwriteRefPremiumF Then
            If toval(rsTr.fields("REF_PREMIUM")) <> 0 AndAlso Abs(RoundCCY(toval(rsTr.fields("REF_PREMIUM")), CCY) - RoundCCY(toval(rsTr.fields("PREMIUM")), CCY)) > toval(GetAppSetting("NominalTolerance")) Then
                StrMsg = "Check Premium Calculation ! Ref Premium : " & Format(toval(rsTr.fields("REF_PREMIUM")), "###,###,##0") & ", by System : " & Format(Premium, "###,###,##0")
                GoTo errmsg
            End If
        Else
            ' Update Premium from Client Reference
            If toval(rsTr.fields("REF_PREMIUM")) <> 0 Then
                If Not db.Execute("Update PCalc Set Gross=" & tovalSF(toval(rsTr.fields("REF_PREMIUM"))) & ", Description='-' from PCalc Where ANO=" & ANO) Then GoTo errmsg
            End If
        End If

        If Not db.Execute("Drop Table #RCover") Then GoTo errmsg
        Scheme_Verify = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        If Not db.Execute("Drop Table #RCover") Then GoTo errmsg
        Scheme_Verify = False
    End Function
    Private Function Convert_FLDID_Into_Array(ByVal FLDID As String) As String()
        Dim SFLDID() As String
        Dim Separator As String

        If InStr(FLDID, "|") <> 0 Then
            Separator = "|"
        ElseIf InStr(FLDID, "/") <> 0 Then
            Separator = "/"
        Else
            Separator = ""
        End If
        Dim i As Integer
        i = 0
        Do While Separator <> ""
            ReDim Preserve SFLDID(i)

            SFLDID(i) = Trim(Mid(FLDID, 1, InStr(FLDID, Separator) - 1))

            FLDID = Mid(FLDID, InStr(FLDID, Separator) + 1, Len(FLDID))
            If InStr(FLDID, "|") <> 0 Then
                Separator = "|"
            ElseIf InStr(FLDID, "/") <> 0 Then
                Separator = "/"
            Else
                Separator = ""
            End If
            i = i + 1
        Loop
        ReDim Preserve SFLDID(i)
        SFLDID(i) = FLDID
        Convert_FLDID_Into_Array = SFLDID
    End Function
    Private Function Get_Scheme_Virtual_Account(ByVal ANO As Long, ByVal V_Bank As String, ByRef V_AccountNo As String, ByRef V_BankName As String) As Boolean
        Dim rsV As RemoteSet
        On Error GoTo errmsg
        rsV = db.OpenQueryDef("QGet_Scheme_Virtual_Account", adOpenForwardonly, ANO, V_Bank)
        V_AccountNo = tostr(rsV.fields("AccountNo"))
        V_BankName = tostr(rsV.fields("BankName"))

        Dim VID As Long = toval(rsV.fields("VID"))
        Dim A_PolicyNo As String = rsV.fields("PolicyNo") & "-" & rsV.fields("CertificateNo")
        Dim PID As String = tostr(rsV.fields("ID"))
        Dim Branch As String = tostr(rsV.fields("Branch"))
        Dim TOC As String = tostr(rsV.fields("TOC"))
        Dim PolicyType As String = tostr(rsV.fields("PolicyType"))
        Dim Segment As String = tostr(rsV.fields("Segment"))
        Dim ADate As Date = Today.Date

        If V_AccountNo = "" AndAlso toval(rsV.fields("AutoGeneratedF")) AndAlso Not toval(rsV.fields("VAccountMF")) Then
            V_AccountNo = Generate_Virtual_Account(VID, "Policy", A_PolicyNo, PID, V_Bank, V_BankName, "", Branch, TOC, PolicyType, Segment, ADate)
        End If

        If V_AccountNo = "" OrElse Not db.Execute("Update V1 Set AllocatedF=1, A_PolicyNo='" & A_PolicyNo & "' from VAccountD V1, VAccount V2 WHere V1.AllocatedF=0 and V2.VID=V1.VID and V1.AccountNo='" & V_AccountNo & "' and V2.VID='" & VID & "'") OrElse db.RecordsAffected = 0 Then
            GoTo errmsg
        End If
        Get_Scheme_Virtual_Account = True
        Exit Function
errmsg:        
        Get_Scheme_Virtual_Account = False
    End Function
    Private Function GetSchemeTC(ByVal schemeNo As String, ByVal coverage As String, ByVal ANO As Long, Optional tPrefix As String="") As Boolean
        Dim rss As RemoteSet
        Dim rsD As RemoteSet
        On Error GoTo errmsg
        rss = db.OpenRemoteSet("Select * from Scheme_Cla Where schemeNo='" & schemeNo & "' and Coverage='" & coverage & "'")
        If Not rss.Eof Then
            Do While Not rss.Eof
                rsD = db.OpenRemoteSet("Select * from " & tPrefix & "AccCLa Where ANO=" & ANO & " and Section='" & rss.fields("Section") & "' and OrderNo='" & rss.fields("OrderNo") & "'")
                If rsD.Eof Then
                    rsD.AddNew()
                    rsD.fields("ANO") = ANO
                    rsD.fields("Section") = rss.fields("Section")
                Else
                    rsD.Edit()
                End If
                rsD.fields("OrderNo") = tostr(rss.fields("OrderNo"))
                rsD.fields("ShortDesc") = tostr(rss.fields("ShortDesc"))
                rsD.fields("Description") = tostr(rss.fields("Description"))
                rsD.fields("ShortDesc_1") = tostr(rss.fields("ShortDesc_1"))
                rsD.fields("Description_1") = tostr(rss.fields("Description_1"))
                rsD.fields("OrgDescription") = ""
                rsD.fields("OrgDescription_1") = ""
                If Not rsD.Update Then GoTo errmsg
                rss.MoveNext()
            Loop
        End If

        rss = db.OpenRemoteSet("Select * from Scheme_Con Where schemeNo='" & schemeNo & "' and Coverage='" & coverage & "'")
        If Not rss.Eof Then
            Do While Not rss.Eof
                rsD = db.OpenRemoteSet("Select * from " & tPrefix & "AccCON Where ANO=" & ANO & " and Section='" & rss.fields("Section") & "' and OrderNo='" & rss.fields("OrderNo") & "'")
                If rsD.Eof Then
                    rsD.AddNew()
                    rsD.fields("ANO") = ANO
                    rsD.fields("Section") = rss.fields("Section")
                Else
                    rsD.Edit()
                End If
                rsD.fields("OrderNo") = tostr(rss.fields("OrderNo"))
                rsD.fields("ShortDesc") = tostr(rss.fields("ShortDesc"))
                rsD.fields("Description") = tostr(rss.fields("Description"))
                rsD.fields("ShortDesc_1") = tostr(rss.fields("ShortDesc_1"))
                rsD.fields("Description_1") = tostr(rss.fields("Description_1"))
                rsD.fields("OrgDescription") = ""
                rsD.fields("OrgDescription_1") = ""
                If Not rsD.Update Then GoTo errmsg
                rss.MoveNext()
            Loop
        End If

        rss = db.OpenRemoteSet("Select * from Scheme_EX Where schemeNo='" & schemeNo & "' and Coverage='" & coverage & "'")
        If Not rss.Eof Then
            Do While Not rss.Eof
                rsD = db.OpenRemoteSet("Select * from " & tPrefix & "AccEX Where ANO=" & ANO & " and Section='" & rss.fields("Section") & "' and OrderNo='" & rss.fields("OrderNo") & "'")
                If rsD.Eof Then
                    rsD.AddNew()
                    rsD.fields("ANO") = ANO
                    rsD.fields("Section") = rss.fields("Section")
                Else
                    rsD.Edit()
                End If
                rsD.fields("OrderNo") = tostr(rss.fields("OrderNo"))
                rsD.fields("ShortDesc") = tostr(rss.fields("ShortDesc"))
                rsD.fields("Description") = tostr(rss.fields("Description"))
                rsD.fields("ShortDesc_1") = tostr(rss.fields("ShortDesc_1"))
                rsD.fields("Description_1") = tostr(rss.fields("Description_1"))
                rsD.fields("OrgDescription") = ""
                rsD.fields("OrgDescription_1") = ""
                If Not rsD.Update Then GoTo errmsg
                rss.MoveNext()
            Loop
        End If
        GetSchemeTC = True
        Exit Function
errmsg:
        GetSchemeTC = False
    End Function
