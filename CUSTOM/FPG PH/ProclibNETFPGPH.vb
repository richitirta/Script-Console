                            rsCA.fields("Amount_OC") = toval(rsCA.fields("CAmount"))
                            rsCA.fields("Amount") = toval(rsCA.fields("CAmount"))
                            rsCA.fields("Rate") = 1
                            rsCA.fields("AdmNo") = -1
                            rsCA.fields("RCode") = RCode
                            rsCA.fields("TOR") = TOR
                            rsCA.fields("Currency_OC") = pCCY
                            rsCA.fields("Currency") = pCCY
                            If Not rsCA.UpdateRow Then GoTo errmsg
                        End If
                        rsCost.CloseRemoteSet()
                    End If

                    If Salvage <> 0 Then
                        rsCA.AddNew()
                        rsCA.fields("BizMapID") = BizMapID
                        rsCA.fields("MSCode") = MSCode
                        rsCA.fields("Source") = Source
                        rsCA.fields("CNO") = CNO
