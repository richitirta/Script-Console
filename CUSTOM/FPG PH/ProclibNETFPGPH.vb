                    If tostr(rsR.fields("Category")) = "C" Or tostr(rsR.fields("Category")) = "E" Then
                        Amount = toval(rs.fields("XL5AMOUNT"))
                        EAmount = toval(rs.fields("XL5EAMOUNT"))
                        RegNo = toval(PutClaRegAmount(EventNo, "X5", RYear, Amount, TAmount, EAmount, ETAmount))
                        If RegNo = -1 Then GoTo errmsg
                        rs.fields("XL5RegNo") = RegNo
                    End If
                End If

                ' Excess Of Loss #6
                If tostr(rs.fields("XL6ID")) <> "" Then
                    rsR = db.OpenQueryDef("QReinsurance", adOpenForwardonly, tostr(rs.fields("XL6ID")))
                    If tostr(rsR.fields("Category")) = "C" Or tostr(rsR.fields("Category")) = "E" Then
