                        PolicyRunOffF = toval(rs.fields("PolicyRunOffF"))
                        RDate = rsRA.fields("RDate")
                        NRDate = rsRA.fields("NRDate")
                        If PolicyRunOffF Then NRDate = rsIC.fields("EDate")
                        If DateDiff(DateInterval.Day, RDate, rsIC.fields("SDate")) >= 0 Then RDate = rsIC.fields("SDate")
                        If DateDiff(DateInterval.Day, NRDate, rsIC.fields("EDate")) <= 0 Then NRDate = rsIC.fields("EDate")
                        If DateDiff(DateInterval.Day, RDate, NRDate) < 0 Then NRDate = RDate
                        TProrata = Calc_Prorata(RDate, NRDate, rsIC.fields("SDate"), rsIC.fields("EDate"), PPeriod)
                        If TProrata = 0 Then Exit Do

                        If (RPremium = 0) OrElse (OnMinPremiumF <> toval(rs.fields("OnMinPremiumF"))) OrElse (OnNetPremiumF <> toval(rs.fields("OnNetPremiumF"))) OrElse (RComm <> rs.fields("Comm")) OrElse (RCommN <> rs.fields("CommN")) OrElse (RAddFee <> rs.fields("Fee")) Then
                            OnMinPremiumF = toval(rs.fields("OnMinPremiumF"))
                            OnNetPremiumF = toval(rs.fields("OnNetPremiumF"))
                            RComm = rs.fields("Comm")
                            RCommN = rs.fields("CommN")
                            RAddFee = rs.fields("Fee")
                            Reinsurance_Gross_Premium_Commission(ANO, tostr(rs.fields("RID")), tostr(rs.fields("ID")), tostr(rs.fields("DocNo")), CCode, SDate, EDate, RCode, AdjustableF, TSI, PSDate, RPremium, RCommission, RDiscount, RFee)
                        End If
                        Premium = TProrata * rs.fields("Share") / 100 * rsRA.fields("CShare") / 100 * toval(rsIC.fields("Share")) / 100 * RPremium * QTY
                        Commission = TProrata * rs.fields("Share") / 100 * rsRA.fields("CShare") / 100 * toval(rsIC.fields("Share")) / 100 * RCommission * QTY
                        Discount = TProrata * rs.fields("Share") / 100 * rsRA.fields("CShare") / 100 * toval(rsIC.fields("Share")) / 100 * RDiscount * QTY
                        Fee = TProrata * rs.fields("Share") / 100 * rsRA.fields("CShare") / 100 * toval(rsIC.fields("Share")) / 100 * RFee * QTY

                        ' Inward Business 
                        If toval(rs.fields("CommI")) <> 0 And (ISType = "R" Or ISType = "T") Then
                            Commission = Premium * (CommI + toval(rs.fields("CommI"))) / 100
                        End If

                        ' Shariah
                        If UjrohShariaF Then
                            Ujroh = Premium * toval(rs.fields("UJROHCEDANT")) / 100
                        Else
                            Premium = Premium * (100 - toval(rs.fields("UJROHCEDANT"))) / 100
