                    rsCA.fields("TOC") = TOC
                    rsCA.fields("Remarks") = AName
                    rsCA.fields("CAmount") = toval(rs.fields("Amount")) - toval(rs.fields("VAT"))
                    rsCA.fields("Amount_OC") = toval(rsCA.fields("CAmount"))
