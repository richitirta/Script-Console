    Private Function Save_Log_Object(ByVal LogName As String, ByVal LogKeyID As String, ByVal LogID As String, ByVal LogKeyIDExt1 As String, ByVal LogIDExt1 As String, ByVal LogKeyIDExt2 As String, ByVal LogIDExt2 As String, ByVal LogKeyIDExt3 As String, ByVal LogIDExt3 As String, ByVal ColName As String, ByVal ColValueOld As String, ByVal ColValueNew As String, ByVal Action As String) As Boolean
        Dim rs As RemoteSet
        On Error GoTo ErrMsg
        If LogName <> "" And (ColValueOld <> ColValueNew Or Action <> "Update") Then
            rs = db.OpenRemoteSet("Select * from SysLogObject Where 1<>1")
            rs.AddNew()
            rs.fields("LogName") = LogName
            rs.fields("LogKeyID") = LogKeyID
            rs.fields("LogID") = LogID
            rs.fields("LogKeyIDext1") = LogKeyIDExt1
            rs.fields("LogIDExt1") = LogIDExt1
            rs.fields("LogKeyIDExt2") = LogKeyIDExt2
            rs.fields("LogIDExt2") = LogIDExt2
            rs.fields("LogKeyIDExt3") = LogKeyIDExt3
            rs.fields("LogIDExt3") = LogIDExt3
            rs.fields("Last_Opr") = db_user
            rs.fields("Last_Update") = Today.Date
            rs.fields("Last_Time") = Time()
            rs.fields("ColName") = ColName
            rs.fields("ColValueOLD") = Trim(tostr(ColValueOld, 255))
            rs.fields("ColValueNew") = Trim(tostr(ColValueNew, 255))
            rs.fields("Action") = Action
            If Not rs.Update Then GoTo ErrMsg
        End If
        Save_Log_Object = True
        Exit Function
ErrMsg:
        StrMsg = StrError(StrMsg)
        Save_Log_Object = False
    End Function
    Private Function GetDocumentNumbering(ByVal AutoNum As String, ByVal PolicyType As String, ByVal ISType As String, ByVal PDate As Date, ByVal Branch As String, ByVal TOC As String, ByVal CT As String) As String
        Dim rs As RemoteSet
        Dim Prefix As String
        Dim InFix As String
        Dim Separator As String
        Dim BranchDigit As Integer
        Dim TOCDigit As Integer
        Dim CTDigit As Integer
        Branch = Get_Branch_Alias_By_TOC(Branch, TOC, TOC)
        rs = db.OpenRemoteSet("Select P.Prefix, P.InFix, P.Separator, P.BranchDigit, P.TOCDigit, P.CTDigit, P.CheckDigitF, I.Prefix as IPrefix, I.InFix as IInFix, S.ApplyAllPrefixInfixF, S.ApplyAllTOCDigitF from ISType I Left Join PolicyType P On (P.PolicyType='" & PolicyType & "'), SysTab S Where I.ISType='" & ISType & "'")
        If toval(rs.fields("ApplyAllPrefixInfixF")) Then
            Prefix = IIf(tostr(rs.fields("Prefix")) <> "", tostr(rs.fields("Prefix")), tostr(rs.fields("IPrefix")))
            InFix = IIf(tostr(rs.fields("InFix")) <> "", tostr(rs.fields("InFix")), tostr(rs.fields("IInFix")))
        Else
            Prefix = ""
            InFix = ""
        End If
        Separator = tostr(rs.fields("Separator"))
        If ISType <> "T" Then
            TOCDigit = toval(rs.fields("TOCDigit"))
            BranchDigit = toval(rs.fields("BranchDigit"))
            CTDigit = toval(rs.fields("CTDigit"))
            If toval(rs.fields("ApplyAllTOCDigitF")) Then
                GetDocumentNumbering = db.GetNextDocNo(AutoNum, PDate, IIf(Prefix <> "", Prefix & Separator, "") & IIf(BranchDigit <> 0, Mid(Branch, 1, BranchDigit) & Separator, "") & IIf(CTDigit <> 0, Mid(CT, 1, CTDigit) & Separator, "") & IIf(InFix <> "", InFix & Separator, "") & IIf(TOCDigit <> 0, Mid(TOC, 1, TOCDigit) & Separator, ""))
            Else
                GetDocumentNumbering = db.GetNextDocNo(AutoNum, PDate, IIf(Prefix <> "", Prefix & Separator, "") & IIf(BranchDigit <> 0, Mid(Branch, 1, BranchDigit) & Separator, "") & IIf(CTDigit <> 0, Mid(CT, 1, CTDigit) & Separator, "") & IIf(InFix <> "", InFix & Separator, "") & TOC & Separator)
            End If
        Else
            GetDocumentNumbering = db.GetNextDocNo(AutoNum, PDate, IIf(Prefix <> "", Prefix & Separator, "") & Branch & Separator & IIf(InFix <> "", InFix & Separator, "") & TOC & Separator)
        End If
    End Function
    Public Function Parsing_AccCla(ByVal ANO) As Boolean
        Dim rs As RemoteSet
        On Error GoTo errmsg
        rs = db.OpenRemoteSet("Select * from AccCla Where (charindex('<<',cast(description as varchar(4096)))<>0 or charindex('<<',cast(description_1 as varchar(4096)))<>0) and ANO=" & ANO)
        Do While Not rs.Eof
            rs.Edit()
            If tostr(rs.fields("OrgDescription")) = "" Then
                rs.fields("OrgDescription") = rs.fields("Description")
            End If
            If tostr(rs.fields("OrgDescription_1")) = "" Then
                rs.fields("OrgDescription_1") = rs.fields("Description_1")
            End If
            rs.fields("Description") = Parsing(ANO, rs.fields("OrgDescription"))
            rs.fields("Description_1") = Parsing(ANO, rs.fields("OrgDescription_1"))
            If Not rs.UpdateRow Then GoTo errmsg
            rs.MoveNext()
        Loop
        rs.MoveFirst()
        If Not rs.Eof Then If Not rs.Update Then GoTo errmsg
        Parsing_AccCla = True
        Exit Function
errmsg:
        Parsing_AccCla = False
    End Function


    Public Function Parsing(ByVal ANO As Long, ByVal str As String) As String
        Dim i As Integer
        Dim j As Integer
        Dim k As Integer
        Dim Searchstr As String
        Dim TStr As String
        TStr = ""
        i = 1
        Do
            j = InStr(i, str, "<<")
            If j <> 0 Then
                TStr = TStr & Mid(str, i, j - i)
                k = InStr(j, str, ">>")
                If k <> 0 Then
                    Searchstr = Mid(str, j + 2, k - j - 2)
                    TStr = TStr & Translate_Field(ANO, Searchstr)
                    j = k + 2
                Else
                    TStr = TStr & Mid(str, j, 2)
                    j = j + 2
                End If
                i = j
            End If
        Loop While j <> 0
        TStr = TStr & Mid(str, i, Len(str) - i + 1)
        Parsing = TStr
    End Function

    Private Function Translate_Field(ByVal ANO As Long, ByVal sfield As String) As String
        Dim i As Integer
        Dim sParam As String
        Dim pSField As String
        Dim tField As String
        pSField = "<<" & sfield & ">>"
        i = InStr(sfield, "&")

        If i <> 0 Then
            sParam = Trim(MID(sfield, i + 1, Len(sfield)))
            sfield = UCase(Trim(MID(sfield, 1, i - 1)))
        Else
            sfield = UCase(Trim(sfield))
            sParam = ""
        End If

        tField = ""
        Select Case UCase(sfield)
            Case "COMPANY"
                tField = Company_Name
            Case "PHOLDER"
                tField = PHolder_Name(ANO)
            Case "DEDUCTIBLE" ' Deductible
                tField = Deductible_Name(ANO, sParam)
            Case "INTEREST"
                tField = Interest_Name(ANO, sParam)
            Case "SUMINSURED"
                tField = SumInsured(ANO)
            Case "LEADER"
                tField = Leader_Name(ANO)
            Case "MEMBERS"
                tField = Member_List(ANO)
            Case "INSTALMENT"
                tField = Premium_Instalment(ANO)
            Case "BANKERS CLAUSE"
                tField = Bankers_Clause(ANO)
            Case "INSURED"
                tField = Insured_Name(ANO)
            Case "ISSUEDATE"
                tField = Issue_Date(ANO)
            Case "STATEDCURRENCY"
            Case "PREMIUMCALCULATION"
                tField = Premium_Calculation(ANO)
            Case "EFFECTIVEDATE"
                tField = Effective_Date(ANO)
            Case "EXPIRYDATE"
                tField = Expiry_Date(ANO)
            Case "STNCDATE"
                tField = STNC_Date(ANO)
            Case "INSURANCEPERIOD"
                tField = Insurance_Period(ANO)
            Case "CPOLICYNO"
                tField = Conjunction_PolicyNO(ANO)
        End Select
        If tField = "" Then tField = pSField
        Translate_Field = tField
    End Function
