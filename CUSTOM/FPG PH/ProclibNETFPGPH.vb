    Private Function Get_AnnualTreatyFlag(ByVal TOC As String) As Boolean
        Dim rs As RemoteSet
        rs = db.OpenRemoteSet("Select T.AnnualTreatyF from TOC T Where T.TOC='" & TOC & "'")
        Get_AnnualTreatyFlag = toval(rs.fields("AnnualTreatyF"))
    End Function
    Private Function Get_Branch_Alias_By_TOC(ByVal Branch As String, ByVal TOC As String, ByRef TAlias As String, Optional ByRef POL_AUTONUM As String = "") As String
        Dim rs As RemoteSet
        Dim BAlias As String

        rs = db.OpenRemoteSet("Select BAlias, TAlias, POL_AUTONUM from Branch_TOC Where (Branch='' or Branch='" & Branch & "') and (TOC='' or TOC='" & TOC & "')")
        BAlias = tostr(rs.fields("BAlias"))
        TAlias = tostr(rs.fields("TAlias"))
        POL_AUTONUM = tostr(rs.fields("POL_AUTONUM"))

        If BAlias = "" Then BAlias = Branch
        If TAlias = "" Then TAlias = TOC
        If POL_AUTONUM = "" Then POL_AUTONUM = "POL"
        rs.CloseRemoteSet()
        Get_Branch_Alias_By_TOC = BAlias
    End Function

    Private Function BusinessResult_Calculation(ByVal pANO As String) As Boolean
        Dim rs As RemoteSet
        Dim rsBS As RemoteSet
        Dim rsPC As RemoteSet
        Dim PctShare As Double
        Dim UjrohReinsPCT As Double
        Dim UjrohCedantPCT As Double
        Dim MShare As Double
        Dim Gross As Double
        Dim SDate As Date
        Dim EDate As Date
        Dim PSDate As Date
        Dim PEDate As Date
        Dim IComm As Double
        Dim IHF As Double
        Dim OHF As Double
        Dim PPeriod As Integer
        Dim RID As String
        Dim RShare As Double
        Dim Premium As Double
        Dim Commission As Double
        Dim rsR As RemoteSet
        Dim rsAcc As RemoteSet
        Dim VoyageF As Boolean
        Dim Basis As Integer
        Dim Prorata As Integer
        Dim PProrata As Double
        Dim AdjustableF As Boolean
        Dim AType As String
        Dim Qty As Integer
        Dim Branch As String
        Dim TOC As String
        Dim BizMapID As String
        Dim PHolder As String
        Dim ISType As String
        Dim UjrohFee As Double
        Dim UjrohCedant As Double
        Dim ANO As Long
        Dim LANO As Long
        Dim M_TOC As String
        Dim M_SDate As Date

        On Error GoTo errmsg

        rsBS = db.OpenRemoteSet("Select * from BusinessResult Where ANO=" & pANO)
        If rsBS.Eof Then
            rsBS.AddNew()
            rsBS.fields("ANO") = pANO
        Else
            rsBS.Edit()
        End If
        rsBS.fields("TSI") = 0
        rsBS.fields("Gross") = 0
        rsBS.fields("Company_Share") = 0
        rsBS.fields("Company_Tabarru") = 0
        rsBS.fields("Company_UjrohFee") = 0
        rsBS.fields("Member_Commission") = 0
        rsBS.fields("Handling_Fee_In") = 0
        rsBS.fields("Payor_Discount") = 0
        rsBS.fields("Brokerage") = 0
        rsBS.fields("Brokerage_Vat") = 0
        rsBS.fields("OPFee") = 0
        rsBS.fields("Handling_Fee_Out") = 0
        rsBS.fields("Treaty_Premium") = 0
        rsBS.fields("Treaty_Commission") = 0
        rsBS.fields("Treaty_Tabarru") = 0
        rsBS.fields("Treaty_UjrohCedant") = 0
        rsBS.fields("Treaty_UjrohFee") = 0
        rsBS.fields("Facultative_Premium") = 0
        rsBS.fields("Facultative_Commission") = 0
        rsBS.fields("Facultative_Tabarru") = 0
        rsBS.fields("Facultative_UjrohCedant") = 0
        rsBS.fields("Facultative_UjrohFee") = 0

        rsAcc = db.OpenRemoteSet("Select A.LANO, A.TOC, A.SDate, C.Voyage, C.Prorata, C.PPeriod, C.ISType, C.PHolder, I.Share, I.UjrohReins, I.UjrohCedant, I.Fee+I.HF as Fee from Acceptance A Inner Join Cover C on (C.CNO=A.CNO) Left Join ISource I on (I.CNO=C.CNO) Where A.ANO=" & pANO)
        If Not rsAcc.Eof Then
            LANO = rsAcc.fields("LANO")
            M_SDate = rsAcc.fields("SDate")
            M_TOC = rsAcc.fields("TOC")
            ISType = rsAcc.fields("ISType")
            PHolder = rsAcc.fields("PHolder")
            VoyageF = rsAcc.fields("Voyage")
            Basis = rsAcc.fields("PPeriod")
            Prorata = rsAcc.fields("Prorata")
            PctShare = IIf(toval(rsAcc.fields("Share")) = 0, 100, toval(rsAcc.fields("Share")))
            UjrohReinsPCT = toval(rsAcc.fields("UjrohReins"))
            UjrohCedantPCT = toval(rsAcc.fields("UjrohCedant"))
            OHF = toval(rsAcc.fields("Fee"))
            If LANO = pANO Then
                rsAcc = db.OpenRemoteSet("Select R.*, A.BizMapID, A.Ujroh, A.Branch, A.TOC, A.AType, A.SDate, A.EDate, A.Qty from Acceptance A Inner Join RArrHeader R on (R.ANO=A.ANO) Where A.PStatus='C' and A.ANO<>A.LANO and A.LANO=" & pANO)
            Else
                rsAcc = db.OpenRemoteSet("Select R.*, A.BizMapID, A.Ujroh, A.Branch, A.TOC, A.AType, A.SDate, A.EDate, A.Qty from Acceptance A Inner Join RArrHeader R on (R.ANO=A.ANO) Where A.PStatus='C' and A.ANO<>A.LANO and A.ANO=" & pANO)
            End If
            Do While Not rsAcc.Eof
                PSDate = rsAcc.fields("SDate")
                PEDate = rsAcc.fields("EDate")
                ANO = rsAcc.fields("ANO")
                AType = rsAcc.fields("AType")
                Branch = rsAcc.fields("Branch")
                TOC = rsAcc.fields("TOC")
                BizMapID = rsAcc.fields("BizMapID")
                Qty = IIf(rsAcc.fields("Qty") = 0, 1, rsAcc.fields("Qty"))

                rs = db.OpenRemoteSet("Select sum(TSI*Rate) as TSI from PCalc Where ANO=" & ANO)
                rsBS.fields("TSI") = toval(rsBS.fields("TSI")) + toval(rs.fields("TSI")) * Qty

                rs = db.OpenRemoteSet("Select dbo.Member_Share(" & ANO & ")")
                MShare = toval(rs.fields(0))

                rs = db.OpenRemoteSet("Select dbo.coinsurance_HandlingFee(" & ANO & ")")
                IHF = toval(rs.fields(0))

                rsPC = db.OpenQueryDef("qPCalc_AccAss", adOpenForwardonly, ANO)
                Do While Not rsPC.Eof
                    Gross = toval(rsPC.fields("Gross")) * toval(rsPC.fields("Rate")) * Qty
                    SDate = todate(rsPC.fields("SDate"))
                    EDate = todate(rsPC.fields("EDate"))
                    PPeriod = DateDiff(DateInterval.Month, PSDate, SDate) / 12 + 1
                    PProrata = toval(rsPC.fields("PProrata"))
                    AdjustableF = toval(rsPC.fields("AdjustableF"))

                    rs = db.OpenRemoteSet("Select dbo.Coinsurance_Commission(" & ANO & ",'" & rsPC.fields("Code") & "')")
                    IComm = toval(rs.fields(0))

                    rsBS.fields("Gross") = toval(rsBS.fields("Gross")) + Gross
                    Dim Company_Share As Double
                    Company_Share = (PctShare - MShare) / 100 * Gross
                    rsBS.fields("Company_Share") = toval(rsBS.fields("Company_Share")) + Company_Share

                    Select Case ISType
                        Case "C", "I", "L"
                            rsBS.fields("Company_UjrohFee") = toval(rsBS.fields("Company_UjrohFee")) + Company_Share * toval(rsAcc.fields("Ujroh")) / 100
                            rsBS.fields("Company_Tabarru") = toval(rsBS.fields("Company_Tabarru")) + (toval(rsBS.fields("Company_Share")) - toval(rsBS.fields("Company_UjrohFee")))
                        Case "R", "T"
                            UjrohCedant = Company_Share * UjrohCedantPCT / 100
                            rsBS.fields("Company_UjrohFee") = toval(rsBS.fields("Company_UjrohFee")) + (Company_Share - UjrohCedant) * UjrohReinsPCT / 100
                            rsBS.fields("Company_Tabarru") = toval(rsBS.fields("Company_Tabarru")) + (Company_Share - UjrohCedant)
                    End Select

                    rsBS.fields("Handling_Fee_In") = toval(rsBS.fields("Handling_Fee_In")) + IHF / 100 * Gross
                    rsBS.fields("Member_Commission") = toval(rsBS.fields("Member_Commission")) + IComm / 100 * Gross

                    rs = db.OpenRemoteSet("Select dbo.Premium_Discount(" & ANO & ",'" & rsPC.fields("Code") & "'," & PPeriod & ")")
                    rsBS.fields("Payor_Discount") = toval(rsBS.fields("Payor_Discount")) - (PctShare - MShare) / 100 * Gross * toval(rs.fields(0)) / 100

                    rs = db.OpenRemoteSet("Select dbo.Premium_Commission_Net(" & ANO & ",'" & rsPC.fields("Code") & "'," & PPeriod & ",0)")
                    rsBS.fields("Brokerage") = toval(rsBS.fields("Brokerage")) - PctShare / 100 * Gross * toval(rs.fields(0)) / 100

                    rs = db.OpenRemoteSet("Select dbo.Premium_Commission_Net_Vat(" & ANO & ",'" & rsPC.fields("Code") & "'," & PPeriod & ",0)")
                    rsBS.fields("Brokerage_Vat") = toval(rsBS.fields("Brokerage_Vat")) - PctShare / 100 * Gross * toval(rs.fields(0)) / 100

                    rsBS.fields("Handling_Fee_Out") = toval(rsBS.fields("Handling_Fee_Out")) - OHF / 100 * PctShare / 100 * Gross

                    ' Treaty Out
                    If rsAcc.fields("CID") <> "" And rsAcc.fields("CShare") <> 0 Then
                        RID = rsAcc.fields("CID")
                        RShare = rsAcc.fields("CShare")
                        rs = db.OpenQueryDef("Treaty_Premium_Commission", adOpenForwardonly, ANO, rsPC.fields("Code"), rsPC.fields("Currency"), SDate, EDate, RID, AdjustableF)
                        rsBS.fields("Treaty_Premium") = toval(rsBS.fields("Treaty_Premium")) - (toval(rs.fields("Premium")) - toval(rs.fields("Discount")) + toval(rs.fields("Fee"))) * RShare / 100 * PctShare / 100 * Qty
                        rsBS.fields("Treaty_Commission") = toval(rsBS.fields("Treaty_Commission")) - (-toval(rs.fields("Commission"))) * RShare / 100 * PctShare / 100 * Qty
                        rsBS.fields("Treaty_UjrohCedant") = toval(rsBS.fields("Treaty_UjrohCedant")) - (-toval(rs.fields("UjrohCedant"))) * RShare / 100 * PctShare / 100 * Qty
                        rsBS.fields("Treaty_UjrohFee") = toval(rsBS.fields("Treaty_UjrohFee")) - (toval(rs.fields("UjrohReins"))) * RShare / 100 * PctShare / 100 * Qty
                        rsBS.fields("Treaty_Tabarru") = toval(rsBS.fields("Treaty_Premium")) + toval(rsBS.fields("Treaty_UjrohCedant"))
                    End If

                    If rsAcc.fields("DID") <> "" And rsAcc.fields("DShare") <> 0 Then
                        RID = rsAcc.fields("DID")
                        RShare = rsAcc.fields("DShare")
                        rs = db.OpenQueryDef("Treaty_Premium_Commission", adOpenForwardonly, ANO, rsPC.fields("Code"), rsPC.fields("Currency"), SDate, EDate, RID, AdjustableF)
                        rsBS.fields("Treaty_Premium") = toval(rsBS.fields("Treaty_Premium")) - (toval(rs.fields("Premium")) - toval(rs.fields("Discount")) + toval(rs.fields("Fee"))) * RShare / 100 * PctShare / 100 * Qty
                        rsBS.fields("Treaty_Commission") = toval(rsBS.fields("Treaty_Commission")) - (-toval(rs.fields("Commission"))) * RShare / 100 * PctShare / 100 * Qty
                        rsBS.fields("Treaty_UjrohCedant") = toval(rsBS.fields("Treaty_UjrohCedant")) - (-toval(rs.fields("UjrohCedant"))) * RShare / 100 * PctShare / 100 * Qty
                        rsBS.fields("Treaty_UjrohFee") = toval(rsBS.fields("Treaty_UjrohFee")) - (toval(rs.fields("UjrohReins"))) * RShare / 100 * PctShare / 100 * Qty
                        rsBS.fields("Treaty_Tabarru") = toval(rsBS.fields("Treaty_Premium")) + toval(rsBS.fields("Treaty_UjrohCedant"))
                    End If

                    If rsAcc.fields("XPID") <> "" And rsAcc.fields("XPShare") <> 0 Then
                        RID = rsAcc.fields("XPID")
                        RShare = rsAcc.fields("XPShare")
                        rs = db.OpenQueryDef("Treaty_Premium_Commission", adOpenForwardonly, ANO, rsPC.fields("Code"), rsPC.fields("Currency"), SDate, EDate, RID, AdjustableF)
                        rsBS.fields("Treaty_Premium") = toval(rsBS.fields("Treaty_Premium")) - (toval(rs.fields("Premium")) - toval(rs.fields("Discount")) + toval(rs.fields("Fee"))) * RShare / 100 * PctShare / 100 * Qty
                        rsBS.fields("Treaty_Commission") = toval(rsBS.fields("Treaty_Commission")) - (-toval(rs.fields("Commission"))) * RShare / 100 * PctShare / 100 * Qty
                        rsBS.fields("Treaty_UjrohCedant") = toval(rsBS.fields("Treaty_UjrohCedant")) - (-toval(rs.fields("UjrohCedant"))) * RShare / 100 * PctShare / 100 * Qty
                        rsBS.fields("Treaty_UjrohFee") = toval(rsBS.fields("Treaty_UjrohFee")) - (toval(rs.fields("UjrohReins"))) * RShare / 100 * PctShare / 100 * Qty
                        rsBS.fields("Treaty_Tabarru") = toval(rsBS.fields("Treaty_Premium")) + toval(rsBS.fields("Treaty_UjrohCedant"))
                    End If

                    If rsAcc.fields("QID") <> "" And rsAcc.fields("QShare") <> 0 Then
                        RID = rsAcc.fields("QID")
                        RShare = rsAcc.fields("QShare")
                        rs = db.OpenQueryDef("Treaty_Premium_Commission", adOpenForwardonly, ANO, rsPC.fields("Code"), rsPC.fields("Currency"), SDate, EDate, RID, AdjustableF)
                        rsBS.fields("Treaty_Premium") = toval(rsBS.fields("Treaty_Premium")) - (toval(rs.fields("Premium")) - toval(rs.fields("Discount")) + toval(rs.fields("Fee"))) * RShare / 100 * PctShare / 100 * Qty
                        rsBS.fields("Treaty_Commission") = toval(rsBS.fields("Treaty_Commission")) - (-toval(rs.fields("Commission"))) * RShare / 100 * PctShare / 100 * Qty
                        rsBS.fields("Treaty_UjrohCedant") = toval(rsBS.fields("Treaty_UjrohCedant")) - (-toval(rs.fields("UjrohCedant"))) * RShare / 100 * PctShare / 100 * Qty
                        rsBS.fields("Treaty_UjrohFee") = toval(rsBS.fields("Treaty_UjrohFee")) - (toval(rs.fields("UjrohReins"))) * RShare / 100 * PctShare / 100 * Qty
                        rsBS.fields("Treaty_Tabarru") = toval(rsBS.fields("Treaty_Premium")) + toval(rsBS.fields("Treaty_UjrohCedant"))
                    End If

                    If rsAcc.fields("SP1ID") <> "" And rsAcc.fields("SP1Share") <> 0 Then
                        RID = rsAcc.fields("SP1ID")
                        RShare = rsAcc.fields("SP1Share")
                        rs = db.OpenQueryDef("Treaty_Premium_Commission", adOpenForwardonly, ANO, rsPC.fields("Code"), rsPC.fields("Currency"), SDate, EDate, RID, AdjustableF)
                        rsBS.fields("Treaty_Premium") = toval(rsBS.fields("Treaty_Premium")) - (toval(rs.fields("Premium")) - toval(rs.fields("Discount")) + toval(rs.fields("Fee"))) * RShare / 100 * PctShare / 100 * Qty
                        rsBS.fields("Treaty_Commission") = toval(rsBS.fields("Treaty_Commission")) - (-toval(rs.fields("Commission"))) * RShare / 100 * PctShare / 100 * Qty
                        rsBS.fields("Treaty_UjrohCedant") = toval(rsBS.fields("Treaty_UjrohCedant")) - (-toval(rs.fields("UjrohCedant"))) * RShare / 100 * PctShare / 100 * Qty
                        rsBS.fields("Treaty_UjrohFee") = toval(rsBS.fields("Treaty_UjrohFee")) - (toval(rs.fields("UjrohReins"))) * RShare / 100 * PctShare / 100 * Qty
                        rsBS.fields("Treaty_Tabarru") = toval(rsBS.fields("Treaty_Premium")) + toval(rsBS.fields("Treaty_UjrohCedant"))
                    End If

                    If rsAcc.fields("SP2ID") <> "" And rsAcc.fields("SP2Share") <> 0 Then
                        RID = rsAcc.fields("SP2ID")
                        RShare = rsAcc.fields("SP2Share")
                        rs = db.OpenQueryDef("Treaty_Premium_Commission", adOpenForwardonly, ANO, rsPC.fields("Code"), rsPC.fields("Currency"), SDate, EDate, RID, AdjustableF)
                        rsBS.fields("Treaty_Premium") = toval(rsBS.fields("Treaty_Premium")) - (toval(rs.fields("Premium")) - toval(rs.fields("Discount")) + toval(rs.fields("Fee"))) * RShare / 100 * PctShare / 100 * Qty
                        rsBS.fields("Treaty_Commission") = toval(rsBS.fields("Treaty_Commission")) - (-toval(rs.fields("Commission"))) * RShare / 100 * PctShare / 100 * Qty
                        rsBS.fields("Treaty_UjrohCedant") = toval(rsBS.fields("Treaty_UjrohCedant")) - (-toval(rs.fields("UjrohCedant"))) * RShare / 100 * PctShare / 100 * Qty
                        rsBS.fields("Treaty_UjrohFee") = toval(rsBS.fields("Treaty_UjrohFee")) - (toval(rs.fields("UjrohReins"))) * RShare / 100 * PctShare / 100 * Qty
                        rsBS.fields("Treaty_Tabarru") = toval(rsBS.fields("Treaty_Premium")) + toval(rsBS.fields("Treaty_UjrohCedant"))
                    End If

                    If rsAcc.fields("SP3ID") <> "" And rsAcc.fields("SP3Share") <> 0 Then
                        RID = rsAcc.fields("SP3ID")
                        RShare = rsAcc.fields("SP3Share")
                        rs = db.OpenQueryDef("Treaty_Premium_Commission", adOpenForwardonly, ANO, rsPC.fields("Code"), rsPC.fields("Currency"), SDate, EDate, RID, AdjustableF)
                        rsBS.fields("Treaty_Premium") = toval(rsBS.fields("Treaty_Premium")) - (toval(rs.fields("Premium")) - toval(rs.fields("Discount")) + toval(rs.fields("Fee"))) * RShare / 100 * PctShare / 100 * Qty
                        rsBS.fields("Treaty_Commission") = toval(rsBS.fields("Treaty_Commission")) - (-toval(rs.fields("Commission"))) * RShare / 100 * PctShare / 100 * Qty
                        rsBS.fields("Treaty_UjrohCedant") = toval(rsBS.fields("Treaty_UjrohCedant")) - (-toval(rs.fields("UjrohCedant"))) * RShare / 100 * PctShare / 100 * Qty
                        rsBS.fields("Treaty_UjrohFee") = toval(rsBS.fields("Treaty_UjrohFee")) - (toval(rs.fields("UjrohReins"))) * RShare / 100 * PctShare / 100 * Qty
                        rsBS.fields("Treaty_Tabarru") = toval(rsBS.fields("Treaty_Premium")) + toval(rsBS.fields("Treaty_UjrohCedant"))
                    End If

                    If rsAcc.fields("AID") <> "" And rsAcc.fields("AShare") <> 0 Then
                        RID = rsAcc.fields("AID")
                        RShare = rsAcc.fields("AShare")
                        rs = db.OpenQueryDef("Treaty_Premium_Commission", adOpenForwardonly, ANO, rsPC.fields("Code"), rsPC.fields("Currency"), SDate, EDate, RID, AdjustableF)
                        rsBS.fields("Treaty_Premium") = toval(rsBS.fields("Treaty_Premium")) - (toval(rs.fields("Premium")) - toval(rs.fields("Discount")) + toval(rs.fields("Fee"))) * RShare / 100 * PctShare / 100 * Qty
                        rsBS.fields("Treaty_Commission") = toval(rsBS.fields("Treaty_Commission")) - (-toval(rs.fields("Commission"))) * RShare / 100 * PctShare / 100 * Qty
                        rsBS.fields("Treaty_UjrohCedant") = toval(rsBS.fields("Treaty_UjrohCedant")) - (-toval(rs.fields("UjrohCedant"))) * RShare / 100 * PctShare / 100 * Qty
                        rsBS.fields("Treaty_UjrohFee") = toval(rsBS.fields("Treaty_UjrohFee")) - (toval(rs.fields("UjrohReins"))) * RShare / 100 * PctShare / 100 * Qty
                        rsBS.fields("Treaty_Tabarru") = toval(rsBS.fields("Treaty_Premium")) + toval(rsBS.fields("Treaty_UjrohCedant"))
                    End If


                    ' Facultative Out
                    Dim FacProrata As Double
                    Dim FSDate As Date
                    Dim FEDate As Date
                    Dim NetRateF As Boolean
                    Dim AcqCost As Double
                    Dim PremiAdj As Double
                    Dim ProfitSharing As Double
                    Dim JPPremium As Double
                    Dim JPComm As Double
                    Dim BRComm As Double
                    Dim FType As String

                    rsR = db.OpenQueryDef("QFacOutDet", adOpenForwardonly, ANO, rsPC.fields("Code"))
                    Do While Not rsR.Eof
                        If UCase(tostr(rsR.fields("Status"))) <> "O" Then
                            Select Case rsR.fields("RType")
                                Case "QS", "QP", "S1", "S2", "S3", "CF", "AF", "OP"
                                    FType = rsR.fields("RType")
                                Case "JP"
                                    FType = "IC"
                                Case Else
                                    FType = "FO"
                            End Select
                            If toval(rsR.fields("NetRate")) = 0 Then
                                Premium = PctShare / 100 * (Gross / PProrata) * Qty
                                If toval(rsR.fields("OnGrossAfterCommF")) Then
                                    Premium = Premium * (100 - Get_Premium_Facultative_Commission(ANO, rsPC.fields("Code"), 0, False)) / 100
                                End If
                                NetRateF = False
                            Else
                                rs = db.OpenQueryDef("Facultative_Premium", adOpenForwardonly, ANO, rsPC.fields("Code"), rsPC.fields("Currency"), SDate, EDate, rsR.fields("FID"), rsPC.fields("AdjustableF"))
                                Premium = PctShare / 100 * toval(rs.fields("Premium")) * Qty
                                NetRateF = True
                            End If

                            JPPremium = 0
                            JPComm = 0

                            ' Check for First Loss
                            If rsR.fields("FLPct") = 0 And rsR.fields("Unit") <> "F" Then
                                Premium = Premium * toval(rsR.fields("Share")) / 100 * toval(rsR.fields("RShare")) / 100
                            End If

                            If Premium <> 0 Then
                                JPPremium = Premium * toval(rsR.fields("JPShare")) / toval(rsR.fields("Share"))
                            End If

                            AcqCost = Premium * toval(rsR.fields("ACQCOST")) / 100
                            PremiAdj = Premium * toval(rsR.fields("DISCOUNT")) / 100
                            ProfitSharing = (Premium - AcqCost - PremiAdj) * toval(rsR.fields("ProfitSharing")) / 100

                            Commission = (Premium - AcqCost - PremiAdj) * (toval(rsR.fields("Comm")) + toval(rsR.fields("OComm"))) / 100
                            BRComm = (Premium - AcqCost - PremiAdj) * (1 - (1 - toval(rsR.fields("BRComm")) / 100))
                            JPComm = (JPPremium) * (1 - (1 - toval(rsR.fields("JPComm")) / 100))

                            Premium = Premium - AcqCost - PremiAdj

                            ' Shariah
                            ' Ujroh Cedant/Re not apply for Coinsurance Follower
                            If Not (FType = "CF" And (ISType = "I" Or ISType = "L")) Then
                                UjrohCedant = (Premium - JPPremium) * toval(rsR.fields("UJROHCEDANT")) / 100
                                UjrohFee = (Premium - JPPremium - UjrohCedant) * toval(rsR.fields("UJROHREINS")) / 100
                            Else
                                UjrohCedant = 0
                                UjrohFee = 0
                            End If

                            ' Premium = Premium - ProfitSharing

                            If DateDiff(DateInterval.Day, SDate, rsR.fields("SDate")) >= 0 Then
                                FSDate = rsR.fields("SDate")
                            Else
                                FSDate = SDate
                            End If

                            If DateDiff(DateInterval.Day, rsR.fields("EDate"), EDate) >= 0 Then
                                FEDate = rsR.fields("EDate")
                            Else
                                FEDate = EDate
                            End If

                            If DateDiff(DateInterval.Day, FSDate, FEDate) > 0 Then   ' In Period Cover
                                If VoyageF Then
                                    FacProrata = PProrata
                                ElseIf rsR.fields("PCalc") = "F" And Not NetRateF Then
                                    FacProrata = PProrata
                                ElseIf rsR.fields("PCalc") = "P" And rsR.fields("CPCT") <> 0 Then
                                    FacProrata = rsR.fields("CPCT") / 100
                                Else
                                    If DateDiff(DateInterval.Month, SDate, EDate) <> 0 Then
                                        If rsR.fields("PCalc") = "F" Then
                                            FacProrata = DateDiff(DateInterval.Month, FSDate, FEDate) / 12
                                        Else
                                            If Not NetRateF Then
                                                If rsR.fields("PCalc") = "P" Then
                                                    If Day(FSDate) = Day(FEDate) And Day(SDate) = Day(EDate) And Basis <> 1 Then
                                                        FacProrata = DateDiff(DateInterval.Month, FSDate, FEDate) / 12
                                                    Else
                                                        FacProrata = DateDiff(DateInterval.Day, FSDate, FEDate) / Prorata
                                                    End If
                                                Else
                                                    If Day(FSDate) = Day(FEDate) And Day(SDate) = Day(EDate) And Basis <> 1 Then
                                                        FacProrata = DateDiff(DateInterval.Month, FSDate, FEDate) / DateDiff(DateInterval.Month, SDate, EDate)
                                                    Else
                                                        FacProrata = DateDiff(DateInterval.Day, FSDate, FEDate) / DateDiff(DateInterval.Day, SDate, EDate)
                                                    End If
                                                End If
                                            Else
                                                If Day(FSDate) = Day(FEDate) And Day(SDate) = Day(EDate) And Basis <> 1 Then
                                                    FacProrata = DateDiff(DateInterval.Month, FSDate, FEDate) / 12
                                                Else
                                                    FacProrata = DateDiff(DateInterval.Day, FSDate, FEDate) / Prorata
                                                End If
                                            End If
                                        End If
                                    Else
                                        If rsR.fields("PCalc") = "P" Then
                                            FacProrata = DateDiff(DateInterval.Day, FSDate, FEDate) / Prorata
                                        Else
                                            FacProrata = PProrata
                                        End If
                                    End If
                                End If
                            Else
                                FacProrata = 0
                            End If

                            If AType = "N" And rsR.fields("Prorata") <> 0 Then
                                rsBS.fields("Facultative_Premium") = toval(rsBS.fields("Facultative_Premium")) - (Premium - JPPremium) * FacProrata * toval(rsR.fields("Prorata"))
                                rsBS.fields("Facultative_Commission") = toval(rsBS.fields("Facultative_Commission")) - (-(Commission - JPComm + BRComm)) * FacProrata * toval(rsR.fields("Prorata"))
                                rsBS.fields("Facultative_UjrohCedant") = toval(rsBS.fields("Facultative_UjrohCedant")) - (-UjrohCedant) * FacProrata * toval(rsR.fields("Prorata"))
                                rsBS.fields("Facultative_UjrohFee") = toval(rsBS.fields("Facultative_UjrohFee")) - (UjrohFee) * FacProrata * toval(rsR.fields("Prorata"))
                                rsBS.fields("Facultative_Tabarru") = toval(rsBS.fields("Facultative_Premium")) + toval(rsBS.fields("Facultative_UjrohCedant"))
                            Else
                                rsBS.fields("Facultative_Premium") = toval(rsBS.fields("Facultative_Premium")) - (Premium - JPPremium) * FacProrata
                                rsBS.fields("Facultative_Commission") = toval(rsBS.fields("Facultative_Commission")) - (-(Commission - JPComm + BRComm)) * FacProrata
                                rsBS.fields("Facultative_UjrohCedant") = toval(rsBS.fields("Facultative_UjrohCedant")) - (-UjrohCedant) * FacProrata
                                rsBS.fields("Facultative_UjrohFee") = toval(rsBS.fields("Facultative_UjrohFee")) - (UjrohFee) * FacProrata
                                rsBS.fields("Facultative_Tabarru") = toval(rsBS.fields("Facultative_Premium")) + toval(rsBS.fields("Facultative_UjrohCedant"))
                            End If
                        End If
                        rsR.MoveNext()
                    Loop
                    rsPC.MoveNext()
                Loop

                ' Fee & Duty
                If (ISType = "I" Or ISType = "L" Or ISType = "C") Then
                    Dim Amount As Double
                    Dim SQL As String
                    SQL = "Select ACCFD.Amount, ACCFD.AmountPCT, ACCFD.AmountPCTBased, ACCFD.Currency, FDTab.FDType, AccFD.AmountPCT, ACCFD.AMOUNTPCTBASED , AccFD.PolicyYear, PCalc.Rate"
                    SQL = SQL & " from AccFD "
                    SQL = SQL & " Inner Join FDTab on (FDTab.FDID=ACCFD.FDID)"
                    SQL = SQL & " Left Join PCalc on (PCalc.ANO=AccFD.ANO and PCalc.Currency=ACCFD.Currency)"
                    SQL = SQL & " Where AccFD.ANO=" & ANO & " and Left(FDTAB.FDType,1)='O'"
                    rsPC = db.OpenRemoteSet(SQL)
                    Do While Not rsPC.Eof
                        If toval(rsPC.fields("Amount")) <> 0 Then
                            Amount = -toval(rsPC.fields("Amount"))
                        ElseIf toval(rsPC.fields("AmountPCT")) <> 0 Or toval(rsPC.fields("AMOUNTPCTBASED")) = 2 Then
                            Amount = -Get_Fee_Amount_By_Percentage(ANO, rsPC.fields("Currency"), Left(tostr(rsPC.fields("FDType")), 1), toval(rsPC.fields("AmountPCT")), toval(rsPC.fields("AMOUNTPCTBASED")), toval(rsPC.fields("PolicyYear")))
                        End If
                        If toval(rsPC.fields("Rate")) <> 0 Then
                            rsBS.fields("OPFee") = toval(rsBS.fields("OPFee")) + Amount * toval(rsPC.fields("Rate"))
                        Else
                            rsBS.fields("OPFee") = toval(rsBS.fields("OPFee")) + Amount * GetReinsuranceRate(TOC, rsPC.fields("Currency"), PSDate, PHolder)
                        End If
                        rsPC.MoveNext()
                    Loop
                    rsPC.CloseRemoteSet()
                End If

                rsAcc.MoveNext()
            Loop

            ' Fee & Duty
            If pANO = LANO Then
                If (ISType = "I" Or ISType = "L" Or ISType = "C") Then
                    Dim Amount As Double
                    Dim SQL As String
                    SQL = "Select ACCFD.Amount, ACCFD.AmountPCT, ACCFD.AmountPCTBased, ACCFD.Currency, FDTab.FDType, AccFD.AmountPCT, ACCFD.AMOUNTPCTBASED , AccFD.PolicyYear, PCalc.Rate"
                    SQL = SQL & " from AccFD "
                    SQL = SQL & " Inner Join FDTab on (FDTab.FDID=ACCFD.FDID)"
                    SQL = SQL & " Left Join PCalc on (PCalc.ANO=AccFD.ANO and PCalc.Currency=ACCFD.Currency)"
                    SQL = SQL & " Where AccFD.ANO=" & pANO & " and Left(FDTAB.FDType,1)='O'"
                    rsPC = db.OpenRemoteSet(SQL)
                    Do While Not rsPC.Eof
                        If toval(rsPC.fields("Amount")) <> 0 Then
                            Amount = -toval(rsPC.fields("Amount"))
                        ElseIf toval(rsPC.fields("AmountPCT")) <> 0 Or toval(rsPC.fields("AMOUNTPCTBASED")) = 2 Then
                            Amount = -Get_Fee_Amount_By_Percentage(pANO, rsPC.fields("Currency"), Left(tostr(rsPC.fields("FDType")), 1), toval(rsPC.fields("AmountPCT")), toval(rsPC.fields("AMOUNTPCTBASED")), toval(rsPC.fields("PolicyYear")))
                        End If
                        If toval(rsPC.fields("Rate")) <> 0 Then
                            rsBS.fields("OPFee") = toval(rsBS.fields("OPFee")) + Amount * toval(rsPC.fields("Rate"))
                        Else
                            rsBS.fields("OPFee") = toval(rsBS.fields("OPFee")) + Amount * GetReinsuranceRate(M_TOC, rsPC.fields("Currency"), M_SDate, PHolder)
                        End If
                        rsPC.MoveNext()
                    Loop
                    rsPC.CloseRemoteSet()
                End If
            End If
        End If

        Dim FacOpt As Integer
        FacOpt = IIf(toval(rsBS.fields("Facultative_Premium")) <> 0, 1, 2)
        rs = db.OpenRemoteSet("Select * from BRRule Where TOC='" & TOC & "' and (Branch='<All>' or Branch='" & Branch & "') and (BizMapID='<All>' or BizMapID='" & BizMapID & "') and (FacOpt=0 or FacOpt=" & FacOpt & ")")
        If Not rs.Eof Then
            rsBS.fields("ExtraCostDesc_1") = rs.fields("ExtraCostDesc_1")
            rsBS.fields("ExtraCost_1") = -toval(rsBS.fields("Company_Share")) * toval(rs.fields("ExtraCost_1")) / 100

            rsBS.fields("ExtraCostDesc_2") = rs.fields("ExtraCostDesc_2")
            rsBS.fields("ExtraCost_2") = -toval(rsBS.fields("Company_Share")) * toval(rs.fields("ExtraCost_2")) / 100

            rsBS.fields("ExtraCostDesc_3") = rs.fields("ExtraCostDesc_3")
            rsBS.fields("ExtraCost_3") = -toval(rsBS.fields("Company_Share")) * toval(rs.fields("ExtraCost_3")) / 100

            rsBS.fields("ExtraCostDesc_4") = rs.fields("ExtraCostDesc_4")
            rsBS.fields("ExtraCost_4") = -toval(rsBS.fields("Company_Share")) * toval(rs.fields("ExtraCost_4")) / 100

            rsBS.fields("ExtraCostDesc_5") = rs.fields("ExtraCostDesc_5")
            rsBS.fields("ExtraCost_5") = -toval(rsBS.fields("Company_Share")) * toval(rs.fields("ExtraCost_5")) / 100

            rsBS.fields("ExtraCostDesc_6") = rs.fields("ExtraCostDesc_6")
            rsBS.fields("ExtraCost_6") = -toval(rsBS.fields("Company_Share")) * toval(rs.fields("ExtraCost_6")) / 100

            rsBS.fields("ExtraCostDesc_7") = rs.fields("ExtraCostDesc_7")
            rsBS.fields("ExtraCost_7") = -toval(rsBS.fields("Company_Share")) * toval(rs.fields("ExtraCost_7")) / 100
        End If

        rsBS.fields("NetResult") = rsBS.fields("Company_Share") + rsBS.fields("Member_Commission") + rsBS.fields("Handling_Fee_In") + rsBS.fields("Payor_Discount") + rsBS.fields("Brokerage") + rsBS.fields("Brokerage_Vat") + rsBS.fields("OPFee") + rsBS.fields("Handling_Fee_Out") + rsBS.fields("Treaty_Premium") + rsBS.fields("Treaty_Commission") + rsBS.fields("Facultative_Premium") + rsBS.fields("Facultative_Commission")
        rsBS.fields("NetResult") = rsBS.fields("NetResult") + toval(rsBS.fields("ExtraCost_1")) + toval(rsBS.fields("ExtraCost_2")) + toval(rsBS.fields("ExtraCost_3")) + toval(rsBS.fields("ExtraCost_4")) + toval(rsBS.fields("ExtraCost_5")) + toval(rsBS.fields("ExtraCost_6")) + toval(rsBS.fields("ExtraCost_7"))
        rsBS.fields("NetPremium") = rsBS.fields("Company_Share") + rsBS.fields("Payor_Discount") + rsBS.fields("Treaty_Premium") + rsBS.fields("Facultative_Premium")

        rsBS.fields("NetUjrohResult") = rsBS.fields("Company_UjrohFee") + rsBS.fields("Member_Commission") + rsBS.fields("Handling_Fee_In") + rsBS.fields("Payor_Discount") + rsBS.fields("Brokerage") + rsBS.fields("Brokerage_Vat") + rsBS.fields("OPFee") + rsBS.fields("Handling_Fee_Out") + rsBS.fields("Treaty_UjrohFee") + rsBS.fields("Treaty_Commission") + rsBS.fields("Facultative_UjrohFee") + rsBS.fields("Facultative_Commission")
        rsBS.fields("NetUjrohResult") = rsBS.fields("NetUjrohResult") + toval(rsBS.fields("ExtraCost_1")) + toval(rsBS.fields("ExtraCost_2")) + toval(rsBS.fields("ExtraCost_3")) + toval(rsBS.fields("ExtraCost_4")) + toval(rsBS.fields("ExtraCost_5")) + toval(rsBS.fields("ExtraCost_6")) + toval(rsBS.fields("ExtraCost_7"))
        rsBS.fields("NetUjroh") = rsBS.fields("Company_UjrohFee") + rsBS.fields("Treaty_UjrohFee") + rsBS.fields("Facultative_UjrohFee")

        rsBS.fields("NetTabarruResult") = rsBS.fields("Company_Tabarru") + rsBS.fields("Treaty_Tabarru") + rsBS.fields("Facultative_Tabarru")
        rsBS.fields("NetTabarru") = rsBS.fields("Company_Tabarru") + rsBS.fields("Treaty_Tabarru") + rsBS.fields("Facultative_Tabarru")


        If Not rsBS.Update Then GoTo errmsg
        BusinessResult_Calculation = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        BusinessResult_Calculation = False
    End Function

    Private Function Get_Reinsurance_Limit_Of_Liability(ByVal ANO As Long, ByVal RDate As Date, ByRef Amount As Double, ByRef PML As Double, ByRef PCTLOSS As Double) As Boolean
        Dim rs As RemoteSet
        On Error GoTo errmsg

        rs = db.OpenQueryDef("Reinsurance_Limit_Liability", adOpenForwardonly, ANO, RDate)
        Amount = toval(rs.fields("Amount"))
        PML = toval(rs.fields("PML"))
        PCTLOSS = toval(rs.fields("PCTLOSS"))
        If PML = 0 Then PML = 100
        If PCTLOSS = 0 Then PCTLOSS = 100
        Get_Reinsurance_Limit_Of_Liability = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Get_Reinsurance_Limit_Of_Liability = False
    End Function
    Private Function Check_Backdated(ByVal Branch As String, ByVal PDate As Date) As Boolean
        Dim rs As RemoteSet
        Dim Br_End_Date As Date
        Dim Br_Month As Integer
        Dim Br_Year As Integer
        On Error GoTo errmsg
        rs = db.OpenRemoteSet("Select * from Branch Where Branch='" & Branch & "'")
        Br_End_Date = todate(rs.fields("End_Date"))
        Br_Month = toval(rs.fields("Month"))
        Br_Year = toval(rs.fields("Year"))

        If (DateDiff(DateInterval.Day, PDate, Br_End_Date) = 0 And Br_Month = Month(PDate) And Br_Year = Year(PDate)) Or (DateDiff(DateInterval.Day, PDate, Br_End_Date) > 0) Then
            Check_Backdated = True
            Exit Function
        End If
        Check_Backdated = False
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Check_Backdated = True
    End Function
