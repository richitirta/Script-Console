    Private Function Generate_Virtual_Account(ByVal VID As Long, ByVal GenerateBy As String, ByVal A_PolicyNo As String, ByVal PID As String, ByRef Bank As String, ByRef BankName As String, ByRef CCY As String, ByVal Branch As String, ByVal TOC As String, ByVal PolicyType As String, ByVal Segment As String, ByVal ADate As Date) As String
        Dim db As New ClassLib
        Try
            If Not db.OpenConnection("", db_Name, db_Server, db_sysuser, db_syspassword, db_TimeOut, db_Trusted) Then
                StrMsg = db.ErrDesc
                Generate_Virtual_Account = ""
                Exit Function
            End If
            db.Var_db_user = db_user
            db.Var_db_Password = db_password
            db.Var_db_User_Type = db_user_type
            db.Var_db_User_CCode = db_User_CCode

            db.Begintrans()
            Dim AccountNo As String = ""
            Dim rs As RemoteSet
            Dim rsd As RemoteSet
            If Not db.GetLockedObject("VACCOUNT" & VID, True) Then Throw New Exception(db.ErrDesc)
            rs = db.OpenRemoteSet("Select * from VAccount Where VID=" & VID)
            Bank = tostr(rs.fields("Bank"))
            BankName = tostr(rs.fields("BankName"))
            CCY = tostr(rs.fields("Currency"))
            If toval(rs.fields("UsePolicyNoF")) Then
                If InStr(A_PolicyNo, "-") <> 0 Then
                    AccountNo = rs.fields("BIN") & Left(A_PolicyNo, InStr(A_PolicyNo, "-") - 1)
                Else
                    AccountNo = rs.fields("BIN") & A_PolicyNo
                End If
            ElseIf tostr(rs.fields("AutoNum")) <> "" Then
                AccountNo = db.GetNextDocNo(tostr(rs.fields("AutoNum")), ADate, GetSegmentGroup(Segment) + Branch + Left(TOC, 2))
                If AccountNo = "" Then
                    StrMsg = "Generate Virtual Account Number Failed !"
                    Throw New Exception(StrMsg)
                End If
                AccountNo = rs.fields("BIN") & AccountNo
            Else
                AccountNo = rs.fields("BIN") & Format(toval(rs.fields("SeqNo")) + 1, rs.fields("sformat"))
                rs.Edit()
                rs.fields("SeqNo") = toval(rs.fields("SeqNo")) + 1
                If Not rs.Update Then Throw New Exception(rs.ErrDesc)
            End If

            rsd = db.OpenRemoteSet("Select * from VAccountD Where 1<>1")
            rsd.AddNew()
            rsd.fields("VID") = VID
            rsd.fields("AccountNo") = AccountNo
            rsd.fields("AllocatedF") = False
            rsd.fields("Last_Update") = Today.Date
            rsd.fields("Last_Opr") = db_user
            If Not rsd.Update Then Throw New Exception(rsd.ErrDesc)
            If Not db.ReleaseLockedObject("VACCOUNT" & VID) Then Throw New Exception(db.ErrDesc)
            db.Committrans()
            db.CloseSession()
            Generate_Virtual_Account = AccountNo
        Catch ex As Exception
            StrMsg = ex.Message
            db.RollBack()
            db.CloseSession()
            Generate_Virtual_Account = ""
        End Try
    End Function
