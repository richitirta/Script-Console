                            FEDate = rsRA.fields("EDate")
                        Else
                            FEDate = EDate
                        End If

                        If DateDiff(DateInterval.Day, FSDate, FEDate) > 0 Then   ' In Period Cover
                            If VoyageF Then
                                FacProrata = PProrata
                            ElseIf AType = "A" Then
                                If AdjMethod <> "OVERLIMIT" Then
                                    If Day(FSDate) = Day(FEDate) And Day(SDate) = Day(EDate) And PPeriod <> 1 Then
                                        FacProrata = PProrata * DateDiff(DateInterval.Month, FSDate, FEDate) / DateDiff(DateInterval.Month, SDate, EDate)
                                    Else
                                        FacProrata = PProrata * DateDiff(DateInterval.Day, FSDate, FEDate) / DateDiff(DateInterval.Day, SDate, EDate)
