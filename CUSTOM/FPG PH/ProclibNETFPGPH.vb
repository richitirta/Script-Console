        End If
        If NewSessionFlag Then db.CloseSession()
        db = Nothing
        Exit Function
errmsg:
        If NewSessionFlag Then db.RollBack()
        If NewSessionFlag Then db.CloseSession()
        db = Nothing
        Call_Process_Execute = 0
    End Function
    Private Function Expire(ByVal ANO As Long, ByVal CNO As Long, ByVal EDate As Date) As Boolean
        Dim rs As RemoteSet
        Dim PHolderLimitF As Boolean
        Dim BackDatedF As Boolean
        Dim AType As String
        Dim TOC As String

        On Error GoTo errmsg

        rs = db.OpenRemoteSet("Select PHolderLimitF from SysTab")
        PHolderLimitF = rs.fields("PHolderLimitF")

        rs = db.OpenRemoteSet("Select BackDatedF, AType, TOC, AStatus from Acceptance Where ANO=" & ANO)
        If Not (tostr(rs.fields("AStatus")) = "I") Then
            StrMsg = "Please Check Policy/Certificate Data Status !"
            GoTo errmsg
        End If

        BackDatedF = rs.fields("BackDatedF")
        AType = rs.fields("AType")
        TOC = rs.fields("TOC")

        If Not db.Execute("Update Acceptance Set AStatus='C', CloseDate='" & Format(EDate, "MM/DD/YYYY") & "', CloseTime='" & Time() & "', CUserID='" & db_user & "' Where AStatus='I' and ANO=" & ANO) Then GoTo errmsg
        If db.RecordsAffected = 0 Then GoTo errmsg

        ' Update Services
        If Not db.Execute("Update Service Set SStatus='A', AUserDate='" & Format(Today.Date, "MM/DD/YYYY") & "', AUserTime='" & Time() & "', AUserID='" & db_user & "' Where SType<>'Claim' and SStatus='P' and ANO=" & ANO) Then GoTo errmsg

        rs = db.OpenQueryDef("QRArrheader", adOpenForwardOnly, ANO)
        If tostr(rs.fields("Status")) = "A" Then
            If Not UnReleaseAccRegAmount(ANO, True) Then GoTo errmsg
        End If

        ' Set The Renewal Policy Accumulation Register
        rs = db.OpenRemoteSet("Select Acceptance.ANO from Acceptance, RArrHeader Where RArrHeader.ANO=Acceptance.ANO and RArrHeader.Status='R' and Acceptance.AType in ('N','E') and Acceptance.AStatus='I' and Acceptance.RANO=" & ANO)
        If Not rs.Eof Then
            If Not ReleaseAccRegAmount(rs.fields("ANO"), True) Then GoTo errmsg
        End If

        If Not BackDatedF Then
            ' Check Policy Holder Limit
            If AType = "N" Or AType = "E" Or AType = "C" Then
                If PHolderLimitF Then
                    If Not db.Execute("QRemove_PHolder_LimitUsage " & ANO) Then
                        StrMsg = StrMsg & "Removing Policy Holder Limit Usage Failed !" & vbCrLf
                    End If
                End If
            End If
        End If

        rs = db.OpenRemoteSet("Select AutoEmailPolicyExpiredF from TOC Where TOC='" & TOC & "'")
        If toval(rs.fields("AutoEmailPolicyExpiredF")) Then
            Insert_Event_Notification(ANO, "POLICY", "POL", "EXPIRY")
        End If

        Expire = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Expire = False
    End Function
    Private Function UndoExpire(ByVal ANO As Long, ByVal CNO As Long, ByVal EDate As Date) As Boolean
        Dim rs As RemoteSet
        Dim PHolderLimitF As Boolean
        Dim BackDatedF As Boolean
        Dim AType As String

        On Error GoTo errmsg

        rs = db.OpenRemoteSet("Select PHolderLimitF from SysTab")
        PHolderLimitF = rs.fields("PHolderLimitF")

        rs = db.OpenRemoteSet("Select BackDatedF, AType, AStatus, pAStatus from Acceptance Where ANO=" & ANO)
        If Not (tostr(rs.fields("AStatus")) = "C" And tostr(rs.fields("pAStatus")) <> "W") Then
            StrMsg = "Please Check Policy/Certificate Data Status !"
            GoTo errmsg
        End If
        BackDatedF = rs.fields("BackDatedF")
        AType = rs.fields("AType")

        If Not db.Execute("Update A Set AStatus='I', CNO=coalesce(MA2.CNO, A.CNO), LANO=coalesce(MA2.LANO, A.LANO), CUSerID='', CloseDate=Null, CloseTime='' from Acceptance A Left Join Acceptance MA1 on (MA1.ANO=A.LANO) Left Join Acceptance MA2 on (MA2.OANO=MA1.OANO and MA2.AType<>'A' and MA2.AStatus='I') Where A.AStatus='C' and A.ANO=" & ANO) Then GoTo errmsg
        If db.RecordsAffected = 0 Then GoTo errmsg
        ' Update Services
        If Not db.Execute("Update Service Set SStatus='P' Where SType<>'Claim' and SStatus='A' and ANO=" & ANO) Then GoTo errmsg
        If Not ReleaseAccRegAmount(ANO, True) Then GoTo errmsg

        ' Set The Renewal Policy Accumulation Register
        rs = db.OpenRemoteSet("Select Acceptance.ANO from Acceptance, RArrHeader Where RArrHeader.ANO=Acceptance.ANO and RArrHeader.Status='A' and Acceptance.AType in ('N','E') and Acceptance.AStatus in ('W','T','I') and Acceptance.RANO=" & ANO)
        If Not rs.Eof Then
            If Not UnReleaseAccRegAmount(rs.fields("ANO"), True) Then GoTo errmsg
        End If

        If Not BackDatedF Then
            ' Check Policy Holder Limit
            If AType = "N" Or AType = "E" Or AType = "C" Then
                If PHolderLimitF Then
                    If Not db.Execute("QUndoRemove_PHolder_LimitUsage " & ANO) Then
                        StrMsg = StrMsg & "Undo Removing Policy Holder Limit Usage Failed !" & vbCrLf
                    End If
                End If
            End If
        End If

        UndoExpire = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        UndoExpire = False
    End Function

    Private Function ExpireMaster(ByVal ANO As Long, ByVal CNO As Long, ByVal EDate As Date) As Boolean
        Dim rs As RemoteSet
        Dim rsDet As RemoteSet
        Dim PHolderLimitF As Boolean

        On Error GoTo errmsg
        'Master Update
        rs = db.OpenRemoteSet("Select PHolderLimitF from SysTab")
        PHolderLimitF = rs.fields("PHolderLimitF")

        rs = db.OpenRemoteSet("Select AStatus from Acceptance Where ANO=" & ANO)
        If Not (tostr(rs.fields("AStatus")) = "I") Then
            StrMsg = "Please Check Policy Data Status !"
            GoTo errmsg
        End If

        If Not db.Execute("Update Acceptance Set AStatus='C', CloseDate='" & Format(EDate, "MM/DD/YYYY") & "', CUserID='" & db_user & "' Where AType not in ('A','C') and AStatus='I' and ANO=" & ANO) Then GoTo errmsg
        If db.RecordsAffected = 0 Then GoTo errmsg

        rsDet = db.OpenQueryDef("QDetailAcceptance", adOpenKeyset, ANO)
        Do While Not rsDet.Eof
            If rsDet.fields("AType") <> "A" And rsDet.fields("AType") <> "C" Then
                rsDet.Edit()
                rsDet.fields("AStatus") = "C"
                rsDet.fields("CloseDate") = EDate
                rsDet.fields("CUserID") = db_user
                If Not rsDet.Update Then GoTo errmsg
                If Not UnReleaseAccRegAmount(rsDet.fields("ANO"), True) Then GoTo errmsg

                ' Set The Renewal Policy Accumulation Register
                rs = db.OpenRemoteSet("Select Acceptance.ANO from Acceptance, RArrHeader Where RArrHeader.ANO=Acceptance.ANO and RArrHeader.Status<>'A' and Acceptance.AType in ('N','E') and Acceptance.AStatus in ('W','I') and Acceptance.RANO=" & rsDet.fields("ANO"))
                If Not rs.Eof Then
                    If Not ReleaseAccRegAmount(rs.fields("ANO"), True) Then GoTo errmsg
                End If

                If Not rsDet.fields("BackDatedF") Then
                    ' Check Policy Holder Limit
                    If rsDet.fields("AType") = "N" Or rsDet.fields("AType") = "E" Or rsDet.fields("AType") = "C" Then
                        If PHolderLimitF Then
                            If Not db.Execute("QRemove_PHolder_LimitUsage " & rsDet.fields("ANO")) Then
                                StrMsg = StrMsg & "Removing Policy Holder Limit Usage Failed !" & vbCrLf
                            End If
                        End If
                    End If
                End If
            End If

            rsDet.MoveNext()
        Loop

        ExpireMaster = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        ExpireMaster = False
    End Function
    Private Function UndoExpireMaster(ByVal ANO As Long, ByVal CNO As Long, ByVal EDate As Date) As Boolean
        Dim rs As RemoteSet
        Dim rsDet As RemoteSet
        Dim PHolderLimitF As Boolean

        On Error GoTo errmsg
        'Master Update
        rs = db.OpenRemoteSet("Select PHolderLimitF from SysTab")
        PHolderLimitF = rs.fields("PHolderLimitF")

        rs = db.OpenRemoteSet("Select AStatus, pAStatus from Acceptance Where ANO=" & ANO)
        If Not (tostr(rs.fields("AStatus")) = "C" And tostr(rs.fields("pAStatus")) <> "W") Then
            StrMsg = "Please Check Policy Data Status !"
            GoTo errmsg
        End If

        If Not db.Execute("Update Acceptance Set AStatus='I', CUSerID='', CloseDate=Null, CloseTime='' Where AType not in ('A','C') and AStatus='C' and ANO=" & ANO) Then GoTo errmsg
        If db.RecordsAffected = 0 Then GoTo errmsg
        ' Update Services
        If Not db.Execute("Update Service Set SStatus='P' Where SType<>'Claim' and SStatus='A' and ANO=" & ANO) Then GoTo errmsg

        rsDet = db.OpenQueryDef("QDetailAcceptance", adOpenKeyset, ANO)
        Do While Not rsDet.Eof
            If rsDet.fields("AType") <> "A" And rsDet.fields("AType") <> "C" Then
                rsDet.Edit()
                rsDet.fields("AStatus") = "I"
                If Not rsDet.Update Then GoTo errmsg
                If Not ReleaseAccRegAmount(rsDet.fields("ANO"), True) Then GoTo errmsg

                ' Set The Renewal Policy Accumulation Register
                rs = db.OpenRemoteSet("Select Acceptance.ANO from Acceptance, RArrHeader Where RArrHeader.ANO=Acceptance.ANO and RArrHeader.Status='A' and Acceptance.AType in ('N','E') and Acceptance.AStatus in ('W','T','I') and Acceptance.RANO=" & rsDet.fields("ANO"))
                If Not rs.Eof Then
                    If Not UnReleaseAccRegAmount(rs.fields("ANO"), True) Then GoTo errmsg
                End If

                If Not rsDet.fields("BackDatedF") Then
                    ' Check Policy Holder Limit
                    If rsDet.fields("AType") = "N" Or rsDet.fields("AType") = "E" Or rsDet.fields("AType") = "C" Then
                        If PHolderLimitF Then
                            If Not db.Execute("QUndoRemove_PHolder_LimitUsage " & rsDet.fields("ANO")) Then
                                StrMsg = StrMsg & "Undo Removing Policy Holder Limit Usage Failed !" & vbCrLf
                            End If
                        End If
                    End If
                End If

            End If
            rsDet.MoveNext()
        Loop


        UndoExpireMaster = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        UndoExpireMaster = False
    End Function

    Private Function UpdatePreviousAcceptance(ByVal ANO As Long) As Boolean
        Dim rs As RemoteSet
        Dim pANO As Long
        Dim LANO As Long
        Dim AType As String
        Dim ADate As Date
        Dim PSDate As Date
        Dim PDate As Date

        On Error GoTo errmsg

        rs = db.OpenRemoteSet("Select PANO, LANO, AType, ADate, SDate, PDate from Acceptance Where ANO=" & ANO)
        pANO = toval(rs.fields("PANO"))
        LANO = toval(rs.fields("LANO"))
        AType = tostr(rs.fields("AType"))
        ADate = todate(rs.fields("ADate"))
        PSDate = todate(rs.fields("SDate"))
        PDate = todate(rs.fields("PDate"))

        If LANO <> -1 And AType <> "N" Then
            If AType = "A" Then
                'Update Previous Acceptance
                If Not db.Execute("Update Acceptance Set AStatus= 'C', CloseDate='" & Format(ADate, "MM/DD/YYYY") & "', CUserID='" & db_user & "' where ANO=" & pANO) Then GoTo errmsg
            End If
        End If


        If AType = "E" Or AType = "C" Or AType = "A" Then
            If AType <> "A" Then
                ' Set Previous Acceptance Status to Closed
                If PSDate <> PDate Then
                    If Not db.Execute("Update Acceptance Set AStatus='C', CloseDate='" & Format(ADate, "MM/DD/YYYY") & "', CUserID='" & db_user & "', PPDate='" & Format(PDate, "MM/DD/YYYY") & "' Where ANO=" & pANO) Then GoTo errmsg
                Else
                    ' Endorsement Period
                    If Not db.Execute("Update Acceptance Set AStatus='C', CloseDate='" & Format(ADate, "MM/DD/YYYY") & "', CUserID='" & db_user & "', PPDate=SDate Where ANO=" & pANO) Then GoTo errmsg
                End If
            End If
        End If

        UpdatePreviousAcceptance = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        UpdatePreviousAcceptance = False
    End Function

    Private Function UpdatePreviousClaim(ByVal CNO As Long) As Boolean
