    Private Function CopyAccTemp(ByVal TName As String, ByVal ANO As Long) As Boolean
        Dim rsSrc As RemoteSet
        Dim rsDst As RemoteSet
        Dim tPrefix As String
        tPrefix = "t"

        rsDst = db.OpenRemoteSet("Select * from " & TName & " Where 1<>1")
        rsSrc = db.OpenRemoteSet("Select * from " & tPrefix & TName & " Where ANO=" & ANO, adOpenForwardonly)
        Do While Not rsSrc.Eof
            rsDst.AddNew()
            db.backup_record(rsSrc, rsDst)
            If Not rsDst.Update Then GoTo errmsg
            rsSrc.MoveNext()
        Loop
        rsDst.CloseRemoteSet()
        rsSrc.CloseRemoteSet()
        CopyAccTemp = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        CopyAccTemp = False
    End Function
    Private Function CopyInterestTemp(ByVal ANO As Long) As Boolean
        Dim rsSrc1 As RemoteSet
        Dim rsDst1 As RemoteSet
        Dim rsSrc2 As RemoteSet
        Dim rsDst2 As RemoteSet

        ' Copy ICOVER & IINFO
        rsDst1 = db.OpenRemoteSet("Select * from ICover Where 1<>1")
        rsSrc1 = db.OpenRemoteSet("Select * from tICover Where ANO=" & ANO)
        Do While Not rsSrc1.Eof
            rsDst1.AddNew()
            db.backup_record(rsSrc1, rsDst1)
            If Not rsDst1.Update Then GoTo errmsg

            rsDst2 = db.OpenRemoteSet("Select * from IINFO Where 1<>1")
            rsSrc2 = db.OpenRemoteSet("Select * from tIINFO Where INO=" & toval(rsSrc1.fields("INO")))
            If Not rsSrc2.Eof Then
                rsDst2.AddNew()
                db.backup_record(rsSrc2, rsDst2)
                If Not rsDst2.Update Then GoTo errmsg
            End If
            rsDst2.CloseRemoteSet()
            rsSrc2.CloseRemoteSet()

            rsSrc1.MoveNext()
        Loop
        rsDst1.CloseRemoteSet()
        rsSrc1.CloseRemoteSet()

        CopyInterestTemp = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        CopyInterestTemp = False
    End Function
    Private Function CopyAccDetail(ByVal TName As String, ByVal ANO As Long, ByVal NewANO As Long, Optional ByVal tPrefix As String = "") As Boolean
        Dim rsSrc As RemoteSet
        Dim rsDst As RemoteSet

        rsDst = db.OpenRemoteSet("Select * from " & tPrefix & TName & " Where 1<>1")
        rsSrc = db.OpenRemoteSet("Select * from " & TName & " Where ANO=" & ANO)
        Do While Not rsSrc.Eof
            rsDst.AddNew()
            If tPrefix = "" Then
                ' Use This Statement Instead Of Backup_Record Speed Up Copy Process (But Source and Destination Must Be The Same Structure)
                If Not rsDst.PutRecord(rsSrc.GetRecord()) Then GoTo errmsg
            Else
                db.backup_record(rsSrc, rsDst)
            End If
            rsDst.fields("ANO") = NewANO
            If Not rsDst.Update Then GoTo errmsg
            rsSrc.MoveNext()
        Loop
        rsDst.CloseRemoteSet()
        rsSrc.CloseRemoteSet()
        CopyAccDetail = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        CopyAccDetail = False
    End Function
    Private Function Process_Reinsurance_Treaty(ByVal CNO As Long) As Boolean
        Dim i As Integer
        Dim RID As String
        Dim Amount As Double
        Dim Deductible As Double
        Dim EAmount As Double
        Dim EDeductible As Double
        Dim rsCA As RemoteSet
        Dim rs As RemoteSet
        On Error GoTo errmsg
        rsCA = db.OpenQueryDef("QCArrHeader", adOpenForwardonly, CNO)
        For i = 1 To 7
            RID = tostr(rsCA.fields("XL" & i & "ID"))
            If RID <> "" Then
                Amount = toval(rsCA.fields("XL" & i & "Amount"))
                EAmount = toval(rsCA.fields("XL" & i & "EAmount"))
                Deductible = toval(rsCA.fields("XL" & i & "Deductible"))
                EDeductible = toval(rsCA.fields("XL" & i & "EDeductible"))
                rs = db.OpenRemoteSet("Select * from Reinsurance Where RID='" & RID & "'")
                If Not rs.Eof Then
                    rs.Edit()
                    rs.fields("A_Deductible") = toval(rs.fields("A_Deductible")) + Deductible
                    rs.fields("A_EDeductible") = toval(rs.fields("A_EDeductible")) + EDeductible
                    rs.fields("A_Aggregate") = toval(rs.fields("A_Aggregate")) + Amount
                    rs.fields("A_EAggregate") = toval(rs.fields("A_EAggregate")) + EAmount
                    If Not rs.Update Then GoTo errmsg
                End If
            End If
        Next i
        Process_Reinsurance_Treaty = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Process_Reinsurance_Treaty = False
    End Function
    Private Function UnProcess_Reinsurance_Treaty(ByVal CNO As Long) As Boolean
        Dim i As Integer
        Dim RID As String
        Dim Amount As Double
        Dim Deductible As Double
        Dim EAmount As Double
        Dim EDeductible As Double
        Dim rsCA As RemoteSet
        Dim rs As RemoteSet
        On Error GoTo errmsg
        rsCA = db.OpenQueryDef("QCArrHeader", adOpenForwardonly, CNO)
        For i = 1 To 7
            RID = tostr(rsCA.fields("XL" & i & "ID"))
            If RID <> "" Then
                Amount = toval(rsCA.fields("XL" & i & "Amount"))
                EAmount = toval(rsCA.fields("XL" & i & "EAmount"))
                Deductible = toval(rsCA.fields("XL" & i & "Deductible"))
                EDeductible = toval(rsCA.fields("XL" & i & "EDeductible"))
                rs = db.OpenRemoteSet("Select * from Reinsurance Where RID='" & RID & "'")
                If Not rs.Eof Then
                    rs.Edit()
                    rs.fields("A_Deductible") = toval(rs.fields("A_Deductible")) - Deductible
                    rs.fields("A_EDeductible") = toval(rs.fields("A_EDeductible")) - EDeductible
                    rs.fields("A_Aggregate") = toval(rs.fields("A_Aggregate")) - Amount
                    rs.fields("A_EAggregate") = toval(rs.fields("A_EAggregate")) - EAmount
                    If Not rs.Update Then GoTo errmsg
                End If
            End If
        Next i
        UnProcess_Reinsurance_Treaty = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        UnProcess_Reinsurance_Treaty = False
    End Function

    Private Function Calc_Prorata(ByVal PSDate As Date, ByVal PEDate As Date, ByVal SDate As Date, ByVal EDate As Date, ByVal PPeriod As Integer) As Double
        Dim Denominator As Double
        Dim Nominator As Double
        If PPeriod = 3 Then       ' Half Monthly Prorate
            Nominator = Premium_Calc_Prorata(PSDate, PEDate, 0, 1, PPeriod, "")
            Denominator = Premium_Calc_Prorata(SDate, EDate, 0, 1, PPeriod, "")
        ElseIf PPeriod = 2 Then     ' Monthly Prorate
            Nominator = Premium_Calc_Prorata(PSDate, PEDate, 0, 1, PPeriod, "")
            Denominator = Premium_Calc_Prorata(SDate, EDate, 0, 1, PPeriod, "")
        ElseIf PSDate.Day = PEDate.Day And PSDate.Day = EDate.Day And SDate.Day = EDate.Day And PPeriod <> 1 And DateDiff(DateInterval.Month, SDate, EDate) <> 0 Then ' and not Daily Basis
            Nominator = DateDiff(DateInterval.Month, PSDate, PEDate)
            Denominator = DateDiff(DateInterval.Month, SDate, EDate)
        Else
            Nominator = DateDiff(DateInterval.Day, PSDate, PEDate)
            Denominator = DateDiff(DateInterval.Day, SDate, EDate)
        End If
        If Nominator <> 0 And Denominator <> 0 Then
            Calc_Prorata = Nominator / Denominator
        Else
            Calc_Prorata = 0
        End If
    End Function

    Private Function Premium_Calc_Prorata(ByVal PSDate As Date, ByVal PEDate As Date, ByVal DaysProrata As Integer, ByVal MonthsProrata As Integer, ByVal PPeriod As Integer, ByRef sProrata As String) As Double
        Dim Prorata As Double
        If PPeriod = 3 Then     ' Half Monthly Prorate
            Prorata = DateDiff(DateInterval.Month, PSDate, PEDate)
            If PSDate.Day > PEDate.Day Then
                Prorata = Prorata - 1
                If Prorata < 0 Then Prorata = 0
            End If
            If DateDiff(DateInterval.Day, DateAdd(DateInterval.Month, Prorata, PSDate), PEDate) > 15 Then
                Prorata = Prorata + 1
            End If
            sProrata = Format(Prorata, "#0") & "/" & MonthsProrata
            Prorata = Prorata / MonthsProrata
        ElseIf PPeriod = 2 Then     ' Monthly Prorate
            Prorata = DateDiff(DateInterval.Month, PSDate, PEDate)
            If DateAdd(DateInterval.Month, Prorata, PSDate) < PEDate Then
                Prorata = Prorata + 1
            End If
            sProrata = Format(Prorata, "#0") & "/" & MonthsProrata
            Prorata = Prorata / MonthsProrata
        ElseIf DaysProrata <> 0 And (PSDate.Day <> PEDate.Day Or PPeriod = 1) Then
            sProrata = Format(DateDiff(DateInterval.Day, PSDate, PEDate), "#0") & "/" & DaysProrata
            Prorata = DateDiff(DateInterval.Day, PSDate, PEDate) / DaysProrata
        Else
            sProrata = Format(DateDiff(DateInterval.Month, PSDate, PEDate), "#0") & "/" & MonthsProrata
            Prorata = DateDiff(DateInterval.Month, PSDate, PEDate) / MonthsProrata
        End If
        Premium_Calc_Prorata = Prorata
    End Function
    Private Function Create_Voucher(ByVal AdmNo As String, Optional ByVal CheckLockedDateF As Boolean = True, Optional ByVal Payment_CC As Double = 0, Optional ByVal PDate As Date = Nothing, Optional ByVal Rate As Double = 0) As String
        Dim i As Integer
        Dim rs As RemoteSet
        Dim Amount(20) As Double

        Dim Nominal As Double
        Dim diff As Double
        Dim UseTempVoucherF As Boolean
        Dim CheckMonthlyExchangeRateF As Boolean
        Dim CheckWeeklyExchangeRateF As Boolean
        Dim UseExchRateOnLossDate As Boolean
        Dim sAdmNo As String

        sAdmNo = "(" & tostr(AdmNo) & ")"

        On Error GoTo errmsg
        rs = db.OpenRemoteSet("Select UseTempVoucherF, UseExchRateOnLossDate, CheckMonthlyExchangeRateF, CheckWeeklyExchangeRateF from SysTab", adOpenForwardonly)
        UseTempVoucherF = toval(rs.fields("UseTempVoucherF"))
        CheckMonthlyExchangeRateF = toval(rs.fields("CheckMonthlyExchangeRateF"))
        CheckWeeklyExchangeRateF = toval(rs.fields("CheckWeeklyExchangeRateF"))
        UseExchRateOnLossDate = toval(rs.fields("UseExchRateOnLossDate"))

        Nominal = 0
        diff = 0
        For i = 1 To 20
            Amount(i - 1) = 0
        Next i

        Dim SQL As String = ""
        SQL = SQL & "Select "
        SQL = SQL & " Count(*) as NumRec,"
        SQL = SQL & " Max(A.ID) as ID, "
        SQL = SQL & " Max(A.Currency) as Currency, "
        SQL = SQL & " Max(A.CT) as CT, "
        SQL = SQL & " Max(A.Branch) as Branch, "
        SQL = SQL & " Max(A.RefNo) as RefNo, "
        SQL = SQL & " Max(A.DocNo) as DocNo, "
        SQL = SQL & " Max(A.ComAcc) as ComAcc, "
        SQL = SQL & " Max(Case When A.Subject='OTHERS' or A.TaxType<>'' Then A.TaxType Else P.TaxType End) as TaxType, "
        SQL = SQL & " Max(A.Date) as Date, "
        SQL = SQL & " Max(A.BillDate) as BillDate, "
        SQL = SQL & " Max(A.Installment) as Installment, "
        SQL = SQL & " Max(A.Remarks) as Remarks, "
        SQL = SQL & " Max(A.Voucher) as Voucher, "
        SQL = SQL & " Max(A.AccountNo) as AccountNo, "
        SQL = SQL & " Max(A.Bank) as Bank, "
        SQL = SQL & " Max(A.BankBranch) as BankBranch, "
        SQL = SQL & " Max(A.BankAccount) as BankAccount, "
        SQL = SQL & " Max(A.BankName) as BankName, "
        SQL = SQL & " Max(A.RefType) as RefType, "
        SQL = SQL & " Max(A.Subject) as Subject, "
        SQL = SQL & " Max(A.ISType) as ISType, "
        SQL = SQL & " Max(A.PNominal_Tax) as PNominal_Tax, "
        SQL = SQL & " Max(A.PNominal_VAT) as PNominal_VAT,"
        SQL = SQL & " Max(A.Type) as Type, "
        SQL = SQL & " Max(A.Code) as Code, "
        SQL = SQL & " cast(Max(cast(A.VoucherF as integer)) as Bit) as VoucherF, "
        SQL = SQL & " cast(Max(cast(A.TaxTableF as integer)) as Bit) as TaxTableF, "
        SQL = SQL & " cast(Max(cast(P.TaxF as integer)) as Bit) as TaxF, "
        SQL = SQL & " Max(T.TaxRate) as TaxRate,"
        SQL = SQL & " Max(A.Extra_1) as Extra_1,"
        SQL = SQL & " Max(A.Extra_2) as Extra_2,"
        SQL = SQL & " Max(A.Extra_3) as Extra_3,"
        SQL = SQL & " Max(A.Extra_4) as Extra_4,"
        SQL = SQL & " Max(A.Extra_5) as Extra_5,"
        SQL = SQL & " Max(A.Extra_6) as Extra_6,"
        SQL = SQL & " Max(P.CGroup) as CGroup,"
        SQL = SQL & " sum(A.Amount_1) as Amount_1,"
        SQL = SQL & " sum(A.Amount_2) as Amount_2,"
        SQL = SQL & " sum(A.Amount_3) as Amount_3,"
        SQL = SQL & " sum(A.Amount_4) as Amount_4,"
        SQL = SQL & " sum(A.Amount_5) as Amount_5,"
        SQL = SQL & " sum(A.Amount_6) as Amount_6,"
        SQL = SQL & " sum(A.Amount_7) as Amount_7,"
        SQL = SQL & " sum(A.Amount_8) as Amount_8,"
        SQL = SQL & " sum(A.Amount_9) as Amount_9,"
        SQL = SQL & " sum(A.Amount_10) as Amount_10,"
        SQL = SQL & " sum(A.Amount_11) as Amount_11,"
        SQL = SQL & " sum(A.Amount_12) as Amount_12,"
        SQL = SQL & " sum(A.Amount_13) as Amount_13,"
        SQL = SQL & " sum(A.Amount_14) as Amount_14,"
        SQL = SQL & " sum(A.Amount_15) as Amount_15,"
        SQL = SQL & " sum(A.Amount_16) as Amount_16,"
        SQL = SQL & " sum(A.Amount_17) as Amount_17,"
        SQL = SQL & " sum(A.Amount_18) as Amount_18,"
        SQL = SQL & " sum(A.Amount_19) as Amount_19,"
        SQL = SQL & " sum(A.Amount_20) as Amount_20,"
        SQL = SQL & " sum(A.LAmount) as LAmount,"
        SQL = SQL & " sum(A.AmountDue_1) as AmountDue_1, Min(A.DueDate_1) as DueDate_1,"
        SQL = SQL & " sum(A.AmountDue_2) as AmountDue_2, Min(A.DueDate_2) as DueDate_2,"
        SQL = SQL & " sum(A.AmountDue_3) as AmountDue_3, Min(A.DueDate_3) as DueDate_3,"
        SQL = SQL & " sum(A.AmountDue_4) as AmountDue_4, Min(A.DueDate_4) as DueDate_4,"
        SQL = SQL & " sum(A.AmountDue_5) as AmountDue_5, Min(A.DueDate_5) as DueDate_5,"
        SQL = SQL & " sum(A.AmountDue_6) as AmountDue_6, Min(A.DueDate_6) as DueDate_6,"
        SQL = SQL & " sum(A.AmountDue_7) as AmountDue_7, Min(A.DueDate_7) as DueDate_7,"
        SQL = SQL & " sum(A.AmountDue_8) as AmountDue_8, Min(A.DueDate_8) as DueDate_8,"
        SQL = SQL & " sum(A.AmountDue_9) as AmountDue_9, Min(A.DueDate_9) as DueDate_9,"
        SQL = SQL & " sum(A.AmountDue_10) as AmountDue_10, Min(A.DueDate_10) as DueDate_10,"
        SQL = SQL & " sum(A.AmountDue_11) as AmountDue_11, Min(A.DueDate_11) as DueDate_11,"
        SQL = SQL & " sum(A.AmountDue_12) as AmountDue_12, Min(A.DueDate_12) as DueDate_12,"
        SQL = SQL & " sum(A.AmountDue_13) as AmountDue_13, Min(A.DueDate_13) as DueDate_13,"
        SQL = SQL & " sum(A.AmountDue_14) as AmountDue_14, Min(A.DueDate_14) as DueDate_14,"
        SQL = SQL & " sum(A.AmountDue_15) as AmountDue_15, Min(A.DueDate_15) as DueDate_15,"
        SQL = SQL & " sum(A.AmountDue_16) as AmountDue_16, Min(A.DueDate_16) as DueDate_16,"
        SQL = SQL & " sum(A.AmountDue_17) as AmountDue_17, Min(A.DueDate_17) as DueDate_17,"
        SQL = SQL & " sum(A.AmountDue_18) as AmountDue_18, Min(A.DueDate_18) as DueDate_18,"
        SQL = SQL & " sum(A.AmountDue_19) as AmountDue_19, Min(A.DueDate_19) as DueDate_19,"
        SQL = SQL & " sum(A.AmountDue_20) as AmountDue_20, Min(A.DueDate_20) as DueDate_20,"
        SQL = SQL & " sum(A.AmountDue_21) as AmountDue_21, Min(A.DueDate_21) as DueDate_21,"
        SQL = SQL & " sum(A.AmountDue_22) as AmountDue_22, Min(A.DueDate_22) as DueDate_22,"
        SQL = SQL & " sum(A.AmountDue_23) as AmountDue_23, Min(A.DueDate_23) as DueDate_23,"
        SQL = SQL & " sum(A.AmountDue_24) as AmountDue_24, Min(A.DueDate_24) as DueDate_24"
        SQL = SQL & " from AdmLink A "
        SQL = SQL & " Inner Join Profile P on (P.ID=A.ID) "
        SQL = SQL & " Left Join TaxType T on (T.TaxType=Case When A.Subject='OTHERS' or A.TaxType<>'' Then A.TaxType Else P.TaxType End) "
        SQL = SQL & " Where A.VoucherF=0 and A.AdmNo in " & sAdmNo
        rs = db.OpenRemoteSet(SQL)
        If rs.Eof OrElse toval(rs.fields("NumRec")) = 0 Then
            Return "(NO DATA)"
        End If

        Dim strHint As String = ""
        For i = 1 To 20
            Amount(i - 1) = toval(rs.fields("Amount_" & i))
            If Amount(i - 1) > 0 Then
                Nominal = Nominal + Amount(i - 1)
            ElseIf Amount(i - 1) < 0 Then
                diff = diff - Amount(i - 1)
            End If
            If Amount(i - 1) <> 0 Then
                If strHint = "" Then
                    strHint = tostr(-i)
                Else
                    strHint = strHint & "," & tostr(-i)
                End If
            End If
        Next i

        If strHint = "" OrElse (Round(Nominal, 4) = 0 AndAlso Round(diff, 4) = 0 AndAlso Not toval(rs.fields("TaxTableF"))) Then
            ' Write Off
            If Not db.Execute("Update ADMLINK Set WriteF=1 Where VoucherF=0 and AdmNo in " & sAdmNo) Then GoTo errmsg
            Return "(WRITE-OFF)"
        End If

        Dim NumRec As Integer
        Dim TaxType As String
        Dim SL_Cat As String
        Dim ID As String
        Dim CCY As String
        Dim CT As String
        Dim Branch As String
        Dim RefNo As String
        Dim DocNo As String
        Dim ComAcc As String
        Dim VAT As Double
        Dim TAX As Double
        Dim VoucherDate As Date
        Dim RefCCYDate As Date
        Dim BillDate As Date

        ' Instalment Information
        Dim Installment As Long
        Dim AmountDue(24) As Double
        Dim DueDate(24) As Date

        Dim sign As Integer
        Dim Preference As String
        Dim Remarks As String
        Dim Voucher As String
        Dim AccountNo As String
        Dim Bank As String
        Dim BankBranch As String
        Dim BankAccount As String
        Dim BankName As String
        Dim RefType As String
        Dim Subject As String
        Dim ISType As String
        Dim VatF As Boolean
        Dim TaxF As Boolean
        Dim Extra_1 As String
        Dim Extra_2 As String
        Dim Extra_3 As String
        Dim Extra_4 As String
        Dim Extra_5 As String
        Dim Extra_6 As String
        Dim LAmount As Double

        SL_Cat = "N"
        NumRec = toval(rs.fields("NumRec"))
        ID = tostr(rs.fields("ID"))
        CCY = tostr(rs.fields("Currency"))
        CT = tostr(rs.fields("CT"))
        Branch = tostr(rs.fields("Branch"))
        RefNo = tostr(rs.fields("RefNo"))
        DocNo = tostr(rs.fields("DocNo"))
        ComAcc = tostr(rs.fields("ComAcc"))
        TaxType = tostr(rs.fields("TaxType"))
        VoucherDate = todate(rs.fields("Date"))
        BillDate = todate(rs.fields("BillDate"))
        Installment = toval(rs.fields("Installment"))
        Remarks = tostr(rs.fields("Remarks"))
        Voucher = tostr(rs.fields("Voucher"))
        AccountNo = tostr(rs.fields("AccountNo"))
        Bank = tostr(rs.fields("Bank"))
        BankBranch = tostr(rs.fields("BankBranch"))
        BankAccount = tostr(rs.fields("BankAccount"))
        BankName = tostr(rs.fields("BankName"))
        RefType = tostr(rs.fields("RefType"))
        Subject = tostr(rs.fields("Subject"))
        ISType = tostr(rs.fields("ISType"))
        Extra_1 = tostr(rs.fields("Extra_1"))
        Extra_2 = tostr(rs.fields("Extra_2"))
        Extra_3 = tostr(rs.fields("Extra_3"))
        Extra_4 = tostr(rs.fields("Extra_4"))
        Extra_5 = tostr(rs.fields("Extra_5"))
        Extra_6 = tostr(rs.fields("Extra_6"))
        LAmount = toval(rs.fields("LAmount"))
        If Subject.ToUpper = "CLAIM" Then
            VAT = toval(Amount(12)) ' 13
            TAX = toval(Amount(13)) + toval(Amount(17)) ' 14 + 18
        Else
            VAT = toval(Amount(12)) + toval(Amount(16)) + toval(Amount(17)) ' 13 + 17 + 18
            TAX = toval(Amount(13)) ' 14
        End If

        If Extra_1 = "" AndAlso Subject.ToUpper = "CLAIM" AndAlso UseExchRateOnLossDate = True Then
            RefCCYDate = DateSerial(Mid(Extra_2, 1, 4), Mid(Extra_2, 6, 2), Mid(Extra_2, 9, 2))
        Else
            RefCCYDate = VoucherDate
        End If

        VatF = VAT <> 0
        TaxF = TAX <> 0 Or (toval(rs.fields("PNominal_Tax")) <> 0 And toval(rs.fields("TaxF")) And toval(rs.fields("TaxRate")) <> 0) Or (toval(rs.fields("TaxTableF")))

        If TaxType = "" And TAX <> 0 Then
            StrMsg = "Please Check the Tax Type for Profile '" & ID & "' !"
            GoTo errmsg
        End If

        If CheckLockedDateF Then
            Dim LockedDate As Date
            Dim BLLocked As Integer
            LockedDate = GetLockedDate(Branch)
            BLLocked = GetUserBLLocked(db_user)

            If (DateDiff(DateInterval.Day, LockedDate, VoucherDate) <= 0 And (DateDiff(DateInterval.Day, LockedDate, Today.Date) > BLLocked Or BLLocked = 0)) Then
                StrMsg = "Please Check The Transaction Closing Period (Locked Date) !"
                GoTo errmsg
            End If
        End If

        For i = 1 To Installment
            AmountDue(i) = toval(rs.fields("AmountDue_" & i))
            DueDate(i) = todate(rs.fields("DueDate_" & i))
        Next i

        If Nominal - diff >= 0 Then
            sign = 1
        Else
            sign = -1
        End If

        Preference = tostr(rs.fields("Type") & "-" & rs.fields("Code")) & "-" & ISType
        If Subject.ToUpper = "PREMIUM" Then
            If Extra_4 = "Cancellation" Or Extra_4 = "Reinstatement" Then
                Preference = Preference & "-C"
            Else
                Preference = Preference & "-?"
            End If
        ElseIf Subject.ToUpper = "CLAIM" Then
            If Extra_3 = "CASH CALL" Then
                Preference = Preference & "-C"
            ElseIf Extra_5 = "Ex-Gratia" Then
                Preference = Preference & "-X"
            ElseIf Extra_6 <> "" Then
                Preference = Preference & "-" & Extra_6
            Else
                Preference = Preference & "-?"
            End If
        End If
        If tostr(rs.fields("CGroup")) <> "" Then
            Preference = Preference & "-" & tostr(rs.fields("CGroup"))
        End If

        If sign >= 0 Then
            rs = db.OpenRemoteSet("SELECT Top 1 VType.vType, VType.Description, VType.AutoNum, VType.DebtorF, VType.CreditorF From VType WHERE TaxF=0 and VatF=0 and '" & TaxType & "' Like VType.TaxType+'%' and '" & Preference & "' like VType.Code+'%' and VType.SL_Cat='" & SL_Cat & "' and VType.DebtorF=1 and (VType.CodeExt='" & Subject & "' or VType.CodeExt='') Order by VType.CodeExt Desc, Len(VType.Code) Desc, difference('" & Preference & "',VType.Code) Desc")
        Else
            rs = db.OpenRemoteSet("SELECT Top 1 VType.vType, VType.Description, VType.AutoNum, VType.DebtorF, VType.CreditorF From VType WHERE TaxF=0 and VatF=0 and '" & TaxType & "' Like VType.TaxType+'%' and '" & Preference & "' like VType.Code+'%' and VType.SL_Cat='" & SL_Cat & "' and VType.CreditorF=1 and (VType.CodeExt='" & Subject & "' or VType.CodeExt='') Order by VType.CodeExt Desc, Len(VType.Code) Desc, difference('" & Preference & "',VType.Code) Desc")
        End If
        If rs.Eof Then
            StrMsg = "No Voucher Type for Preference : " & Preference & " !"
            GoTo errmsg
        End If
        Dim Vtype As String
        Dim CreditorF As Boolean
        Dim DebtorF As Boolean
        Dim AutoNum As String

        Vtype = tostr(rs.fields("VType"))
        CreditorF = toval(rs.fields("CreditorF"))
        DebtorF = toval(rs.fields("DebtorF"))
        AutoNum = tostr(rs.fields("AutoNum"))

        rs = db.OpenRemoteSet("SELECT Top 1 ProAcc, Description, [Currency], RESTRICTEDF From ProAcc WHERE ProAcc.ID='" & ID & "' and [Currency]='" & CCY & "' order by RESTRICTEDF")
        If rs.Eof Then
            If Not Create_Proacc(ID, CCY) Then
                StrMsg = "Can't Create Profile Account for Profile ID " & ID & " !" & vbCrLf
                GoTo errmsg
            End If
            rs = db.OpenRemoteSet("SELECT Top 1 ProAcc, Description, [Currency], RESTRICTEDF From ProAcc WHERE ProAcc.ID='" & ID & "' and [Currency]='" & CCY & "' order by RESTRICTEDF")
        End If

        If rs.Eof Then
            StrMsg = "Profile Account Not Found for Profile ID " & ID & " !"
            GoTo errmsg
        ElseIf toval(rs.fields("RESTRICTEDF")) Then
            StrMsg = "Restricted Profile Account for Profile ID " & ID & " !"
            GoTo errmsg
        End If

        Dim ProAcc As String
        ProAcc = tostr(rs.fields("ProAcc"))

        If Voucher = "" Then Voucher = db.GetNextDocNo(AutoNum, VoucherDate, Branch)
        If Voucher = "" Then
            StrMsg = "Generate Voucher No. Failed !"
            GoTo errmsg
        End If
        Dim DataMaster As RemoteSet
        If Not UseTempVoucherF Then
            DataMaster = db.OpenRemoteSet("Select * from nVoucher Where 1<>1")
        Else
            DataMaster = db.OpenRemoteSet("Select * from tVoucher Where 1<>1")
        End If
        DataMaster.AddNew()
        DataMaster.fields("Voucher") = Voucher
        DataMaster.fields("VType") = Vtype
        DataMaster.fields("Date") = VoucherDate
        DataMaster.fields("RefCCYDate") = RefCCYDate
        DataMaster.fields("DueDate") = BillDate
        DataMaster.fields("CT") = CT
        DataMaster.fields("ProAcc") = ProAcc
        DataMaster.fields("Currency") = CCY
        DataMaster.fields("CreditorF") = IIf(CreditorF = True, 1, 0)
        DataMaster.fields("DebtorF") = IIf(DebtorF = True, 1, 0)
        DataMaster.fields("SL_Flag") = True
        DataMaster.fields("Currency") = CCY
        DataMaster.fields("TaxF") = TaxF
        DataMaster.fields("VatF") = VatF
        DataMaster.fields("Vat_CC") = toval(VAT) * sign
        DataMaster.fields("Tax_CC") = toval(TAX) * sign
        DataMaster.fields("TaxType") = TaxType
        DataMaster.fields("Branch") = Branch
        DataMaster.fields("SL_Cat") = SL_Cat
        DataMaster.fields("RefNo") = RefNo
        DataMaster.fields("DocNo") = DocNo
        DataMaster.fields("ComAcc") = ComAcc
        DataMaster.fields("Remarks") = Remarks
        DataMaster.fields("Bank") = Bank
        DataMaster.fields("BankBranch") = BankBranch
        DataMaster.fields("AccountNo") = AccountNo
        DataMaster.fields("BankAccount") = BankAccount
        DataMaster.fields("BankName") = BankName
        DataMaster.fields("RefType") = RefType
        DataMaster.fields("Installment") = Installment
        DataMaster.fields("Num_Doc") = 0
        DataMaster.fields("SL_Tag") = 0
        DataMaster.fields("AssetF") = 0
        DataMaster.fields("InvestmentF") = 0
        DataMaster.fields("SourceF") = 0
        DataMaster.fields("BranchF") = 0
        DataMaster.fields("ParentF") = 0
        DataMaster.fields("ChequeF") = 0

        Dim j As Integer
        Dim TAmountDue As Double
        Dim TAmountUnDue As Double
        TAmountDue = 0
        TAmountUnDue = 0
        If Installment <> 0 Then
            j = 1
            For i = 1 To Installment
                DataMaster.fields("AmountDue_" & i) = toval(AmountDue(i)) * sign
                DataMaster.fields("DueDate_" & i) = DueDate(i)
                If DateDiff(DateInterval.Day, BillDate, DataMaster.fields("DueDate_" & i)) <= 0 Then
                    j = i
                End If
            Next i
            DataMaster.fields("MDueDate") = DueDate(i - 1)
            For i = 1 To j
                TAmountDue = TAmountDue + AmountDue(i) * sign
            Next i
            TAmountUnDue = toval(IIf(sign > 0, Nominal, diff)) - toval(IIf(sign > 0, diff, Nominal)) - TAmountDue
        Else
            DataMaster.fields("MDueDate") = todate(DataMaster.fields("DueDate"))
            TAmountDue = toval(IIf(sign > 0, Nominal, diff)) - toval(IIf(sign > 0, diff, Nominal))
            TAmountUnDue = 0
        End If

        DataMaster.fields("PDate") = VoucherDate
        DataMaster.fields("CDate") = Today.Date
        DataMaster.fields("CTime") = Time()
        DataMaster.fields("UserID") = db_user
        DataMaster.fields("Last_Date") = Today.Date
        DataMaster.fields("Last_Time") = Time()
        DataMaster.fields("Last_Opr") = db_user
        DataMaster.fields("nPayment") = 0
        DataMaster.fields("Payment_CC") = 0
        DataMaster.fields("Payment_OC") = 0
        DataMaster.fields("TaxPayment_CC") = 0
        DataMaster.fields("TaxPayment_OC") = 0
        DataMaster.fields("NDueDate") = BillDate
        DataMaster.fields("CInstallment") = 1
        DataMaster.fields("AmountDue") = TAmountDue
        DataMaster.fields("AmountUnDue") = TAmountUnDue
        DataMaster.fields("LAmount") = LAmount * sign

        Dim Br_End_Date As Date
        Dim BackDatedDate As Date
        Dim BackDatedF As Boolean
        rs = db.OpenRemoteSet("Select B.end_date, B.BackDatedDate, S.BackDatedF from Branch B, SysUser S Where S.ID='" & db_user & "' and B.Branch='" & Branch & "'")
        Br_End_Date = todate(rs.fields("end_date"))
        BackDatedDate = todate(rs.fields("BackDatedDate"))
        BackDatedF = toval(rs.fields("BackDatedF"))
        If (DateDiff(DateInterval.Day, VoucherDate, Br_End_Date) >= 0) Then
            If BackDatedF And DateDiff(DateInterval.Day, VoucherDate, BackDatedDate) >= 0 Then
                DataMaster.fields("BackDatedF") = True
                DataMaster.fields("Posting_Flag") = True
                DataMaster.fields("Status") = "P"
                If Payment_CC <> 0 Then
                    DataMaster.fields("Payment_CC") = IIf(DebtorF, Payment_CC, -Payment_CC)
                    DataMaster.fields("PDate") = PDate
                End If
            Else
                ' Can't Backdated
                StrMsg = "Please Check The Last Ending Posting Date !"
                GoTo errmsg
            End If
        Else
            DataMaster.fields("BackDatedF") = False
            DataMaster.fields("Posting_Flag") = False
            DataMaster.fields("Status") = "U"
        End If

        If Not toval(DataMaster.fields("BackDatedF")) Then
            If CheckWeeklyExchangeRateF Then
                If Not Check_Weekly_Exchange_Rate(CCY, VoucherDate) Then
                    StrMsg = "Please Check The Weekly Exchange Rate : '" & CCY & "' Currency in '" & Format(VoucherDate, "mmm-yyyy") & "' !"
                    GoTo errmsg
                End If
            Else
                If CheckMonthlyExchangeRateF Then
                    If Not Check_Monthly_Exchange_Rate(CCY, VoucherDate) Then
                        StrMsg = "Please Check The Monthly Exchange Rate : '" & CCY & "' Currency in '" & Format(VoucherDate, "mmm-yyyy") & "' !"
                        GoTo errmsg
                    End If
                End If
            End If
        End If

        If Not (toval(DataMaster.fields("BackDatedF")) And Rate <> 0) Then
            Rate = exchange_rate(CCY, RefCCYDate)
        End If

        If Rate = 0 Then
            StrMsg = "No Exchange Rate for Currency " & CCY & " !"
            GoTo errmsg
        End If

        DataMaster.fields("Rate") = Rate

        Dim Rate_RC As Double = 0
        Rate_RC = exchange_rate_RC(CCY, RefCCYDate)
        DataMaster.fields("Rate_RC") = Rate_RC

        DataMaster.fields("Nominal_CC") = IIf(sign > 0, Nominal, diff)
        DataMaster.fields("Diff_CC") = IIf(sign > 0, diff, Nominal)
        DataMaster.fields("Nominal") = IIf(sign > 0, Nominal, diff) * Rate
        DataMaster.fields("Diff") = IIf(sign > 0, diff, Nominal) * Rate

        Dim rsHint As RemoteSet
        Dim Account As String = ""
        If Not UseTempVoucherF Then
            rs = db.OpenRemoteSet("Select * from nSL Where 1<>1")
        Else
            rs = db.OpenRemoteSet("Select * from tSL Where 1<>1")
        End If
        For i = 1 To 20
            If toval(Amount(i - 1)) <> 0 AndAlso i <> 11 AndAlso i <> 12 Then ' Payment Difference Skip
                If DebtorF Then
                    rsHint = db.OpenRemoteSet("Select V.Account from vPattern V, Account A where v.VType='" & Vtype & "' and A.Account=V.Account and A.Open_ItemF=1 and v.Debit=" & -i)
                Else
                    rsHint = db.OpenRemoteSet("Select V.Account from vPattern V, Account A where v.VType='" & Vtype & "' and A.Account=V.Account and A.Open_ItemF=1 and v.Credit=" & -i)
                End If
                If rsHint.Eof Then
                    StrMsg = "No Hint Preference -" & i & " ! for VType : '" & Vtype & "'"
                    GoTo errmsg
                End If
                If Account = "" Then Account = tostr(rsHint.fields("Account"))
                Exit For
            End If
        Next

        rsHint = db.OpenRemoteSet("Select H.Hint, H.ShortDesc, H.Remarks, H.ShortDesc_1, H.Remarks_1 from Hint H where H.Hint in (" & strHint & ")")
        Dim dv As DataView
        dv = New DataView(rsHint.GetDataSet.Tables(0))

        For i = 1 To 20
            If toval(Amount(i - 1)) <> 0 Then
                dv.RowFilter = "Hint=" & tostr(-i)

                If dv.ToTable.Rows.Count = 0 Then
                    StrMsg = "No Hint Preference -" & i & " ! for VType : '" & Vtype & "'"
                    GoTo errmsg
                End If

                Dim ShortDesc As String
                Dim Description As String

                If Subject.ToUpper = "PREMIUM" Then
                    ShortDesc = dv.ToTable.Rows(0)("ShortDesc")
                    Description = dv.ToTable.Rows(0)("Remarks")
                Else
                    ShortDesc = dv.ToTable.Rows(0)("ShortDesc_1")
                    Description = dv.ToTable.Rows(0)("Remarks_1")
                End If

                rs.AddNew()
                rs.fields("Voucher") = Voucher
                rs.fields("Doc_No") = ShortDesc
                rs.fields("Doc_Date") = VoucherDate
                rs.fields("Doc_Ccy") = CCY
                rs.fields("Nominal_OC") = Amount(i - 1) * sign
                rs.fields("Rate") = 1
                rs.fields("Nominator") = 1
                rs.fields("Denominator") = 1
                rs.fields("Nominal") = Amount(i - 1) * sign
                rs.fields("Remarks") = Description
                rs.fields("Account") = Account
                rs.fields("Hint") = -i
                If Not rs.UpdateRow() Then GoTo errmsg
                rsHint.CloseRemoteSet()
            End If
        Next i

        If Account = "" AndAlso rs.RecordCount <> 0 Then
            StrMsg = "No Open Item Account !"
            GoTo errmsg
        End If

        ' Update Admlink Status
        If Not db.Execute("Update ADMLINK Set VoucherF=1, Voucher='" & Voucher & "' Where VoucherF=0 and AdmNo in " & sAdmNo) Then GoTo errmsg
        If db.RecordsAffected <> NumRec Then GoTo errmsg

        ' Finally
        If Not DataMaster.Update() Then GoTo errmsg
        DataMaster.CloseRemoteSet()

        If Not rs.Update() Then GoTo errmsg
        rs.CloseRemoteSet()

        If ComAcc <> "" AndAlso toval(DataMaster.fields("DebtorF")) Then
            rs = db.OpenRemoteSet("Select * from ARBucket Where 1<>1")
            rs.AddNew()
            rs.fields("Voucher") = DataMaster.fields("Voucher")
            rs.fields("AmountPaid") = DataMaster.fields("Nominal_CC") - DataMaster.fields("Diff_CC")
            rs.fields("ComAcc") = ComAcc
            If Not rs.Update Then GoTo errmsg
        End If

        Create_Voucher = Voucher
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Create_Voucher = ""
    End Function
    Private Function Create_Proacc(ByVal ID As String, ByVal CCY As String) As Boolean
        On Error GoTo errmsg
        If Not db.Execute("Insert into ProAcc(ProAcc,[Currency],Description, ID, RestrictedF, PUserDate, PUserID) Select ID+'-'+ left([Currency].[Currency],3), [Currency].[Currency], Profile.Name, Profile.ID, 0, '" & Format(Today.Date, "MM/DD/YYYY") & "','" & db_user & "' from Profile, [Currency] Where Profile.ID='" & ID & "' and [Currency].[Currency]='" & CCY & "'") Then GoTo errmsg
        If db.RecordsAffected = 0 Then GoTo errmsg
        Create_Proacc = True
        Exit Function
errmsg:
        Create_Proacc = False
    End Function

    Private Function Check_Monthly_Exchange_Rate(ByVal CCY As String, ByVal PDate As Date) As Boolean
        Dim SDate As Date
        Dim rs As RemoteSet
        Dim BaseCCY As String
        rs = db.OpenRemoteSet("Select Currency from SysTab")
        BaseCCY = tostr(rs.fields("Currency"))
        If BaseCCY <> CCY Then
            SDate = DateSerial(Year(PDate), Month(PDate), 1)
            rs = db.OpenRemoteSet("Select top 1 * from Exchange Where Currency='" & CCY & "' and Effective Between '" & Format(SDate, "MM/DD/YYYY") & "' and '" & Format(PDate, "MM/DD/YYYY") & "'")
            Check_Monthly_Exchange_Rate = (Not rs.Eof)
        Else
            Check_Monthly_Exchange_Rate = True
        End If
    End Function
    Private Function Check_Weekly_Exchange_Rate(ByVal CCY As String, ByVal PDate As Date) As Boolean
        Dim SDate As Date
        Dim rs As RemoteSet
        Dim BaseCCY As String
        rs = db.OpenRemoteSet("Select Currency from SysTab")
        BaseCCY = tostr(rs.fields("Currency"))
        If BaseCCY <> CCY Then
            If Weekday(PDate) >= 2 Then
                SDate = DateAdd(DateInterval.Day, -(Weekday(PDate) - 2), PDate)
            Else
                SDate = DateAdd(DateInterval.Day, -(7 - Weekday(PDate)), PDate)
            End If
            rs = db.OpenRemoteSet("Select Top 1 * from Exchange Where Currency='" & CCY & "' and Effective Between '" & Format(SDate, "MM/DD/YYYY") & "' and '" & Format(PDate, "MM/DD/YYYY") & "'")
            Check_Weekly_Exchange_Rate = (Not rs.Eof)
        Else
            Check_Weekly_Exchange_Rate = True
        End If
    End Function
    Private Function exchange_rate(ByVal CCode As String, ByVal PDate As Object) As Double
        Dim rs As RemoteSet

        On Error GoTo errmsg

        rs = db.OpenRemoteSet("Select Currency from SysTab", adOpenForwardonly)
        If CCode.ToUpper <> tostr(rs.fields("Currency")).ToString.ToUpper And IsDate(PDate) Then
            rs = db.OpenRemoteSet("Select Rate from Currency Where Currency='" & CCode & "' and Effective<='" & Format(PDate, "MM/DD/YYYY") & "'")
            If Not rs.Eof Then
                exchange_rate = rs.fields("Rate")
            Else
                rs = db.OpenRemoteSet("select Top 1 exchange.rate from exchange where exchange.currency='" & CCode & "' and exchange.effective<='" & Format(PDate, "MM/DD/YYYY") & "' Order by exchange.effective desc", adOpenForwardonly)
                If Not rs.Eof Then
                    exchange_rate = rs.fields("Rate")
                Else
                    exchange_rate = 1
                End If
            End If
            If exchange_rate <= 0 Then exchange_rate = 1
        Else
            exchange_rate = 1
        End If
        rs.CloseRemoteSet()
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        exchange_rate = 1
    End Function
    Private Function exchange_rate_RC(ByVal CCode As String, ByVal PDate As Object) As Double
        Dim rs As RemoteSet

        On Error GoTo errmsg

        rs = db.OpenRemoteSet("Select Currency_1 from SysTab", adOpenForwardonly)
        If CCode.ToUpper <> tostr(rs.fields("Currency_1")).ToString.ToUpper And IsDate(PDate) Then
            rs = db.OpenRemoteSet("Select Rate_RC from Currency Where Currency='" & CCode & "' and Effective<='" & Format(PDate, "MM/DD/YYYY") & "'")
            If Not rs.Eof Then
                exchange_rate_RC = rs.fields("Rate_RC")
            Else
                rs = db.OpenRemoteSet("select Top 1 exchange.Rate_RC from exchange where exchange.currency='" & CCode & "' and exchange.effective<='" & Format(PDate, "MM/DD/YYYY") & "' Order by exchange.effective desc", adOpenForwardonly)
                If Not rs.Eof Then
                    exchange_rate_RC = rs.fields("Rate_RC")
                Else
                    exchange_rate_RC = 1
                End If
            End If
            If exchange_rate_RC <= 0 Then exchange_rate_RC = 1
        Else
            exchange_rate_RC = 1
        End If
        rs.CloseRemoteSet()
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        exchange_rate_RC = 1
    End Function
    Private Function Exchange_Rate_From_To(ByVal fccy As String, ByVal tccy As String, ByVal tdate As Date) As Double
        Dim sConv As Double
        Dim tConv As Double

        sConv = exchange_rate(fccy, tdate)
        tConv = exchange_rate(tccy, tdate)
        If tConv <> 0 Then
            Exchange_Rate_From_To = sConv / tConv
        Else
            Exchange_Rate_From_To = 1
        End If
    End Function
    Private Sub Get_BankAccount(ByVal ID As String, ByVal Currency As String, ByRef Bank As String, ByRef BankBranch As String, ByRef AccountNo As String, ByRef BankAccount As String, ByRef BankName As String)
