                            rsAA.fields("ID") = tostr(rs.fields("ID"))
                            rsAA.fields("REFNO") = tostr(rs.fields("DocNo"))
                            rsAA.fields("POLICYNO") = PolicyNo
                            rsAA.fields("DocNo") = DocNo
                            rsAA.fields("DATE") = ADate
                            rsAA.fields("BILLDATE") = BillDate
                            rsAA.fields("TOC") = TOC
                            rsAA.fields("Remarks") = AName
                            rsAA.fields("CAmount") = CR
                            rsAA.fields("Amount_OC") = CR * (1 + RProrata)
                            rsAA.fields("Amount") = CR * (1 + RProrata)
                            rsAA.fields("Currency_OC") = CCode
                            rsAA.fields("Currency") = CCode
                            rsAA.fields("Rate") = 1
                            rsAA.fields("AdmNo") = -1
                            rsAA.fields("PProrata") = PProrata
                            rsAA.fields("AdjustableF") = AdjustableF
                            rsAA.fields("AdjMethod") = AdjMethod
                            rsAA.fields("RCode") = RCode
                            rsAA.fields("AType") = AType
                            rsAA.fields("NoRefundF") = pNoRefundF
                            rsAA.fields("CommPoolF") = False
                            If Not rsAA.UpdateRow Then GoTo errmsg
                        End If
                    End If

                    ' Joint Placement
                    If rs.fields("JP") <> 0 Then
                        If UjrohShariaF Then
                            Ujroh = Premium * toval(rs.fields("UJROHCEDANT")) / 100
                        Else
                            Ujroh = 0
                        End If

                        ' Premium
                        If Premium <> 0 Then
                            rsAA.AddNew()
                            rsAA.fields("BizMapID") = BizMapID
                            rsAA.fields("MSCode") = MSCode
                            rsAA.fields("Source") = Source
                            rsAA.fields("SDate") = todate(rsIC.fields("SDate"))
                            rsAA.fields("EDate") = todate(rsIC.fields("EDate"))
                            rsAA.fields("ANO") = ANO
                            rsAA.fields("Type") = "JP"
                            rsAA.fields("Code") = "P"
                            rsAA.fields("ID") = tostr(rs.fields("ID"))
                            rsAA.fields("REFNO") = tostr(rs.fields("DocNo"))
                            rsAA.fields("POLICYNO") = PolicyNo
                            rsAA.fields("DocNo") = DocNo
                            rsAA.fields("DATE") = ADate
                            rsAA.fields("BILLDATE") = BillDate
                            rsAA.fields("TOC") = TOC
                            rsAA.fields("Remarks") = AName
                            rsAA.fields("CAmount") = toval(rs.fields("JP")) / 100 * IIf(UjrohShariaF, Premium, Premium * (100 - toval(rs.fields("UJROHCEDANT"))) / 100)
                            rsAA.fields("Amount_OC") = toval(rsAA.fields("CAmount")) * (1 + RProrata)
                            rsAA.fields("Amount") = toval(rsAA.fields("CAmount")) * (1 + RProrata)
                            rsAA.fields("Currency_OC") = CCode
                            rsAA.fields("Currency") = CCode
                            rsAA.fields("Rate") = 1
                            rsAA.fields("AdmNo") = -1
                            rsAA.fields("PProrata") = PProrata
                            rsAA.fields("AdjustableF") = AdjustableF
                            rsAA.fields("AdjMethod") = AdjMethod
                            rsAA.fields("RCode") = RCode
                            rsAA.fields("AType") = AType
                            rsAA.fields("NoRefundF") = pNoRefundF
                            rsAA.fields("CommPoolF") = False
                            If Not rsAA.UpdateRow Then GoTo errmsg
                        End If

                        ' Ujroh
                        If Ujroh <> 0 Then
                            rsAA.AddNew()
                            rsAA.fields("BizMapID") = BizMapID
                            rsAA.fields("MSCode") = MSCode
                            rsAA.fields("Source") = Source
                            rsAA.fields("SDate") = todate(rsIC.fields("SDate"))
                            rsAA.fields("EDate") = todate(rsIC.fields("EDate"))
                            rsAA.fields("ANO") = ANO
                            rsAA.fields("Type") = "JP"
                            rsAA.fields("Code") = "U"
                            rsAA.fields("ID") = tostr(rs.fields("ID"))
                            rsAA.fields("REFNO") = tostr(rs.fields("DocNo"))
                            rsAA.fields("POLICYNO") = PolicyNo
                            rsAA.fields("DocNo") = DocNo
                            rsAA.fields("DATE") = ADate
                            rsAA.fields("BILLDATE") = BillDate
                            rsAA.fields("TOC") = TOC
                            rsAA.fields("Remarks") = AName
                            rsAA.fields("CAmount") = -toval(rs.fields("JP")) / 100 * Ujroh
                            rsAA.fields("Amount_OC") = toval(rsAA.fields("CAmount")) * (1 + RProrata)
                            rsAA.fields("Amount") = toval(rsAA.fields("CAmount")) * (1 + RProrata)
                            rsAA.fields("Currency_OC") = CCode
                            rsAA.fields("Currency") = CCode
                            rsAA.fields("Rate") = 1
                            rsAA.fields("AdmNo") = -1
                            rsAA.fields("PProrata") = PProrata
                            rsAA.fields("AdjustableF") = AdjustableF
                            rsAA.fields("AdjMethod") = AdjMethod
                            rsAA.fields("RCode") = RCode
                            rsAA.fields("AType") = AType
                            rsAA.fields("NoRefundF") = pNoRefundF
                            rsAA.fields("CommPoolF") = False
                            If Not rsAA.UpdateRow Then GoTo errmsg
                        End If

                        ' Ujroh Fee
                        Fee = (IIf(UjrohShariaF, Premium, Premium * (100 - toval(rs.fields("UJROHCEDANT"))) / 100) - Ujroh) * toval(rs.fields("UJROHREINS")) / 100
                        If Fee <> 0 Then
                            rsAA.AddNew()
                            rsAA.fields("BizMapID") = BizMapID
                            rsAA.fields("MSCode") = MSCode
                            rsAA.fields("Source") = Source
                            rsAA.fields("SDate") = todate(rsIC.fields("SDate"))
                            rsAA.fields("EDate") = todate(rsIC.fields("EDate"))
                            rsAA.fields("ANO") = ANO
                            rsAA.fields("Type") = "JP"
                            rsAA.fields("Code") = "F"
                            rsAA.fields("ID") = tostr(rs.fields("ID"))
                            rsAA.fields("REFNO") = tostr(rs.fields("DocNo"))
                            rsAA.fields("POLICYNO") = PolicyNo
                            rsAA.fields("DocNo") = DocNo
                            rsAA.fields("DATE") = ADate
                            rsAA.fields("BILLDATE") = BillDate
                            rsAA.fields("TOC") = TOC
                            rsAA.fields("Remarks") = AName
                            rsAA.fields("CAmount") = toval(rs.fields("JP")) / 100 * Fee
                            rsAA.fields("Amount_OC") = toval(rsAA.fields("CAmount")) * (1 + RProrata)
                            rsAA.fields("Amount") = toval(rsAA.fields("CAmount")) * (1 + RProrata)
                            rsAA.fields("Currency_OC") = CCode
                            rsAA.fields("Currency") = CCode
                            rsAA.fields("Rate") = 1
                            rsAA.fields("AdmNo") = -1
                            rsAA.fields("PProrata") = PProrata
                            rsAA.fields("AdjustableF") = AdjustableF
                            rsAA.fields("AdjMethod") = AdjMethod
                            rsAA.fields("RCode") = RCode
                            rsAA.fields("AType") = AType
                            rsAA.fields("NoRefundF") = pNoRefundF
                            rsAA.fields("CommPoolF") = False
                            If Not rsAA.UpdateRow Then GoTo errmsg
                        End If

                        ' Discount
                        Discount = toval(rs.fields("JP")) / 100 * (Premium * (1 - (1 - GDiscount / 100) * (1 - NDiscount / 100) * (1 - PDiscount / 100) * (1 + SLoading / 100)))
                        If Discount <> 0 Then
                            rsAA.AddNew()
                            rsAA.fields("BizMapID") = BizMapID
                            rsAA.fields("MSCode") = MSCode
                            rsAA.fields("Source") = Source
                            rsAA.fields("SDate") = todate(rsIC.fields("SDate"))
                            rsAA.fields("EDate") = todate(rsIC.fields("EDate"))
                            rsAA.fields("ANO") = ANO
                            rsAA.fields("Type") = "JP"
                            rsAA.fields("Code") = "O"
                            rsAA.fields("ID") = tostr(rs.fields("ID"))
                            rsAA.fields("REFNO") = tostr(rs.fields("DocNo"))
                            rsAA.fields("POLICYNO") = PolicyNo
                            rsAA.fields("DocNo") = DocNo
                            rsAA.fields("DATE") = ADate
                            rsAA.fields("BILLDATE") = BillDate
                            rsAA.fields("TOC") = TOC
                            rsAA.fields("Remarks") = AName
                            rsAA.fields("CAmount") = -Discount
                            rsAA.fields("Amount_OC") = -Discount * (1 + RProrata)
                            rsAA.fields("Amount") = -Discount * (1 + RProrata)
                            rsAA.fields("Currency_OC") = CCode
                            rsAA.fields("Currency") = CCode
                            rsAA.fields("Rate") = 1
                            rsAA.fields("AdmNo") = -1
                            rsAA.fields("PProrata") = PProrata
                            rsAA.fields("AdjustableF") = AdjustableF
                            rsAA.fields("AdjMethod") = AdjMethod
                            rsAA.fields("RCode") = RCode
                            rsAA.fields("AType") = AType
                            rsAA.fields("NoRefundF") = pNoRefundF Or dNoRefundF
                            rsAA.fields("CommPoolF") = False
                            If Not rsAA.UpdateRow Then GoTo errmsg
                        End If

                        ' Commission
                        Commission = toval(rs.fields("JP") / 100 * toval(rs.fields("RComm")) / 100 * Premium)
                        If Commission <> 0 Then
                            rsAA.AddNew()
                            rsAA.fields("BizMapID") = BizMapID
                            rsAA.fields("MSCode") = MSCode
                            rsAA.fields("Source") = Source
                            rsAA.fields("SDate") = todate(rsIC.fields("SDate"))
                            rsAA.fields("EDate") = todate(rsIC.fields("EDate"))
                            rsAA.fields("ANO") = ANO
                            rsAA.fields("Type") = "JP"
                            rsAA.fields("Code") = "C"
                            rsAA.fields("ID") = tostr(rs.fields("ID"))
                            rsAA.fields("REFNO") = tostr(rs.fields("DocNo"))
                            rsAA.fields("POLICYNO") = PolicyNo
                            rsAA.fields("DocNo") = DocNo
                            rsAA.fields("DATE") = ADate
                            rsAA.fields("BILLDATE") = BillDate
                            rsAA.fields("TOC") = TOC
                            rsAA.fields("Remarks") = AName
                            rsAA.fields("CAmount") = -Commission
                            rsAA.fields("Amount_OC") = -Commission * (1 + RProrata)
                            rsAA.fields("Amount") = -Commission * (1 + RProrata)
                            rsAA.fields("Currency_OC") = CCode
                            rsAA.fields("Currency") = CCode
                            rsAA.fields("Rate") = 1
                            rsAA.fields("AdmNo") = -1
                            rsAA.fields("PProrata") = PProrata
                            rsAA.fields("AdjustableF") = AdjustableF
                            rsAA.fields("AdjMethod") = AdjMethod
                            rsAA.fields("RCode") = RCode
                            rsAA.fields("AType") = AType
                            rsAA.fields("NoRefundF") = pNoRefundF
                            rsAA.fields("CommPoolF") = False
                            If Not rsAA.UpdateRow Then GoTo errmsg
                        End If
                    End If
                    rs.MoveNext()
                Loop
                rs.CloseRemoteSet()
            End If

            'Business Source
            Dim CommPoolF As Boolean
            Dim AlternateF As Boolean
            Dim GrossUpComm As Double
            Dim TotalUpFee As Double
            Dim bNoRefundF As Boolean
            Dim StampDutyF As Boolean
            Dim NoProrataF As Boolean
            Dim BSID As String
            Dim pVATSubsidiesF As Boolean
            GrossUpComm = 0
            TotalUpFee = 0
            AlternateF = True
            If ANO <> LANO And LANO <> -1 Then
                ' Alternate Business Source
                rs = db.OpenQueryDef("QAAccBS", adOpenForwardonly, SANO)
                If rs.Eof Then
                    rs = db.OpenQueryDef("QAccBS", adOpenForwardonly, LANO)
                    AlternateF = False
                End If
            Else
                rs = db.OpenQueryDef("QAccBS", adOpenForwardonly, SANO)
                AlternateF = False
            End If
            Do While Not rs.Eof
                pVATSubsidiesF = VATSubsidiesF
                CommPoolF = toval(rs.fields("CommPoolF"))
                BSTYPE = tostr(rs.fields("BSType"))
                bNoRefundF = toval(rs.fields("NoRefundF"))
                NoProrataF = toval(rs.fields("NoProrataF"))
                StampDutyF = (BSTYPE = "O")
                BSID = rs.fields("BSID")
                If BSID = "" Then BSID = rs.fields("ID")

                Dim DiscFactor As Double
                Discount = 0
                Commission = 0
                UpFee = 0

                Dim VAT As Double = 0
                Dim TAX As Double = 0

                If Not toval(rs.fields("NotMinimumPremiumF")) Or (toval(rs.fields("NotMinimumPremiumF")) And Not toval(rsIC.fields("MinimumPremiumF"))) Then
                    ' Net after Payor Discount (and Group Discount)
                    If rs.fields("NetF") Then
                        DiscFactor = (1 - GDiscount / 100) * (1 - NDiscount / 100) * (1 - PDiscount / 100) * (1 + SLoading / 100)
                        ' Net after Group Discount
                    ElseIf rs.fields("NetGroupF") Then
                        DiscFactor = (1 - GDiscount / 100)
                    Else
                        DiscFactor = 1
                    End If

                    If NumCCY = 1 Then
                        ' in Original Currency
                        Commission = toval(rs.fields("FeeAmount")) / rsIC.RecordCount * QTY
                    Else
                        Commission = toval(rs.fields("FeeAmount")) / rsIC.RecordCount / Rate * QTY
                    End If

                    If Commission = 0 Then
                        Commission = toval(rs.fields("Fee")) / 100 * (Gross + IIf(toval(rs.fields("GrossF")), FDiscount - FLoading, IIf(toval(rs.fields("GrossBLF")), -FLoading, 0))) * QTY * DiscFactor
                    End If
                    Discount = toval(rs.fields("Discount")) / 100 * Gross * QTY
                    UpFee = toval(rs.fields("UpFee")) / 100 * Gross * QTY

                    'Business Source Detail
                    If AlternateF Then
                        rsDetail = db.OpenQueryDef("QAAccBSDet_1", adOpenForwardonly, SANO, tostr(rs.fields("ID")), tostr(rs.fields("BSType")), RCode, DateDiff(DateInterval.Month, PSDate, todate(rsIC.fields("SDate"))) \ 12 + 1)
                    Else
                        If ANO <> LANO And LANO <> -1 Then
                            rsDetail = db.OpenQueryDef("QAccBSDet_1", adOpenForwardonly, LANO, tostr(rs.fields("ID")), tostr(rs.fields("BSType")), RCode, DateDiff(DateInterval.Month, PSDate, todate(rsIC.fields("SDate"))) \ 12 + 1)
                        Else
                            rsDetail = db.OpenQueryDef("QAccBSDet_1", adOpenForwardonly, SANO, tostr(rs.fields("ID")), tostr(rs.fields("BSType")), RCode, DateDiff(DateInterval.Month, PSDate, todate(rsIC.fields("SDate"))) \ 12 + 1)
                        End If
                    End If

                    If Not rsDetail.Eof Then
                        If NumCCY = 1 Then
                            ' In Original Currency
                            Commission = toval(rsDetail.fields("FeeAmount")) * QTY
                        Else
                            Commission = toval(rsDetail.fields("FeeAmount")) / Rate * QTY
                        End If
                        If Commission = 0 Then
                            Commission = toval(rsDetail.fields("Fee")) / 100 * (Gross + IIf(toval(rs.fields("GrossF")), FDiscount - FLoading, IIf(toval(rs.fields("GrossBLF")), -FLoading, 0))) * QTY * DiscFactor
                        End If
                        Discount = toval(rsDetail.fields("Discount")) / 100 * Gross * QTY
                    End If
                    rsDetail.CloseRemoteSet()

                    If toval(rs.fields("CommAfterMinPremiumF")) Then
                        Dim MinPremium As Double
                        MinPremium = Get_minimum_Premium_By_Rate_Code(LANO, RCode, Branch, TOC, CCode, SType, Source, SDate, PProrata, 100)

                        If MinPremium <> 0 AndAlso Gross >= MinPremium AndAlso (Gross - Commission / QTY) < MinPremium Then
                            Commission = (Gross - MinPremium) * QTY
                        End If
                    End If

                    ' Overriding Discount (see Scheme Transaction)
                    If sDiscount <> 0 Then
                        Discount = sDiscount / 100 * Gross * QTY
                    End If

                    If toval(rs.fields("GrossUpF")) Then
                        GrossUpComm = GrossUpComm + Commission / (Gross * QTY * DiscFactor) * 100 + toval(rs.fields("UpFee"))
                    ElseIf toval(rs.fields("NetUpF")) Then
                        If VAT = 0 AndAlso TAX = 0 Then Get_Profile_VAT_TAX(rs.fields("ID"), PDate, "B" & BSTYPE, VAT, TAX, pVATSubsidiesF)
                        GrossUpComm = GrossUpComm + Commission / (Gross * QTY * DiscFactor) * 100 * (100 + VAT - TAX) / 100 + toval(rs.fields("UpFee"))
                    End If

                    If Not toval(rs.fields("GrossUpF")) And Not toval(rs.fields("NetUpF")) Then
                        Commission = Commission - Commission * GrossUpComm / 100
                        Discount = Discount - Discount * GrossUpComm / 100
                        UpFee = UpFee - UpFee * GrossUpComm / 100
                    End If

                    TotalUpFee = TotalUpFee + UpFee

                    'Discount To Insured
                    If Discount <> 0 Then
                        rsAA.AddNew()
                        rsAA.fields("BizMapID") = BizMapID
                        rsAA.fields("MSCode") = MSCode
                        rsAA.fields("Source") = Source
                        rsAA.fields("SDate") = todate(rsIC.fields("SDate"))
                        rsAA.fields("EDate") = todate(rsIC.fields("EDate"))
                        rsAA.fields("ANO") = ANO
                        rsAA.fields("Type") = PType
                        rsAA.fields("Code") = "O"
                        rsAA.fields("ID") = PID
                        rsAA.fields("REFNO") = RefNo
                        rsAA.fields("POLICYNO") = PolicyNo
                        rsAA.fields("DocNo") = DocNo
                        rsAA.fields("DATE") = ADate
                        rsAA.fields("BILLDATE") = BillDate
                        rsAA.fields("TOC") = TOC
                        rsAA.fields("Remarks") = AName
                        If toval(rs.fields("MemberF")) Then
                            rsAA.fields("CAmount") = toval(rsIC.fields("Share")) / 100 * -Discount * (1 - PShare / 100)
                        Else
                            rsAA.fields("CAmount") = toval(rsIC.fields("Share")) / 100 * -Discount
                        End If
                        rsAA.fields("Amount_OC") = toval(rsAA.fields("CAmount")) * (1 + RProrata)
                        rsAA.fields("Amount") = toval(rsAA.fields("CAmount")) * (1 + RProrata)
                        rsAA.fields("Currency_OC") = CCode
                        rsAA.fields("Currency") = CCode
                        rsAA.fields("Rate") = 1
                        rsAA.fields("AdmNo") = -1
                        rsAA.fields("PProrata") = PProrata
                        rsAA.fields("AdjustableF") = IIf(NoProrataF, False, AdjustableF)
                        rsAA.fields("AdjMethod") = AdjMethod
                        rsAA.fields("RCode") = RCode
                        rsAA.fields("AType") = AType
                        rsAA.fields("NoRefundF") = (pNoRefundF Or bNoRefundF)
                        rsAA.fields("CommPoolF") = False
                        If Not rsAA.UpdateRow Then GoTo errmsg
                    End If

                    If (Discount - UpFee) <> Commission Then
                        'Discount From Agent/Broker
                        If (Discount - UpFee) <> 0 Then
                            rsAA.AddNew()
                            rsAA.fields("BizMapID") = BizMapID
                            rsAA.fields("MSCode") = MSCode
                            rsAA.fields("Source") = Source
                            rsAA.fields("SDate") = todate(rsIC.fields("SDate"))
                            rsAA.fields("EDate") = todate(rsIC.fields("EDate"))
                            rsAA.fields("ANO") = ANO
                            rsAA.fields("Type") = "B" & BSTYPE
                            rsAA.fields("Code") = "O"
                            rsAA.fields("ID") = BSID
                            rsAA.fields("REFNO") = IIf(CommPoolF, PolicyNo, RefNo)
                            rsAA.fields("POLICYNO") = PolicyNo
                            rsAA.fields("DocNo") = IIf(CommPoolF, PolicyNo, DocNo)
                            rsAA.fields("DATE") = IIf(CommPoolF, Last_date_of_period(ADate, 1), ADate)
                            rsAA.fields("BILLDATE") = IIf(CommPoolF, Last_date_of_period(ADate, 1), BillDate)
                            rsAA.fields("TOC") = TOC
                            rsAA.fields("Remarks") = AName
                            If toval(rs.fields("MemberF")) Then
                                rsAA.fields("CAmount") = toval(rsIC.fields("Share")) / 100 * (Discount - UpFee) * (1 - PShare / 100)
                            Else
                                rsAA.fields("CAmount") = toval(rsIC.fields("Share")) / 100 * (Discount - UpFee)
                            End If
                            rsAA.fields("Amount_OC") = toval(rsAA.fields("CAmount")) * (1 + RProrata)
                            rsAA.fields("Amount") = toval(rsAA.fields("CAmount")) * (1 + RProrata)
                            rsAA.fields("Currency_OC") = CCode
                            rsAA.fields("Currency") = CCode
                            rsAA.fields("Rate") = 1
                            rsAA.fields("AdmNo") = -1
                            rsAA.fields("PProrata") = PProrata
                            rsAA.fields("AdjustableF") = IIf(NoProrataF, False, AdjustableF)
                            rsAA.fields("AdjMethod") = AdjMethod
                            rsAA.fields("RCode") = RCode
                            rsAA.fields("AType") = AType
                            rsAA.fields("NoRefundF") = (pNoRefundF Or bNoRefundF)
                            rsAA.fields("CommPoolF") = CommPoolF
                            If Not rsAA.UpdateRow Then GoTo errmsg
                        End If

                        'Commission To Agent/Broker
                        If Commission <> 0 Then
                            rsAA.AddNew()
                            rsAA.fields("BizMapID") = BizMapID
                            rsAA.fields("MSCode") = MSCode
                            rsAA.fields("Source") = Source
                            rsAA.fields("SDate") = todate(rsIC.fields("SDate"))
                            rsAA.fields("EDate") = todate(rsIC.fields("EDate"))
                            rsAA.fields("ANO") = ANO
                            rsAA.fields("Type") = "B" & BSTYPE
                            rsAA.fields("Code") = "C"
                            rsAA.fields("ID") = BSID
                            rsAA.fields("REFNO") = IIf(CommPoolF, PolicyNo, RefNo)
                            rsAA.fields("POLICYNO") = PolicyNo
                            rsAA.fields("DocNo") = IIf(CommPoolF, PolicyNo, DocNo)
                            rsAA.fields("DATE") = IIf(CommPoolF, Last_date_of_period(ADate, 1), ADate)
                            rsAA.fields("BILLDATE") = IIf(CommPoolF, Last_date_of_period(ADate, 1), BillDate)
                            rsAA.fields("TOC") = TOC
                            rsAA.fields("Remarks") = AName
                            If toval(rs.fields("MemberF")) Then
                                rsAA.fields("CAmount") = toval(rsIC.fields("Share")) / 100 * -Commission * (1 - PShare / 100)
                            Else
                                rsAA.fields("CAmount") = toval(rsIC.fields("Share")) / 100 * -Commission
                            End If
                            rsAA.fields("Amount_OC") = toval(rsAA.fields("CAmount")) * (1 + RProrata)
                            rsAA.fields("Amount") = toval(rsAA.fields("CAmount")) * (1 + RProrata)
                            rsAA.fields("Currency_OC") = CCode
                            rsAA.fields("Currency") = CCode
                            rsAA.fields("Rate") = 1
                            rsAA.fields("AdmNo") = -1
                            rsAA.fields("PProrata") = PProrata
                            rsAA.fields("AdjustableF") = IIf(NoProrataF, False, AdjustableF)
                            rsAA.fields("AdjMethod") = AdjMethod
                            rsAA.fields("RCode") = RCode
                            rsAA.fields("AType") = AType
                            rsAA.fields("NoRefundF") = (pNoRefundF Or bNoRefundF)
                            rsAA.fields("CommPoolF") = CommPoolF
                            If Not rsAA.UpdateRow Then GoTo errmsg
                        End If

                        If (Commission - (Discount - UpFee)) <> 0 And StampDutyF Then
                            Dim rsFD As RemoteSet
                            Dim SQL As String
                            SQL = "Select F.FDType, sum(A.AmountPCT) as AmountPCT from AccFD A, FDTab F "
                            SQL = SQL & " Where (A.ANO=" & ANO & " or A.ANO=" & LANO & ") and F.FDID=A.FDID and F.FDType Like 'D%' and A.AMOUNTPCT<>0 and A.AMOUNTPCTBASED=0 "
                            SQL = SQL & " and (A.PolicyYear=0 or ('" & Format(todate(rsIC.fields("SDate")), "MM/DD/YYYY") & "' >= dateadd(month,12*(A.PolicyYear-1),'" & Format(PSDate, "MM/DD/YYYY") & "') and '" & Format(todate(rsIC.fields("SDate")), "MM/DD/YYYY") & "' < dateadd(month,12*A.PolicyYear,'" & Format(PSDate, "MM/DD/YYYY") & "')))"
                            SQL = SQL & " Group by F.FDType"
                            rsFD = db.OpenRemoteSet(SQL)
                            Do While Not rsFD.Eof
                                rsAA.AddNew()
                                rsAA.fields("BizMapID") = BizMapID
                                rsAA.fields("MSCode") = MSCode
                                rsAA.fields("Source") = Source
                                rsAA.fields("SDate") = todate(rsIC.fields("SDate"))
                                rsAA.fields("EDate") = todate(rsIC.fields("EDate"))
                                rsAA.fields("ANO") = ANO
                                rsAA.fields("Type") = "B" & BSTYPE

                                rsAA.fields("Code") = Left(tostr(rsFD.fields("FDType")), 1)
                                rsAA.fields("CodeExt") = IIf(Len(tostr(rsFD.fields("FDType"))) > 1, Right(tostr(rsFD.fields("FDType")), 1), "")
                                rsAA.fields("ID") = BSID
                                rsAA.fields("REFNO") = IIf(CommPoolF, PolicyNo, RefNo)
                                rsAA.fields("POLICYNO") = PolicyNo
