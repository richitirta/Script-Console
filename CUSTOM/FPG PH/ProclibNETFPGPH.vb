    Private Function Claim_Cession_XOLShortFall(ByVal CNO As Long, ByVal RDate As Date, ByVal RLimit As Double, ByVal ShortFall As Double, ByVal TAmount As Double) As Boolean
        Dim rs As RemoteSet
        Dim rsR As RemoteSet
        Dim i As Integer
        Dim TLimit As Double
        Dim OurShare As Double
        Dim Saldo As Double
        Dim RAmount As Double
        Dim Excess As Double
        Dim TExcess As Double
        Dim Limit As Double
        Dim Share As Double
        Dim ManualF As Boolean

        On Error GoTo errmsg
        rs = db.OpenRemoteSet("Select * from CArrDetail Where CNO=" & CNO)
        If rs.Eof Then
            rs.AddNew()
            rs.fields("CNO") = CNO
            rs.fields("LDate") = Today.Date
            rs.fields("LUserID") = db_user
        Else
            rs.Edit()
        End If
        ManualF = toval(rs.fields("ManualF"))

        OurShare = ShortFall
        Saldo = OurShare
        RAmount = Saldo
        TExcess = 0
        For i = 1 To 7
            rsR = db.OpenQueryDef("Claim_Cession_XOLShortFall", adOpenForwardOnly, CNO, RDate, "X" & i)
            If Not rsR.Eof And OurShare <> 0 Then
                If Not ManualF Then
                    TLimit = IIf(toval(rsR.fields("AssessmentF")), RLimit, 1)

                    Excess = toval(rsR.fields("Excess"))

                    Dim dExcess As Double
                    dExcess = Excess * (1 - TLimit)
                    Excess = Excess * TLimit

                    Excess = Excess - TExcess
                    Excess = IIf(Excess > 0, Excess, 0)
                    If Excess > Saldo Then Excess = Saldo
                    Saldo = Saldo - Excess

                    Limit = rsR.fields("Limit") + dExcess
                    Limit = IIf(Limit > 0, Limit, 0)
                    If Saldo > Limit Then
                        Share = Limit
                    Else
                        Share = Saldo
                    End If

                    rs.fields("XL" & i & "Share") = toval(Share / OurShare * 100)
                    rs.fields("XL" & i & "Amount") = Share
                    TExcess = TExcess + Excess + Share
                    Saldo = Saldo - Share
                    RAmount = RAmount - Share
                Else
                    Share = rs.fields("XL" & i & "Amount")
                    rs.fields("XL" & i & "Share") = toval(Share / OurShare * 100)
                End If
                Saldo = Saldo - Share
                RAmount = RAmount - Share
            Else
                rs.fields("XL" & i & "Share") = 0
                rs.fields("XL" & i & "Amount") = 0
            End If
            rs.fields("XL" & i & "ID") = tostr(rsR.fields("RID"))
        Next i

        If OurShare <> 0 Then
            rs.fields("Retention") = toval(RAmount / OurShare * 100)
        Else
            rs.fields("Retention") = 0
        End If
        rs.fields("RAmount") = RAmount
        rs.fields("TShare") = OurShare / TAmount * 100
        rs.fields("TAmount") = OurShare
        rs.fields("Date") = RDate
        rs.fields("RDate") = RDate
        rs.fields("Status") = "R"
        If Not rs.Update Then GoTo errmsg
        rsR.CloseRemoteSet()

        Claim_Cession_XOLShortFall = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Claim_Cession_XOLShortFall = False
    End Function
