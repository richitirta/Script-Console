                    Retention = toval(rsFac.fields("Retention"))

                    RefNo = tostr(rsFac.fields("SLIPNO"))
                    FShare = toval(rsFac.fields("Share")) + toval(rsFac.fields("JPShare"))
                    If FShare <> 0 Then
                        Select Case rsFac.fields("RType")
                            Case "QS", "QP", "S1", "S2", "S3", "CF", "AF", "OP"
