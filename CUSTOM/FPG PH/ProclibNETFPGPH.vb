                            Rate = toval(rsd.fields("Rate")) + Short_Period_Calc(TOC, pSDate, pEDate, pEDate) / 100 * Rate
                            RateMax = toval(rsd.fields("RateMax")) + Short_Period_Calc(TOC, pSDate, pEDate, pEDate) / 100 * RateMax
                        Else
                            If (UMonth + PMonth) <= rss.fields("Upper") Then
                                If RoundUpF Then
                                    If sPeriod = 0 Then
                                        Rate = toval(rsd.fields("Rate")) + (rss.fields("Upper") - rss.fields("Lower") + 1) / 12 * Rate
                                        RateMax = toval(rsd.fields("RateMax")) + (rss.fields("Upper") - rss.fields("Lower") + 1) / 12 * RateMax
                                    Else
                                        If Prorata = 0 Then
                                            Rate = toval(rsd.fields("Rate")) + (rss.fields("Upper") - rss.fields("Lower") + 1) / DateDiff(DateInterval.Day, pSDate, DateAdd(DateInterval.Month, 12, pSDate)) * Rate
                                            RateMax = toval(rsd.fields("RateMax")) + (rss.fields("Upper") - rss.fields("Lower") + 1) / DateDiff(DateInterval.Day, pSDate, DateAdd(DateInterval.Month, 12, pSDate)) * RateMax
                                        Else
                                            Rate = toval(rsd.fields("Rate")) + (rss.fields("Upper") - rss.fields("Lower") + 1) / Prorata * Rate
                                            RateMax = toval(rsd.fields("RateMax")) + (rss.fields("Upper") - rss.fields("Lower") + 1) / Prorata * RateMax
                                        End If
                                    End If
                                Else
                                    If DailyBasisF Or sPeriod = 1 Then  ' Daily Basis or Daily Scheme Period
                                        If ((SplitRiskF And Day(pSDate) = Day(pEDate)) Or (Not SplitRiskF And Day(pSDate) = Day(EDate))) And sPeriod = 0 And PPeriod <> 1 Then
                                            Rate = toval(rsd.fields("Rate")) + DateDiff(DateInterval.Month, pSDate, pEDate) / 12 * Rate
                                            RateMax = toval(rsd.fields("RateMax")) + DateDiff(DateInterval.Month, pSDate, pEDate) / 12 * RateMax
                                        Else
                                            If Prorata = 0 Then
                                                If Day(pSDate) = Day(pEDate) And DateDiff(DateInterval.Month, pSDate, pEDate) = pTerm Then
                                                    Rate = toval(rsd.fields("Rate")) + Rate
                                                    RateMax = toval(rsd.fields("RateMax")) + RateMax
                                                Else
                                                    Rate = toval(rsd.fields("Rate")) + Premium_Calc_Prorata(pSDate, pEDate, DaysProrata, pTerm, PPeriod, "") * Rate
                                                    RateMax = toval(rsd.fields("RateMax")) + Premium_Calc_Prorata(pSDate, pEDate, DaysProrata, pTerm, PPeriod, "") * RateMax
                                                End If
                                            Else
                                                Rate = toval(rsd.fields("Rate")) + DateDiff(DateInterval.Day, pSDate, pEDate) / Prorata * Rate
                                                RateMax = toval(rsd.fields("RateMax")) + DateDiff(DateInterval.Day, pSDate, pEDate) / Prorata * RateMax
                                            End If
                                        End If
                                    Else
                                        Rate = toval(rsd.fields("Rate")) + (toval(((UMonth + PMonth) / 12) * 12, 0) - rss.fields("Lower") + 1) / 12 * Rate
                                        RateMax = toval(rsd.fields("RateMax")) + (toval(((UMonth + PMonth) / 12) * 12, 0) - rss.fields("Lower") + 1) / 12 * RateMax
                                    End If
                                End If
                            Else
                                If RoundUpF Then
                                    If sPeriod = 0 Then
                                        Rate = toval(rsd.fields("Rate")) + (rss.fields("Upper") - rss.fields("Lower") + 1) / 12 * Rate
                                        RateMax = toval(rsd.fields("RateMax")) + (rss.fields("Upper") - rss.fields("Lower") + 1) / 12 * RateMax
                                    Else
                                        If Prorata = 0 Then
                                            Rate = toval(rsd.fields("Rate")) + (rss.fields("Upper") - rss.fields("Lower") + 1) / DateDiff(DateInterval.Day, pSDate, DateAdd(DateInterval.Month, 12, pSDate)) * Rate
                                            RateMax = toval(rsd.fields("RateMax")) + (rss.fields("Upper") - rss.fields("Lower") + 1) / DateDiff(DateInterval.Day, pSDate, DateAdd(DateInterval.Month, 12, pSDate)) * RateMax
                                        Else
                                            Rate = toval(rsd.fields("Rate")) + (rss.fields("Upper") - rss.fields("Lower") + 1) / Prorata * Rate
                                            RateMax = toval(rsd.fields("RateMax")) + (rss.fields("Upper") - rss.fields("Lower") + 1) / Prorata * RateMax
                                        End If
                                    End If
                                Else
                                    If DailyBasisF Or sPeriod = 1 Then  ' Daily Basis or Daily Scheme Period
                                        If ((SplitRiskF And Day(pSDate) = Day(pEDate)) Or (Not SplitRiskF And Day(pSDate) = Day(EDate))) And sPeriod = 0 And PPeriod <> 1 Then
                                            Rate = toval(rsd.fields("Rate")) + DateDiff(DateInterval.Month, pSDate, pEDate) / 12 * Rate
                                            RateMax = toval(rsd.fields("RateMax")) + DateDiff(DateInterval.Month, pSDate, pEDate) / 12 * RateMax
                                        Else
                                            If Prorata = 0 Then
                                                If Day(pSDate) = Day(pEDate) And DateDiff(DateInterval.Month, pSDate, pEDate) = pTerm Then
                                                    Rate = toval(rsd.fields("Rate")) + Rate
                                                    RateMax = toval(rsd.fields("RateMax")) + RateMax
                                                Else
                                                    Rate = toval(rsd.fields("Rate")) + Premium_Calc_Prorata(pSDate, pEDate, DaysProrata, pTerm, PPeriod, "") * Rate
                                                    RateMax = toval(rsd.fields("RateMax")) + Premium_Calc_Prorata(pSDate, pEDate, DaysProrata, pTerm, PPeriod, "") * RateMax
                                                End If
                                            Else
                                                Rate = toval(rsd.fields("Rate")) + DateDiff(DateInterval.Day, pSDate, pEDate) / Prorata * Rate
                                                RateMax = toval(rsd.fields("RateMax")) + DateDiff(DateInterval.Day, pSDate, pEDate) / Prorata * RateMax
                                            End If
                                        End If
                                    Else
                                        Rate = toval(rsd.fields("Rate")) + (rss.fields("Upper") - rss.fields("Lower") + 1) / 12 * Rate
                                        RateMax = toval(rsd.fields("RateMax")) + (rss.fields("Upper") - rss.fields("Lower") + 1) / 12 * RateMax
                                    End If
                                End If
                            End If
                        End If
                    End If

                    rsd.fields("PCalc") = "F"
                    If RoundRF Then
                        Rate = RoundCCY(Rate, CCY, 0.01)
                        RateMax = RoundCCY(RateMax, CCY, 0.01)
                    End If
                    rsd.fields("Rate") = Rate
                    rsd.fields("RateMax") = RateMax

                    If Voyage Then
                        rsd.fields("DEPARTDATE") = SDate
                        rsd.fields("ARRIVALDATE") = SDate
                        rsd.fields("Vessel") = Vessel
                        rsd.fields("VOYAGEFROM") = VoyageFrom
                        rsd.fields("VOYAGETO") = VoyageTo
                    End If

                    If Not rsd.UpdateRow Then
                        StrMsg = "Risk Cover : " & rsd.ErrDesc
                        GoTo errmsg
                    End If

                    rss.MoveNext()
                Loop

                If Not rsd.Eof AndAlso Not rsd.Update Then
                    StrMsg = "Risk Cover : " & rsd.ErrDesc
                    GoTo errmsg
                End If

                rsSC.MoveNext()
            Loop

            ' Get Scheme Deductible from Coverage #2
            rs = db.OpenQueryDef("QScheme_Verify_5", adOpenForwardonly, TSI, Coverage, SchemeNO, Description)
            If Not rs.Eof Then
                Do While Not rs.Eof
                    rsd = db.OpenRemoteSet("Select * from " & tPrefix & "AccDed Where ANO=" & ANO & " and TOR='" & tostr(rs.fields("TOR")) & "' and DCode='" & tostr(rs.fields("DCode")) & "' and Section='' and PolicyYear=0")
                    If rsd.Eof Then
                        rsd.AddNew()
                        rsd.fields("ANO") = ANO
                        rsd.fields("Section") = ""
                        rsd.fields("DCode") = tostr(rs.fields("DCode"))
                        rsd.fields("PCTTSI") = toval(rs.fields("PCTTSI"))
                        rsd.fields("PCTCL") = toval(rs.fields("PCTCL"))
                        rsd.fields("FIXEDMIN") = toval(rs.fields("FIXEDMIN"))
                        rsd.fields("FIXEDMAX") = toval(rs.fields("FIXEDMAX"))
                        rsd.fields("Currency") = tostr(rs.fields("Currency"))
                        rsd.fields("IUNIT") = tostr(rs.fields("IUNIT"))
                        rsd.fields("Remarks") = tostr(rs.fields("Remarks"))
                        rsd.fields("Remarks_1") = tostr(rs.fields("Remarks_1"))
                        rsd.fields("TOR") = tostr(rs.fields("TOR"))
                        rsd.fields("STRTSI") = tostr(rs.fields("STRTSI"))
                        rsd.fields("PolicyYear") = 0
                        rsd.fields("SDate") = lSDate
                        rsd.fields("EDate") = lEDate
                    Else
                        rsd.Edit()
                        rsd.fields("EDate") = lEDate
                    End If
                    If Not rsd.Update Then
                        StrMsg = "Deductible : " & rsd.ErrDesc
                        GoTo errmsg
                    End If
                    rs.MoveNext()
                Loop
            End If

            ' Get T & C for Scheme Coverage
            If Not GetSchemeTC(SchemeNO, Coverage, ANO, tPrefix) Then
                StrMsg = "Scheme TC for " & Coverage & " !"
                GoTo errmsg
            End If
        End If

        If lEDate <> EDate Then
            StrMsg = "Scheme Indemnity Coverage Not Ended Up Until " & Format(EDate, "dd-mmm-yy")
            GoTo errmsg
        End If

        ' New Version of Scheme Additional Coverage
        For i = 3 To 20
            LMonth = toval(toval(rsTr.fields("SOfYears_" & i)) * 12, 0)
            If LMonth = 0 Then LMonth = 1
            Coverage = tostr(rsTr.fields("Coverage_" & i))
            NOfYears = toval(rsTr.fields("NOfYears_" & i))
            If NOfYears = 0 Then NOfYears = toval(rsTr.fields("NOfYears"))

            If Coverage <> "" Then
                lSDate = CDate("1900/01/01")
                rsSC = db.OpenQueryDef("QScheme_Verify_2", adOpenForwardonly, Coverage, SchemeNO, Description)
                If rsSC.Eof Then
                    StrMsg = "No Scheme Coverage for " & Coverage & " - " & Description
                    GoTo errmsg
                End If
                Do While Not rsSC.Eof
                    If NOfYears <> 0 Then
                        NOfMonths = toval(NOfYears * 12, 0)
                    Else
                        NOfMonths = 1
                    End If
                    UMonth = LMonth + NOfMonths - 1

                    Code = tostr(rsSC.fields("Code"))
                    'If Not Check_RateCon(ANO, Code) Then
                    '    StrMsg = "Rate Condition (" & Code & ") : Not Allowable for Object Coverage !" & vbCrLf
                    '    GoTo errmsg
                    'End If
                    RateLoadingF = toval(rsSC.fields("RateLoadingF"))
                    If RateLoadingF Then
                        If tPrefix <> "" Then
                            Loading = Get_RateLoading_Temp(ANO, Code, SDate)
                        Else
                            Loading = Get_RateLoading(ANO, Code, SDate)
                        End If
                    Else
                        Loading = 1
                    End If
                    GrossUpF = toval(rsSC.fields("GrossUpF"))
                    If GrossUpF Then
                        GrossUpRate = Get_Premium_GrossUpRate(LANO, Code, 0)
                    End If

                    rsd = db.OpenRemoteSet("Select * from #RCover Where 1<>1")
                    ' Get Scheme Indemnity
                    If UMonth - LMonth + 1 < 12 And PCalc = "S" Then
                        rss = db.OpenQueryDef("QScheme_Verify_3", adOpenForwardonly, Coverage, Code, (LMonth + PMonth) - (LMonth + PMonth) + 1, (UMonth + PMonth) - (LMonth + PMonth) + 1, SchemeNO, Description, TSI)
                    Else
                        rss = db.OpenQueryDef("QScheme_Verify_3", adOpenForwardonly, Coverage, Code, (LMonth + PMonth), (UMonth + PMonth), SchemeNO, Description, TSI)
                    End If
                    Do While Not rss.Eof
                        If toval(rss.fields("HoldF")) Then
                            HoldF = True
                            If HoldF Then
                                If HoldMessage <> "" Then HoldMessage = HoldMessage & vbCrLf
                                HoldMessage = HoldMessage & "Scheme Verify Coverage : " & Coverage & "'"
                            End If
                        End If

                        If sPeriod <> 1 Then        ' Not in Days
                            pSDate = DateAdd(DateInterval.Month, rss.fields("Lower") - PMonth - 1, SDate)
                        Else
                            pSDate = DateAdd(DateInterval.Day, rss.fields("Lower") - PMonth - 1, SDate)
                        End If
                        If lSDate = CDate("1900/01/01") Then lSDate = pSDate
                        RateLoadingF = toval(rss.fields("RateLoadingF"))
                        If RateLoadingF Then
                            Dim HMsg As String = ""
                            If tPrefix <> "" Then
                                Loading = Get_RateLoading_Temp(ANO, Code, pSDate, , HoldF, HMsg)
                            Else
                                Loading = Get_RateLoading(ANO, Code, pSDate, , HoldF, HMsg)
                            End If
                            If HoldF Then
                                If HoldMessage <> "" Then HoldMessage = HoldMessage & vbCrLf
                                HoldMessage = HoldMessage & HMsg
                            End If
                        End If

                        If SplitRiskF Then
                            rsd.AddNew()
                        Else
                            If tostr(rsd.fields("Code")) = Code And toval(rsd.fields("PCTLoss")) = toval(rss.fields("PCTLoss")) And toval(rsd.fields("PADDITION")) = toval(rss.fields("PADDITION")) And toval(rsd.fields("Discount")) = toval(rss.fields("Discount")) And toval(rsd.fields("Loading")) = Loading Then
                                rsd.Edit()
                            Else
                                rsd.AddNew()
                            End If
                        End If

                        If rsd.editmode = AdEditAdd Then
                            rsd.fields("ANO") = ANO
                            rsd.fields("Code") = Code
                            rsd.fields("Unit") = tostr(rsSC.fields("Unit"))
                            rsd.fields("Category") = tostr(rsSC.fields("Category"))
                            rsd.fields("Portion") = toval(rsSC.fields("Portion"))
                            rsd.fields("Remark") = tostr(rsSC.fields("Description"))
                            rsd.fields("PRATEPCT") = toval(rsSC.fields("PRATEPCT"))
                            rsd.fields("PCTLoss") = toval(rss.fields("PCTLOSS"))
                            rsd.fields("PADDITION") = toval(rss.fields("PADDITION"))
                            rsd.fields("Discount") = toval(rss.fields("Discount"))
                            rsd.fields("NoRefundF") = toval(rss.fields("NoRefundF"))
                            rsd.fields("Loading") = Loading
                            rsd.fields("SDate") = pSDate
                            rsd.fields("NCDate") = pSDate
                            rsd.fields("NoRefundF") = toval(rss.fields("NoRefundF"))
                            rsd.fields("InclAddInterestF") = toval(rsSC.fields("InclAddInterestF"))
                        End If

                        If sPeriod <> 1 Then    ' Not in Days
                            If (UMonth + PMonth) <= rss.fields("Upper") And Not RoundUpDF Then
                                If Day(SDate) <> Day(EDate) Then
                                    pEDate = EDate
                                    If DateDiff(DateInterval.Month, pEDate, DateAdd(DateInterval.Month, toval((UMonth / 12) * 12, 0), SDate)) < 0 Then
                                        pEDate = DateAdd(DateInterval.Month, toval((UMonth / 12) * 12, 0), SDate)
                                    End If
                                Else
                                    pEDate = DateAdd(DateInterval.Month, toval((UMonth / 12) * 12, 0), SDate)
                                End If
                            Else
                                pEDate = DateAdd(DateInterval.Month, rss.fields("Upper") - PMonth, SDate)
                            End If
                        Else
                            If (UMonth + PMonth) <= rss.fields("Upper") Then
                                pEDate = EDate
                            Else
                                pEDate = DateAdd(DateInterval.Day, rss.fields("Upper") - PMonth, SDate)
                            End If
                        End If
                        If DateDiff(DateInterval.Day, pEDate, EDate) < 0 Then
                            pEDate = EDate
                        End If

                        rsd.fields("EDate") = pEDate
                        lEDate = pEDate

                        ' Annualized Rate
                        If toval(rss.fields("RateLower")) <> 0 Or toval(rss.fields("Rate")) <> 0 Or toval(rsTr.fields(rss.fields("Rate_Source"))) <> 0 Then
                            If sPeriod <> 1 Then
                                If toval(rsTr.fields(rss.fields("Rate_Source"))) <> 0 Then
                                    Rate = toval(rsTr.fields(rss.fields("Rate_Source")))
                                    RateMax = Rate
                                ElseIf toval(rss.fields("RateLower")) <> 0 And toval(rss.fields("Rate")) <> 0 Then
                                    If toval(rsTr.fields("Rate")) = 0 Then  ' Not Floating Rate
                                        Rate = (toval(rss.fields("RateLower")) * (toval(rss.fields("Upper")) - (UMonth + PMonth)) + toval(rss.fields("Rate")) * (12 - (toval(rss.fields("Upper")) - (UMonth + PMonth)))) / 12
                                        RateMax = Rate
                                    Else
                                        ' Average Rate
                                        Rate = toval(rss.fields("RateLower"))
                                        RateMax = toval(rss.fields("Rate"))
                                    End If
                                ElseIf toval(rss.fields("RateLower")) <> 0 Then
                                    Rate = toval(rss.fields("RateLower"))
                                    RateMax = Rate
                                Else
                                    Rate = toval(rss.fields("Rate"))
                                    RateMax = Rate
                                End If
                                Rate = 12 / (rss.fields("Upper") - rss.fields("Lower") + 1) * Rate
                                RateMax = 12 / (rss.fields("Upper") - rss.fields("Lower") + 1) * RateMax
                            Else    ' In Days
                                If PCalc = "N" Then
                                    Rate = rss.fields("Rate")
                                    RateMax = Rate
                                Else
                                    If Prorata = 0 Then
                                        Rate = DateDiff(DateInterval.Day, pSDate, DateAdd(DateInterval.Month, 12, pSDate)) / (rss.fields("Upper") - rss.fields("Lower") + 1) * rss.fields("Rate")
                                        RateMax = Rate
                                    Else
                                        Rate = Prorata / (rss.fields("Upper") - rss.fields("Lower") + 1) * rss.fields("Rate")
                                        RateMax = Rate
                                    End If
                                End If
                            End If
                        Else
                            Rate = toval(rsSC.fields("Rate")) / (1 + IRate / 100) ^ (DateDiff(DateInterval.Month, SDate, pSDate) \ 12)
                            RateMax = Rate
                        End If
                        If GrossUpF Then
                            Rate = Rate * GrossUpRate
                            RateMax = RateMax * GrossUpRate
                        End If

                        If PCalc = "N" Then ' No Prorate
                            Rate = toval(rsd.fields("Rate")) + Rate
                            RateMax = toval(rsd.fields("RateMax")) + RateMax
                        Else
                            If UMonth - LMonth + 1 < 12 And PCalc = "S" Then
                                Rate = toval(rsd.fields("Rate")) + Short_Period_Calc(TOC, pSDate, pEDate, pEDate) / 100 * Rate
                                RateMax = toval(rsd.fields("RateMax")) + Short_Period_Calc(TOC, pSDate, pEDate, pEDate) / 100 * RateMax
                            Else
                                If (UMonth + PMonth) <= rss.fields("Upper") Then
                                    If RoundUpF Then
                                        If sPeriod = 0 Then
                                            Rate = toval(rsd.fields("Rate")) + (rss.fields("Upper") - rss.fields("Lower") + 1) / 12 * Rate
                                            RateMax = toval(rsd.fields("RateMax")) + (rss.fields("Upper") - rss.fields("Lower") + 1) / 12 * RateMax
                                        Else
                                            If Prorata = 0 Then
                                                Rate = toval(rsd.fields("Rate")) + (rss.fields("Upper") - rss.fields("Lower") + 1) / DateDiff(DateInterval.Day, pSDate, DateAdd(DateInterval.Month, 12, pSDate)) * Rate
                                                RateMax = toval(rsd.fields("RateMax")) + (rss.fields("Upper") - rss.fields("Lower") + 1) / DateDiff(DateInterval.Day, pSDate, DateAdd(DateInterval.Month, 12, pSDate)) * RateMax
                                            Else
                                                Rate = toval(rsd.fields("Rate")) + (rss.fields("Upper") - rss.fields("Lower") + 1) / Prorata * Rate
                                                RateMax = toval(rsd.fields("RateMax")) + (rss.fields("Upper") - rss.fields("Lower") + 1) / Prorata * RateMax
                                            End If
                                        End If
                                    Else
                                        If DailyBasisF Or sPeriod = 1 Then  ' Daily Basis or Daily Scheme Period
                                            If ((SplitRiskF And Day(pSDate) = Day(pEDate)) Or (Not SplitRiskF And Day(pSDate) = Day(EDate))) And sPeriod = 0 And PPeriod <> 1 Then
                                                Rate = toval(rsd.fields("Rate")) + DateDiff(DateInterval.Month, pSDate, pEDate) / 12 * Rate
                                                RateMax = toval(rsd.fields("RateMax")) + DateDiff(DateInterval.Month, pSDate, pEDate) / 12 * RateMax
                                            Else
                                                If Prorata = 0 Then
                                                    If Day(pSDate) = Day(pEDate) And DateDiff(DateInterval.Month, pSDate, pEDate) = pTerm Then
                                                        Rate = toval(rsd.fields("Rate")) + Rate
                                                        RateMax = toval(rsd.fields("RateMax")) + RateMax
                                                    Else
                                                        Rate = toval(rsd.fields("Rate")) + Premium_Calc_Prorata(pSDate, pEDate, DaysProrata, pTerm, PPeriod, "") * Rate
                                                        RateMax = toval(rsd.fields("RateMax")) + Premium_Calc_Prorata(pSDate, pEDate, DaysProrata, pTerm, PPeriod, "") * RateMax
                                                    End If
                                                Else
                                                    Rate = toval(rsd.fields("Rate")) + DateDiff(DateInterval.Day, pSDate, pEDate) / Prorata * Rate
                                                    RateMax = toval(rsd.fields("RateMax")) + DateDiff(DateInterval.Day, pSDate, pEDate) / Prorata * RateMax
                                                End If
                                            End If
                                        Else
                                            Rate = toval(rsd.fields("Rate")) + (toval(((UMonth + PMonth) / 12) * 12, 0) - rss.fields("Lower") + 1) / 12 * Rate
                                            RateMax = toval(rsd.fields("RateMax")) + (toval(((UMonth + PMonth) / 12) * 12, 0) - rss.fields("Lower") + 1) / 12 * RateMax
                                        End If
                                    End If
                                Else
                                    If RoundUpF Then
                                        If sPeriod = 0 Then
                                            Rate = toval(rsd.fields("Rate")) + (rss.fields("Upper") - rss.fields("Lower") + 1) / 12 * Rate
                                            RateMax = toval(rsd.fields("RateMax")) + (rss.fields("Upper") - rss.fields("Lower") + 1) / 12 * RateMax
                                        Else
                                            If Prorata = 0 Then
                                                Rate = toval(rsd.fields("Rate")) + (rss.fields("Upper") - rss.fields("Lower") + 1) / DateDiff(DateInterval.Day, pSDate, DateAdd(DateInterval.Month, 12, pSDate)) * Rate
                                                RateMax = toval(rsd.fields("RateMax")) + (rss.fields("Upper") - rss.fields("Lower") + 1) / DateDiff(DateInterval.Day, pSDate, DateAdd(DateInterval.Month, 12, pSDate)) * RateMax
                                            Else
                                                Rate = toval(rsd.fields("Rate")) + (rss.fields("Upper") - rss.fields("Lower") + 1) / Prorata * Rate
                                                RateMax = toval(rsd.fields("RateMax")) + (rss.fields("Upper") - rss.fields("Lower") + 1) / Prorata * RateMax
                                            End If
                                        End If
                                    Else
                                        If DailyBasisF Or sPeriod = 1 Then  ' Daily Basis or Daily Scheme Period
                                            If ((SplitRiskF And Day(pSDate) = Day(pEDate)) Or (Not SplitRiskF And Day(pSDate) = Day(EDate))) And sPeriod = 0 And PPeriod <> 1 Then
                                                Rate = toval(rsd.fields("Rate")) + DateDiff(DateInterval.Month, pSDate, pEDate) / 12 * Rate
                                                RateMax = toval(rsd.fields("RateMax")) + DateDiff(DateInterval.Month, pSDate, pEDate) / 12 * RateMax
                                            Else
                                                If Prorata = 0 Then
                                                    If Day(pSDate) = Day(pEDate) And DateDiff(DateInterval.Month, pSDate, pEDate) = pTerm Then
                                                        Rate = toval(rsd.fields("Rate")) + Rate
                                                        RateMax = toval(rsd.fields("RateMax")) + RateMax
                                                    Else
                                                        Rate = toval(rsd.fields("Rate")) + Premium_Calc_Prorata(pSDate, pEDate, DaysProrata, pTerm, PPeriod, "") * Rate
                                                        RateMax = toval(rsd.fields("RateMax")) + Premium_Calc_Prorata(pSDate, pEDate, DaysProrata, pTerm, PPeriod, "") * RateMax
                                                    End If
                                                Else
                                                    Rate = toval(rsd.fields("Rate")) + DateDiff(DateInterval.Day, pSDate, pEDate) / Prorata * Rate
                                                    RateMax = toval(rsd.fields("RateMax")) + DateDiff(DateInterval.Day, pSDate, pEDate) / Prorata * RateMax
                                                End If
                                            End If
                                        Else
                                            Rate = toval(rsd.fields("Rate")) + (rss.fields("Upper") - rss.fields("Lower") + 1) / 12 * Rate
                                            RateMax = toval(rsd.fields("RateMax")) + (rss.fields("Upper") - rss.fields("Lower") + 1) / 12 * RateMax
                                        End If
                                    End If
                                End If
                            End If
                        End If

                        rsd.fields("PCalc") = "F"
                        If RoundRF Then
                            Rate = RoundCCY(Rate, CCY, 0.01)
                            RateMax = RoundCCY(RateMax, CCY, 0.01)
                        End If
                        rsd.fields("Rate") = Rate
                        rsd.fields("RateMax") = RateMax

                        If Voyage Then
                            rsd.fields("DEPARTDATE") = SDate
                            rsd.fields("ARRIVALDATE") = SDate
                            rsd.fields("Vessel") = Vessel
                            rsd.fields("VOYAGEFROM") = VoyageFrom
                            rsd.fields("VOYAGETO") = VoyageTo
                        End If

                        If Not rsd.UpdateRow Then
                            StrMsg = "Risk Cover : " & rsd.ErrDesc
                            GoTo errmsg
                        End If

                        rss.MoveNext()
                    Loop

                    If Not rsd.Eof AndAlso Not rsd.Update Then
                        StrMsg = "Risk Cover : " & rsd.ErrDesc
                        GoTo errmsg
                    End If

                    rsSC.MoveNext()
                Loop

                ' Get Scheme Deductible from Coverage #2
                rs = db.OpenQueryDef("QScheme_Verify_5", adOpenForwardonly, TSI, Coverage, SchemeNO, Description)
                If Not rs.Eof Then
                    Do While Not rs.Eof
                        rsd = db.OpenRemoteSet("Select * from " & tPrefix & "AccDed Where ANO=" & ANO & " and TOR='" & tostr(rs.fields("TOR")) & "' and DCode='" & tostr(rs.fields("DCode")) & "' and Section='' and PolicyYear=0")
                        If rsd.Eof Then
                            rsd.AddNew()
                            rsd.fields("ANO") = ANO
                            rsd.fields("Section") = ""
                            rsd.fields("DCode") = tostr(rs.fields("DCode"))
                            rsd.fields("PCTTSI") = toval(rs.fields("PCTTSI"))
                            rsd.fields("PCTCL") = toval(rs.fields("PCTCL"))
                            rsd.fields("FIXEDMIN") = toval(rs.fields("FIXEDMIN"))
                            rsd.fields("FIXEDMAX") = toval(rs.fields("FIXEDMAX"))
                            rsd.fields("Currency") = tostr(rs.fields("Currency"))
                            rsd.fields("IUNIT") = tostr(rs.fields("IUNIT"))
                            rsd.fields("Remarks") = tostr(rs.fields("Remarks"))
                            rsd.fields("Remarks_1") = tostr(rs.fields("Remarks_1"))
                            rsd.fields("TOR") = tostr(rs.fields("TOR"))
                            rsd.fields("STRTSI") = tostr(rs.fields("STRTSI"))
                            rsd.fields("PolicyYear") = 0
                            rsd.fields("SDate") = lSDate
                            rsd.fields("EDate") = lEDate
                        Else
                            rsd.Edit()
                            rsd.fields("EDate") = lEDate
                        End If
                        If Not rsd.Update Then
                            StrMsg = "Deductible : " & rsd.ErrDesc
                            GoTo errmsg
                        End If
                        rs.MoveNext()
                    Loop
                End If

                ' Get T & C for Scheme Coverage
                If Not GetSchemeTC(SchemeNO, Coverage, ANO, tPrefix) Then
                    StrMsg = "Scheme TC for " & Coverage & " !"
                    GoTo errmsg
                End If
            Else
                Exit For
            End If
        Next
        ' Get Scheme Additional (Interest #1 - Interest #5)
        Dim ATSI_OC As Double
        Dim ATSI As Double
        Dim Remark As String
        For i = 1 To 5
            ' Get User Entry
            Coverage = tostr(rsTr.fields("Coverage_1"))
            Interest = tostr(rsTr.fields("Interest_" & i))

            Amount_OC = toval(rsTr.fields("Amount_" & i))
            ATSI_OC = toval(rsTr.fields("TSI_" & i))

            ATSI = ATSI_OC * RateCCY
            Amount = Amount_OC * RateCCY

            Total_OC = toval(rsTr.fields("Total_" & i))
            Remark = tostr(rsTr.fields("ADDINTERESTREMARK" & i))
            If Interest <> "" Then
                If Interest = "" Then
                    Select Case i
                        Case 1
                            Interest = "TPL"
                        Case 2
                            Interest = "DRIVER"
                        Case 3
                            Interest = "PASSENGER"
                        Case 4
                            Interest = "ACCESSORIES"
                        Case 5
                            Interest = "OTHERS"
                    End Select
                End If
                ' Reset Here
                rsTr.fields("Interest_" & i) = Interest
                rsTr.fields("TSI_" & i) = 0
                rs = db.OpenQueryDef("QScheme_Verify_6", adOpenForwardonly, Coverage, Interest, ATSI, rsTr.fields("NOfyears"), SchemeNO, Description)
                Do While Not rs.Eof
                    If toval(rs.fields("SI")) <> 0 Then

                        If toval(rs.fields("HoldF")) Then
                            HoldF = True
                            If HoldF Then
                                If HoldMessage <> "" Then HoldMessage = HoldMessage & vbCrLf
                                HoldMessage = HoldMessage & "Scheme Additional Interest : " & Interest & "'"
                            End If
                        End If

                        If ATSI = 0 Then
                            ATSI = toval(rs.fields("SI"))
                            ATSI_OC = ATSI / RateCCY
                        End If
                        If Remark = "" Then Remark = tostr(rs.fields("TOIDesc"))
                        rsTr.fields("TSI_" & i) = ATSI
                        Rate = toval(rs.fields("Rate"))
                        If ATSI <> 0 And rs.fields("Unit") = "F" Then
                            ' To Flat Rate
                            Rate = Round(ATSI * Rate / 100, 2)
                        ElseIf rs.fields("Unit") = "M" Then
                            ' To Mile
                            Rate = Rate * 10
                        End If
                        If toval(rs.fields("RateBasedID")) <> 0 Then     ' Of Limit Of Liability or Total Sum Insured
                            Select Case UCase(tostr(rs.fields("Unit")))
                                Case "C", "M"
                                    Rate = Rate * TSI / ATSI
                            End Select
                        End If

                        ' If Progressive but the Sum Insured is greater than available progressive Setting Table
                        If toval(rs.fields("ProgressiveF")) AndAlso ATSI > toval(rs.fields("Upper")) Then
                            StrMsg = "No (or Not Complete) Progressive Table Scheme Additional for " & Coverage & " - " & Interest
                            GoTo errmsg
                        End If

                        Dim pRate As Double
                        rsd = db.OpenRemoteSet("Select * from #RCover Where ANO=" & ANO & " and Code='" & tostr(rs.fields("Code")) & "'")
                        Do While True
                            If rsd.Eof Then
                                pSDate = SDate
                                pEDate = EDate
                            Else
                                pSDate = rsd.fields("SDate")
                                pEDate = rsd.fields("Edate")
                            End If

                            If PCalc = "N" Then ' No Prorate
                                pRate = Rate
                            Else
                                If DateDiff(DateInterval.Month, pSDate, pEDate) < 12 And PCalc = "S" Then
                                    pRate = Short_Period_Calc(TOC, pSDate, pEDate, pEDate) / 100 * Rate
                                Else
                                    If RoundUpF Then
                                        If sPeriod = 0 Then
                                            pRate = RoundUp(DateDiff(DateInterval.Month, pSDate, pEDate) / 12, 1) * Rate
                                        Else
                                            If Prorata = 0 Then
                                                pRate = DateDiff(DateInterval.Day, pSDate, pEDate) / DateDiff(DateInterval.Day, pSDate, DateAdd(DateInterval.Month, 12, pSDate)) * Rate
                                            Else
                                                pRate = DateDiff(DateInterval.Day, pSDate, pEDate) / Prorata * Rate
                                            End If
                                        End If
                                    Else
                                        If DailyBasisF Or sPeriod = 1 Then  ' Daily Basis or Daily Scheme Period
                                            If Day(pSDate) = Day(pEDate) And sPeriod = 0 And PPeriod <> 1 Then
                                                pRate = DateDiff(DateInterval.Month, pSDate, pEDate) / 12 * Rate
                                            Else
                                                If Prorata = 0 Then
                                                    If Day(pSDate) = Day(pEDate) And DateDiff(DateInterval.Month, pSDate, pEDate) = pTerm Then
                                                        pRate = Rate
                                                    Else
                                                        pRate = Premium_Calc_Prorata(pSDate, pEDate, DaysProrata, pTerm, PPeriod, "") * Rate
                                                    End If
                                                Else
                                                    pRate = DateDiff(DateInterval.Day, pSDate, pEDate) / Prorata * Rate
                                                End If
                                            End If
                                        Else
                                            pRate = DateDiff(DateInterval.Month, pSDate, pEDate) / 12 * Rate
                                        End If
                                    End If
                                End If
                            End If

                            If rsd.Eof OrElse (toval(rsd.fields("Rate")) = 0 And pRate <> 0) Then
                                If rsd.Eof Then
                                    rsd.AddNew()
                                    rsd.fields("ANO") = ANO
                                    rsd.fields("Code") = tostr(rs.fields("Code"))
                                    rsd.fields("Unit") = tostr(rs.fields("Unit"))
                                    rsd.fields("Category") = tostr(rs.fields("Category"))
                                    rsd.fields("Portion") = toval(rs.fields("Portion"))
                                    rsd.fields("Remark") = tostr(rs.fields("RateDesc"))
                                    rsd.fields("PRATEPCT") = toval(rs.fields("PRATEPCT"))
                                    rsd.fields("SDate") = pSDate
                                    rsd.fields("Edate") = pEDate
                                    rsd.fields("NCDate") = pSDate
                                    rsd.fields("PCTLoss") = 100
                                    rsd.fields("Loading") = 1
                                    rsd.fields("PAddition") = 0
                                    rsd.fields("PCalc") = "F"
                                Else
                                    rsd.Edit()
                                End If
                                rsd.fields("Rate") = pRate
                                rsd.fields("RateMax") = pRate
                                If Not rsd.Update Then
                                    StrMsg = "Risk Cover : " & rsd.ErrDesc
                                    GoTo errmsg
                                End If
                            Else
                                ' Follow from Scheme Indemnity
                            End If

                            If pSDate = SDate And pEDate = EDate Then Exit Do

                            rsd.MoveNext()
                            If rsd.Eof Then Exit Do
                        Loop


                        TOI = tostr(rs.fields("TOI"))
                        rsd = db.OpenRemoteSet("Select * from " & tPrefix & "ICover Where ANO=" & ANO & " and TOI='" & TOI & "'")
                        If rsd.Eof Then
                            rsd.AddNew()
                            rsd.fields("ANO") = ANO
                            rsd.fields("TOI") = TOI
                            rsd.fields("Remark") = Remark
                            rsd.fields("Adjustable") = toval(rs.fields("Adjustable"))
                            rsd.fields("Category") = tostr(rs.fields("Category"))

                            If tPrefix <> "" Then
                                INO = db.GetIdentity("tICover") + 1
                            Else
                                INO = db.GetIdentity("ICover") + 1
                            End If
                            rsd.fields("INO") = INO
                        Else
                            ' Keep Value
                            INO = rsd.fields("INO")
                            rsd.Edit()
                        End If
                        rsd.fields("NOTDECRF") = toval(rs.fields("NOTDECRF"))

                        rsd.fields("Currency") = CCY
                        rsd.fields("Amount") = IIf(Amount = 0, ATSI, Amount)
                        rsd.fields("Amount_AOE") = IIf(Amount = 0, ATSI, Amount)
                        rsd.fields("SI") = ATSI

                        rsd.fields("Currency_OC") = CCYFrom
                        rsd.fields("Rate_OC") = RateCCY

                        rsd.fields("Amount_OC") = IIf(Amount_OC = 0, ATSI_OC, Amount_OC)
                        rsd.fields("Amount_AOE_OC") = IIf(Amount_OC = 0, ATSI_OC, Amount_OC)
                        rsd.fields("SI_OC") = ATSI_OC

                        rsd.fields("Total") = Total_OC
                        If Not rsd.Update Then
                            StrMsg = "Interest Cover : " & rsd.ErrDesc
                            GoTo errmsg
                        End If

                        If Not Copy_Master_ICoverNOC(LANO, ANO, INO, TOI, tPrefix) Then GoTo errmsg
                        Dim OrderNo As Integer = 0
                        rss = db.OpenRemoteSet("Select * from " & tPrefix & "Scheme_Detail Where TrNo=" & TrNo & " and IntNo=" & i & "")
                        rsd = db.OpenRemoteSet("Select * from " & tPrefix & "ICoverDet Where 1<>1")
                        Do While Not rss.Eof
                            rsd.AddNew()
                            rsd.fields("INO") = INO
                            rsd.fields("DPeriod") = 0
                            rsd.fields("OrderNo") = OrderNo + 1
                            rsd.fields("Description") = tostr(rss.fields("Description"))
                            rsd.fields("Qty") = toval(rss.fields("Qty"))
                            rsd.fields("Unit") = tostr(rss.fields("Unit"))
                            rsd.fields("UValue") = toval(rss.fields("UValue"))
                            rsd.fields("Amount") = toval(rss.fields("Amount"))
                            rsd.fields("ANO") = ANO
                            rsd.fields("Memo") = tostr(rss.fields("Memo"))
                            If Not rsd.Update Then
                                StrMsg = "Detail Interest Cover : " & rsd.ErrDesc
                                GoTo errmsg
                            End If
                            rss.MoveNext()
                            OrderNo = OrderNo + 1
                        Loop
                    End If
                    rs.MoveNext()
                Loop
            Else
                Exit For
            End If
        Next i

        ' Fee & Duty
        If FDAMOUNT_1 <> 0 Then
            rsd = db.OpenRemoteSet("Select * from " & tPrefix & "AccFD Where 1<>1")
            rs = db.OpenQueryDef("QFDTAB", adOpenForwardonly, FDID_1)
            If Not rs.Eof Then
                rsd.AddNew()
                rsd.fields("ANO") = ANO
                rsd.fields("ID") = "<Payor>"
                rsd.fields("FDID") = tostr(rs.fields("FDID"))
                rsd.fields("REMARK") = tostr(rs.fields("Description"))
                rsd.fields("Currency") = tostr(rs.fields("Currency"))
                rsd.fields("PolicyYear") = 1
                rsd.fields("Amount") = FDAMOUNT_1
                If Not rsd.Update Then
                    StrMsg = "Fee Duty : " & rsd.ErrDesc
                    GoTo errmsg
                End If
            End If
        End If

        If FDAMOUNT_2 <> 0 Then
            rsd = db.OpenRemoteSet("Select * from " & tPrefix & "AccFD Where 1<>1")
            rs = db.OpenQueryDef("QFDTAB", adOpenForwardonly, FDID_2)
            If Not rs.Eof Then
                rsd.AddNew()
                rsd.fields("ANO") = ANO
                rsd.fields("ID") = "<Payor>"
                rsd.fields("FDID") = tostr(rs.fields("FDID"))
                rsd.fields("REMARK") = tostr(rs.fields("Description"))
                rsd.fields("Currency") = tostr(rs.fields("Currency"))
                rsd.fields("PolicyYear") = 1
                rsd.fields("Amount") = FDAMOUNT_2
                If Not rsd.Update Then
                    StrMsg = "Fee Duty : " & rsd.ErrDesc
                    GoTo errmsg
                End If
            End If
        End If

        Dim OPFDID_1 As String
        Dim OPAMOUNT_1 As Double
        Dim OPPCT_1 As Double

        If OPAMOUNT_1 <> 0 OrElse OPPCT_1 <> 0 Then
            rsd = db.OpenRemoteSet("Select * from " & tPrefix & "AccFD Where 1<>1")
            rs = db.OpenQueryDef("QFDTAB", adOpenForwardonly, OPFDID_1)
            If Not rs.Eof Then
                rsd.AddNew()
                rsd.fields("ANO") = ANO
                rsd.fields("ID") = "<Payor>"
                rsd.fields("FDID") = tostr(rs.fields("FDID"))
                rsd.fields("REMARK") = tostr(rs.fields("Description"))
                rsd.fields("Currency") = tostr(rs.fields("Currency"))
                rsd.fields("PolicyYear") = 1
                rsd.fields("Amount") = FDAMOUNT_1
                If Not rsd.Update Then
                    StrMsg = "Fee Duty : " & rsd.ErrDesc
                    GoTo errmsg
                End If
            End If
        End If


        rsd = db.OpenRemoteSet("Select * from " & tPrefix & "Acceptance Where ANO=" & ANO)
        rsd.Edit()
        rsd.fields("EDate") = EDate
        rsd.fields("PPDate") = EDate
        If Not rsd.Update Then
            StrMsg = "Policy Data : " & rsd.ErrDesc
            GoTo errmsg
        End If

        ' Add for Default Risk Arrangement
        Dim RDate As Date
        Dim NRDate As Date
        RDate = SDate
        NRDate = IIf(AnnualTreatyF, DateAdd(DateInterval.Month, 12, RDate), EDate)
        If DateDiff(DateInterval.Day, EDate, NRDate) > 0 Then NRDate = EDate

        rsd = db.OpenRemoteSet("Select * from " & tPrefix & "RArrHeader Where ANO=" & ANO)
        If rsd.Eof Then
            rsd.AddNew()
        Else
            rsd.Edit()
        End If
        rsd.fields("ANO") = ANO
        rsd.fields("PDate") = RDate
        rsd.fields("PPDate") = NRDate
        rsd.fields("LDate") = Today.Date
        rsd.fields("LUserID") = db_user
        rsd.fields("NCDate") = RDate
        rsd.fields("RDate") = RDate
        rsd.fields("NRDate") = NRDate
        rsd.fields("Status") = "R"
        rsd.fields("TreatyF") = True
        If ISType = "L" Then
            rs = db.OpenRemoteSet("Select sum(Share) as Share from Coinsurance Where CNO=" & CNO)
            rsd.fields("MShare") = toval(rs.fields("Share"))
        Else
            rsd.fields("MShare") = 0
        End If
        If Not rsd.Update Then
            StrMsg = "Risk Arrangement : " & rsd.ErrDesc
            GoTo errmsg
        End If
        rs.CloseRemoteSet()

        ' Default Treaty Excluded Clauses
        rss = db.OpenRemoteSet("Select * from RexCla Where TOC='" & TOC & "' and RYear=" & Year(SDate), adOpenForwardonly)
        Do While Not rss.Eof
            rsd = db.OpenRemoteSet("Select * from " & tPrefix & "AccCLa Where ANO=" & ANO & " and OrderNo='" & rss.fields("OrderNo") & "'")
            If rsd.Eof Then
                rsd.AddNew()
