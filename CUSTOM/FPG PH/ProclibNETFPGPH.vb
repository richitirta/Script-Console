                        rs.fields("XL2RegNo") = RegNo
                    End If
                End If

                ' Excess Of Loss #3
                If tostr(rs.fields("XL3ID")) <> "" Then
                    rsR = db.OpenQueryDef("QReinsurance", adOpenForwardonly, tostr(rs.fields("XL3ID")))
                    If tostr(rsR.fields("Category")) = "C" Or tostr(rsR.fields("Category")) = "E" Then
                        Amount = toval(rs.fields("XL3AMOUNT"))
                        EAmount = toval(rs.fields("XL3EAMOUNT"))
                        RegNo = toval(PutClaRegAmount(EventNo, "X3", RYear, Amount, TAmount, EAmount, ETAmount))
                        If RegNo = -1 Then GoTo errmsg
                        rs.fields("XL3RegNo") = RegNo
                    End If
                End If

                ' Excess Of Loss #4
                If tostr(rs.fields("XL4ID")) <> "" Then
                    rsR = db.OpenQueryDef("QReinsurance", adOpenForwardonly, tostr(rs.fields("XL4ID")))
                    If tostr(rsR.fields("Category")) = "C" Or tostr(rsR.fields("Category")) = "E" Then
                        Amount = toval(rs.fields("XL4AMOUNT"))
                        EAmount = toval(rs.fields("XL4EAMOUNT"))
