    Private Function AccAss_Reversal_Process(ByVal SQL As String, ByVal PDate As Date) As Boolean
        ' SQL Statement Returns ACCASS Record to be reversed
        Dim rs As RemoteSet
        Dim rsAA As RemoteSet
        Dim rsAcc As RemoteSet
        Dim DetailTreatyF As Boolean

        On Error GoTo errmsg

        rs = db.OpenRemoteSet("Select DetailTreatyF from SysTab", adOpenForwardonly)
        DetailTreatyF = rs.fields("DetailTreatyF")

        rs = db.OpenRemoteSet(SQL)
        If Not rs.Eof Then
            rsAA = db.OpenRemoteSet("Select * from AccAss Where 1<>1")
        End If
        Do While Not rs.Eof
            rsAcc = db.OpenQueryDef("QAcceptance", adOpenForwardonly, rs.fields("ANO"))
            If Not rsAcc.Eof Then
                rsAA.AddNew()
                db.backup_record(rs, rsAA)
                rsAA.fields("Date") = PDate
                rsAA.fields("CAmount") = -rs.fields("CAmount")
                rsAA.fields("Amount_OC") = -rs.fields("Amount_OC")
                rsAA.fields("Amount") = -rs.fields("Amount")
                rsAA.fields("AdmNo") = -1
                If Not rsAA.Update Then GoTo errmsg
                If Not Production_To_Adm(rsAcc.fields("ANO"), rsAcc.fields("LANO"), , DetailTreatyF) Then GoTo errmsg
            End If
            rs.MoveNext()
        Loop
        AccAss_Reversal_Process = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        AccAss_Reversal_Process = False
    End Function

    Private Function Production_To_Adm(ByVal ANO As Long, ByVal LANO As Long, Optional ByVal Bulkf As Boolean = False, Optional ByVal DetailTreatyF As Boolean = False, Optional ByRef Voucher As String = "", Optional ByVal SplitDNCNF As Boolean = False) As Boolean
        Dim rs As RemoteSet
        Dim rsAdm As RemoteSet
        Dim rsP As RemoteSet
        Dim rsI As RemoteSet
        Dim PID As String
        Dim PCode As String
        Dim pRCode As String
        Dim pSegment As String
        Dim pPolicyNo As String
        Dim PType As String
        Dim pCCY As String
        Dim PRefNo As String
        Dim ADate As Date
        Dim pADate As Date
        Dim BillDate As Date
        Dim pBillDate As Date
        Dim PDocNo As String
        Dim ODocNo As String
        Dim pODocNo As String
        Dim pBranch As String
        Dim pSubject As String
        Dim pSource As String
        Dim CT As String
        Dim Branch As String
        Dim PrevBranch As String
        Dim PDate As Date
        Dim SDate As Date
        Dim PolicyYearF As Boolean
        Dim FDInstallmentF As Boolean
        Dim OpenFlag As Boolean
        Dim PolicyNo As String
        Dim AdmNo As Long
        Dim EDate As Date
        Dim Source As String
        Dim MO As String
        Dim GracePeriod As Integer
        Dim pGracePeriod As Integer
        Dim BatchNo As String
        Dim ISType As String
        Dim AID As String
        Dim Statement As Integer
        Dim Installment As Long
        Dim WPC As Integer
        Dim VirtualF As Boolean
        Dim AType As String
        Dim PrevAType As String
        Dim EMethod As String
        Dim PrevEMethod As String
        Dim PolicyType As String
        Dim Segment As String
        Dim PaymentType As String
        Dim CRefNo As String
        Dim TaxTableF As Boolean
        Dim TreatyInstallmentF As Boolean
        Dim pTreatyInstallmentF As Boolean
        Dim SplitPremiumAndClaimF As Boolean
        Dim ApplyAlternateVAccountF As Boolean
        Dim AgentID As String
        Dim BrokerID As String
        Dim CPAID As String
        Dim RANO As Long
        Dim ProformaF As Boolean
        Dim RValue As Double
        Dim TaxType As String
        Dim ConsortiumF As Boolean
        Dim NoRefundF As Integer
        Dim ASource As String
        Dim TOC As String
        Dim MSCode As String
        Dim BizmapID As String
        Dim ScheduleF As Boolean
        Dim pANO As Long
        Dim pLANO As Long

        On Error GoTo errmsg

        rs = db.OpenRemoteSet("Select TreatyInstallmentF, TaxTableF, SplitPremiumAndClaimF, ApplyAlternateVAccountF from SysTab")
        TreatyInstallmentF = toval(rs.fields("TreatyInstallmentF"))
        TaxTableF = toval(rs.fields("TaxTableF"))
        SplitPremiumAndClaimF = toval(rs.fields("SplitPremiumAndClaimF"))
        ApplyAlternateVAccountF = toval(rs.fields("ApplyAlternateVAccountF"))

        TaxType = ""

        ' Get CT and Other Policy Information
        Dim SQL As String
        SQL = "Select TOC.TOC, TOC.RValue, TOC.ConsortiumF, sysuser.CT as sCT, A1.ASource, A1.NoRefundF, A1.CT as aCT, A1.AType, A1.EMethod, "
        SQL = SQL & " LA1.AType as MAType, LA1.EMethod as MEMethod, LA1.PDate as MPDate, LA1.SDate as MSDate, LA1.EDate as MEDate, "
        SQL = SQL & " pLA1.AType as PrevMAType, pLA1.EMethod as PrevMEMethod, pA1.Branch as PrevBranch, pA1.EMethod as PrevEMethod, pA1.AType as PrevAType, "
        SQL = SQL & " A1.Branch, A1.AID, A1.MSCode, A1.BizMapID, A1.Source, A1.BatchNo, A1.PolicyNo, A1.CertificateNo, A1.SDate, A1.EDate, A1.PDate, "
        SQL = SQL & " LA1.ESeqNo as MESeqNo, LA1.EESeqNo as MEESeqNo, LA1.ERSeqNo as MERSeqNo, A1.ESeqNo, A1.EESeqNo, A1.ERSeqNo, A1.RANO, "
        SQL = SQL & " Cover.ProformaF, Cover.PolicyType, Cover.Segment, Cover.OpenFlag, Cover.MO, Cover.ISType, Cover.RefNo as CRefNo, "
        SQL = SQL & " pA1.ANO as pANO, pA1.LANO as pLANO"
        SQL = SQL & " from Acceptance A1 "
        SQL = SQL & " Left Join Acceptance pA1 on (PA1.ANO=A1.PANO) "
        SQL = SQL & " Left join Acceptance LA1 on (LA1.ANO=A1.LANO) "
        SQL = SQL & " Left join Acceptance pLA1 on (pLA1.ANO=LA1.pANO) "
        SQL = SQL & " inner Join Cover on (Cover.CNO=A1.CNO) "
        SQL = SQL & " inner Join TOC on (TOC.TOC=A1.TOC) "
        SQL = SQL & " Left Join sysuser on (sysuser.ID=Cover.MO) "
        SQL = SQL & " Where A1.ANO = " & ANO

        rs = db.OpenRemoteSet(SQL)
        CT = tostr(rs.fields("aCT"))
        If CT = "" Then CT = tostr(rs.fields("sCT"))
        Branch = tostr(rs.fields("Branch"))
        PrevBranch = tostr(rs.fields("PrevBranch"))
        OpenFlag = toval(rs.fields("OpenFlag"))
        ISType = tostr(rs.fields("ISType"))
        If OpenFlag Or LANO = -1 Or ISType = "T" Then
            PDate = todate(rs.fields("PDate"))
            SDate = todate(rs.fields("SDate"))
            EDate = todate(rs.fields("EDate"))
            AType = tostr(rs.fields("AType"))
            EMethod = tostr(rs.fields("EMethod"))
            PrevAType = tostr(rs.fields("PrevAType"))
            PrevEMethod = tostr(rs.fields("PrevEMethod"))
        Else
            PDate = todate(rs.fields("MPDate"))
            SDate = todate(rs.fields("MSDate"))
            EDate = todate(rs.fields("MEDate"))
            AType = tostr(rs.fields("MAType"))
            EMethod = tostr(rs.fields("MEMethod"))
            PrevAType = tostr(rs.fields("PrevMAType"))
            PrevEMethod = tostr(rs.fields("PrevMEMethod"))
        End If
        MO = tostr(rs.fields("MO"))
        BatchNo = tostr(rs.fields("BatchNo"))
        Source = tostr(rs.fields("Source"))
        MSCode = tostr(rs.fields("MSCode"))
        BizmapID = tostr(rs.fields("BizMapID"))
        AID = tostr(rs.fields("AID"))
        PolicyType = tostr(rs.fields("PolicyType"))
        Segment = tostr(rs.fields("Segment"))
        CRefNo = tostr(rs.fields("CRefNo"))
        AgentID = Get_AgentID(ANO)
        BrokerID = Get_BrokerID(ANO)
        CPAID = Get_CPAID(ANO)
        RANO = toval(rs.fields("RANO"))
        ProformaF = toval(rs.fields("ProformaF"))
        RValue = toval(rs.fields("RValue"))
        ConsortiumF = toval(rs.fields("ConsortiumF"))
        NoRefundF = toval(rs.fields("NoRefundF"))
        ASource = tostr(rs.fields("ASource"))
        TOC = tostr(rs.fields("TOC"))
        pANO = toval(rs.fields("pANO"))
        pLANO = toval(rs.fields("pLANO"))

        If LANO <> -1 Then
            If OpenFlag And ANO <> LANO And Not Bulkf Then
                PolicyNo = tostr(rs.fields("PolicyNo")) + "-" + tostr(rs.fields("CertificateNo"))
            Else
                PolicyNo = tostr(rs.fields("PolicyNo"))
            End If
        Else
            PolicyNo = tostr(rs.fields("PolicyNo"))
        End If

        Dim BankAccount As String
        Dim BankName As String
        Dim Bank As String
        Dim BankBranch As String
        Dim AccountNo As String
        Dim V_Currency As String = ""
        Dim V_BankName As String = ""
        Dim V_Bank As String = ""
        Dim V_PID As String = ""
        Dim V_AccountNo As String = ""
        Dim V_BankName_Ext As String = ""
        Dim V_Bank_Ext As String = ""
        Dim V_AccountNo_Ext As String = ""
        Dim TotalVAT As Double = 0
        Dim TotalTAX As Double = 0
        Dim VAT As Double
        Dim TAX As Double
        Dim WriteF As Boolean
        Dim CommPoolF As Boolean
        Dim DataReversalF As Boolean
        Dim SCGroup As String
        Dim CGroup As String
        Dim DocNo As String

        ' Detail Treaty Document No
        If LANO <> -1 Then
            If OpenFlag And ANO <> LANO And Not Bulkf Then
                DocNo = tostr(rs.fields("PolicyNo")) + "-" + tostr(rs.fields("CertificateNo"))
                If toval(rs.fields("ESeqNo")) <> 0 Then
                    DocNo = DocNo + "-" + tostr(rs.fields("ESeqNo")) + "/" + tostr(rs.fields("EESeqNo"))
                    If toval(rs.fields("ERSeqNo")) <> 0 Then
                        DocNo = DocNo + "/" + tostr(rs.fields("ERSeqNo"))
                    End If
                End If
            Else
                DocNo = tostr(rs.fields("PolicyNo"))
                If toval(rs.fields("MESeqNo")) <> 0 Then
                    DocNo = DocNo + "-" + tostr(rs.fields("MESeqNo")) + "/" + tostr(rs.fields("MEESeqNo"))
                    If toval(rs.fields("MERSeqNo")) <> 0 Then
                        DocNo = DocNo + "/" + tostr(rs.fields("MERSeqNo"))
                    End If
                End If
            End If
        Else
            DocNo = tostr(rs.fields("PolicyNo"))
            If toval(rs.fields("ESeqNo")) <> 0 Then
                DocNo = DocNo + "-" + tostr(rs.fields("ESeqNo")) + "/" + tostr(rs.fields("EESeqNo"))
                If toval(rs.fields("ERSeqNo")) <> 0 Then
                    DocNo = DocNo + "/" + tostr(rs.fields("ERSeqNo"))
                End If
            End If
        End If

        If Not SplitDNCNF Then
            If ANO <> LANO And LANO <> -1 Then
                ' Alternate Payor
                rsP = db.OpenQueryDef("QAPayor", adOpenForwardonly, ANO)
                If rsP.Eof Then
                    rsP = db.OpenQueryDef("QPayor", adOpenForwardonly, LANO)
                End If
            Else
                rsP = db.OpenQueryDef("QPayor", adOpenForwardonly, ANO)
            End If
            GracePeriod = toval(rsP.fields("Grace"))
            PolicyYearF = toval(rsP.fields("PolicyYearF"))
            FDInstallmentF = toval(rsP.fields("FDInstallmentF"))
            PaymentType = tostr(rsP.fields("RefType"))
            If PaymentType = "VIRTUAL" Then
                V_PID = rsP.fields("ID")
                V_AccountNo = rsP.fields("AccountNo")
                V_Bank = rsP.fields("Bank")
                V_BankName = rsP.fields("BankName")
            End If
            ScheduleF = toval(rsP.fields("ScheduleF"))

            ' Virtual Account Not for Proforma Policy and Not Yet Set Payment Type
            If Not ProformaF And (PaymentType = "" Or (PaymentType = "VIRTUAL" And V_AccountNo = "")) Then
                VirtualF = True
            Else
                VirtualF = False
            End If

            ' Get Sub Company Group for Virtual Account Payment Information
            Dim rsT As RemoteSet
            rsT = db.OpenRemoteSet("Select CGroup, SCGroup from Profile Where ID='" & rsP.fields("ID") & "'")
            CGroup = rsT.fields("CGroup")
            SCGroup = rsT.fields("SCGroup")
        End If

        rs = db.OpenQueryDef("QProduction_To_Adm", adOpenForwardonly, ANO)
        If Not rs.Eof Then
            PRefNo = ""
            PType = ""
            pODocNo = ""
            rsAdm = db.OpenRemoteSet("Select * from Admlink Where 1<>1")
            Do While Not rs.Eof
                PID = tostr(rs.fields("ID"))
                pCCY = tostr(rs.fields("Currency"))
                ADate = todate(rs.fields("Date"))
                pADate = ADate
                BillDate = todate(rs.fields("BillDate"))
                pBillDate = BillDate
                PDocNo = tostr(rs.fields("DocNo"))
                ODocNo = PDocNo
                pSource = tostr(rs.fields("Source"))
                pBranch = tostr(rs.fields("Branch"))
                pSubject = tostr(rs.fields("Subject"))
                PCode = tostr(rs.fields("TOC"))
                pRCode = tostr(rs.fields("RCODE"))
                WriteF = toval(rs.fields("WriteF"))
                CommPoolF = toval(rs.fields("CommPoolF"))
                DataReversalF = toval(rs.fields("DataReversalF"))
                pSegment = Segment
                If pSubject = "" Then pSubject = "Premium"

                If PRefNo <> tostr(rs.fields("RefNo")) OrElse PType <> tostr(rs.fields("Type")) OrElse pODocNo <> ODocNo Then
                    PRefNo = tostr(rs.fields("RefNo"))
                    PType = tostr(rs.fields("Type"))
                    pODocNo = ODocNo

                    If Not SplitDNCNF Then
                        pGracePeriod = GracePeriod
                        If InStr("CPXPQSQPS1S2S3DCAF", PType) <> 0 Then
                            rsI = db.OpenRemoteSet("Select Top 1 R1.TreatyInstallmentF, R1.Statement from Reinsurance R1 Inner Join RPart R2 on (R2.RNO=R1.RNO and R2.ID='" & PID & "') Where CASE WHEN COALESCE(R2.DOCNO,'')='' THEN R1.DOCNO ELSE R2.DOCNO END='" & PRefNo & "'")
                            pTreatyInstallmentF = TreatyInstallmentF Or toval(rsI.fields("TreatyInstallmentF"))
                            Statement = toval(rsI.fields("Statement"))
                        ElseIf PType = "FO" Or PType = "FP" Then
                            rsI = db.OpenQueryDef("QFPart", adOpenForwardonly, ANO, PID, PRefNo)
                            If toval(rsI.fields("Grace")) <> 0 Then
                                pGracePeriod = toval(rsI.fields("Grace"))
                            End If
                        End If
                    Else
                        If Not DataReversalF Then
                            If ANO <> LANO And LANO <> -1 Then
                                ' Alternate Payor
                                rsP = db.OpenQueryDef("QAPayor", adOpenForwardonly, ANO)
                                If rsP.Eof Then
                                    rsP = db.OpenQueryDef("QPayor", adOpenForwardonly, LANO)
                                End If
                            Else
                                rsP = db.OpenQueryDef("QPayor", adOpenForwardonly, ANO)
                            End If
                            pGracePeriod = toval(rsP.fields("Grace"))
                            PolicyYearF = toval(rsP.fields("PolicyYearF"))
                            FDInstallmentF = toval(rsP.fields("FDInstallmentF"))
                            PaymentType = tostr(rsP.fields("RefType"))
                            If PaymentType = "VIRTUAL" Then
                                V_PID = rsP.fields("ID")
                                V_AccountNo = rsP.fields("AccountNo")
                                V_Bank = rsP.fields("Bank")
                                V_BankName = rsP.fields("BankName")
                            End If
                            ScheduleF = toval(rsP.fields("ScheduleF"))

                            ' Virtual Account Not for Proforma Policy and Not Yet Set Payment Type
                            If Not ProformaF And (PaymentType = "" Or (PaymentType = "VIRTUAL" And V_AccountNo = "")) Then
                                VirtualF = True
                            Else
                                VirtualF = False
                            End If
                        Else
                            If pANO <> pLANO And pLANO <> -1 Then
                                ' Alternate Payor
                                rsP = db.OpenQueryDef("QAPayor", adOpenForwardonly, pANO)
                                If rsP.Eof Then
                                    rsP = db.OpenQueryDef("QPayor", adOpenForwardonly, pLANO)
                                End If
                            Else
                                rsP = db.OpenQueryDef("QPayor", adOpenForwardonly, pANO)
                            End If
                            pGracePeriod = toval(rsP.fields("Grace"))
                            PolicyYearF = toval(rsP.fields("PolicyYearF"))
                            FDInstallmentF = toval(rsP.fields("FDInstallmentF"))
                            PaymentType = tostr(rsP.fields("RefType"))
                            If PaymentType = "VIRTUAL" Then
                                V_PID = rsP.fields("ID")
                                V_AccountNo = rsP.fields("AccountNo")
                                V_Bank = rsP.fields("Bank")
                                V_BankName = rsP.fields("BankName")
                            End If
                            ScheduleF = toval(rsP.fields("ScheduleF"))

                            ' Virtual Account Not for Proforma Policy and Not Yet Set Payment Type
                            If Not ProformaF And (PaymentType = "" Or (PaymentType = "VIRTUAL" And V_AccountNo = "")) Then
                                VirtualF = True
                            Else
                                VirtualF = False
                            End If
                        End If

                        ' Get Sub Company Group for Virtual Account Payment Information
                        Dim rsT As RemoteSet
                        rsT = db.OpenRemoteSet("Select CGroup, SCGroup from Profile Where ID='" & rsP.fields("ID") & "'")
                        CGroup = rsT.fields("CGroup")
                        SCGroup = rsT.fields("SCGroup")

                        If Not DataReversalF Then
                            If InStr("CPXPQSQPS1S2S3DCAF", PType) <> 0 Then
                                rsI = db.OpenRemoteSet("Select Top 1 R1.TreatyInstallmentF, R1.Statement from Reinsurance R1 Inner Join RPart R2 on (R2.RNO=R1.RNO and R2.ID='" & PID & "') Where CASE WHEN COALESCE(R2.DOCNO,'')='' THEN R1.DOCNO ELSE R2.DOCNO END='" & PRefNo & "'")
                                pTreatyInstallmentF = TreatyInstallmentF Or toval(rsI.fields("TreatyInstallmentF"))
                                Statement = toval(rsI.fields("Statement"))
                            ElseIf PType = "FO" Or PType = "FP" Then
                                rsI = db.OpenQueryDef("QFPart", adOpenForwardonly, ANO, PID, PRefNo)
                                If toval(rsI.fields("Grace")) <> 0 Then
                                    pGracePeriod = toval(rsI.fields("Grace"))
                                End If
                            End If
                        Else
                            If InStr("CPXPQSQPS1S2S3DCAF", PType) <> 0 Then
                                rsI = db.OpenRemoteSet("Select Top 1 R1.TreatyInstallmentF, R1.Statement from Reinsurance R1 Inner Join RPart R2 on (R2.RNO=R1.RNO and R2.ID='" & PID & "') Where CASE WHEN COALESCE(R2.DOCNO,'')='' THEN R1.DOCNO ELSE R2.DOCNO END='" & PRefNo & "'")
                                pTreatyInstallmentF = TreatyInstallmentF Or toval(rsI.fields("TreatyInstallmentF"))
                                Statement = toval(rsI.fields("Statement"))
                            ElseIf PType = "FO" Or PType = "FP" Then
                                rsI = db.OpenQueryDef("QFPart", adOpenForwardonly, pANO, PID, PRefNo)
                                If toval(rsI.fields("Grace")) <> 0 Then
                                    pGracePeriod = toval(rsI.fields("Grace"))
                                End If
                            End If
                        End If
                    End If
                End If

                Select Case PType
                    Case "DI", "IR", "IC", "JP", "CF", "FO", "FP", "BA", "BB", "BO", "BC", "BP", "BD", "OP"
                        If AType <> "A" Then
                            If PType = "FO" Or PType = "FP" Then
                                rsI = rsI
                            Else
                                rsI = rsP
                            End If
                            Installment = toval(rsI.fields("Installment"))
                            WPC = toval(rsI.fields("WPC"))
                        Else
                            Installment = 0
                            WPC = 0
                        End If
                    Case "DC", "QS", "QP", "S1", "S2", "S3", "AF"
                        If pTreatyInstallmentF And AType <> "A" Then
                            rsI = rsP
                            Installment = toval(rsI.fields("Installment"))
                        Else
                            Installment = 0
                        End If
                        WPC = 0
                    Case Else
                        ' Installment Not Applied for BPPDAN/MAIPARK
                        Installment = 0
                        WPC = 0
                End Select

                If ScheduleF Then
                    ' No Installment for Payor Schedule
                    Installment = 0
                    If DateDiff(DateInterval.Day, pBillDate, rs.fields("SDate")) > 0 Then
                        pBillDate = rs.fields("SDate")
                    End If
                End If

                ' for each policy year starting from 2nd and so on
                If PolicyYearF And DateDiff(DateInterval.Month, SDate, todate(rs.fields("SDate"))) \ 12 > 0 Then
                    Select Case PType
                        Case "DI", "IR", "IC", "JP", "CF", "FO", "FP", "BA", "BB", "BO", "BC", "BP", "BD", "DP", "DR", "OP", "IT", "IX", "PD"
                            PDate = DateAdd(DateInterval.Month, (DateDiff(DateInterval.Month, SDate, todate(rs.fields("SDate"))) \ 12) * 12, SDate)
                            If DateDiff(DateInterval.Day, todate(rs.fields("SDate")), PDate) > 0 Then
                                PDate = DateAdd(DateInterval.Month, -12, PDate)
                            End If
                            If DateDiff(DateInterval.Day, PDate, pADate) <= 0 Then
                                pADate = PDate
                            End If
                            pBillDate = PDate
                            pBillDate = DateAdd(DateInterval.Day, pGracePeriod, pBillDate)
                            pPolicyNo = PolicyNo
                            If CommPoolF Then
                                pADate = Last_date_of_period(pADate, 1)
                                pBillDate = Last_date_of_period(pBillDate, 1)
                            End If
                        Case Else ' Treaty
                            If Installment <> 0 Or DetailTreatyF Or ConsortiumF Or PType = "DC" Or PType = "CP" Or PType = "XP" Or PType = "AF" Then
                                pADate = pADate
                                PDocNo = DocNo
                                pPolicyNo = PolicyNo
                            Else
                                pADate = Last_date_of_period(pADate, 1)
                                PDocNo = PRefNo
                                pPolicyNo = PRefNo
                            End If
                            pBillDate = Last_date_of_period(pADate, Statement)
                    End Select
                Else
                    Select Case PType
                        Case "DI", "IR", "IC", "JP", "CF", "FO", "FP", "BA", "BB", "BO", "BC", "BP", "BD", "DP", "DR", "OP", "IT", "IX", "PD"
                            pBillDate = DateAdd(DateInterval.Day, pGracePeriod, pBillDate)
                            pPolicyNo = PolicyNo
                            If CommPoolF Then
                                pADate = Last_date_of_period(pADate, 1)
                                pBillDate = Last_date_of_period(pBillDate, 1)
                            End If
                        Case Else ' Treaty
                            If Installment <> 0 Or DetailTreatyF Or ConsortiumF Or PType = "DC" Or PType = "CP" Or PType = "XP" Or PType = "AF" Then
                                pADate = pADate
                                PDocNo = DocNo
                                pPolicyNo = PolicyNo
                            Else
                                pADate = Last_date_of_period(pADate, 1)
                                PDocNo = PRefNo
                                pPolicyNo = PRefNo
                            End If
                            pBillDate = Last_date_of_period(pADate, Statement)
                    End Select
                End If

                Dim LockedKey As String = ""
                Dim EditMode As Integer

                If (OpenFlag And Not Bulkf) Or LANO = -1 Then
                    Select Case PType
                        Case "DI", "IR", "IC", "JP", "CF", "FO", "FP", "BA", "BB", "BO", "BC", "BP", "BD", "DP", "DR", "OP", "IT", "IX", "PD"
                            EditMode = AdEditAdd
                            AdmNo = db.GetIdentity("Admlink") + 1
                        Case Else ' Treaty
                            If Installment <> 0 Or DetailTreatyF Or ConsortiumF Or PType = "DC" Or PType = "CP" Or PType = "XP" Or PType = "AF" Then
                                EditMode = AdEditAdd
                                AdmNo = db.GetIdentity("Admlink") + 1
                            Else
                                Do While True
                                    rsAdm = db.OpenQueryDef("QAdmLink", adOpenKeyset, PID, PCode, PType, pCCY, PRefNo, pADate, pBillDate, PDocNo, pSubject, pBranch, pSegment, pPolicyNo)
                                    If rsAdm.Eof Then
                                        EditMode = AdEditAdd
                                        AdmNo = db.GetIdentity("Admlink") + 1
                                    Else
                                        EditMode = AdEditInProgress
                                        AdmNo = toval(rsAdm.fields("AdmNo"))
                                    End If
                                    LockedKey = "ADMLINK_" & AdmNo
                                    If db.GetLockedObject(LockedKey) Then
                                        Exit Do
                                    Else
                                        System.Threading.Thread.Sleep(1000)
                                    End If
                                Loop
                            End If
                    End Select
                Else
                    Do While True
                        rsAdm = db.OpenQueryDef("QAdmLink", adOpenKeyset, PID, PCode, PType, pCCY, PRefNo, pADate, pBillDate, PDocNo, pSubject, pBranch, pSegment, pPolicyNo)
                        If rsAdm.Eof Then
                            EditMode = AdEditAdd
                            AdmNo = db.GetIdentity("Admlink") + 1
                        Else
                            EditMode = AdEditInProgress
                            AdmNo = toval(rsAdm.fields("AdmNo"))
                        End If
                        LockedKey = "ADMLINK_" & AdmNo
                        If db.GetLockedObject(LockedKey) Then
                            Exit Do
                        Else
                            System.Threading.Thread.Sleep(1000)
                        End If
                    Loop
                End If


                If EditMode = AdEditInProgress Then
                    rsAdm.Edit()
                Else
                    rsAdm.AddNew()
                    rsAdm.fields("AdmNo") = AdmNo
                    rsAdm.fields("ID") = PID
                    rsAdm.fields("CODE") = PCode
                    rsAdm.fields("TYPE") = PType
                    rsAdm.fields("Currency") = pCCY
                    rsAdm.fields("Subject") = pSubject
                    rsAdm.fields("Branch") = pBranch
                    rsAdm.fields("RefNo") = PRefNo
                    rsAdm.fields("DocNo") = PDocNo
                    rsAdm.fields("Date") = pADate
                    rsAdm.fields("BillDate") = pBillDate
                    rsAdm.fields("Segment") = pSegment
                    rsAdm.fields("A_PolicyNo") = pPolicyNo
                    rsAdm.fields("DataReversalF") = DataReversalF
                End If

                ' Check Virtual Account First
                If PType = "DI" Or PType = "IR" Or PType = "IC" Then
                    If Not rsAdm.editmode = AdEditAdd AndAlso rsAdm.fields("RefType") = "VIRTUAL" Then
                        V_Currency = rsAdm.fields("Currency")
                        V_AccountNo = rsAdm.fields("AccountNo")
                        V_Bank = rsAdm.fields("Bank")
                        V_BankName = rsAdm.fields("BankName")
                        V_AccountNo_Ext = rsAdm.fields("AccountNo_Ext")
                        V_Bank_Ext = rsAdm.fields("Bank_Ext")
                        V_BankName_Ext = rsAdm.fields("BankName_Ext")
                    Else
                        V_Currency = ""
                        V_AccountNo = ""
                        V_Bank = ""
                        V_BankName = ""
                        V_AccountNo_Ext = ""
                        V_Bank_Ext = ""
                        V_BankName_Ext = ""
                        If PaymentType = "VIRTUAL" Then
                            V_AccountNo = rsP.fields("AccountNo")
                            V_Bank = rsP.fields("Bank")
                            V_BankName = rsP.fields("BankName")
                        End If
                    End If
                End If

                If VirtualF And V_AccountNo = "" And (PType = "DI" Or PType = "IR" Or PType = "IC") Then
                    If V_PID = "" Then V_PID = PID
                    Get_Virtual_Account(Branch, TOC, PolicyType, Segment, CGroup, SCGroup, PaymentType, PolicyNo, AType, pCCY, V_PID, V_Bank, V_BankName, V_AccountNo, V_Currency, "", ADate)
                    ' Get Second Virtual Account
                    If ApplyAlternateVAccountF And V_AccountNo <> "" And V_AccountNo_Ext = "" And (PType = "DI" Or PType = "IR" Or PType = "IC") Then
                        Get_Virtual_Account(Branch, TOC, PolicyType, Segment, CGroup, SCGroup, PaymentType, PolicyNo, AType, pCCY, V_PID, V_Bank_Ext, V_BankName_Ext, V_AccountNo_Ext, V_Currency, V_Bank, ADate)
                    End If
                End If
                rsAdm.fields("RCode") = pRCode
                rsAdm.fields("ASource") = ASource
                rsAdm.fields("CT") = CT
                rsAdm.fields("Source") = pSource
                rsAdm.fields("MSCode") = MSCode
                rsAdm.fields("AgentID") = AgentID
                rsAdm.fields("BrokerID") = BrokerID
                rsAdm.fields("CPAID") = CPAID
                rsAdm.fields("BatchNo") = BatchNo
                rsAdm.fields("ISType") = ISType
                rsAdm.fields("WPC") = WPC
                rsAdm.fields("A_ID") = AID
                rsAdm.fields("A_SDate") = SDate
                rsAdm.fields("A_EDate") = EDate
                rsAdm.fields("A_MO") = MO
                rsAdm.fields("A_RefNo") = CRefNo
                rsAdm.fields("BizMapID") = BizmapID
                rsAdm.fields("Extra_1") = ""
                If pSubject = "Claim" Then
                    rsAdm.fields("Extra_2") = Format(SDate, "YYYY-MM-DD")
                    rsAdm.fields("Extra_3") = ""
                Else
                    rsAdm.fields("Extra_3") = IIf(RANO = -1, "New", "Renewal")
                    rsAdm.fields("Extra_4") = IIf(AType = "N", "New", IIf(AType = "C", IIf(EMethod = "A", "Cancel All", "Cancellation"), IIf(AType = "E", IIf(PrevAType = "C" And PrevEMethod = "", "Reinstatement", "Endorsement"), "Adjustment")))
                End If

                rsAdm.fields("Remarks") = tostr(rs.fields("Remarks"))
                Select Case PType
                    Case "DI", "IR", "IC", "JP", "CF", "FO", "FP", "BA", "BB", "BO", "BC", "BP", "BD", "DP", "DR", "OP", "IT", "IX", "PD"
                        rsAdm.fields("Statement") = 0
                    Case Else
                        rsAdm.fields("Statement") = Statement
                End Select
                rsAdm.fields("VoucherF") = 0
                If Voucher <> "" Then
                    Select Case PType
                        Case "DI", "IR", "IC", "IT", "IX"
                            rsAdm.fields("Voucher") = Voucher
                            Voucher = ""
                    End Select
                End If
                Select Case PType
                    Case "DI", "IR", "IC", "PD"
                        If V_AccountNo <> "" And (pCCY = V_Currency Or V_Currency = "") Then
                            rsAdm.fields("RefType") = "VIRTUAL"
                            rsAdm.fields("AccountNo") = V_AccountNo
                            rsAdm.fields("Bank") = V_Bank
                            rsAdm.fields("BankName") = V_BankName
                            rsAdm.fields("AccountNo_Ext") = V_AccountNo_Ext
                            rsAdm.fields("Bank_Ext") = V_Bank_Ext
                            rsAdm.fields("BankName_Ext") = V_BankName_Ext
                        Else
                            rsAdm.fields("RefType") = tostr(rsP.fields("RefType"))
                            rsAdm.fields("Bank") = tostr(rsP.fields("Bank"))
                            rsAdm.fields("BankBranch") = tostr(rsP.fields("BankBranch"))
                            rsAdm.fields("AccountNo") = tostr(rsP.fields("AccountNo"))
                            rsAdm.fields("BankAccount") = tostr(rsP.fields("BankAccount"))
                            rsAdm.fields("BankName") = tostr(rsP.fields("BankName"))
                        End If
                    Case Else
                        Get_BankAccount(PID, pCCY, Bank, BankBranch, AccountNo, BankAccount, BankName)
                        rsAdm.fields("Bank") = Bank
                        rsAdm.fields("BankBranch") = BankBranch
                        rsAdm.fields("AccountNo") = AccountNo
                        rsAdm.fields("BankAccount") = BankAccount
                        rsAdm.fields("BankName") = BankName
                End Select

                Dim pTAmount As Double
                pTAmount = toval(rsAdm.fields("Amount_1")) + toval(rsAdm.fields("Amount_2")) + toval(rsAdm.fields("Amount_3")) + toval(rsAdm.fields("Amount_4")) + toval(rsAdm.fields("Amount_5")) + toval(rsAdm.fields("Amount_6")) + toval(rsAdm.fields("Amount_7")) + toval(rsAdm.fields("Amount_8")) + toval(rsAdm.fields("Amount_9")) + toval(rsAdm.fields("Amount_10")) + toval(rsAdm.fields("Amount_15")) + toval(rsAdm.fields("Amount_16")) + toval(rsAdm.fields("Amount_19")) + toval(rsAdm.fields("Amount_20"))

                ' Case "P"    ' Premium
                rsAdm.fields("Amount_1") = toval(rsAdm.fields("Amount_1")) + toval(rs.fields("Amount_1"))
                ' Case "C"    ' Commission
                rsAdm.fields("Amount_2") = toval(rsAdm.fields("Amount_2")) + toval(rs.fields("Amount_2"))
                ' Case "F"    ' Fee
                rsAdm.fields("Amount_3") = toval(rsAdm.fields("Amount_3")) + toval(rs.fields("Amount_3"))
                ' Case "D"    ' Duty
                rsAdm.fields("Amount_4") = toval(rsAdm.fields("Amount_4")) + toval(rs.fields("Amount_4"))
                ' Case "O"    ' Discount/Acquisition Cost
                rsAdm.fields("Amount_5") = toval(rsAdm.fields("Amount_5")) + toval(rs.fields("Amount_5"))
                ' Case "A"    ' Claim Amount
                rsAdm.fields("Amount_6") = toval(rsAdm.fields("Amount_6")) + toval(rs.fields("Amount_6"))
                ' Case "O1"    ' Premium Adjustment
                rsAdm.fields("Amount_7") = toval(rsAdm.fields("Amount_7")) + toval(rs.fields("Amount_7"))
                ' Case "O2"    ' Profit Sharing
                rsAdm.fields("Amount_8") = toval(rsAdm.fields("Amount_8")) + toval(rs.fields("Amount_8"))
                ' Case "C1"    ' Overriding Commission
                rsAdm.fields("Amount_9") = toval(rsAdm.fields("Amount_9")) + toval(rs.fields("Amount_9"))
                ' Case "R"    ' Subrogation
                rsAdm.fields("Amount_10") = toval(rsAdm.fields("Amount_10")) + toval(rs.fields("Amount_10"))
                ' Case "F3/D3"    ' Others Fee / Stamp Duty #3
                rsAdm.fields("Amount_12") = toval(rsAdm.fields("Amount_12")) + toval(rs.fields("Amount_12"))
                ' Case "T"    ' Tax
                rsAdm.fields("Amount_14") = toval(rsAdm.fields("Amount_14")) + toval(rs.fields("Amount_14"))
                ' Case "F1/D1"    ' Others Fee / Stamp Duty #1
                rsAdm.fields("Amount_15") = toval(rsAdm.fields("Amount_15")) + toval(rs.fields("Amount_15"))
                ' Case "F2/D2"    ' Others Fee / Stamp Duty #2
                rsAdm.fields("Amount_16") = toval(rsAdm.fields("Amount_16")) + toval(rs.fields("Amount_16"))
                ' Case "J"    ' Deposit/Reserve/Advance
                rsAdm.fields("Amount_19") = toval(rsAdm.fields("Amount_19")) + toval(rs.fields("Amount_19"))
                ' Case "U"    ' Ujroh Fee
                rsAdm.fields("Amount_20") = toval(rsAdm.fields("Amount_20")) + toval(rs.fields("Amount_20"))

                rsAdm.fields("Amount") = toval(rsAdm.fields("Amount_1")) + toval(rsAdm.fields("Amount_2")) + toval(rsAdm.fields("Amount_3")) + toval(rsAdm.fields("Amount_4")) + toval(rsAdm.fields("Amount_5")) + toval(rsAdm.fields("Amount_6")) + toval(rsAdm.fields("Amount_7")) + toval(rsAdm.fields("Amount_8")) + toval(rsAdm.fields("Amount_9")) + toval(rsAdm.fields("Amount_10")) + toval(rsAdm.fields("Amount_12")) + toval(rsAdm.fields("Amount_15")) + toval(rsAdm.fields("Amount_16")) + toval(rsAdm.fields("Amount_19")) + toval(rsAdm.fields("Amount_20"))
                rsAdm.fields("LUserID") = db_user
                rsAdm.fields("LDate") = Today.Date
                rsAdm.fields("LTime") = Time()
                rsAdm.fields("WriteF") = WriteF
                If Not rsAdm.Update Then GoTo errmsg

                If LockedKey <> "" Then
                    If Not db.ReleaseLockedObject(LockedKey) Then GoTo errmsg
                End If

                ' Update AccAss
                Dim SplitClaimSQL As String
                If SplitPremiumAndClaimF Then
                    SplitClaimSQL = " and (Case When AccAss.Code in ('A','R') Then 'Claim' else 'Premium' end)='" & pSubject & "'"
                Else
                    SplitClaimSQL = ""
                End If

                If Branch = PrevBranch Then
                    If Not db.Execute("Update Accass Set AdmNo=" & AdmNo & ", Posted=1 from AccAss Where AdmNo=-1 and ANO=" & ANO & " and ID='" & PID & "' and TOC='" & PCode & "' and Type='" & PType & "' and Currency='" & pCCY & "' and DocNo='" & ODocNo & "' and Refno='" & PRefNo & "' and SDate Between '" & Format(rs.fields("MINSDate"), "MM/DD/YYYY") & "' and '" & Format(rs.fields("MAXSDate"), "MM/DD/YYYY") & "' and Date='" & Format(ADate, "MM/DD/YYYY") & "' and BillDate='" & Format(BillDate, "MM/DD/YYYY") & "'" & SplitClaimSQL) Then GoTo errmsg
                Else
                    If Branch = pBranch Then
                        If Not db.Execute("Update Accass Set AdmNo=" & AdmNo & ", Posted=1 from AccAss Where CAmount<>0 and AdmNo=-1 and ANO=" & ANO & " and ID='" & PID & "' and TOC='" & PCode & "' and Type='" & PType & "' and Currency='" & pCCY & "' and DocNo='" & ODocNo & "' and Refno='" & PRefNo & "' and SDate Between '" & Format(rs.fields("MINSDate"), "MM/DD/YYYY") & "' and '" & Format(rs.fields("MAXSDate"), "MM/DD/YYYY") & "' and Date='" & Format(ADate, "MM/DD/YYYY") & "' and BillDate='" & Format(BillDate, "MM/DD/YYYY") & "'" & SplitClaimSQL) Then GoTo errmsg
                    Else
                        If Not db.Execute("Update Accass Set AdmNo=" & AdmNo & ", Posted=1 from AccAss Where CAmount=0 and AdmNo=-1 and ANO=" & ANO & " and ID='" & PID & "' and TOC='" & PCode & "' and Type='" & PType & "' and Currency='" & pCCY & "' and DocNo='" & ODocNo & "' and Refno='" & PRefNo & "' and SDate Between '" & Format(rs.fields("MINSDate"), "MM/DD/YYYY") & "' and '" & Format(rs.fields("MAXSDate"), "MM/DD/YYYY") & "' and Date='" & Format(ADate, "MM/DD/YYYY") & "' and BillDate='" & Format(BillDate, "MM/DD/YYYY") & "'" & SplitClaimSQL) Then GoTo errmsg
                    End If
                End If

                If NoRefundF = 7 And InStr("BBBABOBCBPBD", PType) <> 0 Then
                    PType = IIf(ISType = "I" Or ISType = "L", "DI", IIf(ISType = "C", "IC", IIf(ISType = "R", "IR", "IT")))
                    If Not db.Execute("Update A1 Set Type='" & PType & "', Code=(Case When A1.Code<>'D' Then 'P' else A1.Code end) from AccAss A1 Where A1.Type in ('BB','BA','BO','BC','BP','BD') and A1.AdmNo=" & AdmNo) Then GoTo errmsg
                    If Not db.Execute("Update A2 Set Type='" & PType & "', Amount_1=Amount_1+Amount_2+Amount_5, Amount_2=0, Amount_5=0 from Admlink A2 Where A2.Type in ('BB','BA','BO','BC','BP','BD') and A2.AdmNo=" & AdmNo) Then GoTo errmsg

                End If
                rs.MoveNext()
            Loop
            rsAdm.CloseRemoteSet()
        End If

        rs.CloseRemoteSet()
        Production_To_Adm = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Production_To_Adm = False
    End Function
    Private Function GetPNominalVat_ByRisk(ByVal AdmNo As Long) As Double
        Dim rs As RemoteSet
        rs = db.OpenRemoteSet("Select dbo.fn_GetPNominalVat_ByRisk(" & AdmNo & ") as PNominal_VAT")
        GetPNominalVAT_BYRISK = toval(rs.fields("PNominal_VAT"))
    End Function
    Private Function Production_To_Adm_Finalize(ByVal ANO As Long, ByVal LANO As Long, ByVal AdmNo As String, Optional ByVal GetLockedObjectF As Boolean = True, Optional ByVal SplitDNCNF As Boolean = False) As Boolean
        On Error GoTo errmsg

        Dim rsAdm As RemoteSet
        Dim rs As RemoteSet

        Dim TreatyInstallmentF As Boolean
        Dim NetAdjustmentDepositF As Boolean
        Dim VATSubsidiesF As Boolean
        Dim TaxTableF As Boolean
        Dim TaxMethod As Integer

        Dim PID As String
        Dim PType As String = ""
        Dim PCode As String = ""
        Dim pCCY As String
        Dim pADate As Date
        Dim pRefNo As String = ""
        Dim pDocNo As String = ""
        Dim DataReversalF As Boolean

        Dim pTreatyInstallmentF As Boolean
        Dim RValue As Double

        Dim BVATPCT As Double
        Dim TVATPCT As Double
        Dim OBVATPCT As Double
        Dim OTVATPCT As Double
        Dim OverwriteBVatF As Boolean
        Dim OverwriteTVatF As Boolean
        Dim NoRefundF As Integer
        Dim VATInstallmentF As Boolean
        Dim FDInstallmentF As Boolean
        Dim VatBusinessF As Boolean
        Dim InsuredVATF As Boolean
        Dim InsuredBVATF As Boolean
        Dim InsuredTVATF As Boolean
        Dim AType As String
        Dim PDate As Date
        Dim Installment As Integer
        Dim ScheduleF As Boolean
        Dim pANO As Long
        Dim pLANO As Long

        Dim TaxType As String = ""

        Dim rsI As RemoteSet
        Dim rsF As RemoteSet
        Dim rsP As RemoteSet

        Dim sAdmNo As String

        sAdmNo = "(" & tostr(AdmNo) & ")"

        rs = db.OpenRemoteSet("Select TreatyInstallmentF, TaxTableF, TaxMethod, NetAdjustmentDepositF, VATSubsidiesF from SysTab")
        TreatyInstallmentF = toval(rs.fields("TreatyInstallmentF"))
        TaxTableF = toval(rs.fields("TaxTableF"))
        TaxMethod = toval(rs.fields("TaxMethod"))
        NetAdjustmentDepositF = toval(rs.fields("NetAdjustmentDepositF"))
        VATSubsidiesF = toval(rs.fields("VATSubsidiesF"))

        ' Get CT and Other Policy Information
        Dim SQL As String
        SQL = "Select A.NoRefundF, A.AType, coalesce(lA.PDate, A.PDate) as PDate, A.OverwriteBVatF, A.OverwriteTVatF, "
        SQL = SQL & " Case When A.ADate Between coalesce(Insured.VATESDate,'01/01/1900') and coalesce(Insured.VATEEDate,'01/01/1900') then cast(0 as Bit) else Insured.VatF end as InsuredVatF,"
        SQL = SQL & " Insured.BVATF as InsuredBVATF,"
        SQL = SQL & " Insured.TVATF as InsuredTVATF,"
        SQL = SQL & " A.BVATPCT as OBVATPCT, A.TVATPCT as OTVATPCT, "
        SQL = SQL & " Case When coalesce(A.BVATPCT,0)=0 Then Branch.VAT else coalesce(A.BVATPCT,0) end as BVATPCT, "
        SQL = SQL & " Case When coalesce(A.TVATPCT,0)=0 Then TOC.VAT else coalesce(A.TVATPCT,0) end as TVATPCT, "
        SQL = SQL & " TOC.RValue, TOC.VATInstallmentF, TOC.VatBusinessF, "
        SQL = SQL & " pA.ANO as pANO, pA.LANO as pLANO"
        SQL = SQL & " from Acceptance A "
        SQL = SQL & " Left Join Acceptance pA on (PA.ANO=A.PANO) "
        SQL = SQL & " inner Join Cover C on (C.CNO=A.CNO) "
        SQL = SQL & " Left Join Acceptance lA on (lA.ANO=A.LANO and C.OpenFlag=0) "
        SQL = SQL & " inner join Profile Insured on (Insured.ID=A.AID) "
        SQL = SQL & " inner Join Branch on (Branch.Branch=A.Branch) "
        SQL = SQL & " inner join TOC on (TOC.TOC=A.TOC) "
        SQL = SQL & " Where A.ANO = " & ANO
        rs = db.OpenRemoteSet(SQL)

        BVATPCT = toval(rs.fields("BVATPCT"))
        NoRefundF = toval(rs.fields("NoRefundF"))
        InsuredVATF = toval(rs.fields("InsuredVATF"))
        InsuredBVATF = toval(rs.fields("InsuredBVATF"))
        InsuredTVATF = toval(rs.fields("InsuredTVATF"))
        AType = tostr(rs.fields("AType"))
        PDate = todate(rs.fields("PDate"))
        RValue = toval(rs.fields("RValue"))
        TVATPCT = toval(rs.fields("TVATPCT"))
        VATInstallmentF = toval(rs.fields("VATInstallmentF"))
        VatBusinessF = toval(rs.fields("VatBusinessF"))
        OBVATPCT = toval(rs.fields("OBVATPCT"))
        OTVATPCT = toval(rs.fields("OTVATPCT"))
        OverwriteBVatF = toval(rs.fields("OverwriteBVatF"))
        OverwriteTVatF = toval(rs.fields("OverwriteTVatF"))
        If OverwriteBVatF Then BVATPCT = OBVATPCT
        If OverwriteTVatF Then TVATPCT = OTVATPCT
        pANO = toval(rs.fields("pANO"))
        pLANO = toval(rs.fields("pLANO"))

        If Not SplitDNCNF Then
            If ANO <> LANO And LANO <> -1 Then
                ' Alternate Payor
                rsP = db.OpenQueryDef("QAPayor", adOpenForwardonly, ANO)
                If rsP.Eof Then
                    rsP = db.OpenQueryDef("QPayor", adOpenForwardonly, LANO)
                End If
            Else
                rsP = db.OpenQueryDef("QPayor", adOpenForwardonly, ANO)
            End If
            FDInstallmentF = toval(rsP.fields("FDInstallmentF"))
            ScheduleF = toval(rsP.fields("ScheduleF"))
        End If

        Dim rsadmL As RemoteSet

        rsadmL = db.OpenRemoteSet("Select AdmNo from Admlink Where AdmNo in " & sAdmNo & " Order By AdmNo")
        If Not rsadmL.Eof Then
            If GetLockedObjectF Then
                rsadmL.MoveFirst()
                Do While Not rsadmL.Eof
                    Do While True
                        If db.GetLockedObject("ADMLINK_" & rsadmL.fields("AdmNo")) Then
                            Exit Do
                        Else
                            System.Threading.Thread.Sleep(1000)
                        End If
                    Loop
                    rsadmL.MoveNext()
                Loop
            End If

            rsadmL.MoveFirst()
            Do While Not rsadmL.Eof
                AdmNo = rsadmL.fields("AdmNo")
                rsAdm = db.OpenRemoteSet("Select * from Admlink Where AdmNo=" & AdmNo)
                If rsAdm.Eof Then GoTo errmsg

                rsAdm.Edit()
                PID = rsAdm.fields("ID")
                pCCY = rsAdm.fields("Currency")
                pADate = rsAdm.fields("Date")
                PCode = rsAdm.fields("Code")
                DataReversalF = toval(rsAdm.fields("DataReversalF"))

                If pRefNo <> rsAdm.fields("RefNo") OrElse PType <> rsAdm.fields("Type") OrElse pDocNo <> rsAdm.fields("DocNo") Then
                    pRefNo = rsAdm.fields("RefNo")
                    PType = rsAdm.fields("Type")
                    pDocNo = rsAdm.fields("DocNo")
                    rsF = Nothing
                    If Not SplitDNCNF Then
                        If InStr("CPXPQSQPS1S2S3DCAF", PType) <> 0 Then
                            rs = db.OpenRemoteSet("Select Top 1 TreatyInstallmentF from Reinsurance Where Reinsurance.docNo='" & pRefNo & "'")
                            pTreatyInstallmentF = TreatyInstallmentF Or toval(rs.fields("TreatyInstallmentF"))
                        End If
                        If PType = "FO" Or PType = "FP" Or PType = "AF" Then
                            rsF = db.OpenQueryDef("QFPart", adOpenForwardonly, ANO, PID, pRefNo)
                        End If
                    Else
                        If Not DataReversalF Then
                            If ANO <> LANO And LANO <> -1 Then
                                ' Alternate Payor
                                rsP = db.OpenQueryDef("QAPayor", adOpenForwardonly, ANO)
                                If rsP.Eof Then
                                    rsP = db.OpenQueryDef("QPayor", adOpenForwardonly, LANO)
                                End If
                            Else
                                rsP = db.OpenQueryDef("QPayor", adOpenForwardonly, ANO)
                            End If
                            FDInstallmentF = toval(rsP.fields("FDInstallmentF"))
                            ScheduleF = toval(rsP.fields("ScheduleF"))

                            If InStr("CPXPQSQPS1S2S3DCAF", PType) <> 0 Then
                                rs = db.OpenRemoteSet("Select Top 1 TreatyInstallmentF from Reinsurance Where Reinsurance.docNo='" & pRefNo & "'")
                                pTreatyInstallmentF = TreatyInstallmentF Or toval(rs.fields("TreatyInstallmentF"))
                            End If
                            If PType = "FO" Or PType = "FP" Or PType = "AF" Then
                                rsF = db.OpenQueryDef("QFPart", adOpenForwardonly, ANO, PID, pRefNo)
                            End If
                        Else
                            If pANO <> pLANO And pLANO <> -1 Then
                                ' Alternate Payor
                                rsP = db.OpenQueryDef("QAPayor", adOpenForwardonly, pANO)
                                If rsP.Eof Then
                                    rsP = db.OpenQueryDef("QPayor", adOpenForwardonly, pLANO)
                                End If
                            Else
                                rsP = db.OpenQueryDef("QPayor", adOpenForwardonly, pANO)
                            End If
                            FDInstallmentF = toval(rsP.fields("FDInstallmentF"))
                            ScheduleF = toval(rsP.fields("ScheduleF"))

                            If InStr("CPXPQSQPS1S2S3DCAF", PType) <> 0 Then
                                rs = db.OpenRemoteSet("Select Top 1 TreatyInstallmentF from Reinsurance Where Reinsurance.docNo='" & pRefNo & "'")
                                pTreatyInstallmentF = TreatyInstallmentF Or toval(rs.fields("TreatyInstallmentF"))
                            End If
                            If PType = "FO" Or PType = "FP" Or PType = "AF" Then
                                rsF = db.OpenQueryDef("QFPart", adOpenForwardonly, pANO, PID, pRefNo)
                            End If
                        End If
                    End If
                End If

                Select Case PType
                    Case "DI", "IR", "IC", "JP", "CF", "FO", "FP", "BA", "BB", "BO", "BC", "BP", "BD", "OP"
                        If AType <> "A" Then
                            If PType = "FO" Or PType = "FP" Then
                                rsI = rsF
                            Else
                                rsI = rsP
                            End If
                            Installment = toval(rsI.fields("Installment"))
                        Else
                            Installment = 0
                        End If
                    Case "DC", "QS", "QP", "S1", "S2", "S3"
                        If pTreatyInstallmentF And AType <> "A" Then
                            rsI = rsP
                            Installment = toval(rsI.fields("Installment"))
                        Else
                            Installment = 0
                        End If
                    Case "AF"
                        If Not rsF Is Nothing AndAlso Not rsF.Eof Then
                            If AType <> "A" Then
                                rsI = rsF
                                Installment = toval(rsI.fields("Installment"))
                            Else
                                Installment = 0
                            End If
                        Else
                            If pTreatyInstallmentF And AType <> "A" Then
                                rsI = rsP
                                Installment = toval(rsI.fields("Installment"))
                            Else
                                Installment = 0
                            End If
                        End If
                    Case Else
                        ' Installment Not Applied for BPPDAN/MAIPARK
                        Installment = 0
                End Select

                ' No Installment for Payor Schedule
                If ScheduleF Then Installment = 0

                ' Rounding Amount
                Dim Amount As Double
                Dim TAmount As Double

                'rsAdm.fields("Amount_1") = RoundCCY(toval(rsAdm.fields("Amount_1")), pCCY, RValue)
                'rsAdm.fields("Amount_2") = RoundCCY(toval(rsAdm.fields("Amount_2")), pCCY, RValue)
                'rsAdm.fields("Amount_3") = RoundCCY(toval(rsAdm.fields("Amount_3")), pCCY, RValue)
                'rsAdm.fields("Amount_4") = RoundCCY(toval(rsAdm.fields("Amount_4")), pCCY, RValue)
                'rsAdm.fields("Amount_5") = RoundCCY(toval(rsAdm.fields("Amount_5")), pCCY, RValue)
                'rsAdm.fields("Amount_6") = RoundCCY(toval(rsAdm.fields("Amount_6")), pCCY, RValue)
                'rsAdm.fields("Amount_7") = RoundCCY(toval(rsAdm.fields("Amount_7")), pCCY, RValue)
                'rsAdm.fields("Amount_8") = RoundCCY(toval(rsAdm.fields("Amount_8")), pCCY, RValue)
                'rsAdm.fields("Amount_9") = RoundCCY(toval(rsAdm.fields("Amount_9")), pCCY, RValue)
                'rsAdm.fields("Amount_10") = RoundCCY(toval(rsAdm.fields("Amount_10")), pCCY, RValue)
                'rsAdm.fields("Amount_15") = RoundCCY(toval(rsAdm.fields("Amount_15")), pCCY, RValue)
                'rsAdm.fields("Amount_16") = RoundCCY(toval(rsAdm.fields("Amount_16")), pCCY, RValue)
                'rsAdm.fields("Amount_19") = RoundCCY(toval(rsAdm.fields("Amount_19")), pCCY, RValue)
                'rsAdm.fields("Amount_20") = RoundCCY(toval(rsAdm.fields("Amount_20")), pCCY, RValue)
                'rsAdm.fields("Amount_11") = 0

                TAmount = toval(rsAdm.fields("Amount_1")) + toval(rsAdm.fields("Amount_2")) + toval(rsAdm.fields("Amount_3")) + toval(rsAdm.fields("Amount_4")) + toval(rsAdm.fields("Amount_5")) + toval(rsAdm.fields("Amount_6")) + toval(rsAdm.fields("Amount_7")) + toval(rsAdm.fields("Amount_8")) + toval(rsAdm.fields("Amount_9")) + toval(rsAdm.fields("Amount_10")) + toval(rsAdm.fields("Amount_15")) + toval(rsAdm.fields("Amount_16")) + toval(rsAdm.fields("Amount_19")) + toval(rsAdm.fields("Amount_20"))
                Amount = RoundCCY(TAmount, pCCY, RValue) - TAmount
                rsAdm.fields("Amount_11") = Amount

                Dim VAT As Double = 0
                Dim TAX As Double = 0
                Dim Branch_VAT As Double = 0
                Dim TOC_VAT As Double = 0
                Dim PNominal_VAT As Double = 0
                Dim PNominal_Tax As Double = 0
                Dim pTaxTableF As Boolean = False
                Dim VATsubsidies As Double = 0

                ' VAT and TAX not Applied for Inward Treaty
                If PType <> "IT" And PType <> "IX" Then

                    pTaxTableF = TaxTableF

                    If TaxMethod = 0 Then   ' Indonesia/Thailand
                        If InStr("BBBABCBPBD", PType) <> 0 Then
                            PNominal_VAT = (toval(rsAdm.fields("Amount_2")) + toval(rsAdm.fields("Amount_5"))) + Amount
                        ElseIf PType = "OP" Then
                            PNominal_VAT = (toval(rsAdm.fields("Amount_3")) + toval(rsAdm.fields("Amount_12")) + toval(rsAdm.fields("Amount_15")) + toval(rsAdm.fields("Amount_16"))) + Amount
                        ElseIf InStr("DIICCFJPBO", PType) <> 0 Then
                            PNominal_VAT = (toval(rsAdm.fields("Amount_1")) + toval(rsAdm.fields("Amount_2")) + toval(rsAdm.fields("Amount_5")) + toval(rsAdm.fields("Amount_19")) + toval(rsAdm.fields("Amount_20"))) + Amount
                        Else
                            PNominal_VAT = (toval(rsAdm.fields("Amount_1")) + toval(rsAdm.fields("Amount_2")) + toval(rsAdm.fields("Amount_5")) + toval(rsAdm.fields("Amount_6")) + toval(rsAdm.fields("Amount_7")) + toval(rsAdm.fields("Amount_8")) + toval(rsAdm.fields("Amount_9")) + toval(rsAdm.fields("Amount_10")) + toval(rsAdm.fields("Amount_19")) + toval(rsAdm.fields("Amount_20"))) + Amount
                        End If
                    Else ' Philipine
                        If (InStr("CPDCQSQPS1S2S3AFXPFOFPIRITIX", PType) <> 0) Then
                            ' VAT Only for Commission
                            PNominal_VAT = (toval(rsAdm.fields("Amount_2")))
                        ElseIf InStr("BBBABCBPBD", PType) <> 0 Then
                            PNominal_VAT = (toval(rsAdm.fields("Amount_2")) + toval(rsAdm.fields("Amount_5"))) + Amount
                        ElseIf PType = "OP" Then
                            PNominal_VAT = (toval(rsAdm.fields("Amount_3")) + toval(rsAdm.fields("Amount_12")) + toval(rsAdm.fields("Amount_15")) + toval(rsAdm.fields("Amount_16"))) + Amount
                        ElseIf InStr("DIICCFJPBO", PType) <> 0 Then
                            PNominal_VAT = (toval(rsAdm.fields("Amount_1")) + toval(rsAdm.fields("Amount_2")) + toval(rsAdm.fields("Amount_5")) + toval(rsAdm.fields("Amount_19")) + toval(rsAdm.fields("Amount_20"))) + Amount
                        Else
                            PNominal_VAT = (toval(rsAdm.fields("Amount_1")) + toval(rsAdm.fields("Amount_2")) + toval(rsAdm.fields("Amount_5")) + toval(rsAdm.fields("Amount_6")) + toval(rsAdm.fields("Amount_7")) + toval(rsAdm.fields("Amount_8")) + toval(rsAdm.fields("Amount_9")) + toval(rsAdm.fields("Amount_10")) + toval(rsAdm.fields("Amount_19")) + toval(rsAdm.fields("Amount_20"))) + Amount
                        End If
                    End If
                    If (PType = "FO" Or PType = "FP" Or PType = "QS" Or PType = "QP" Or PType = "S1" Or PType = "S2" Or PType = "S3" Or PType = "AF") Then
                        Select Case TaxType.ToUpper
                            Case "PASAL21", "PASAL23", "PASAL4"
                                ' Excluding Premium
                                PNominal_Tax = (toval(rsAdm.fields("Amount_2")) + toval(rsAdm.fields("Amount_3")) + toval(rsAdm.fields("Amount_5")) + toval(rsAdm.fields("Amount_6")) + toval(rsAdm.fields("Amount_7")) + toval(rsAdm.fields("Amount_8")) + toval(rsAdm.fields("Amount_9")) + toval(rsAdm.fields("Amount_10")) + toval(rsAdm.fields("Amount_15")) + toval(rsAdm.fields("Amount_16")) + toval(rsAdm.fields("Amount_19")) + toval(rsAdm.fields("Amount_20")))
                            Case Else
                                ' Excluding Commission 
                                PNominal_Tax = (toval(rsAdm.fields("Amount_1")) + toval(rsAdm.fields("Amount_3")) + toval(rsAdm.fields("Amount_5")) + toval(rsAdm.fields("Amount_6")) + toval(rsAdm.fields("Amount_7")) + toval(rsAdm.fields("Amount_8")) + toval(rsAdm.fields("Amount_9")) + toval(rsAdm.fields("Amount_10")) + toval(rsAdm.fields("Amount_15")) + toval(rsAdm.fields("Amount_16")) + toval(rsAdm.fields("Amount_19")) + toval(rsAdm.fields("Amount_20"))) + Amount
                        End Select
                    Else
                        If InStr("BBBABCBPBD", PType) <> 0 Then
                            PNominal_Tax = (toval(rsAdm.fields("Amount_2")) + toval(rsAdm.fields("Amount_5"))) + Amount
                        ElseIf PType = "OP" Then
                            PNominal_Tax = (toval(rsAdm.fields("Amount_3")) + toval(rsAdm.fields("Amount_12")) + toval(rsAdm.fields("Amount_15")) + toval(rsAdm.fields("Amount_16"))) + Amount
                        ElseIf InStr("DIICCFJPBO", PType) <> 0 Then
                            PNominal_Tax = (toval(rsAdm.fields("Amount_1")) + toval(rsAdm.fields("Amount_2")) + toval(rsAdm.fields("Amount_5")) + toval(rsAdm.fields("Amount_19")) + toval(rsAdm.fields("Amount_20"))) + Amount
                        Else
                            PNominal_Tax = (toval(rsAdm.fields("Amount_1")) + toval(rsAdm.fields("Amount_2")) + toval(rsAdm.fields("Amount_5")) + toval(rsAdm.fields("Amount_6")) + toval(rsAdm.fields("Amount_7")) + toval(rsAdm.fields("Amount_8")) + toval(rsAdm.fields("Amount_9")) + toval(rsAdm.fields("Amount_10")) + toval(rsAdm.fields("Amount_19")) + toval(rsAdm.fields("Amount_20"))) + Amount
                        End If
                    End If

                    Dim pVATSubsidiesF As Boolean = VATSubsidiesF
                    If Not Calculate_VAT_TAX(pTaxTableF, PID, PType, pADate, pCCY, PNominal_VAT, PNominal_Tax, VAT, TAX, TaxType, BVATPCT, TVATPCT, Branch_VAT, TOC_VAT, pVATSubsidiesF) Then
                        StrMsg = "Failed in Calculating Vat/Tax !"
                        GoTo errmsg
                    End If

                    ' PASAL21 and Not Commission Net To Premium (NoRefundF=7)
                    If Not (TaxType = "PASAL21" And NoRefundF <> 7 And NoRefundF <> 9 And NoRefundF <> 10) Then
                        pTaxTableF = False
                    End If

                    ' NoRefundf : 8 : No Add Refund Vat, 10 : no Add Refund VAT and TAX
                    If TaxMethod = 0 Then   ' Indonesia/Thailand
                        If (((PType = "BB" Or PType = "BA" Or PType = "BC" Or PType = "BP" Or PType = "BD" Or PType = "OP") Or (((InStr("BBBABOBCBPBDOPDIICCFJP", PType) = 0 And VatBusinessF) Or (InsuredVATF And VatBusinessF)) And VAT <> 0)) And NoRefundF <> 8 And NoRefundF <> 10 And NoRefundF <> 14) Then
                            rsAdm.fields("PNominal_VAT") = PNominal_VAT
                            rsAdm.fields("Amount_13") = VAT
                            If PNominal_VAT <> 0 AndAlso VAT / PNominal_VAT < 0 AndAlso pVATSubsidiesF Then
                                VATsubsidies = -VAT
                            End If
                            rsAdm.fields("Amount_8") = VATsubsidies
                        End If
                    Else
                        If (((PType = "BB" Or PType = "BA" Or PType = "BC" Or PType = "BP" Or PType = "BD" Or PType = "OP") Or (((InStr("BBBABOBCBPBDOPDIICCFJP", PType) = 0) Or (InsuredVATF And VatBusinessF)) And VAT <> 0)) And NoRefundF <> 8 And NoRefundF <> 10 And NoRefundF <> 14) Then
                            rsAdm.fields("PNominal_VAT") = PNominal_VAT
                            rsAdm.fields("Amount_13") = VAT
                            If PNominal_VAT <> 0 AndAlso VAT / PNominal_VAT < 0 AndAlso pVATSubsidiesF Then
                                VATsubsidies = -VAT
                            End If
                            rsAdm.fields("Amount_8") = VATsubsidies
                        End If
                    End If

                    ' NoRefundf : 9 : No Add Refund Tax, 10 : no Add Refund VAT and TAX
                    If (((PType = "BB" Or PType = "BA" Or PType = "BC" Or PType = "BP" Or PType = "BD" Or PType = "OP") Or (TAX <> 0)) And NoRefundF <> 9 And NoRefundF <> 10) Then
                        rsAdm.fields("PNominal_Tax") = PNominal_Tax
                        rsAdm.fields("Amount_14") = TAX
                    End If

                    ' Branch VAT and TOC VAT only Applied to Direct Business Premium
                    If NoRefundF <> 11 AndAlso NoRefundF <> 14 AndAlso (InStr("DIICCFJPBO", PType) <> 0) Then
                        If InsuredBVATF Then
                            rsAdm.fields("Amount_17") = Branch_VAT
                        End If
                        If InsuredTVATF Then
                            If InStr("DIICCFJPBO", PType) <> 0 Then
                                Select Case TaxMethod
                                    Case 0  ' Indonesia/Thailand
                                        rsAdm.fields("Amount_18") = TOC_VAT
                                    Case 1  ' Philipine(Tax Method by TOC)
                                        rsAdm.fields("Amount_18") = TOC_VAT
                                    Case 2  ' Philipine(Tax Method by Risk)
                                        rsAdm.fields("Amount_18") = RoundCCY(GetPNominalVat_ByRisk(AdmNo) * (TVATPCT) / 100, pCCY, 1)
                                End Select
                            End If
                        End If
                    End If
                End If
                rsAdm.fields("Amount") = TAmount + VATsubsidies + toval(rsAdm.fields("Amount_11")) + toval(rsAdm.fields("Amount_13")) + toval(rsAdm.fields("Amount_14")) + toval(rsAdm.fields("Amount_17")) + toval(rsAdm.fields("Amount_18"))

                'Lumpsum Amount
                If Not VATInstallmentF Then
                    rsAdm.fields("LAmount") = VATsubsidies + toval(rsAdm.fields("Amount_13")) + toval(rsAdm.fields("Amount_17")) + toval(rsAdm.fields("Amount_18"))
                Else
                    rsAdm.fields("LAmount") = toval(rsAdm.fields("Amount_17"))
                End If
                If PType = "DI" AndAlso Not FDInstallmentF Then
                    rsAdm.fields("LAmount") = toval(rsAdm.fields("LAmount")) + toval(rsAdm.fields("Amount_3")) + toval(rsAdm.fields("Amount_4")) + toval(rsAdm.fields("Amount_15")) + toval(rsAdm.fields("Amount_16"))
                End If

                'Instalment Amount
                rsAdm.fields("IAmount") = toval(rsAdm.fields("Amount")) - toval(rsAdm.fields("LAmount"))

                If Installment > 0 Then
                    ' Instalment Procedures
                    Dim AmountDue As Double
                    Dim TAmountDue As Double
                    Dim i As Integer
                    Dim j As Integer
                    Dim IPCT As Double
                    Dim TIPCT As Double

                    AmountDue = 0
                    TAmountDue = 0
                    j = 0
                    TIPCT = 0
                    If PType <> "IX" And PType <> "IT" Then
                        If Installment > 0 Then
                            For i = 1 To Installment
                                If toval(rsI.fields("IPCT_" & i)) = 0 Then
                                    IPCT = 100 / Installment
                                Else
                                    IPCT = toval(rsI.fields("IPCT_" & i))
                                End If

                                ' Last Instalment or Effective Date isn't exceeding Instalment Date or Type is Outward Facultative
                                If i = Installment Or DateDiff(DateInterval.Day, PDate, todate(rsI.fields("IDate_" & i))) >= 0 Or PType = "FO" Or PType = "FP" Then
                                    If j = 0 Then j = i

                                    If i = Installment Then
                                        AmountDue = AmountDue + toval(rsAdm.fields("LAmount")) + toval(rsAdm.fields("IAmount")) - TAmountDue
                                    ElseIf i = j Then
                                        AmountDue = AmountDue + toval(rsAdm.fields("LAmount")) + RoundCCY(toval(rsAdm.fields("IAmount")) * IPCT / (100 - TIPCT), pCCY, RValue)
                                    Else
                                        AmountDue = AmountDue + RoundCCY(toval(rsAdm.fields("IAmount")) * IPCT / (100 - TIPCT), pCCY, RValue)
                                    End If

                                    rsAdm.fields("DueDate_" & i) = todate(rsI.fields("IDate_" & i))
                                    rsAdm.fields("AmountDue_" & i) = AmountDue
                                    TAmountDue = TAmountDue + AmountDue
                                    AmountDue = 0
                                Else
                                    rsAdm.fields("DueDate_" & i) = todate(rsI.fields("IDate_" & i))
                                    rsAdm.fields("AmountDue_" & i) = 0
                                    TIPCT = TIPCT + IPCT
                                End If
                            Next i
                        End If

                        ' No Instalment Process 
                        If j = 0 Then Installment = 0
                    End If

                End If

                rsAdm.fields("Installment") = Installment

                rsAdm.fields("LUserID") = db_user
                rsAdm.fields("LDate") = Today.Date
                rsAdm.fields("LTime") = Time()
                rsAdm.fields("TaxTableF") = pTaxTableF

                If pTaxTableF Then
                    If (RoundCCY(toval(rsAdm.fields("Amount")), pCCY, RValue) <> RoundCCY(VATsubsidies + toval(rsAdm.fields("Amount_11")) + toval(rsAdm.fields("Amount_12")) + toval(rsAdm.fields("Amount_13")) + toval(rsAdm.fields("Amount_14")) + toval(rsAdm.fields("Amount_17")) + toval(rsAdm.fields("Amount_18")), pCCY, RValue)) Or (PNominal_Tax <> 0) Then
                        'Update Tax Table                    
                        If toval(rsAdm.fields("TaxTableF")) Then
                            If Not Update_Tax_Table(PID, pADate, pCCY, PNominal_Tax, TAX) Then
                                StrMsg = "Failed Inserting into Tax Table !"
                                GoTo errmsg
                            End If
                        End If
                        rsAdm.fields("WriteF") = 0
                    Else
                        rsAdm.fields("WriteF") = 1
                    End If
                Else
                    If NetAdjustmentDepositF Then
                        If RoundCCY(toval(rsAdm.fields("Amount")), pCCY, RValue) = 0 And RoundCCY(toval(rsAdm.fields("Amount_20")), pCCY, RValue) = 0 Then
                            rsAdm.fields("WriteF") = 1
                        Else
                            rsAdm.fields("WriteF") = 0
                        End If
                    Else
                        If RoundCCY(toval(rsAdm.fields("Amount")), pCCY, RValue) = 0 And RoundCCY(toval(rsAdm.fields("Amount_19")), pCCY, RValue) = 0 And RoundCCY(toval(rsAdm.fields("Amount_20")), pCCY, RValue) = 0 Then
                            rsAdm.fields("WriteF") = 1
                        Else
                            rsAdm.fields("WriteF") = 0
                        End If
                    End If
                End If
                If toval(rsAdm.fields("WriteF")) Then
                    rsAdm.fields("TaxTableF") = False
                    rsAdm.fields("Amount") = 0
                    rsAdm.fields("Amount_8") = toval(rsAdm.fields("Amount_8")) - VATsubsidies
                    rsAdm.fields("Amount_11") = 0
                    rsAdm.fields("Amount_12") = 0
                    rsAdm.fields("Amount_13") = 0
                    rsAdm.fields("Amount_14") = 0
                    rsAdm.fields("Amount_17") = 0
                    rsAdm.fields("Amount_18") = 0
                End If

                If Not rsAdm.Update Then GoTo errmsg
                rsadmL.MoveNext()
            Loop

            If GetLockedObjectF Then
                rsadmL.MoveFirst()
                Do While Not rsadmL.Eof
                    If Not db.ReleaseLockedObject("ADMLINK_" & rsadmL.fields("AdmNo")) Then GoTo errmsg
                    rsadmL.MoveNext()
                Loop
            End If
        End If


        If BVATPCT <> OBVATPCT OrElse TVATPCT <> OTVATPCT Then
            If Not db.Execute("Update Acceptance Set BVATPCT=" & tovalSF(BVATPCT) & ", TVATPCT=" & tovalSF(TVATPCT) & " Where ANO=" & ANO) Then
                GoTo errmsg
            End If
        End If
        Production_To_Adm_Finalize = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Production_To_Adm_Finalize = False
    End Function
    Private Function Cancel_Voucher_Production(ByVal ANO As Long) As Boolean
        Dim rsVoucher As RemoteSet
        Dim rs As RemoteSet
        Dim Voucher As String
        Dim VoucherDate As Date
        Dim Branch As String

        Branch = ""
        rsVoucher = db.OpenRemoteSet("Select Distinct nVoucher.Voucher, nVoucher.Branch, nVoucher.Date from nVoucher, Admlink A1, AccAss A2, Acceptance A3 Where nVoucher.Voucher=A1.Voucher and A1.AdmNo=A2.AdmNo and A2.ANO=A3.ANO and A3.ANO=" & ANO)
        Do While Not rsVoucher.Eof
            Voucher = rsVoucher.fields("Voucher")
            VoucherDate = rsVoucher.fields("Date")

            If Branch <> rsVoucher.fields("Branch") Then
                Branch = rsVoucher.fields("Branch")
                Dim LockedDate As Date
                Dim BLLocked As Integer
                LockedDate = GetLockedDate(Branch)
                BLLocked = GetUserBLLocked(db_user)

                If (DateDiff(DateInterval.Day, LockedDate, VoucherDate) <= 0 And (DateDiff(DateInterval.Day, LockedDate, Today.Date) > BLLocked Or BLLocked = 0)) Then
                    StrMsg = "Please Check The Transaction Closing Period (Locked Date) !"
                    GoTo errmsg
                End If
            End If
            rs = db.OpenRemoteSet("Select * from nSL Where paymentF=1 and Doc_No='" & Voucher & "'")
            If Not rs.Eof Then
                StrMsg = "Voucher Already Used by WithHolding Voucher No. '" & tostr(rs.fields("Voucher")) & "' !"
                GoTo errmsg
            Else
                rs = db.OpenRemoteSet("Select * from ReminderV where Voucher='" & Voucher & "'", adOpenForwardonly)
                If Not rs.Eof Then
                    StrMsg = "Voucher Already Used by Reminder No. '" & tostr(rs.fields("PrintNo")) & "' !"
                    GoTo errmsg
                Else
                    rs = db.OpenRemoteSet("Select * from CollectionV where Voucher='" & Voucher & "'", adOpenForwardonly)
                    If Not rs.Eof Then
                        StrMsg = "Voucher Already Used by Collection No. '" & tostr(rs.fields("CollNo")) & "' !"
                        GoTo errmsg
                    Else
                        rs = db.OpenRemoteSet("Select * from SL_request where PaymentF=1 and Doc_No='" & Voucher & "'", adOpenForwardonly)
                        If Not rs.Eof Then
                            StrMsg = "Voucher Already Used by Payment Request No. '" & tostr(rs.fields("Request")) & "' !"
                            GoTo errmsg
                        Else
                            rs = db.OpenRemoteSet("Select * from pSL where paymentf=1 and Doc_No='" & Voucher & "'", adOpenForwardonly)
                            If Not rs.Eof Then
                                StrMsg = "Voucher Already Used by Voucher No. '" & tostr(rs.fields("Voucher")) & "' !"
                                GoTo errmsg
                            Else
                                If Not db.Execute("Update Admlink Set VoucherF=0, Voucher='' Where voucher='" & Voucher & "'") Then GoTo ErrMsg
                                If Not db.Execute("Delete from nVoucher where Voucher='" & Voucher & "' and Posting_Flag=0 and Status='U' and nPayment=0") Then GoTo ErrMsg
                                If db.RecordsAffected = 0 Then
                                    StrMsg = "Voucher Already Processed (Please Check Posting or Payment Status) !"
                                    GoTo errmsg
                                End If
                            End If
                        End If
                    End If
                End If
            End If
            rsVoucher.MoveNext()
        Loop
        Return True
errmsg:
        StrMsg = StrError(StrMsg)
        Return False
    End Function
    Private Function ReProduction_To_Adm(ByVal ANO As Long) As Boolean
        Dim rs As RemoteSet
        Dim LANO As Long
        Dim OpenFlag As Boolean
        Dim DetailTreatyF As Boolean

        rs = db.OpenRemoteSet("Select Acceptance.ANO, Acceptance.LANO, Cover.OpenFlag from Acceptance, Cover Where Cover.CNO=Acceptance.CNO and Acceptance.ANO=" & ANO)
        If rs.Eof Then
            StrMsg = "No Policy Transaction !"
            GoTo errmsg
        End If
        LANO = rs.fields("LANO")
        OpenFlag = rs.fields("OpenFlag")
        rs = db.OpenRemoteSet("Select DetailTreatyF from SysTab", adOpenForwardonly)
        DetailTreatyF = rs.fields("DetailTreatyF")
        If Not Cancel_Voucher_Production(ANO) Then GoTo errmsg
        If Not Undo_Production_To_Adm(ANO, True) Then GoTo errmsg
        If Not Production_To_Adm(ANO, LANO, , DetailTreatyF) Then GoTo errmsg

        If (LANO = -1 Or OpenFlag) Then
            If DetailTreatyF Then
                rs = db.OpenRemoteSet("Select distinct Admlink.ID, TOC.COB, Admlink.TYPE, Admlink.CURRENCY, Admlink.REFNO, Admlink.DATE, Admlink.BILLDATE, Admlink.DOCNO, Admlink.Subject, Admlink.BRANCH from AccAss, Admlink, TOC Where TOC.TOC=Admlink.Code and Admlink.VoucherF=0 and Admlink.AdmNo=AccAss.AdmNo and Admlink.WriteF=0 and AccAss.CommPoolF<>1 and AccAss.ANO=" & ANO)
            Else
                rs = db.OpenRemoteSet("Select distinct Admlink.ID, TOC.COB, Admlink.TYPE, Admlink.CURRENCY, Admlink.REFNO, Admlink.DATE, Admlink.BILLDATE, Admlink.DOCNO, Admlink.Subject, Admlink.BRANCH from AccAss, Admlink, TOC Where TOC.TOC=Admlink.Code and Admlink.VoucherF=0 and Admlink.AdmNo=AccAss.AdmNo and Admlink.WriteF=0 and AccAss.CommPoolF<>1 and (AccAss.Type in ('DI', 'IR', 'IT', 'IX', 'IC', 'JP', 'CF', 'FO', 'FP', 'BA', 'BB', 'BO', 'BC', 'BP','BD', 'OP', 'DC','CP','XP','AF') or TOC.ConsortiumF=1) and AccAss.ANO=" & ANO)
            End If

            Do While Not rs.Eof
                Dim rsAdmNo As RemoteSet
                Dim sAdmNo As String = ""
                rsAdmNo = db.OpenRemoteSet("Select A.AdmNo from Admlink A, TOC T Where A.Code=T.TOC and A.VoucherF=0 and A.WriteF=0 and A.ID='" & rs.fields("ID") & "' and T.COB='" & rs.fields("COB") & "' and A.Type='" & rs.fields("Type") & "' and A.Currency='" & rs.fields("Currency") & "' and A.RefNo='" & rs.fields("RefNo") & "' and A.Date='" & Format(rs.fields("Date"), "MM/DD/YYYY") & "' and A.BillDate='" & Format(rs.fields("BillDate"), "MM/DD/YYYY") & "' and A.DocNo='" & rs.fields("DocNo") & "' and A.Subject='" & rs.fields("Subject") & "' and A.Branch='" & rs.fields("Branch") & "'")
                If Not rsAdmNo.Eof Then
                    Do While Not rsAdmNo.Eof
                        If sAdmNo = "" Then
                            sAdmNo = tostr(rsAdmNo.fields("AdmNo"))
                        Else
                            sAdmNo = sAdmNo & "," & tostr(rsAdmNo.fields("AdmNo"))
                        End If
                        rsAdmNo.MoveNext()
                    Loop
                    If Not Production_To_Adm_Finalize(ANO, ANO, sAdmNo) Then GoTo errmsg
                    If Create_Voucher(sAdmNo, True) = "" Then GoTo errmsg
                End If

                rs.MoveNext()
            Loop
        End If

        Return True
errmsg:
        StrMsg = StrError(StrMsg)
        Return False
    End Function
    Private Function Tax_Rate(ByVal CCode As String, ByVal PDate As Object) As Double
        Dim rs As RemoteSet

        On Error GoTo errmsg
        rs = db.OpenRemoteSet("Select Currency from SysTab", adOpenForwardonly)
        If CCode.ToUpper <> tostr(rs.fields("Currency")).ToString.ToUpper And IsDate(PDate) Then
            rs = db.OpenRemoteSet("Select TRate from Currency Where Currency='" & CCode & "' and Effective<='" & Format(PDate, "MM/DD/YYYY") & "'")
            If Not rs.Eof Then
                Tax_Rate = rs.fields("TRate")
            Else
                rs = db.OpenRemoteSet("select Top 1 exchange.TRate from exchange where exchange.currency='" & CCode & "' and exchange.effective<='" & Format(PDate, "MM/DD/YYYY") & "' Order by exchange.effective desc", adOpenForwardonly)
                If Not rs.Eof Then
                    Tax_Rate = rs.fields("TRate")
                Else
                    Tax_Rate = 1
                End If
            End If
        Else
            Tax_Rate = 1
        End If
        rs.CloseRemoteSet()
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Tax_Rate = 1
    End Function
    Private Function Calc_Tax_Amount(ByVal CCode As String, ByVal PDate As Date, ByVal Amount As Double, ByVal TaxPCT As Double, Optional ByVal TaxCCYRate As Double = 0) As Double
        Dim Amount_BC As Double
        Dim rs As RemoteSet
        Dim Difference As Double
        Dim TAX As Double
        Dim sign As Integer

        On Error GoTo errmsg
        If Amount <> 0 Then
            If TaxCCYRate = 0 Then TaxCCYRate = Tax_Rate(CCode, PDate)
            Amount_BC = TaxCCYRate * Amount
            TAX = 0
            sign = Abs(Amount_BC) / Amount_BC
            Amount_BC = Abs(Amount_BC)

            rs = db.OpenRemoteSet("Select * from ProgTab Where [Lower]<=" & tovalSF(Amount_BC) & " Order By lower")
            Do While Not rs.Eof
                Difference = toval(rs.fields("Upper")) - toval(rs.fields("Lower"))
                If Difference > Amount_BC Then Difference = Amount_BC
                TAX = TAX + toval(rs.fields("Tax")) / 100 * TaxPCT / 100 * Difference
                Amount_BC = Amount_BC - Difference
                rs.MoveNext()
            Loop
            Calc_Tax_Amount = -TAX / TaxCCYRate * sign
        Else
            Calc_Tax_Amount = 0
        End If
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Calc_Tax_Amount = 0
    End Function
    Private Function Get_Tax_Table(ByVal PID As String, ByVal PDate As Date, ByRef Amount As Double, ByRef Tax As Double) As Boolean
        Dim rs As RemoteSet
        Dim TaxRate As Double
        Dim Yr As Integer
        On Error GoTo errmsg
        Amount = 0
        Tax = 0
        Yr = Year(PDate)
        rs = db.OpenRemoteSet("Select * from TaxTable Where Year=" & Yr & " and ID='" & PID & "'")
        Do While Not rs.Eof
            TaxRate = Tax_Rate(rs.fields("Currency"), PDate)
            Amount = Amount + TaxRate * toval(rs.fields("PNominal"))
            Tax = Tax + TaxRate * toval(rs.fields("Tax"))
            rs.MoveNext()
        Loop
        Get_Tax_Table = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Get_Tax_Table = False
    End Function
    Private Function Update_Tax_Table(ByVal PID As String, ByVal PDate As Date, ByVal CCY As String, ByVal Amount As Double, ByVal Tax As Double) As Boolean
        Dim rs As RemoteSet
        Dim Yr As Integer
        On Error GoTo errmsg
        Yr = Year(PDate)
        rs = db.OpenRemoteSet("Select * from TaxTable Where Year=" & Yr & " and ID='" & PID & "' and Currency='" & CCY & "'")
        If rs.Eof Then
            rs.AddNew()
            rs.fields("Year") = Yr
            rs.fields("ID") = PID
            rs.fields("Currency") = CCY
        Else
            rs.Edit()
        End If
        rs.fields("PNominal") = toval(rs.fields("PNominal")) + Amount
        rs.fields("Tax") = toval(rs.fields("Tax")) + Tax
        If Not rs.Update Then GoTo errmsg
        Update_Tax_Table = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Update_Tax_Table = False
    End Function
    Private Function Calculate_VAT_TAX(ByRef TaxTableF As Boolean, ByVal PID As String, ByVal PType As String, ByVal pDate As Date, ByVal pCCY As String, ByVal Nominal_VAT As Double, ByVal Nominal_TAX As Double, ByRef VAT As Double, ByRef TAX As Double, ByRef TaxType As String, Optional ByVal BVATPCT As Double = 0, Optional ByVal TVATPCT As Double = 0, Optional ByRef Branch_VAT As Double = 0, Optional ByRef TOC_VAT As Double = 0, Optional ByRef VATSubsidiesF As Boolean = False) As Boolean
        Dim rsTAX As RemoteSet
        Dim TaxPCT As Double
        Dim TaxRate As Double
        Dim TaxDiscount As Double
        Dim NTaxIncome As Double
        Dim TaxIncome As Double
        Dim AccruedTax As Double
        Dim VATPCT As Double

        On Error GoTo ErrMsg

        TaxType = ""
        Dim SQL As String
        SQL = "Select SysTab.Currency, SysTab.LimitVatAmount, TaxType.MTaxType, Profile.NTaxIncome, Profile.TaxType, "
        If InStr("DIICCFJPBO", PType) Then
            SQL = SQL & " Case When '" & Format(pDate, "MM/DD/YYYY") & "' Between coalesce(Profile.VATESDate,'01/01/1900') and coalesce(Profile.VATEEDate,'01/01/1900') then cast(0 as Bit) else Profile.VatF end as VatF, "
        Else
            SQL = SQL & " Profile.VatF,"
        End If
        SQL = SQL & " Profile.BVatF as BVatF, "
        SQL = SQL & " Profile.TVatF as TVatF, "
        If InStr("DIICCFJPBO", PType) Then
            SQL = SQL & " Profile.TaxF, "
        Else
            SQL = SQL & " Case When '" & Format(pDate, "MM/DD/YYYY") & "' Between coalesce(Profile.TaxHSDate,'01/01/1900') and coalesce(Profile.TaxHEDate,'01/01/1900') then cast(0 as Bit) else Profile.TaxF end as TaxF, "
        End If
        SQL = SQL & " Profile.VATSubsidiesF, "
        SQL = SQL & " MParam.TaxDiscount, MParam.Effective, MParam.VAT, MParam.VATOLD, MParam.PASAL21, MPARAM.PASAL23, MPARAM.PASAL26, MPARAM.PASAL4, Profile.AccruedTax,"
        SQL = SQL & " (Case When Profile.TaxPCT=0 Then 100 else Profile.TaxPCT end) as TaxPCT "
        SQL = SQL & " from Profile"
        SQL = SQL & " Left Join TaxType on (TaxType.TaxType=Profile.TaxType)"
        SQL = SQL & " Inner Join MParam on (Mparam.Type='" & PType & "')"
        SQL = SQL & " Inner Join SysTab on (1=1)"
        SQL = SQL & " Where Profile.ID='" & PID & "'"
        rsTAX = db.OpenRemoteSet(SQL)
        If Not rsTAX.Eof Then
            TaxType = tostr(rsTAX.fields("MTaxType")).ToUpper
            If PType = "SC" And TaxType = "" Then TaxType = "PASAL23"
            TaxPCT = toval(rsTAX.fields("TaxPCT"))
            TaxDiscount = toval(rsTAX.fields("TaxDiscount"))
            NTaxIncome = toval(rsTAX.fields("NTaxIncome"))
            AccruedTax = toval(rsTAX.fields("AccruedTax"))
            TaxRate = toval(rsTAX.fields(TaxType))
            VATSubsidiesF = VATSubsidiesF Or toval(rsTAX.fields("VATSubsidiesF"))

            ' Added Information to Check Effective Tax Rate
            If DateDiff(DateInterval.Day, todate(rsTAX.fields("Effective")), pDate) < 0 Then
                VATPCT = toval(rsTAX.fields("VATOLD"))
            Else
                VATPCT = toval(rsTAX.fields("VAT"))
            End If

            If toval(rsTAX.fields("VatF")) Then
                VAT = Nominal_VAT * (VATPCT) / 100
            Else
                If InStr("DIICCFJPBO", PType) <> 0 Then
                    VAT = Nominal_VAT * (VATPCT) / 100
                Else
                    VAT = 0
                End If
            End If
            If toval(rsTAX.fields("BVATF")) Then
                Branch_VAT = Nominal_VAT * (BVATPCT) / 100
            Else
                If InStr("DIICCFJPBO", PType) <> 0 Then
                    Branch_VAT = Nominal_VAT * (BVATPCT) / 100
                Else
                    Branch_VAT = 0
                End If
            End If
            If toval(rsTAX.fields("TVATF")) Then
                TOC_VAT = Nominal_VAT * (TVATPCT) / 100
            Else
                If InStr("DIICCFJPBO", PType) <> 0 Then
                    TOC_VAT = Nominal_VAT * (TVATPCT) / 100
                Else
                    TOC_VAT = 0
                End If
            End If
            If toval(rsTAX.fields("TAXF")) Then
                If TaxType = "PASAL21" Or TaxType = "PASAL23" Or TaxType = "PASAL26" Or TaxType = "PASAL4" Then
                    If TaxRate <> 0 Then
                        If AccruedTax = 0 Then
                            If TaxType = "PASAL21" Then
                                Dim TaxCCYRate As Double
                                TaxCCYRate = Tax_Rate(pCCY, pDate)
                                If TaxTableF Then
                                    Dim TAmount As Double
                                    Dim TTax As Double

                                    ' TAmount and TTax already in Base Currency
                                    Get_Tax_Table(PID, pDate, TAmount, TTax)

                                    'Looking at Progressive Table
                                    TaxIncome = -(TAmount + TaxCCYRate * Nominal_TAX) * (100 - TaxDiscount) / 100 - NTaxIncome * (DateDiff(DateInterval.Month, DateSerial(Year(pDate), 1, 1), pDate) + 1)
                                    If TaxIncome < 0 Then TaxIncome = 0

                                    'TaxIncome = -(TAmount + TaxCCYRate * Nominal_TAX) * (100 - TaxDiscount) / 100

                                    TAX = Calc_Tax_Amount(rsTAX.fields("Currency"), pDate, -TaxIncome, TaxPCT, 1) - TTax
                                    TAX = TAX / TaxCCYRate
                                Else
                                    'Looking at Progressive Table
                                    TaxIncome = -(TaxCCYRate * Nominal_TAX) * (100 - TaxDiscount) / 100
                                    TAX = Calc_Tax_Amount(rsTAX.fields("Currency"), pDate, -TaxIncome, TaxPCT, 1)
                                    TAX = TAX / TaxCCYRate
                                End If
                            Else
                                TAX = Nominal_TAX * -TaxRate / 100 * TaxPCT / 100
                                TaxTableF = False
                            End If
                        Else
                            TAX = Nominal_TAX * -AccruedTax / 100 * TaxPCT / 100
                            TaxTableF = False
                        End If
                    Else                        
                        TAX = 0
                        ' Return False Tax Table Flag 
                        TaxTableF = False
                    End If
                Else
                    TAX = Nominal_TAX * -AccruedTax / 100 * TaxPCT / 100
                    ' Return False Tax Table Flag
                    TaxTableF = False
                End If
            Else
                ' Return False Tax Table Flag
                TaxTableF = False
            End If

        End If
        VAT = RoundCCY(VAT, pCCY, 1)
        TAX = RoundCCY(TAX, pCCY, 1)
        Branch_VAT = RoundCCY(Branch_VAT, pCCY, 1)
        TOC_VAT = RoundCCY(TOC_VAT, pCCY, 1)
        Calculate_VAT_TAX = True
        Exit Function
ErrMsg:
        StrMsg = StrError(StrMsg)
        Calculate_VAT_TAX = False
    End Function
