        End If

        Dim OANO As Long
        Dim PANO As Long
        Dim AType As String
        Dim PDate As Date
        Dim ESeqNo As Long
        Dim EESeqNo As Long
        Dim EEndorseF As Boolean

        OANO = -1
        ANO = -1
        PANO = -1
        AType = "N"
        PDate = SDate
        ESeqNo = 0
        EESeqNo = 0
        EEndorseF = False
        If EndorseF Then
            rsd = db.OpenRemoteSet("Select top 1 ANO, OANO, ESeqNo, EESeqNo, EEndorseF, AType, PDate, PANO, AStatus from Acceptance Where LANO<>ANO and LANO=" & LANO & " and CertificateNo='" & CertificateNo & "' Order By ANO Desc")
            If Not rsd.Eof Then
                If tostr(rsd.fields("AStatus")) = "W" Then
                    ANO = toval(rsd.fields("ANO"))
                    OANO = toval(rsd.fields("OANO"))
                    PANO = toval(rsd.fields("PANO"))
                    AType = tostr(rsd.fields("AType"))
                    PDate = todate(rsd.fields("PDate"))
                    ESeqNo = toval(rsd.fields("ESeqNo"))
                    EESeqNo = toval(rsd.fields("EESeqNo"))
                    EEndorseF = toval(rsd.fields("EEndorseF"))
                Else
                    ANO = -1
                    OANO = toval(rsd.fields("OANO"))
                    PANO = toval(rsd.fields("ANO"))
                    AType = "E"
                    PDate = todate(rsd.fields("PDate"))
                    ESeqNo = toval(rsd.fields("ESeqNo")) + 1
                    EESeqNo = toval(rsd.fields("EESeqNo"))
                    EEndorseF = False
                End If
                If IsDate(Effective_Date) Then
                    PDate = Effective_Date
                End If
            Else
                StrMsg = "Certificate No '" & CertificateNo & "' Not Found !"
                GoTo errmsg
            End If
        End If

        Dim BankersClause As String
        Dim NewBankersClause As String

        rsd = db.OpenRemoteSet("Select * from " & tPrefix & "Acceptance Where ANO=" & ANO)
        If rsd.Eof Then
            rsd.AddNew()
            If Not EndorseF AndAlso tPrefix = "" Then
                If CertificateNo = "" Then
                    'Set Auto Numbering Here
                    CertNum = GetCertificateNo(CNO)
                    If CertNum = 0 Then
                        StrMsg = "Can't Get Certificate No !" & StrMsg
                        GoTo errmsg
                    End If
                    ' Certificate Number
                    CertificateNo = Format(CertNum, "000000")
                Else
                    ' Adjust Certificate Numbering
                    CertNum = toval(CertificateNo)
                    If CertNum > 0 Then
                        CertNum = GetCertificateNo(CNO, CertNum)
                        If CertNum = 0 Then
                            StrMsg = "Can't Get Certificate No !" & StrMsg
                            GoTo errmsg
                        End If
                        ' Certificate Number
                        CertificateNo = Format(CertNum, "000000")
                    End If
                End If
            End If
        Else
            rs = db.OpenQueryDef("QRArrHeader", adOpenKeyset, ANO)
            If tostr(rs.fields("Status")) = "A" Then
                If Not UnReleaseAccRegAmount(ANO, True) Then GoTo errmsg
            End If

            If Not db.Execute("Delete from " & tPrefix & "APayor Where ANO=" & ANO) Then GoTo errmsg
            If Not db.Execute("Delete from " & tPrefix & "AccCla Where ANO=" & ANO) Then GoTo errmsg
            If Not db.Execute("Delete from " & tPrefix & "AccCon Where ANO=" & ANO) Then GoTo errmsg
            If Not db.Execute("Delete from " & tPrefix & "AccEx Where ANO=" & ANO) Then GoTo errmsg
            If Not db.Execute("Delete from " & tPrefix & "RCover Where ANO=" & ANO) Then GoTo errmsg
            If Not db.Execute("Delete from " & tPrefix & "ICover Where ANO=" & ANO) Then GoTo errmsg
            If Not db.Execute("Delete from " & tPrefix & "AccDed Where ANO=" & ANO) Then GoTo errmsg
            If Not db.Execute("Delete from " & tPrefix & "AccFD Where ANO=" & ANO) Then GoTo errmsg
            If Not db.Execute("Delete from " & tPrefix & "RArrDet Where ANO=" & ANO) Then GoTo errmsg
            If Not db.Execute("Delete from " & tPrefix & "FPart Where ANO=" & ANO) Then GoTo errmsg
            If Not db.Execute("Delete from " & tPrefix & "RArrHeader Where ANO=" & ANO) Then GoTo errmsg
            If Not db.Execute("Delete from " & tPrefix & "AccSearch Where ANO=" & ANO) Then GoTo errmsg

            rsd.Requery()
            rsd.Edit()
        End If

        BankersClause = tostr(rsd.fields("BankersClause"))
        NewBankersClause = tostr(rsTr.fields("BankersClause"))

        ' Use This Statement Instead Of Backup_Record Speed Up Copy Process (But Source and Destination Must Be The Same Structure)
        If ANO = -1 Then
            If Not rsd.PutRecord(rsAcc.GetRecord()) Then GoTo errmsg
            rsd.fields("CertificateNo") = CertificateNo
        End If
        If Branch <> "" Then
            rsd.fields("Branch") = Branch
        End If
        If CT <> "" Then
            rsd.fields("CT") = CT
        End If
        rsd.fields("SDate") = SDate
        rsd.fields("EDate") = EDate
        rsd.fields("PDate") = PDate
        rsd.fields("PPDate") = EDate
        rsd.fields("ADate") = Today.Date

        rsd.fields("AID") = ID
        rsd.fields("AName") = AName
        rsd.fields("PolicyNo") = PolicyNo
        rsd.fields("BankersClause") = NewBankersClause
        rsd.fields("BID") = toval(rsTr.fields("BID"))
        rsd.fields("RefNo") = tostr(rsTr.fields("ContractNo"))
        rsd.fields("RefDate") = todate(rsTr.fields("ContractDate"))
        rsd.fields("Location") = tostr(rsTr.fields("Location"))
        rsd.fields("ASource") = tostr(rsTr.fields("ASource"))
        rsd.fields("BatchNo") = tostr(rsTr.fields("BatchNo"))
        rsd.fields("AType") = AType    ' New Policy
        rsd.fields("ESeqNo") = ESeqNo
        rsd.fields("EESeqNo") = EESeqNo
        rsd.fields("EEndorseF") = EEndorseF
        rsd.fields("AStatus") = "W"  ' Waiting
        rsd.fields("PolicyDate") = SDate

        If tostr(rsTr.fields("NCDate")) <> "" And DateDiff(DateInterval.Day, SDate, todate(rsTr.fields("NCDate"))) >= 0 Then
            rsd.fields("NCDate") = todate(rsTr.fields("NCDate"))
        Else
            rsd.fields("NCDate") = SDate
        End If
        rsd.fields("pANO") = PANO    ' Previous ANO
        rsd.fields("PStatus") = "I"
        rsd.fields("LANO") = LANO ' Master Link ANO
        rsd.fields("RegDate") = Today.Date
        rsd.fields("RenewableF") = toval(rsAcc.fields("RenewableF"))
        rsd.fields("Renewal") = 0
        rsd.fields("UserID") = db_user
        rsd.fields("CDate") = Today.Date
        rsd.fields("CTime") = Time()
        rsd.fields("LUserID") = db_user
        rsd.fields("LDate") = Today.Date
        rsd.fields("LTime") = Time()
        rsd.fields("Discount") = Discount
        If ANO = -1 Then
            If tPrefix <> "" Then
                ANO = db.GetIdentity("tAcceptance") + 1
            Else
                ANO = db.GetIdentity("Acceptance") + 1
            End If
            If AType = "N" Then
                rsd.fields("OANO") = ANO
            Else
                rsd.fields("OANO") = OANO
            End If
        End If
        rsd.fields("ANO") = ANO
        rsd.fields("Qty") = IIf(Qty <> 0, Qty, 1)
        rsd.fields("SchemeNo") = SchemeNO
        rsd.fields("ExclusiveF") = ExclusiveF
        rsd.fields("Reason") = ""
        rsd.fields("Remarks") = tostr(rsTr.fields("Remarks"))
        rsd.fields("Memo") = Memo
        rsd.fields("Comment") = ""
        rsd.fields("BSyncF") = False
        rsd.fields("CPCT") = 0
        rsd.fields("NoRefundF") = NoRefundF
        rsd.fields("WordingID") = ""
        rsd.fields("BackDatedF") = 0
        rsd.fields("RequestF") = False
        rsd.fields("RequestMessage") = ""
        rsd.fields("RequestName") = ""
        rsd.fields("CUserID") = ""
        rsd.fields("CLoseDate") = ""
        rsd.fields("CloseTime") = ""
        rsd.fields("AUserID") = ""
        rsd.fields("AUSerDate") = ""
        rsd.fields("AUserTime") = ""
        rsd.fields("NoRiskAccumulationF") = NoRiskAccumulationF
        rsd.fields("AnnualTreatyF") = AnnualTreatyF
        If WordingID <> "" Then
            rsd.fields("PWordingID") = WordingID
        End If

        ' Update Object Information
        rs = db.OpenRemoteSet("Select * from " & tPrefix & "AINFO Where ANO=" & ANO)
        If rs.Eof Then
            rs.AddNew()
        Else
            rs.Edit()
        End If
        ' Construct Search Criteria
        FLDID = ""
        VALUEID = ""
        VALUEDESC = ""
        Description = ""
        rs.fields("ANO") = ANO
        For i = 1 To 15
            If toval(rsTOC.fields("FLDCRITERIA" & i)) Then
                If tostr(rsTr.fields("VALUEID" & i)) = "" Then
                    Description = Description & "/"
                Else
                    Description = Description & tostr(rsTr.fields("VALUEID" & i)) & "/"
                End If
            End If
            If tostr(rsTr.fields("FLDID" & i)) <> "" Then
                rs.fields("FLDID" & i) = tostr(rsTr.fields("FLDID" & i))
                rs.fields("VALUEID" & i) = tostr(rsTr.fields("VALUEID" & i))
                rs.fields("VALUEDESC" & i) = tostr(rsTr.fields("VALUEDESC" & i))
                If AccRegisterFlag(IAccReg, i) Then
                    If FLDID = "" Then
                        FLDID = tostr(rsTr.fields("FLDID" & i))
                    Else
                        FLDID = FLDID + "|" + tostr(rsTr.fields("FLDID" & i))
                    End If

                    If toval(rsTOC.fields("FLDTAB" & i)) Then
                        If VALUEID = "" Then
                            VALUEID = tostr(rsTr.fields("VALUEID" & i))
                        Else
                            VALUEID = VALUEID + "|" + tostr(rsTr.fields("VALUEID" & i))
                        End If
                    Else
                        If VALUEID = "" Then
                            VALUEID = tostr(rsTr.fields("VALUEDESC" & i))
                        Else
                            VALUEID = VALUEID + "|" + tostr(rsTr.fields("VALUEDESC" & i))
                        End If
                    End If

                    If VALUEDESC = "" Then
                        VALUEDESC = tostr(rsTr.fields("valuedesc" & i))
                    Else
                        VALUEDESC = VALUEDESC + "|" + tostr(rsTr.fields("valuedesc" & i))
                    End If
                End If

            Else
                rs.fields("FLDID" & i) = ""
                rs.fields("VALUEID" & i) = ""
                rs.fields("VALUEDESC" & i) = ""
            End If
        Next i

        ' Update Acceptance Data
        rsd.fields("REGID") = REGID
        rsd.fields("FLDID") = FLDID
        rsd.fields("VALUEID") = VALUEID
        rsd.fields("VALUEDESC") = VALUEDESC
        If Not rsd.Update Then
            StrMsg = "Policy Data : " & rsd.ErrDesc
            GoTo errmsg
        End If

        ' Update Object Information
        If Not rs.Update Then
            StrMsg = "Object Information : " & rs.ErrDesc
            GoTo errmsg
        End If

        ' Update Search Field
        For i = 1 To 15
            If tostr(rs.fields("FLDID" & i)) <> "" Then
                If tostr(rs.fields("ValueID" & i)) <> "" AndAlso rsTOC.fields("FLDSEARCH" & i) Then
                    If Not Set_AccSearch(ANO, rs.fields("FLDID" & i), rs.fields("ValueID" & i)) Then GoTo ErrMsg
                End If
            Else
                Exit For
            End If
        Next

        ' Extended Object Information
        rsTOC = db.OpenQueryDef("QTOC_EXT_GENHTAB", adOpenForwardonly, TOC)
        If Not rsTOC.Eof Then
            rs = db.OpenRemoteSet("Select * from " & tPrefix & "AINFO_EXT Where ANO=" & ANO)
            If rs.Eof Then
                rs.AddNew()
            Else
                rs.Edit()
            End If
            rs.fields("ANO") = ANO
            For i = 16 To 30
                If tostr(rsTr.fields("FLDID" & i)) <> "" Then
                    rs.fields("FLDID" & i) = tostr(rsTr.fields("FLDID" & i))
                    rs.fields("VALUEID" & i) = tostr(rsTr.fields("VALUEID" & i))
                    rs.fields("VALUEDESC" & i) = tostr(rsTr.fields("VALUEDESC" & i))
                Else
                    rs.fields("FLDID" & i) = ""
                    rs.fields("VALUEID" & i) = ""
                    rs.fields("VALUEDESC" & i) = ""
                End If
            Next i
            ' Update Extended Object Information
            If Not rs.Update Then
                StrMsg = "Extended Object Information : " & rs.ErrDesc
                GoTo errmsg
            End If
        End If

        If Voyage Then
            Dim AValueID As Object
            Dim AValueDesc As Object
            AValueID = Convert_FLDID_Into_Array(VALUEID)
            AValueDesc = Convert_FLDID_Into_Array(VALUEDESC)

            For i = 0 To UBound(AValueID)
                If AValueID(i) <> AValueDesc(i) Then
                    Vessel = AValueDesc(i)
                    Exit For
                End If
            Next
            VoyageFrom = rsTr.fields("VOYAGEFROM")
            VoyageTo = rsTr.fields("VOYAGETO")
            If Vessel = "" Then Vessel = "-"
            If VoyageFrom = "" Then VoyageFrom = "-"
            If VoyageTo = "" Then VoyageTo = "-"
        End If

        ' Update Correspondence Address
        If ApplyMasterCAF Then
            ' Get Correspondence Address from Master Policies
            If Not CopyAccDetail("AccCA", LANO, ANO, tPrefix) Then
                StrMsg = "AccCA - Failed to Copy !"
                GoTo errmsg
            End If
        ElseIf Address <> "" Then
            rs = db.OpenRemoteSet("Select * from " & tPrefix & "AccCA Where 1<>1")
            rs.AddNew()
            rs.fields("ANO") = ANO
            rs.fields("Attention") = Trim(tostr(AName, 255))
            rs.fields("Address") = Trim(tostr(Address, 255))
            rs.fields("Phone_1") = Phone_1
            rs.fields("Email") = Email
            If Not rs.Update Then
                StrMsg = "Correspondence Address : " & rs.ErrDesc
                GoTo errmsg
            End If
        End If

        ' Get Clauses from Master Policies
        If Not CopyAccDetail("AccCla", LANO, ANO, tPrefix) Then
            StrMsg = "AccCla - Failed to Copy !"
            GoTo errmsg
        End If

        If Not CopyAccDetail("AccCon", LANO, ANO, tPrefix) Then
            StrMsg = "AccCon- Failed to Copy !"
            GoTo errmsg
        End If

        If Not CopyAccDetail("AccEx", LANO, ANO, tPrefix) Then
            StrMsg = "AccEx- Failed to Copy !"
            GoTo errmsg
        End If

        If Not db.Execute("Update AccCla Set Description=OrgDescription, Description_1=OrgDescription_1 from " & tPrefix & "AccCla AccCla Where AccCla.ANO=" & ANO & " and cast(OrgDescription as varchar(10))<>''") Then GoTo errmsg

        Dim INO As Long
        Dim TOI As String
        Dim SI_OC As Double
        Dim SI As Double
        Dim rsTOI As RemoteSet
        ' Get Scheme Interest
        rs = db.OpenQueryDef("QScheme_Verify_4", adOpenForwardonly, SchemeNO, Description)
        If rs.Eof Then
            StrMsg = "No Scheme Interest For " & Description
            GoTo errmsg
        End If
        Do While Not rs.Eof
            SI_OC = toval(rs.fields("SI"))
            SI = SI_OC * RateCCY
            rsd = db.OpenRemoteSet("Select * from " & tPrefix & "ICover Where 1<>1")
            rsd.AddNew()
            rsd.fields("ANO") = ANO
            TOI = tostr(rs.fields("TOI"))
            rsd.fields("TOI") = TOI
            rsd.fields("Remark") = tostr(rs.fields("Description"))
            rsd.fields("Adjustable") = toval(rs.fields("Adjustable"))
            rsd.fields("Category") = tostr(rs.fields("Category"))

            rsd.fields("Currency") = CCY
            rsd.fields("Amount") = IIf(Amount <> 0, Amount, SI)
            rsd.fields("Amount_AOE") = IIf(Amount <> 0, Amount, SI)
            rsd.fields("SI") = IIf(TSI <> 0, TSI, SI)

            rsd.fields("Currency_OC") = CCYFrom
            rsd.fields("Rate_OC") = RateCCY
            rsd.fields("Amount_OC") = IIf(Amount_OC <> 0, Amount_OC, SI_OC)
            rsd.fields("Amount_AOE_OC") = IIf(Amount_OC <> 0, Amount_OC, SI_OC)
            rsd.fields("SI_OC") = IIf(TSI_OC <> 0, TSI_OC, SI_OC)

            rsd.fields("Total") = Total_OC
            If tPrefix <> "" Then
                INO = db.GetIdentity("tICover") + 1
            Else
                INO = db.GetIdentity("ICover") + 1
            End If
            rsd.fields("INO") = INO
            If Not rsd.Update Then
                StrMsg = "Interest Cover : " & rsd.ErrDesc
                GoTo errmsg
            End If

            rsTOI = db.OpenQueryDef("QTOI", adOpenForwardonly, TOI)
            rss = db.OpenRemoteSet("Select * from " & tPrefix & "AINFO Where ANO=" & ANO)
            rsd = db.OpenRemoteSet("Select * from " & tPrefix & "IInfo Where 1<>1")
            rsd.AddNew()
            rsd.fields("INO") = INO
            For i = 1 To 15
                rsd.fields("FLDID" & i) = ""
                rsd.fields("VALUEID" & i) = ""
                rsd.fields("VALUEDESC" & i) = ""
                FLDID = rsTOI.fields("FLDID" & i)
                If FLDID <> "" Then
                    rsd.fields("FLDID" & i) = FLDID
                    For j = 1 To 15
                        If FLDID = rss.fields("FLDID" & j) Then
                            rsd.fields("VALUEID" & i) = rss.fields("VALUEID" & j)
                            rsd.fields("VALUEDESC" & i) = rss.fields("VALUEDESC" & j)
                        End If
                    Next j
                End If
            Next i

            If Not rsd.Update Then
                StrMsg = "Interest Info : " & rsd.ErrDesc
                GoTo errmsg
            End If

            If Not Copy_Master_ICoverNOC(LANO, ANO, INO, TOI, tPrefix) Then GoTo errmsg
            rs.MoveNext()
        Loop

        ' Get Scheme Coverage #1
        Dim LMonth As Double
        Dim UMonth As Double
        Dim NOfYears As Double
        Dim NOfMonths As Double
        Dim Code As String
        Dim GrossUpF As Boolean
        Dim GrossUpRate As Double
        Dim RateLoadingF As Boolean
        Dim Loading As Double
        Dim PMonth As Integer

        LMonth = 1
        Coverage = tostr(rsTr.fields("Coverage_1"))
        NOfYears = toval(rsTr.fields("NOfYears_1"))
        PMonth = toval(rsTr.fields("PMonth"))    ' Lapse Policy Month
        lSDate = SDate
        rsSC = db.OpenQueryDef("QScheme_Verify_2", adOpenForwardonly, Coverage, SchemeNO, Description)
        If rsSC.Eof Then
            StrMsg = "No Scheme Coverage for " & Coverage & " - " & Description
            GoTo errmsg
        End If
        Do While Not rsSC.Eof
            If NOfYears <> 0 Then
                NOfMonths = toval(NOfYears * 12, 0)
            Else
                NOfMonths = 1
            End If

            If sPeriod <> 1 Then        ' Not in Days
                UMonth = LMonth + NOfMonths - 1
            Else
                UMonth = DateDiff(DateInterval.Day, SDate, EDate)
            End If

            Code = tostr(rsSC.fields("Code"))
            'If Not Check_RateCon(ANO, Code) Then
            '    StrMsg = "Rate Condition (" & Code & ") : Not Allowable for Object Coverage !" & vbCrLf
            '    GoTo errmsg
            'End If
            RateLoadingF = toval(rsSC.fields("RateLoadingF"))
            If RateLoadingF Then
                If tPrefix <> "" Then
                    Loading = Get_RateLoading_Temp(ANO, Code, SDate)
                Else
                    Loading = Get_RateLoading(ANO, Code, SDate)
                End If
            Else
                Loading = 1
            End If
            GrossUpF = toval(rsSC.fields("GrossUpF"))
            If GrossUpF Then
                GrossUpRate = Get_Premium_GrossUpRate(LANO, Code, 0)
            End If
            ' Get Scheme Indemnity
            If UMonth - LMonth + 1 < 12 And PCalc = "S" Then
                rss = db.OpenQueryDef("QScheme_Verify_3", adOpenForwardonly, Coverage, Code, (LMonth + PMonth) - (LMonth + PMonth) + 1, (UMonth + PMonth) - (LMonth + PMonth) + 1, SchemeNO, Description, TSI)
            Else
                rss = db.OpenQueryDef("QScheme_Verify_3", adOpenForwardonly, Coverage, Code, (LMonth + PMonth), (UMonth + PMonth), SchemeNO, Description, TSI)
            End If
            If rss.Eof Then
                StrMsg = "No Scheme Indemnity for " & Coverage & " " & Code & " (" & LMonth & "-" & UMonth & ") - " & Description
                GoTo errmsg
            End If

            rsd = db.OpenRemoteSet("Select * from #RCover Where 1<>1")
            Do While Not rss.Eof
                If toval(rss.fields("HoldF")) Then
                    HoldF = True
                    If HoldF Then
                        If HoldMessage <> "" Then HoldMessage = HoldMessage & vbCrLf
                        HoldMessage = HoldMessage & "Scheme Verify Coverage : " & Coverage & "'"
                    End If
                End If

                If sPeriod <> 1 Then        ' Not in Days
                    pSDate = DateAdd(DateInterval.Month, rss.fields("Lower") - PMonth - 1, SDate)
                Else
                    pSDate = DateAdd(DateInterval.Day, rss.fields("Lower") - PMonth - 1, SDate)
                End If
                RateLoadingF = toval(rss.fields("RateLoadingF"))
                If RateLoadingF Then
                    Dim HMsg As String = ""
                    If tPrefix <> "" Then
                        Loading = Get_RateLoading_Temp(ANO, Code, pSDate, , HoldF, HMsg)
                    Else
                        Loading = Get_RateLoading(ANO, Code, pSDate, , HoldF, HMsg)
                    End If
                    If HoldF Then
                        If HoldMessage <> "" Then HoldMessage = HoldMessage & vbCrLf
                        HoldMessage = HoldMessage & HMsg
                    End If
                End If

                If SplitRiskF Then
                    rsd.AddNew()
                Else
                    If tostr(rsd.fields("Code")) = Code And toval(rsd.fields("PCTLoss")) = toval(rss.fields("PCTLoss")) And toval(rsd.fields("PADDITION")) = toval(rss.fields("PADDITION")) And toval(rsd.fields("Discount")) = toval(rss.fields("Discount")) And toval(rsd.fields("Loading")) = Loading Then
                        rsd.Edit()
                    Else
                        rsd.AddNew()
                    End If
                End If

                If rsd.editmode = AdEditAdd Then
                    rsd.fields("ANO") = ANO
                    rsd.fields("Code") = Code
                    rsd.fields("Unit") = tostr(rsSC.fields("Unit"))
                    rsd.fields("Category") = tostr(rsSC.fields("Category"))
                    rsd.fields("Portion") = toval(rsSC.fields("Portion"))
                    rsd.fields("Remark") = tostr(rsSC.fields("Description"))
                    rsd.fields("PRATEPCT") = toval(rsSC.fields("PRATEPCT"))
                    rsd.fields("PCTLoss") = toval(rss.fields("PCTLOSS"))
                    rsd.fields("PADDITION") = toval(rss.fields("PADDITION"))
                    rsd.fields("Discount") = toval(rss.fields("Discount"))
                    rsd.fields("Loading") = Loading
                    rsd.fields("SDate") = pSDate
                    rsd.fields("NCDate") = pSDate
                    rsd.fields("NoRefundF") = toval(rss.fields("NoRefundF"))
                    rsd.fields("InclAddInterestF") = toval(rsSC.fields("InclAddInterestF"))
                End If

                If sPeriod <> 1 Then    ' Not in Days
                    If (UMonth + PMonth) <= rss.fields("Upper") And Not RoundUpDF Then
                        If Day(SDate) <> Day(EDate) Then
                            pEDate = EDate
                            If DateDiff(DateInterval.Month, pEDate, DateAdd(DateInterval.Month, toval((UMonth / 12) * 12, 0), SDate)) < 0 Then
                                pEDate = DateAdd(DateInterval.Month, toval((UMonth / 12) * 12, 0), SDate)
                            End If
                        Else
                            pEDate = DateAdd(DateInterval.Month, toval((UMonth / 12) * 12, 0), SDate)
                        End If
                    Else
                        pEDate = DateAdd(DateInterval.Month, rss.fields("Upper") - PMonth, SDate)
                    End If
                Else
                    If (UMonth + PMonth) <= rss.fields("Upper") Then
                        pEDate = EDate
                    Else
                        pEDate = DateAdd(DateInterval.Day, rss.fields("Upper") - PMonth, SDate)
                    End If
                End If
                If DateDiff(DateInterval.Day, pEDate, EDate) < 0 Then
                    pEDate = EDate
                End If

                rsd.fields("EDate") = pEDate
                lEDate = pEDate

                ' Annualized Rate
                If toval(rss.fields("RateLower")) <> 0 Or toval(rss.fields("Rate")) <> 0 Or toval(rsTr.fields(rss.fields("Rate_Source"))) <> 0 Then
                    If sPeriod <> 1 Then   ' Not in Days
                        If toval(rsTr.fields(rss.fields("Rate_Source"))) <> 0 Then
                            Rate = toval(rsTr.fields(rss.fields("Rate_Source")))
                            RateMax = Rate
                        ElseIf toval(rss.fields("RateLower")) <> 0 And toval(rss.fields("Rate")) <> 0 Then
                            If toval(rsTr.fields("Rate")) = 0 Then  ' Not Floating Rate
                                Rate = (toval(rss.fields("RateLower")) * (toval(rss.fields("Upper")) - (UMonth + PMonth)) + toval(rss.fields("Rate")) * (12 - (toval(rss.fields("Upper")) - (UMonth + PMonth)))) / 12
                                RateMax = Rate
                            Else
                                ' Average Rate
                                Rate = toval(rss.fields("RateLower"))
                                RateMax = toval(rss.fields("Rate"))
                            End If
                        ElseIf toval(rss.fields("RateLower")) <> 0 Then
                            Rate = toval(rss.fields("RateLower"))
                            RateMax = Rate
                        Else
                            Rate = toval(rss.fields("Rate"))
                            RateMax = Rate
                        End If
                        Rate = 12 / (rss.fields("Upper") - rss.fields("Lower") + 1) * Rate
                        RateMax = 12 / (rss.fields("Upper") - rss.fields("Lower") + 1) * RateMax
                    Else    ' in Days
                        If PCalc = "N" Then
                            Rate = rss.fields("Rate")
                            RateMax = Rate
                        Else
                            If Prorata = 0 Then
                                Rate = DateDiff(DateInterval.Day, pSDate, DateAdd(DateInterval.Month, 12, pSDate)) / (rss.fields("Upper") - rss.fields("Lower") + 1) * rss.fields("Rate")
                                RateMax = Rate
                            Else
                                Rate = Prorata / (rss.fields("Upper") - rss.fields("Lower") + 1) * rss.fields("Rate")
                                RateMax = Rate
                            End If
                        End If
                    End If
                Else
                    Rate = toval(rsSC.fields("Rate")) / (1 + IRate / 100) ^ (DateDiff(DateInterval.Month, SDate, pSDate) \ 12)
                    RateMax = Rate
                End If
                If GrossUpF Then
                    Rate = Rate * GrossUpRate
                    RateMax = RateMax * GrossUpRate
                End If

                If PCalc = "N" Then ' No Prorate
                    Rate = toval(rsd.fields("Rate")) + Rate
                    RateMax = toval(rsd.fields("RateMax")) + RateMax
                Else
                    If UMonth - LMonth + 1 < 12 And PCalc = "S" Then
                        Rate = toval(rsd.fields("Rate")) + Short_Period_Calc(TOC, pSDate, pEDate, pEDate) / 100 * Rate
                        RateMax = toval(rsd.fields("RateMax")) + Short_Period_Calc(TOC, pSDate, pEDate, pEDate) / 100 * RateMax
                    Else
                        If (UMonth + PMonth) <= rss.fields("Upper") Then
                            If RoundUpF Then
                                If sPeriod = 0 Then
                                    Rate = toval(rsd.fields("Rate")) + (rss.fields("Upper") - rss.fields("Lower") + 1) / 12 * Rate
                                    RateMax = toval(rsd.fields("Ratemax")) + (rss.fields("Upper") - rss.fields("Lower") + 1) / 12 * RateMax
                                Else
                                    If Prorata = 0 Then
                                        Rate = toval(rsd.fields("Rate")) + (rss.fields("Upper") - rss.fields("Lower") + 1) / DateDiff(DateInterval.Day, pSDate, DateAdd(DateInterval.Month, 12, pSDate)) * Rate
                                        RateMax = toval(rsd.fields("RateMax")) + (rss.fields("Upper") - rss.fields("Lower") + 1) / DateDiff(DateInterval.Day, pSDate, DateAdd(DateInterval.Month, 12, pSDate)) * RateMax
                                    Else
                                        Rate = toval(rsd.fields("Rate")) + (rss.fields("Upper") - rss.fields("Lower") + 1) / Prorata * Rate
                                        RateMax = toval(rsd.fields("RateMax")) + (rss.fields("Upper") - rss.fields("Lower") + 1) / Prorata * RateMax
                                    End If
                                End If
                            Else
                                If DailyBasisF Or sPeriod = 1 Then  ' Daily Basis or Daily Scheme Period
                                    If ((SplitRiskF And Day(pSDate) = Day(pEDate)) Or (Not SplitRiskF And Day(pSDate) = Day(EDate))) And sPeriod = 0 And PPeriod <> 1 Then
                                        Rate = toval(rsd.fields("Rate")) + DateDiff(DateInterval.Month, pSDate, pEDate) / 12 * Rate
                                        RateMax = toval(rsd.fields("RateMax")) + DateDiff(DateInterval.Month, pSDate, pEDate) / 12 * RateMax
                                    ElseIf GracePeriod <> 0 Then    ' Any Grace Period in Days (Only for Coverage 1)
                                        Dim tEDate As Date
                                        Dim tNumMonth As Integer
                                        tNumMonth = DateDiff(DateInterval.Month, pSDate, pEDate)
                                        tEDate = DateAdd(DateInterval.Month, tNumMonth, pSDate)
                                        If DateDiff(DateInterval.Day, pEDate, tEDate) > 0 Then
                                            tNumMonth = tNumMonth - 1
                                            tEDate = DateAdd(DateInterval.Month, tNumMonth, pSDate)
                                        End If
                                        If DateDiff(DateInterval.Day, tEDate, pEDate) > GracePeriod Then
                                            tNumMonth = tNumMonth + 1
                                        End If
                                        Rate = toval(rsd.fields("Rate")) + tNumMonth / 12 * Rate
                                        RateMax = toval(rsd.fields("RateMax")) + tNumMonth / 12 * RateMax
                                    Else
                                        If Prorata = 0 Then
                                            If Day(pSDate) = Day(pEDate) And DateDiff(DateInterval.Month, pSDate, pEDate) = pTerm Then
                                                Rate = toval(rsd.fields("Rate")) + Rate
                                                RateMax = toval(rsd.fields("RateMax")) + RateMax
                                            Else
                                                Rate = toval(rsd.fields("Rate")) + Premium_Calc_Prorata(pSDate, pEDate, DaysProrata, pTerm, PPeriod, "") * Rate
                                                RateMax = toval(rsd.fields("RateMax")) + Premium_Calc_Prorata(pSDate, pEDate, DaysProrata, pTerm, PPeriod, "") * RateMax
                                            End If
                                        Else
                                            Rate = toval(rsd.fields("Rate")) + DateDiff(DateInterval.Day, pSDate, pEDate) / Prorata * Rate
                                            RateMax = toval(rsd.fields("RateMax")) + DateDiff(DateInterval.Day, pSDate, pEDate) / Prorata * RateMax
                                        End If
                                    End If
                                Else
                                    Rate = toval(rsd.fields("Rate")) + (toval(((UMonth + PMonth) / 12) * 12, 0) - rss.fields("Lower") + 1) / 12 * Rate
                                    RateMax = toval(rsd.fields("RateMax")) + (toval(((UMonth + PMonth) / 12) * 12, 0) - rss.fields("Lower") + 1) / 12 * RateMax
                                End If
                            End If
                        Else
                            If RoundUpF Then
                                If sPeriod = 0 Then
                                    Rate = toval(rsd.fields("Rate")) + (rss.fields("Upper") - rss.fields("Lower") + 1) / 12 * Rate
                                    RateMax = toval(rsd.fields("RateMax")) + (rss.fields("Upper") - rss.fields("Lower") + 1) / 12 * RateMax
                                Else
                                    If Prorata = 0 Then
                                        Rate = toval(rsd.fields("Rate")) + (rss.fields("Upper") - rss.fields("Lower") + 1) / DateDiff(DateInterval.Day, pSDate, DateAdd(DateInterval.Month, 12, pSDate)) * Rate
                                        RateMax = toval(rsd.fields("RateMax")) + (rss.fields("Upper") - rss.fields("Lower") + 1) / DateDiff(DateInterval.Day, pSDate, DateAdd(DateInterval.Month, 12, pSDate)) * RateMax
                                    Else
                                        Rate = toval(rsd.fields("Rate")) + (rss.fields("Upper") - rss.fields("Lower") + 1) / Prorata * Rate
                                        RateMax = toval(rsd.fields("RateMax")) + (rss.fields("Upper") - rss.fields("Lower") + 1) / Prorata * RateMax
                                    End If
                                End If
                            Else
                                If DailyBasisF Or sPeriod = 1 Then  ' Daily Basis or Daily Scheme Period
                                    If ((SplitRiskF And Day(pSDate) = Day(pEDate)) Or (Not SplitRiskF And Day(pSDate) = Day(EDate))) And sPeriod = 0 And PPeriod <> 1 Then
                                        Rate = toval(rsd.fields("Rate")) + DateDiff(DateInterval.Month, pSDate, pEDate) / 12 * Rate
                                        RateMax = toval(rsd.fields("Ratemax")) + DateDiff(DateInterval.Month, pSDate, pEDate) / 12 * RateMax
                                    ElseIf GracePeriod <> 0 Then    ' Any Grace Period in Days (Only for Coverage 1)
                                        Dim tEDate As Date
                                        Dim tNumMonth As Integer
                                        tNumMonth = DateDiff(DateInterval.Month, pSDate, pEDate)
                                        tEDate = DateAdd(DateInterval.Month, tNumMonth, pSDate)
                                        If DateDiff(DateInterval.Day, pEDate, tEDate) > 0 Then
                                            tNumMonth = tNumMonth - 1
                                            tEDate = DateAdd(DateInterval.Month, tNumMonth, pSDate)
                                        End If
                                        If DateDiff(DateInterval.Day, tEDate, pEDate) > GracePeriod Then
                                            tNumMonth = tNumMonth + 1
                                        End If
                                        Rate = toval(rsd.fields("Rate")) + tNumMonth / 12 * Rate
                                        RateMax = toval(rsd.fields("RateMax")) + tNumMonth / 12 * RateMax
                                    Else
                                        If Prorata = 0 Then
                                            If Day(pSDate) = Day(pEDate) And DateDiff(DateInterval.Month, pSDate, pEDate) = pTerm Then
                                                Rate = toval(rsd.fields("Rate")) + Rate
                                                RateMax = toval(rsd.fields("RateMax")) + RateMax
                                            Else
                                                Rate = toval(rsd.fields("Rate")) + Premium_Calc_Prorata(pSDate, pEDate, DaysProrata, pTerm, PPeriod, "") * Rate
                                                RateMax = toval(rsd.fields("RateMax")) + Premium_Calc_Prorata(pSDate, pEDate, DaysProrata, pTerm, PPeriod, "") * RateMax
                                            End If
                                        Else
                                            Rate = toval(rsd.fields("Rate")) + DateDiff(DateInterval.Day, pSDate, pEDate) / Prorata * Rate
                                            RateMax = toval(rsd.fields("RateMax")) + DateDiff(DateInterval.Day, pSDate, pEDate) / Prorata * RateMax
                                        End If
                                    End If
                                Else
                                    Rate = toval(rsd.fields("Rate")) + (rss.fields("Upper") - rss.fields("Lower") + 1) / 12 * Rate
                                    RateMax = toval(rsd.fields("RateMax")) + (rss.fields("Upper") - rss.fields("Lower") + 1) / 12 * RateMax
                                End If
                            End If
                        End If
