        If Not (rsTr.fields("Status") = "O") Then
            StrMsg = "Please Check Scheme Transaction Status !"
            GoTo errmsg
        End If
        PolicyNo = tostr(rsTr.fields("PolicyNo"))
        ' Get Certificate Number
