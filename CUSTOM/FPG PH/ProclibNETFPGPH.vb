    Private Function ReOpen_Claim(ByVal CNO As Long) As Boolean
        Dim rs As RemoteSet
        Dim ClaimType As String
        Dim PCNO As Long
        Dim ANO As Long
        Dim CStatus As String
        Dim ClaimNo As String

        rs = db.OpenRemoteSet("Select CType, pCNO, ANO, CStatus, ClaimNo from Claim Where CNO=" & CNO)
        ClaimType = rs.fields("CType")
        PCNO = rs.fields("PCNO")
        ANO = rs.fields("ANO")
        CStatus = rs.fields("CStatus")
        ClaimNo = rs.fields("ClaimNo")
        rs.CloseRemoteSet()

        If CStatus = "T" Then
            If Not db.Execute("Delete from ClaAss Where CNO=" & CNO) Then GoTo errmsg
        Else
            If Not Undo_Claim_To_Adm(CNO) Then GoTo errmsg
        End If
        'If ClaimType = "E" Or ClaimType = "C" Then
        '    If CStatus = "A" Then
        '        If Not db.Execute("Update Claim set SettledF=PSettledF, CStatus='A' where CStatus='C' and CNO=" & PCNO) Then GoTo errmsg
        '        If db.RecordsAffected = 0 Then GoTo errmsg
        '    End If
        'End If

        ' Update Current Claim  Status
        If CStatus = "T" Then
            If Not db.Execute("Update Claim set ADate=Null, CStatus= 'P', SettledF=PSettledF, CSDate=RegDate, AUserDate=Null, AUserTime='', AUserID='', RUserDate=Null, RUserTime='', RUserID='' where CStatus in ('A','T') and CNO=" & CNO) Then GoTo errmsg
        Else
            ' Reset Flag Backdated
            If Not db.Execute("Update Claim set ADate=Null, CStatus= 'P', SettledF=PSettledF, BackDatedF=0, CSDate=RegDate, AUserDate=Null, AUserTime='', AUserID='', RUserDate=Null, RUserTime='', RUserID='' where CStatus in ('A','T') and CNO=" & CNO) Then GoTo errmsg
        End If
        If db.RecordsAffected = 0 Then GoTo errmsg

        ' Update Services
        If Not db.Execute("Update Service Set SStatus='P' Where SType='Claim' and SStatus='A' and CNO=" & CNO) Then GoTo errmsg

        'Create Log Object
        If Not Save_Log_Object("Claim", "CNO", CNO, "ClaimNo", ClaimNo, "", "", "", "", "", "", "", "ReOpen") Then GoTo errmsg

        ReOpen_Claim = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        ReOpen_Claim = False
    End Function

    Private Function Undo_Claim_To_Adm(ByVal CNO As Long, Optional ByVal UpdateOnlyFlag As Boolean = False) As Boolean
        Dim rs As RemoteSet
        Dim rsAdm As RemoteSet
        Dim AdmNo As Long
        Dim PID As String
        Dim pCCY As String
        Dim pDate As Date
        Dim pType As String
        Dim RValue As Double

        rs = db.OpenRemoteSet("Select TOC.RValue from Claim , TOC Where TOC.TOC=Claim.TOC and Claim.CNO=" & CNO)
        RValue = toval(rs.fields("RValue"))

        rs = db.OpenQueryDef("QUndo_Claim_To_Adm", adOpenKeyset, CNO)
        Do While Not rs.Eof
            AdmNo = rs.fields("AdmNo")
            If Not db.GetLockedObject("ADMLINK_" & AdmNo) Then GoTo errmsg
            rsAdm = db.OpenRemoteSet("Select * from AdmLink Where AdmNo=" & AdmNo)
            If Not rsAdm.Eof Then
                If toval(rsAdm.fields("VoucherF")) Then
                    If Cancel_Voucher(tostr(rsAdm.fields("Voucher"))) Then
                        ' Re Open 
                        rsAdm = db.OpenRemoteSet("Select * from AdmLink Where AdmNo=" & AdmNo)
                    Else
                        GoTo errmsg
                    End If
                End If

                PID = rsAdm.fields("ID")
                pCCY = rsAdm.fields("Currency")
                pDate = rsAdm.fields("Date")
                pType = rsAdm.fields("Type")

                If Not toval(rsAdm.fields("VoucherF")) Then
                    'Update Tax Table
                    If toval(rsAdm.fields("TaxTableF")) Then
                        Dim Tax As Double = toval(rsAdm.fields("Amount_14")) + toval(rsAdm.fields("Amount_18"))
                        If Not Update_Tax_Table(PID, pDate, pCCY, -rsAdm.fields("PNominal_Tax"), -Tax) Then
                            StrMsg = "Failed in Calculating Vat/Tax !"
                            GoTo errmsg
                        End If                        
                    End If

                    rsAdm.Edit()
                    rsAdm.fields("Amount_1") = toval(rsAdm.fields("Amount_1")) - toval(rs.fields("Amount_1"))
                    rsAdm.fields("Amount_6") = toval(rsAdm.fields("Amount_6")) - toval(rs.fields("Amount_6"))
                    rsAdm.fields("Amount_7") = toval(rsAdm.fields("Amount_7")) - toval(rs.fields("Amount_7"))
                    rsAdm.fields("Amount_8") = toval(rsAdm.fields("Amount_8")) - toval(rs.fields("Amount_8"))
                    rsAdm.fields("Amount_9") = toval(rsAdm.fields("Amount_9")) - toval(rs.fields("Amount_9"))
                    rsAdm.fields("Amount_10") = toval(rsAdm.fields("Amount_10")) - toval(rs.fields("Amount_10"))
                    rsAdm.fields("Amount_13") = toval(rsAdm.fields("Amount_13")) - toval(rs.fields("Amount_13"))
                    rsAdm.fields("Amount_14") = toval(rsAdm.fields("Amount_14")) - toval(rs.fields("Amount_14"))
                    rsAdm.fields("Amount_15") = toval(rsAdm.fields("Amount_15")) - toval(rs.fields("Amount_15"))
                    rsAdm.fields("Amount_16") = toval(rsAdm.fields("Amount_16")) - toval(rs.fields("Amount_16"))
                    rsAdm.fields("Amount_17") = toval(rsAdm.fields("Amount_17")) - toval(rs.fields("Amount_17"))
                    rsAdm.fields("Amount_18") = toval(rsAdm.fields("Amount_18")) - toval(rs.fields("Amount_18"))

                    Dim Amount As Double

                    rsAdm.fields("Amount_13") = RoundCCY(toval(rsAdm.fields("Amount_13")), pCCY, 1)
                    rsAdm.fields("Amount_14") = RoundCCY(toval(rsAdm.fields("Amount_14")), pCCY, 1)

                    Amount = toval(rsAdm.fields("Amount_1")) + toval(rsAdm.fields("Amount_4")) + toval(rsAdm.fields("Amount_5")) + toval(rsAdm.fields("Amount_6")) + toval(rsAdm.fields("Amount_7")) + toval(rsAdm.fields("Amount_8")) + toval(rsAdm.fields("Amount_9")) + toval(rsAdm.fields("Amount_10")) + toval(rsAdm.fields("Amount_15")) + toval(rsAdm.fields("Amount_16")) + toval(rsAdm.fields("Amount_17"))
                    rsAdm.fields("Amount_11") = 0
                    rsAdm.fields("Amount_12") = 0
                    If pType = "RP" Then    ' Premium Reinstatement
                        rsAdm.fields("Amount_11") = -(Amount - RoundCCY(Amount, pCCY, RValue))
                    Else
                        rsAdm.fields("Amount_12") = -(Amount - RoundCCY(Amount, pCCY, RValue))
                    End If
                    Amount = RoundCCY(Amount, pCCY, RValue) + toval(rsAdm.fields("Amount_13")) + toval(rsAdm.fields("Amount_14"))

                    rsAdm.fields("Amount") = Amount
                    If (RoundCCY(toval(rsAdm.fields("Amount")), pCCY, RValue) <> RoundCCY(toval(rsAdm.fields("Amount_11")) + toval(rsAdm.fields("Amount_12")) + toval(rsAdm.fields("Amount_13")) + toval(rsAdm.fields("Amount_14")) + toval(rsAdm.fields("Amount_18")), pCCY, RValue)) Or (toval(rsAdm.fields("Amount_14")) <> 0) Then
                        rsAdm.fields("WriteF") = 0
                    Else
                        rsAdm.fields("WriteF") = 1
                    End If

                    rsAdm.fields("LUserID") = db_user
                    rsAdm.fields("LDate") = Today.Date
                    rsAdm.fields("LTime") = Time()
                    If Not rsAdm.Update Then GoTo errmsg
                Else
                    StrMsg = "Voucher Already Created !"
                    GoTo errmsg
                End If
            End If

            If UpdateOnlyFlag Then
                ' Update Only
                If Not db.Execute("Update ClaAss Set AdmNo=-1, Posted=0 Where CNO=" & CNO & " and AdmNo=" & AdmNo) Then GoTo errmsg
            Else
                ' Delete ClaAss
                If Not db.Execute("Delete from ClaAss Where CNO=" & CNO & " and AdmNo=" & AdmNo) Then GoTo errmsg
            End If

            If Not db.Execute("Delete Admlink from admlink Where AdmNo=" & AdmNo & " and WriteF=1 and not exists (Select Top 1 AdmNo from ClaAss Where ClaAss.AdmNo=Admlink.AdmNo)") Then GoTo errmsg

            If Not db.ReleaseLockedObject("ADMLINK_" & AdmNo) Then GoTo errmsg
            rsAdm.CloseRemoteSet()
            rs.MoveNext()
        Loop
        rs.CloseRemoteSet()

        Undo_Claim_To_Adm = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Undo_Claim_To_Adm = False
    End Function

    Private Function ReleaseClaRegAmount(ByVal CNO As Long) As Boolean
