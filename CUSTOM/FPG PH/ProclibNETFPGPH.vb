    Private Function StrError(Optional ByVal errmsg As String = "") As String
        Dim str As String
        Dim ErrDesc As String
        ErrDesc = Err.Description
        On Error GoTo errmsg
        str = errmsg
        If str = "" Then str = ErrDesc
        If str = "" Then str = db.ErrDesc
        StrError = str
        Exit Function
errmsg:
        StrError = "Connection is Broken !"
    End Function
    Private Function CheckDigit(ByVal PolicyNo As String) As String
        Dim nTemp As Integer = 0
        Dim nRes As Integer = 0

        Dim i As Integer
        For i = 1 To 20
            nTemp = nTemp + toval(Mid(PolicyNo, i, 1)) * IIf(i Mod 2 = 0, 2, 1)
        Next

        If nTemp <= 9 Then
            nRes = nTemp
        Else
            Do While Len(Trim(Str(nTemp))) > 1
                nRes = Val(Mid(Trim(Str(nTemp)), Len(Trim(Str(nTemp))), 1))
                nTemp = Val(Mid(Trim(Str(nTemp)), 1, Len(Trim(Str(nTemp))) - 1))
                nTemp = nTemp + nRes
            Loop
            nRes = nTemp
        End If
        CheckDigit = Trim(Str(nRes))
    End Function
    Private Function Confirmed_Facultative(ByVal ANO As Long, ByVal FID As String) As Boolean
        Try

            Dim rs As RemoteSet
            Dim LANO As Long
            Dim SDate As Date
            Dim EDate As Date

            Dim FullCoverF As Boolean
            Dim Share As Double
            Dim Amount As Double
            Dim OurShare As Double
            Dim rsArr As RemoteSet
            Dim rsFac As RemoteSet
            Dim ErrMsg As String = ""

            rs = db.OpenRemoteSet("Select LANO, AStatus, SDate, EDate from Acceptance Where ANO=" & ANO)
            If rs.fields("AStatus") <> "W" Then
                ErrMsg = "Please Check Policy Data Status !"
                Throw New Exception(Errmsg)
            End If

            LANO = toval(rs.fields("LANO"))
            SDate = todate(rs.fields("SDate"))
            EDate = todate(rs.fields("EDate"))

            Dim SQL As String
            SQL = "Select FPart.ANO, FPart.FID, cast(coalesce(Max(Cast(LOB.SecuritiesF as Int)),0) as Bit) as SecuritiesF, coalesce(sum(FSecurity.Share),100) as TShare,sum(Case When coalesce(FSecurity.ANO,0)<>0 Then 1 else 0 end) as NumSecurities"
            SQL = SQL & " from FPart Left Join Profile on (Profile.ID=FPart.ID) Left Join LOB on (LOB.LOB=Profile.LOB) Left Join FSecurity on (FSecurity.ANO=FPart.ANO and FSecurity.FID=FPart.FID)"
            SQL = SQL & " Where FPart.ANO=" & ANO & " and FPart.FID='" & FID & "'"
            SQL = SQL & " Group By FPart.ANO, FPart.FID"
            rs = db.OpenRemoteSet(SQL)

            If toval(rs.fields("SecuritiesF")) AndAlso toval(rs.fields("NumSecurities")) = 0 Then
                ErrMsg = "Please Check Facultative Security !"
                Throw New Exception(ErrMsg)
            ElseIf toval(rs.fields("TShare")) <> 100 Then
                ErrMsg = "Please Check Total Security's Share (Should be 100%) !"
                Throw New Exception(ErrMsg)
            End If

            If ANO <> LANO Then
                rsArr = db.OpenQueryDef("QRArrHeader", adOpenKeyset, ANO)
                If rsArr.Eof Then
                    ErrMsg = "Please Check Risk Arrangement Data !"
                    Throw New Exception(ErrMsg)
                End If
                OurShare = toval(rsArr.fields("TAmount"))
            Else
                OurShare = 0
            End If

            rsFac = db.OpenRemoteSet("Select * From RArrDet Where ANO=" & ANO & " and FID='" & FID & "'")
            If rsFac.Eof Then
                ErrMsg = "No Facultative Data !"
                Throw New Exception(ErrMsg)
            End If
            If rsFac.fields("Status") <> "O" And rsFac.fields("AType") <> "C" Then
                ErrMsg = "Facultative Already Processed !"
                Throw New Exception(ErrMsg)
            End If
            If DateDiff(DateInterval.Day, rsFac.fields("SDate"), SDate) > 0 Or DateDiff(DateInterval.Day, rsFac.fields("EDate"), EDate) < 0 Then
                ErrMsg = "Facultative Period Must Within Insurance Period !"
                Throw New Exception(ErrMsg)
            End If

            Share = toval(rsFac.fields("Share")) - toval(rsFac.fields("JPShare"))
            FullCoverF = rsFac.fields("FullCoverF")
            If toval(rsFac.fields("Limit")) <> 0 Then
                Amount = Share * toval(rsFac.fields("Limit")) / 100
            ElseIf OurShare <> 0 Then
                Amount = Share * OurShare / 100
            Else
                Amount = toval(rsFac.fields("Amount"))
            End If
            rsFac.Edit()
            rsFac.fields("Status") = "R"
            rsFac.fields("Amount") = Amount
            rsFac.fields("AUserID") = db_user
            rsFac.fields("AUserDate") = Today.Date
            If Not rsFac.Update Then Throw New Exception(db.ErrDesc)

            Dim FShare As Double
            If toval(rsFac.fields("Limit")) <> 0 And OurShare <> 0 Then
                FShare = (toval(rsFac.fields("Limit"))) / OurShare * 100 * Share / 100
            Else
                FShare = Share
            End If

            Dim RShare As Double = 0
            rsFac = db.OpenRemoteSet("Select * from FPart Where ANO=" & ANO & " and FID='" & FID & "'")
            Do While Not rsFac.Eof
                If tostr(rsFac.fields("Code")) <> "" And tostr(rsFac.fields("Comm")) = 0 And tostr(rsFac.fields("NetRate")) = 0 Then
                    rsFac.Edit()
                    rsFac.fields("NetRate") = Get_RateCon(ANO, rsFac.fields("Code"), Amount, rsFac.fields("Unit"))
                    If rsFac.fields("Unit") = "" Then rsFac.fields("Unit") = "C"
                    If Not rsFac.Update Then Throw New Exception(db.ErrDesc)
                End If
                RShare = RShare + rsFac.fields("Share")
                rsFac.MoveNext()
            Loop

            FShare = FShare * RShare / 100

            If Not FullCoverF Then
                rsFac = db.OpenRemoteSet("Select * from FPartDet Where ANO=" & ANO & " and FID='" & FID & "'")
                Do While Not rsFac.Eof
                    If tostr(rsFac.fields("Code")) <> "" And tostr(rsFac.fields("Comm")) = 0 And tostr(rsFac.fields("NetRate")) = 0 Then
                        rsFac.Edit()
                        rsFac.fields("NetRate") = Get_RateCon(ANO, rsFac.fields("Code"), Amount, rsFac.fields("Unit"))
                        If rsFac.fields("Unit") = "" Then rsFac.fields("Unit") = "C"
                        If Not rsFac.Update Then Throw New Exception(db.ErrDesc)
                    End If
                    rsFac.MoveNext()
                Loop
                FullCoverF = Check_Facultative_Main_Coverage(ANO, FID)
            End If

            If FullCoverF AndAlso ANO <> LANO Then
                If Round((FShare - (100 - toval(rsArr.fields("MShare")) - toval(rsArr.fields("FShare")))), 14, MidpointRounding.AwayFromZero) > 0 Then
                    ErrMsg = "Facultative Placement exceeds sum insured amount !"
                    Throw New Exception(ErrMsg)
                End If

                rsArr.Edit()
                rsArr.fields("FShare") = toval(rsArr.fields("FShare")) + FShare
                rsArr.fields("FAmount") = Decimal.Add(toval(rsArr.fields("FAmount")), FShare * OurShare / 100)
                rsArr.fields("Retention") = toval(rsArr.fields("Retention")) - FShare
                rsArr.fields("RAmount") = Decimal.Add(toval(rsArr.fields("RAmount")), -FShare * OurShare / 100)
                If Not rsArr.Update Then Throw New Exception(db.ErrDesc)
            End If

            If Not db.Execute("Update Acceptance Set AStatus='W', LDate='" & Format(Today.Date, "MM/DD/YYYY") & "', LTime='" & Time() & "' Where AStatus='W' and ANO=" & ANO) Then Throw New Exception(db.ErrDesc)
            If db.RecordsAffected = 0 Then
                ErrMsg = "Policy Already Processed !"
                Throw New Exception(ErrMsg)
            End If

            Return True
        Catch ex As Exception
            StrMsg = ex.Message
            Return False
        End Try
    End Function
    Private Function UnConfirmed_Facultative(ByVal ANO As Long, ByVal FID As String) As Boolean
        Dim FullCoverF As Boolean
        Dim Share As Double
        Dim Amount As Double
        Dim OurShare As Double
        Dim rsArr As RemoteSet
        Dim rsFac As RemoteSet
        Dim rs As RemoteSet

        On Error GoTo errmsg
        rs = db.OpenRemoteSet("Select LANO, AStatus from Acceptance Where ANO=" & ANO)
        If rs.fields("AStatus") <> "W" Then
            StrMsg = "Please Check Policy Data Status !"
            GoTo errmsg
        End If

        Dim LANO As Long = toval(rs.fields("LANO"))
        If ANO <> LANO Then
            rsArr = db.OpenQueryDef("QRArrHeader", adOpenKeyset, ANO)
            If rsArr.Eof Then
                StrMsg = "Please Check Risk Arrangement Data !"
                GoTo errmsg
            End If
            OurShare = toval(rsArr.fields("TAmount"))
        Else
            OurShare = 0
        End If

        rsFac = db.OpenRemoteSet("Select * from RArrDet Where Status='R' and ANO=" & ANO & " and FID='" & FID & "'")
        If rsFac.Eof Then GoTo errmsg
        FullCoverF = rsFac.fields("FullCoverF")
        Share = toval(rsFac.fields("Share")) - toval(rsFac.fields("JPShare"))
        Amount = rsFac.fields("Amount")
        rsFac.Edit()
        rsFac.fields("Status") = "O"
        rsFac.fields("AUserID") = ""
        rsFac.fields("AUserDate") = Today.Date
        If Not rsFac.Update Then GoTo errmsg

        Dim FShare As Double
        If toval(rsFac.fields("Limit")) <> 0 And OurShare <> 0 Then
            FShare = (toval(rsFac.fields("Limit"))) / OurShare * 100 * Share / 100
        Else
            FShare = Share
        End If

        Dim RShare As Double = 0
        rsFac = db.OpenRemoteSet("Select sum(Share) as RShare from FPart Where ANO=" & ANO & " and FID='" & FID & "'")
        RShare = rsFac.fields("RShare")

        FShare = FShare * RShare / 100

        If Not FullCoverF Then
            FullCoverF = Check_Facultative_Main_Coverage(ANO, FID)
        End If

        If FullCoverF AndAlso ANO <> LANO Then
            rsArr.Edit()
            rsArr.fields("FShare") = rsArr.fields("FShare") - FShare
            rsArr.fields("FAmount") = Decimal.Add(toval(rsArr.fields("FAmount")), -FShare * OurShare / 100)
            rsArr.fields("Retention") = rsArr.fields("Retention") + FShare
            rsArr.fields("RAmount") = Decimal.Add(toval(rsArr.fields("RAmount")), FShare * OurShare / 100)
            If Not rsArr.Update Then GoTo errmsg
        End If

        UnConfirmed_Facultative = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        UnConfirmed_Facultative = False
    End Function
    Private Function Check_Facultative_Main_Coverage(ByVal ANO As Long, ByVal FID As String) As Boolean
        Dim rs As RemoteSet
        rs = db.OpenRemoteSet("Select RCover.ANO from FPartDet, RCover Where RCover.ANO=FPartDet.ANO and RCover.Code=FPartDet.Code and RCover.Category='M' and FPartDet.ANO=" & ANO & " and FPartDet.FID='" & FID & "'", adOpenForwardonly)
        Check_Facultative_Main_Coverage = (Not rs.Eof())
    End Function

    Private Function Copy_Facultative_Master(ByVal LANO As Long, ByVal ANO As Long) As Boolean
        Dim rsSrc As RemoteSet
        Dim rsDst As RemoteSet

        Dim rsSrc1 As RemoteSet
        Dim rsDst1 As RemoteSet

        Dim rs As RemoteSet
        Dim FID As String
        Dim SDate As Date
        Dim EDate As Date
        Dim Branch As String
        Dim TOC As String
        Dim CT As String
        Dim AType As String
        Dim PolicyType As String
        Dim ISType As String

        On Error GoTo errmsg


        rs = db.OpenRemoteSet("Select * from RArrDet Where Status='R' and ANO=" & ANO)
        Do While Not rs.Eof
            If Not UnConfirmed_Facultative(ANO, rs.fields("FID")) Then GoTo errmsg
            rs.MoveNext()
        Loop

        ' Delete first
        If Not db.Execute("Delete from RArrDet Where Status='O' and AType='N' and ANO=" & ANO) Then GoTo errmsg

        Dim OurShare As Double
        rs = db.OpenRemoteSet("Select A1.SDate, A1.EDate, A1.Branch, A1.CT, A1.TOC, C1.PolicyType, C1.ISType, R.TAmount as OurShare from Acceptance A1 Left Join RArrHeader R on (R.ANO=A1.ANO), Cover C1 Where C1.CNO=A1.CNO and A1.ANO=" & ANO)
        OurShare = toval(rs.fields("OurShare"))

        Branch = tostr(rs.fields("Branch"))
        TOC = tostr(rs.fields("TOC"))
        CT = tostr(rs.fields("CT"))
        SDate = todate(rs.fields("SDate"))
        EDate = todate(rs.fields("EDate"))
        PolicyType = tostr(rs.fields("PolicyType"))
        ISType = tostr(rs.fields("ISType"))

        rsSrc = db.OpenRemoteSet("Select RArrDet.*,FPart.ID, FPart.SlipNo, Acceptance.SDate as MSDate, Acceptance.EDate as MEDate from RArrDet, FPart, Acceptance Where FPart.ANO=Acceptance.ANO and FPart.ANO=RArrDet.ANO and FPart.FID=RArrDet.FID and RArrDet.Status in ('R','A') and ('" & Format(SDate, "MM/DD/YYYY") & "' Between RArrDet.SDate and RArrDet.EDate or '" & Format(EDate, "MM/DD/YYYY") & "' Between RArrDet.SDate and RArrDet.EDate) and Acceptance.ANO=" & LANO)
        Do While Not rsSrc.Eof
            rsDst = db.OpenRemoteSet("Select RArrDet.* from RArrDet Where Exists (Select FPart.ANO from FPart Where FPart.ANO=RArrDet.ANO and FPart.FID=RArrDet.FID and FPart.ANO=" & ANO & " and FPart.ID='" & rsSrc.fields("ID") & "' and FPart.SlipNo='" & rsSrc.fields("SlipNo") & "')")
            If rsDst.Eof Then
                rsDst.AddNew()
                AType = "N"
                FID = ""
            Else
                rsDst.Edit()
                AType = rsDst.fields("AType")
                FID = rsDst.fields("FID")
            End If

            ' Use This Statement Instead Of Backup_Record Speed Up Copy Process (But Source and Destination Must Be The Same Structure)
            If Not rsDst.PutRecord(rsSrc.GetRecord()) Then GoTo errmsg
            rsDst.fields("ANO") = ANO
            If FID = "" Then
                FID = GetDocumentNumbering("FS", PolicyType, ISType, Today.Date, Branch, TOC, CT)
            End If
            If FID = "" Then
                StrMsg = "Generate Facultative ID Failed !"
                GoTo errmsg
            End If
            rsDst.fields("AType") = AType
            rsDst.fields("FID") = FID
            If DateDiff(DateInterval.Day, rsSrc.fields("SDate"), SDate) >= 0 Then
                rsDst.fields("SDate") = SDate
            Else
                rsDst.fields("SDate") = rsSrc.fields("SDate")
            End If
            If DateDiff(DateInterval.Day, EDate, rsSrc.fields("EDate")) >= 0 Or DateDiff(DateInterval.Day, rsSrc.fields("MEDate"), rsSrc.fields("EDate")) = 0 Then
                rsDst.fields("EDate") = EDate
            Else
                rsDst.fields("EDate") = rsSrc.fields("EDate")
            End If
            rsDst.fields("Status") = "O"
            rsDst.fields("UserID") = db_user
            rsDst.fields("CDate") = Today.Date
            rsDst.fields("LUserID") = db_user
            rsDst.fields("LDate") = Today.Date

            ' Adjust Here
            If OurShare <> 0 Then
                If toval(rsDst.fields("Limit")) <> 0 AndAlso toval(rsDst.fields("Limit")) > OurShare Then
                    rsDst.fields("Limit") = 0
                End If

                Dim Amount As Double

                If toval(rsDst.fields("Amount")) <> 0 Then
                    If toval(rsDst.fields("Limit")) <> 0 Then
                        Amount = toval(rsDst.fields("Share")) / 100 * toval(rsDst.fields("Limit"))
                    Else
                        Amount = toval(rsDst.fields("Share")) / 100 * OurShare
                    End If

                    If Amount > toval(rsDst.fields("Amount")) Then
                        Amount = toval(rsDst.fields("Amount"))
                        If toval(rsDst.fields("Limit")) <> 0 Then
                            rsDst.fields("Share") = Amount / toval(rsDst.fields("Limit")) * 100
                        Else
                            rsDst.fields("Share") = Amount / OurShare * 100
                        End If
                    End If

                End If
            End If
            If Not rsDst.Update Then GoTo errmsg

            rsSrc1 = db.OpenRemoteSet("Select * from FPart Where ANO=" & LANO & " and FID='" & rsSrc.fields("FID") & "'")
            Do While Not rsSrc1.Eof
                rsDst1 = db.OpenRemoteSet("Select * from FPart Where ANO=" & ANO & " and ID='" & rsSrc1.fields("ID") & "' and SlipNo='" & rsSrc1.fields("SlipNo") & "'")
                If rsDst1.Eof Then
                    rsDst1.AddNew()
                Else
                    rsDst1.Edit()
                End If
                ' Use This Statement Instead Of Backup_Record Speed Up Copy Process (But Source and Destination Must Be The Same Structure)
                If Not rsDst1.PutRecord(rsSrc1.GetRecord()) Then GoTo errmsg
