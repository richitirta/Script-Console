                            NetRateF = True
                        End If

                        JPPremium = 0
                        JPComm = 0
                        JPUjroh = 0
                        JPFee = 0

                        ' Check for First Loss
                        If rsRA.fields("FLPct") = 0 And rsRA.fields("Unit") <> "F" Then
                            Premium = Premium * toval(rsRA.fields("Share")) / 100 * toval(rsRA.fields("RShare")) / 100
                        End If
                        If Premium <> 0 Then
                            JPPremium = Premium * toval(rsRA.fields("JPShare")) / toval(rsRA.fields("Share"))
                        End If

                        AcqCost = Premium * toval(rsRA.fields("ACQCOST")) / 100
                        If toval(rsRA.fields("DISCOUNT")) <> 0 Then
                            PremiAdj = Premium * toval(rsRA.fields("DISCOUNT")) / 100
                        Else
                            If NumCCY = 1 Then
                                ' in Original Currency
                                PremiAdj = toval(rsRA.fields("DISCAMOUNT")) / rsIC.RecordCount * QTY
                            Else
                                PremiAdj = toval(rsRA.fields("DISCAMOUNT")) / rsIC.RecordCount / Rate * QTY
                            End If
                        End If

                        ProfitSharing = (Premium - AcqCost - PremiAdj) * toval(rsRA.fields("ProfitSharing")) / 100

                        Dim OCommission As Double
                        If NumCCY = 1 Then
                            ' in Original Currency
                            Commission = (toval(rsRA.fields("CommAmount"))) / rsIC.RecordCount * QTY
                            OCommission = (toval(rsRA.fields("OCommAmount"))) / rsIC.RecordCount * QTY
                        Else
                            Commission = (toval(rsRA.fields("CommAmount"))) / rsIC.RecordCount / Rate * QTY
                            OCommission = (toval(rsRA.fields("OCommAmount"))) / rsIC.RecordCount / Rate * QTY
                        End If

                        If Commission = 0 Then
                            Commission = (Premium - AcqCost - PremiAdj) * toval(rsRA.fields("Comm")) / 100
                        End If

                        If OCommission = 0 Then
                            OCommission = (Premium - AcqCost - PremiAdj) * toval(rsRA.fields("OComm")) / 100
                        End If


                        BRComm = (Premium - AcqCost - PremiAdj) * (1 - (1 - toval(rsRA.fields("BRComm")) / 100))
                        JPComm = (JPPremium) * (1 - (1 - toval(rsRA.fields("JPComm")) / 100))


                        ' Shariah
                        ' Ujroh Cedant/Re not apply for Coinsurance Follower
                        If Not (FType = "CF" And (ISType = "I" Or ISType = "L")) Then
                            If UjrohShariaF Then
                                Ujroh = (Premium - AcqCost - PremiAdj) * toval(rsRA.fields("UJROHCEDANT")) / 100
                                JPUjroh = (JPPremium) * toval(rsRA.fields("UJROHCEDANT")) / 100
                            Else
                                Premium = Premium * (100 - toval(rsRA.fields("UJROHCEDANT"))) / 100
                                AcqCost = AcqCost * (100 - toval(rsRA.fields("UJROHCEDANT"))) / 100
                                PremiAdj = PremiAdj * (100 - toval(rsRA.fields("UJROHCEDANT"))) / 100
                                Ujroh = 0
                                JPUjroh = 0
                            End If
                            Fee = ((Premium - AcqCost - PremiAdj) - Ujroh) * toval(rsRA.fields("UJROHREINS")) / 100
                            JPFee = ((JPPremium) - JPUjroh) * toval(rsRA.fields("UJROHREINS")) / 100
                        Else
