    Private Sub Get_Virtual_Account(ByVal Branch As String, ByVal TOC As String, ByVal PolicyType As String, ByVal Segment As String, ByVal CGroup As String, ByVal SCGroup As String, ByVal PaymentType As String, ByVal A_PolicyNo As String, ByVal AType As String, ByVal pCCY As String, ByVal PID As String, ByRef Bank As String, ByRef BankName As String, ByRef AccountNo As String, ByRef CCY As String, ByVal ExcBank As String, ByVal ADate As Date)
        Dim rs As RemoteSet
        Dim VID As Long

        On Error GoTo errmsg
        AccountNo = ""
        Dim SQL As String

        If AType = "C" Then
            SQL = "Select top 1 V1.VID, V1.Bank, V1.BankName, V1.Currency, V2.AccountNo "
            SQL = SQL & " from VAccount V1, VAccountD V2"
            SQL = SQL & " Where V2.VID = V1.VID "
            SQL = SQL & " and V1.RestrictedF=0 and V2.AllocatedF=1"
            SQL = SQL & " and (V1.Currency='' or V1.Currency='" & pCCY & "')"
            SQL = SQL & " and (V2.A_PolicyNo='" & A_PolicyNo & "' or V2.PayorID='" & PID & "')"
            SQL = SQL & " and V1.Bank<>'" & ExcBank & "'"
            SQL = SQL & " order by V1.Currency Desc, V2.A_PolicyNo Desc, V2.AccountNo"
            rs = db.OpenRemoteSet(SQL)
            If Not rs.Eof Then
                VID = rs.fields("VID")
                Bank = tostr(rs.fields("Bank"))
                BankName = tostr(rs.fields("BankName"))
                CCY = tostr(rs.fields("Currency"))
                AccountNo = rs.fields("AccountNo")
            End If
        Else
            SQL = "Select top 1 V1.VID, V1.Bank, V1.BankName, V1.Currency, V2.AccountNo "
            SQL = SQL & " from VAccount V1, VAccountD V2"
            SQL = SQL & " Where V2.VID = V1.VID "
            SQL = SQL & " and V1.RestrictedF=0 and V2.AllocatedF=1"
            SQL = SQL & " and (V1.Currency='' or V1.Currency='" & pCCY & "')"
            SQL = SQL & " and (V2.A_PolicyNo='" & A_PolicyNo & "' or V2.PayorID='" & PID & "')"
            SQL = SQL & " and V1.Bank<>'" & ExcBank & "'"
            SQL = SQL & " order by V1.Currency Desc, V2.A_PolicyNo Desc, V2.AccountNo"
            rs = db.OpenRemoteSet(SQL)
            If Not rs.Eof Then
                VID = rs.fields("VID")
                Bank = tostr(rs.fields("Bank"))
                BankName = tostr(rs.fields("BankName"))
                CCY = tostr(rs.fields("Currency"))
                AccountNo = rs.fields("AccountNo")
            Else
                Dim rsV As RemoteSet
                SQL = "Select V1.VID, V1.AutoGeneratedF, V1.VAccountMF "
                SQL = SQL & " from VAccount V1 "
                SQL = SQL & " Left Join VSCGroup V7 on (V7.VID=V1.VID and (V7.SCGroup='" & CGroup & "' or V7.SCGroup='" & SCGroup & "')) "
                SQL = SQL & " Left Join VPaymentType V8 on (V8.VID=V1.VID and V8.PaymentType='" & PaymentType & "'), VTOC V3, VPolicyType V4, VSegment V5, VBranch V6"
                SQL = SQL & " Where (V1.ApplyVSCGroupF=0 or coalesce(V7.SCGroup,'')<>'') and (V1.XApplyVSCGroupF=0 or coalesce(V7.SCGroup,'')='') and (V1.ApplyVPaymentTypeF=0 or coalesce(V8.PaymentType,'')<>'') and (V1.Currency='' or V1.Currency='" & pCCY & "') "
                SQL = SQL & " and V3.VID = V1.VID And V4.VID = V1.VID And V5.VID = V1.VID And V6.VID=V1.VID"
                SQL = SQL & " and ((V3.TOC='" & TOC & "' and V4.PolicyType='" & PolicyType & "' and V5.Segment='" & Segment & "' and V6.Branch='" & Branch & "' and V1.RestrictedF=0 and V1.UsedByCollectionF=0)) "
                SQL = SQL & " and V1.Bank<>'" & ExcBank & "'"
                If Bank <> "" Then
                    SQL = SQL & " and V1.Bank='" & Bank & "'"
                End If
                SQL = SQL & " Order by V1.Currency Desc, V1.VID"
                rsV = db.OpenRemoteSet(SQL)
                Do While Not rsV.Eof
                    VID = rsV.fields("VID")
                    If Not toval(rsV.fields("AutoGeneratedF")) Then     ' always By Policy
                        SQL = "Select Top 1 V1.VID, V1.Bank, V1.BankName, V1.Currency, V2.AccountNo "
                        SQL = SQL & " from VAccount V1, VAccountD V2"
                        SQL = SQL & " Where V2.VID = V1.VID and V2.AllocatedF=0 and V1.VID=" & VID
                        SQL = SQL & " order by V2.AccountNo"
                        rs = db.OpenRemoteSet(SQL)
                        If rs.Eof Then
                            rsV.MoveNext()
                        Else
                            Bank = tostr(rs.fields("Bank"))
                            BankName = tostr(rs.fields("BankName"))
                            CCY = tostr(rs.fields("Currency"))
                            AccountNo = rs.fields("AccountNo")
                            If Not db.Execute("Update VAccountD set AllocatedF=1, A_PolicyNo='" & A_PolicyNo & "' Where AllocatedF=0 and VID=" & VID & " and AccountNo='" & AccountNo & "'") Then GoTo errmsg
                            If db.RecordsAffected = 0 Then
                                rsV.MoveNext()
                            Else
                                Exit Do
                            End If
                        End If
                    ElseIf Not toval(rsV.fields("VAccountMF")) Then
                        AccountNo = Generate_Virtual_Account(VID, "Policy", A_PolicyNo, PID, Bank, BankName, CCY, Branch, TOC, PolicyType, Segment, ADate)
                        If AccountNo = "" Then
                            StrMsg = "Generate Virtual Account Number Failed !"
                            GoTo errmsg
                        End If
                        If Not db.Execute("Update VAccountD set AllocatedF=1, A_PolicyNo='" & A_PolicyNo & "' Where AllocatedF=0 and VID=" & VID & " and AccountNo='" & AccountNo & "'") Then GoTo errmsg
                        If db.RecordsAffected = 0 Then
                            rsV.MoveNext()
                        Else
                            Exit Do
                        End If
                    Else
                        SQL = "Select Top 1 GenerateBy "
                        SQL = SQL & " from vAccountM "
                        SQL = SQL & " Where VID=" & VID & " and Branch='" & Branch & "' and TOC='" & TOC & "' and PolicyType='" & PolicyType & "' and Segment='" & Segment & "'"
                        rs = db.OpenRemoteSet(SQL)
                        If rs.Eof Then
                            rsV.MoveNext()
                        Else
                            AccountNo = Generate_Virtual_Account(VID, rs.fields("GenerateBy"), A_PolicyNo, PID, Bank, BankName, CCY, Branch, TOC, PolicyType, Segment, ADate)
                            If AccountNo = "" Then
                                StrMsg = "Generate Virtual Account Number Failed !"
                                GoTo errmsg
                            End If
                            If rs.fields("GenerateBy") = "Policy" Then
                                If Not db.Execute("Update VAccountD set AllocatedF=1, A_PolicyNo='" & A_PolicyNo & "', PayorID='' Where AllocatedF=0 and VID=" & VID & " and AccountNo='" & AccountNo & "'") Then GoTo errmsg
                            Else
                                If Not db.Execute("Update VAccountD set AllocatedF=1, A_PolicyNo='', PayorID='" & PID & "' Where AllocatedF=0 and VID=" & VID & " and AccountNo='" & AccountNo & "'") Then GoTo errmsg
                            End If
                            If db.RecordsAffected = 0 Then
                                rsV.MoveNext()
                            Else
                                Exit Do
                            End If
                        End If
                    End If
                Loop
            End If
        End If
errmsg:
    End Sub
