            End If
        End If

        UpdatePreviousClaim = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        UpdatePreviousClaim = False
    End Function

    Private Function Loss_Calc(ByVal CNO As Long) As Boolean
        Dim rs As RemoteSet
        Dim rsLoss As RemoteSet
        Dim rsCalc As RemoteSet
        On Error GoTo errmsg

        rs = db.OpenRemoteSet("Select Cstatus, PStatus from Claim Where CNO=" & CNO)
        If rs.fields("CStatus") <> "R" Or rs.fields("PStatus") <> "I" Then
            Loss_Calc = True
            Exit Function
        End If
        If Not db.Execute("Delete from LCalc where CNO=" & CNO) Then GoTo errmsg
        If Not db.Execute("Delete from CCalc where CNO=" & CNO) Then GoTo errmsg

        rsCalc = db.OpenRemoteSet("Select * from LCalc Where 1<>1")
        rsLoss = db.OpenQueryDef("CCALC01", adOpenForwardOnly, CNO)
        Do While Not rsLoss.Eof
            rsCalc.AddNew()
            rsCalc.fields("CNO") = CNO
            rsCalc.fields("Currency") = tostr(rsLoss.fields("Currency"))
            rsCalc.fields("Code") = tostr(rsLoss.fields("Code"))
            rsCalc.fields("TOR") = tostr(rsLoss.fields("TOR"))
            rsCalc.fields("Loss") = toval(rsLoss.fields("Loss"))
            rsCalc.fields("Indemnity") = toval(rsLoss.fields("Indemnity"))
            rsCalc.fields("EDeductible") = toval(rsLoss.fields("EDeductible"))
            rsCalc.fields("Deductible") = toval(rsLoss.fields("Deductible"))
            rsCalc.fields("ESalvage") = toval(rsLoss.fields("ESalvage"))
            rsCalc.fields("Salvage") = toval(rsLoss.fields("Salvage"))
            If Not rsCalc.UpdateRow Then GoTo errmsg
            rsLoss.MoveNext()
        Loop

        ' Finally
        If Not rsCalc.Eof Then
            If Not rsCalc.Update Then GoTo errmsg
        End If
        rsLoss.CloseRemoteSet()
        rsCalc.CloseRemoteSet()

        Dim Share As Double
        Dim Rate As Double
        Share = GetPctClaimShare(CNO)

        rsCalc = db.OpenRemoteSet("Select * from CCalc Where 1<>1")
        rsLoss = db.OpenQueryDef("CCALC02", adOpenForwardOnly, CNO)
        Do While Not rsLoss.Eof
            Rate = Claim_Reinsurance_Rate(CNO, tostr(rsLoss.fields("Currency")))
            If Rate = 0 Then
                StrMsg = "No Reinsurance Rate for Currency : '" & rsLoss.fields("Currency") & "' !"
                GoTo errmsg
            End If
            rsCalc.AddNew()
            rsCalc.fields("CNO") = CNO
            rsCalc.fields("Currency") = tostr(rsLoss.fields("Currency"))
            rsCalc.fields("Loss") = toval(rsLoss.fields("Loss"))
            rsCalc.fields("Claim") = toval(rsLoss.fields("Claim"))
            rsCalc.fields("EDeductible") = toval(rsLoss.fields("EDeductible"))
            rsCalc.fields("Deductible") = toval(rsLoss.fields("Deductible"))
            rsCalc.fields("Cost") = toval(rsLoss.fields("Cost"))
            rsCalc.fields("RCost") = toval(rsLoss.fields("RCost"))
            rsCalc.fields("ECost") = toval(rsLoss.fields("ECost"))
            rsCalc.fields("ERCost") = toval(rsLoss.fields("ERCost"))
            rsCalc.fields("TCost") = toval(rsLoss.fields("TCost"))
            rsCalc.fields("ETCost") = toval(rsLoss.fields("ETCost"))
            rsCalc.fields("Subrogation") = toval(rsLoss.fields("Subrogation"))
            rsCalc.fields("RSubrogation") = toval(rsLoss.fields("RSubrogation"))
            rsCalc.fields("ESubrogation") = toval(rsLoss.fields("ESubrogation"))
            rsCalc.fields("ERSubrogation") = toval(rsLoss.fields("ERSubrogation"))
            rsCalc.fields("TSubrogation") = toval(rsLoss.fields("TSubrogation"))
            rsCalc.fields("ETSubrogation") = toval(rsLoss.fields("ETSubrogation"))
            rsCalc.fields("Salvage") = toval(rsLoss.fields("Salvage"))
            rsCalc.fields("RSalvage") = toval(rsLoss.fields("RSalvage"))
            rsCalc.fields("ESalvage") = toval(rsLoss.fields("ESalvage"))
            rsCalc.fields("ERSalvage") = toval(rsLoss.fields("ERSalvage"))
            rsCalc.fields("TSalvage") = toval(rsLoss.fields("TSalvage"))
            rsCalc.fields("ETSalvage") = toval(rsLoss.fields("ETSalvage"))
            rsCalc.fields("OurShare") = toval(rsLoss.fields("Claim")) * Share / 100
            rsCalc.fields("Share") = Share
            rsCalc.fields("Rate") = Rate
            If Not rsCalc.UpdateRow Then GoTo errmsg
            rsLoss.MoveNext()
        Loop

        ' Finally
        If Not rsCalc.Eof Then
            If Not rsCalc.Update Then GoTo errmsg
        End If
        rsLoss.CloseRemoteSet()
        rsCalc.CloseRemoteSet()

        'Update Claim Process Status
        If Not db.Execute("Update Claim Set PStatus='C', LDate='" & Format(Today.Date, "MM/DD/YYYY") & "', LTime='" & Time() & "' Where Claim.CNO=" & CNO) Then GoTo errmsg

        If Not db.Execute("Update CArrHeader Set RDate=Claim.LossDate from CArrHeader,Claim Where CArrHeader.CNO=Claim.CNO and Claim.CNO=" & CNO) Then GoTo errmsg

        If Not Claim_Cession(CNO) Then GoTo errmsg

        Loss_Calc = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Loss_Calc = False
    End Function
    Private Function GetPctClaimShare(ByVal CNO As Long) As Double
        Dim rs As RemoteSet

        rs = db.OpenQueryDef("QClaimShare", adOpenForwardOnly, CNO)
        GetPctClaimShare = toval(rs.fields("ISShare"))
        If GetPctClaimShare = 0 Then GetPctClaimShare = 100
        rs.CloseRemoteSet()
    End Function
    Private Function Claim_Reinsurance_Rate(ByVal CNO As Long, ByVal CCY As String) As Double
        Dim rs As RemoteSet
        Dim CCYTo As String
        Dim BaseCCY As String
        Dim Rate As Double
        Rate = 1
        rs = db.OpenRemoteSet("Select Currency from SysTab", adOpenForwardOnly)
        BaseCCY = rs.fields("Currency")
        If CCY.ToUpper <> BaseCCY.ToUpper Then
            CCYTo = CCY
            Do
                CCY = CCYTo
                rs = db.OpenQueryDef("QClaim_Rate", adOpenForwardonly, CNO, CCY)
                CCYTo = tostr(rs.fields("CCYTO"))
                Rate = Rate * toval(rs.fields("CRate"))
            Loop While CCYTo.ToUpper <> CCY.ToUpper And CCYTo.ToUpper <> "" And CCYTo.ToUpper <> BaseCCY.ToUpper
        End If
        Claim_Reinsurance_Rate = Rate
    End Function
