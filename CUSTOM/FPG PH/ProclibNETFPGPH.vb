                End If

                rsd = db.OpenRemoteSet("Select * from #RCover Where 1<>1")
                ' Get Scheme Indemnity
                If UMonth - LMonth + 1 < 12 And PCalc = "S" Then
                    rss = db.OpenQueryDef("QScheme_Verify_3", adOpenForwardonly, Coverage, Code, (LMonth + PMonth) - (LMonth + PMonth) + 1, (UMonth + PMonth) - (LMonth + PMonth) + 1, SchemeNO, Description, TSI)
                Else
                    rss = db.OpenQueryDef("QScheme_Verify_3", adOpenForwardonly, Coverage, Code, (LMonth + PMonth), (UMonth + PMonth), SchemeNO, Description, TSI)
                End If
                Do While Not rss.Eof
                    If toval(rss.fields("HoldF")) Then
                        HoldF = True
                        If HoldF Then
                            If HoldMessage <> "" Then HoldMessage = HoldMessage & vbCrLf
                            HoldMessage = HoldMessage & "Scheme Verify Coverage : " & Coverage & "'"
                        End If
                    End If

                    If sPeriod <> 1 Then        ' Not in Days
                        pSDate = DateAdd(DateInterval.Month, rss.fields("Lower") - PMonth - 1, SDate)
                    Else
                        pSDate = DateAdd(DateInterval.Day, rss.fields("Lower") - PMonth - 1, SDate)
                    End If
                    RateLoadingF = toval(rss.fields("RateLoadingF"))
                    If RateLoadingF Then
                        Dim HMsg As String = ""
                        If tPrefix <> "" Then
                            Loading = Get_RateLoading_Temp(ANO, Code, pSDate, , HoldF, HMsg)
                        Else
                            Loading = Get_RateLoading(ANO, Code, pSDate, , HoldF, HMsg)
                        End If
                        If HoldF Then
                            If HoldMessage <> "" Then HoldMessage = HoldMessage & vbCrLf
                            HoldMessage = HoldMessage & HMsg
                        End If
                    End If

                    If SplitRiskF Then
                        rsd.AddNew()
                    Else
                        If tostr(rsd.fields("Code")) = Code And toval(rsd.fields("PCTLoss")) = toval(rss.fields("PCTLoss")) And toval(rsd.fields("PADDITION")) = toval(rss.fields("PADDITION")) And toval(rsd.fields("Discount")) = toval(rss.fields("Discount")) And toval(rsd.fields("Loading")) = Loading Then
                            rsd.Edit()
                        Else
                            rsd.AddNew()
                        End If
                    End If

                    If rsd.editmode = AdEditAdd Then
                        rsd.fields("ANO") = ANO
