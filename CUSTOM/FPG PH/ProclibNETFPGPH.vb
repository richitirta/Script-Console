                            rsCA.fields("BillDate") = BillDate
                            rsCA.fields("TOC") = TOC
                            rsCA.fields("Remarks") = AName
                            rsCA.fields("CAmount") = -Claim * toval(rs.fields("Share")) / 100
                            rsCA.fields("Amount_OC") = toval(rsCA.fields("CAmount"))
                            rsCA.fields("Amount") = toval(rsCA.fields("CAmount"))
                            rsCA.fields("Rate") = 1
                            rsCA.fields("AdmNo") = -1
                            rsCA.fields("RCode") = RCode
                            rsCA.fields("TOR") = TOR
                            rsCA.fields("Currency_OC") = pCCY
                            rsCA.fields("Currency") = pCCY
