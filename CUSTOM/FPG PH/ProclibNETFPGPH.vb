        ' Get Scheme Deductible from Coverage #1
        rs = db.OpenQueryDef("QScheme_Verify_5", adOpenForwardonly, TSI, Coverage, SchemeNO, Description)
        If Not rs.Eof Then
            Do While Not rs.Eof
                rsd = db.OpenRemoteSet("Select * from " & tPrefix & "AccDed Where ANO=" & ANO & " and TOR='" & tostr(rs.fields("TOR")) & "' and DCode='" & tostr(rs.fields("DCode")) & "' and Section='' and PolicyYear=0")
