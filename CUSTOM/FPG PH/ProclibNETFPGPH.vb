    Private Function PutClaRegAmount(ByVal EventNo As Long, ByVal RType As String, ByVal RYear As Integer, ByVal Amount As Double, ByVal TClaim As Double, ByVal EAmount As Double, ByVal ETClaim As Double) As Long
        Dim rs As RemoteSet
        On Error GoTo errmsg

        rs = db.OpenQueryDef("QCLAREGDET", adOpenKeyset, EventNo, RType, RYear)
        If rs.Eof Then
            rs.AddNew()
            rs.fields("EventNo") = EventNo
            rs.fields("RTYPE") = RType
            rs.fields("RYear") = RYear
            rs.fields("RegNo") = db.GetIdentity("CLAREGDET") + 1
        Else
            rs.Edit()
        End If
        rs.fields("AMOUNT") = toval(rs.fields("Amount")) + Amount
        rs.fields("TCLAIM") = toval(rs.fields("TCLAIM")) + TClaim
        rs.fields("EAMOUNT") = toval(rs.fields("EAmount")) + EAmount
        rs.fields("ETCLAIM") = toval(rs.fields("ETCLAIM")) + ETClaim

        If Not rs.Update Then GoTo errmsg
        PutClaRegAmount = rs.fields("RegNo")
        rs.CloseRemoteSet()
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        PutClaRegAmount = -1
    End Function
    Private Function GetClaRegAmount(ByVal EventNo As Long, ByVal RType As String, ByVal RYear As Integer, ByVal Amount As Double, ByVal TClaim As Double, ByVal EAmount As Double, ByVal ETClaim As Double) As Long
        Dim rs As RemoteSet
        On Error GoTo errmsg
        rs = db.OpenQueryDef("QCLAREGDET", adOpenKeyset, EventNo, RType, RYear)
        If Not rs.Eof Then
            rs.Edit()
            rs.fields("AMOUNT") = toval(rs.fields("AMOUNT")) - Amount
            rs.fields("TCLAIM") = toval(rs.fields("TCLAIM")) - TClaim
            rs.fields("EAMOUNT") = toval(rs.fields("EAMOUNT")) - EAmount
            rs.fields("ETCLAIM") = toval(rs.fields("ETCLAIM")) - ETClaim
            If Not rs.Update Then GoTo errmsg
        End If
        GetClaRegAmount = -1
        rs.CloseRemoteSet()
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        GetClaRegAmount = 0
    End Function

    Private Function Approval(ByVal CNO As Long, ByVal Param As Object) As Boolean
        Dim rs As RemoteSet
        Dim PCNO As Long
        Dim ClaimType As String
        Dim Claimant As String
        Dim ClaimNo As String
        Dim DetailTreatyF As Boolean
        Dim ANO As Long
        Dim CStatus As String

        Dim ADate As Date = todate(getInParamValue(Param, 0))
        Dim PDate As Date = todate(getInParamValue(Param, 1))
        Dim SettledF As Boolean = toval(getInParamValue(Param, 2))
        Dim br_Approval_User As String = tostr(getInParamValue(Param, 3))
        Dim BackDatedF As Boolean = toval(getInParamValue(Param, 4))
        Dim Comment As String = tostr(getInParamValue(Param, 5))

        rs = db.OpenRemoteSet("Select DetailTreatyF from SysTab", adOpenForwardonly)
        DetailTreatyF = rs.fields("DetailTreatyF")

        rs = db.OpenRemoteSet("Select pCNO, CType, Claimant, ClaimNo, ANO, CStatus, pSettledF from Claim Where CNO=" & CNO)
        PCNO = toval(rs.fields("PCNO"))
        ClaimType = tostr(rs.fields("CType"))
        Claimant = tostr(rs.fields("Claimant"))
        ClaimNo = tostr(rs.fields("ClaimNo"))
        ANO = toval(rs.fields("ANO"))
        CStatus = tostr(rs.fields("CStatus"))
        SettledF = IIf(toval(rs.fields("PSettledF")), True, SettledF)
        If Not (CStatus = "P" Or CStatus = "T") Then
            StrMsg = "Please Check Claim Status !"
            GoTo errmsg
        End If

        If CStatus = "P" Then
            If Not Temporary_Approval(CNO, ADate) Then GoTo errmsg
        End If

        ' Correction or Cancellation
        If ClaimType = "E" Or ClaimType = "C" Then
            ' Set Previous Claim Status to Closed
        End If

        rs = db.OpenRemoteSet("Select Status from CArrHeader Where CNO=" & CNO)
        If rs.fields("Status") = "R" Then
            If Not ReleaseClaRegAmount(CNO) Then GoTo errmsg
        End If

        ' Update Current claim Status to Approved
        If Not db.Execute("Update Claim Set BackDatedF=" & IIf(BackDatedF, 1, 0) & ", SettledF=" & IIf(SettledF, 1, 0) & ", CStatus='A', CSDate='" & Format(ADate, "MM/DD/YYYY") & "', ADate='" & Format(ADate, "MM/DD/YYYY") & "', PDate='" & Format(PDate, "MM/DD/YYYY") & "', AUserDate='" & Format(Today.Date, "MM/DD/YYYY") & "', AUserTime='" & Time() & "', AUserID='" & br_Approval_User & "', Comment='" & Comment & "' Where CStatus='T' and CNO=" & CNO) Then GoTo errmsg
        If db.RecordsAffected = 0 Then
            StrMsg = "Please Check Claim Data !"
            GoTo errmsg
        End If

        ' Update Services
        If Not db.Execute("Update Service Set SStatus='A', AUserDate='" & Format(Today.Date, "MM/DD/YYYY") & "', AUserID='" & br_Approval_User & "', AUserTime='" & Time() & "' Where SType='Claim' and SStatus='P' and CNO=" & CNO) Then GoTo errmsg

        ' Update Renewal Data Process Status
        If Not db.Execute("Update Renewal Set PStatus='I' Where ANO=" & ANO) Then GoTo errmsg

        If Not BackDatedF Then
            ' Immediately Posting to Adm
            If Not Claim_To_Adm(CNO, DetailTreatyF) Then GoTo errmsg

            If DetailTreatyF Then
                rs = db.OpenRemoteSet("Select distinct Admlink.AdmNo from Admlink, ClaAss Where Admlink.VoucherF=0 and Admlink.AdmNo=ClaAss.AdmNo and Admlink.WriteF=0 and ClaAss.CNO=" & CNO)
            Else
                rs = db.OpenRemoteSet("Select distinct Admlink.AdmNo from Admlink, ClaAss, TOC Where TOC.TOC=Admlink.Code and Admlink.VoucherF=0 and Admlink.AdmNo=ClaAss.AdmNo and Admlink.WriteF=0 and (ClaAss.Type in ('DI', 'IR', 'IT', 'IX', 'IC', 'JP', 'CF', 'FO','FP','BA', 'BB', 'BO', 'BC', 'BP','BD', 'OP','DC','CP','XP','AF','X1','X2','X3','X4','X5','X6','X7','X8','X9','XX','RP','AP') or Admlink.Extra_3='CASH CALL' or TOC.ConsortiumF=1) and ClaAss.CNO=" & CNO)
            End If
            Do While Not rs.Eof
                If Create_Voucher(rs.fields("AdmNo"), True) = "" Then GoTo errmsg
                rs.MoveNext()
            Loop
        End If

        Approval = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Approval = False
    End Function
    Private Function Claim_To_Adm(ByVal CNO As Long, Optional ByVal DetailTreatyF As Boolean = False) As Boolean
        Dim rs As RemoteSet
        Dim rsAdm As RemoteSet
        Dim PID As String
        Dim PCode As String
        Dim pRCode As String
        Dim PType As String
        Dim pCCY As String
        Dim PRefNo As String
        Dim PDocNo As String
        Dim pComAcc As String
        Dim pBranch As String
        Dim pSegment As String
        Dim pPolicyNo As String
        Dim pADate As Date
        Dim pBillDate As Date
        Dim pSubject As String
        Dim pExGratiaF As Boolean
        Dim CT As String
        Dim Branch As String
        Dim ADate As Date
        Dim EventNo As Long
        Dim EventName As String
        Dim AdmNo As Long
        Dim SDate As Date
        Dim EDate As Date
        Dim PDate As Date
        Dim Source As String
        Dim AgentID As String
        Dim BrokerID As String
        Dim CPAID As String
        Dim Segment As String
        Dim ANO As Long
        Dim LANO As Long
        Dim OpenFlag As Boolean
        Dim PolicyNo As String
        Dim MO As String
        Dim ISType As String
        Dim BatchNo As String
        Dim AID As String
        Dim LossDate As Date
        Dim CRefNo As String
        Dim Statement As Integer
        Dim DocNo As String
        Dim ConsortiumF As Boolean
        Dim BulkF As Boolean
        Dim ExGratiaF As Boolean
        Dim CashCallOnPartialPaymentF As Boolean
        Dim ASource As String
        Dim MSCode As String
        Dim BizMapID As String
        Dim TaxTableF As Boolean
        Dim RValue As Double

        On Error GoTo errmsg
        rs = db.OpenRemoteSet("Select TaxTableF from SysTab")
        TaxTableF = toval(rs.fields("TaxTableF"))

        ' Get CT & Other Policy Information
        rs = db.OpenRemoteSet("Select sysuser.CT as sCT, Acceptance.MSCode, Acceptance.BizMapID, Acceptance.CT as aCT, Acceptance.BulkF as BulkF, Claim.ASource, Claim.ClaimNo, Claim.CSeqNo, Claim.LossDate, Claim.PDate, Claim.ADate, Claim.CSDate, Claim.EventNo, Claim.ExGratiaF, Event.EventName, Acceptance.Branch, Acceptance.AID, Acceptance.BatchNo, Acceptance.Source, Acceptance.PolicyNo, Acceptance.CertificateNo, Acceptance.SDate, Acceptance.EDate, Acceptance.ANO, Acceptance.LANO, Cover.OpenFlag, Cover.Segment, Cover.MO, Cover.ISType, Cover.RefNo as CRefNo, TOC.ConsortiumF, TOC.CashCallOnPartialPaymentF, TOC.RValue from Cover, Acceptance, Claim Left Join Event on (Event.EventNo=Claim.EventNo), sysuser, TOC Where Acceptance.ANO=Claim.ANO and Cover.CNO=Acceptance.CNO and TOC.TOC=Acceptance.TOC and sysuser.ID=Cover.MO and Claim.CNO=" & CNO)
        CT = tostr(rs.fields("aCT"))
        If CT = "" Then CT = tostr(rs.fields("sCT"))
        Branch = tostr(rs.fields("Branch"))
        PDate = todate(rs.fields("PDate"))
        ADate = todate(rs.fields("ADate"))
        EventNo = toval(rs.fields("EventNo"))
        EventName = tostr(rs.fields("EventName"))
        ASource = tostr(rs.fields("ASource"))
        RValue = toval(rs.fields("RValue"))
        SDate = todate(rs.fields("SDate"))
        EDate = todate(rs.fields("EDate"))
        ANO = toval(rs.fields("ANO"))
        LANO = toval(rs.fields("LANO"))
        OpenFlag = toval(rs.fields("OpenFlag"))
        MO = tostr(rs.fields("MO"))
        BatchNo = tostr(rs.fields("BatchNo"))
        Source = tostr(rs.fields("Source"))
        MSCode = tostr(rs.fields("MSCode"))
        BizMapID = tostr(rs.fields("BizMapID"))
        ISType = tostr(rs.fields("ISType"))
        AID = tostr(rs.fields("AID"))
        LossDate = todate(rs.fields("LossDate"))
        CRefNo = tostr(rs.fields("CRefNo"))
        AgentID = Get_AgentID(ANO)
        BrokerID = Get_BrokerID(ANO)
        CPAID = Get_CPAID(ANO)
        Segment = tostr(rs.fields("Segment"))
        ConsortiumF = toval(rs.fields("ConsortiumF"))
        BulkF = toval(rs.fields("BulkF"))
        ExGratiaF = toval(rs.fields("ExGratiaF"))
        CashCallOnPartialPaymentF = toval(rs.fields("CashCallOnPartialPaymentF"))
        Statement = 0

        If LANO <> -1 Then
            If OpenFlag And ANO <> LANO And Not BulkF Then
                PolicyNo = tostr(rs.fields("PolicyNo")) + "-" + tostr(rs.fields("CertificateNo"))
            Else
                PolicyNo = tostr(rs.fields("PolicyNo"))
            End If
        Else
            PolicyNo = tostr(rs.fields("PolicyNo"))
        End If

        ' Document No for Detail Treaty
        DocNo = rs.fields("ClaimNo")
        If toval(rs.fields("CSeqNo")) <> 0 Then
            DocNo = DocNo + "-" + tostr(rs.fields("CSeqNo"))
        End If

        rs = db.OpenQueryDef("QClaim_To_Adm", adOpenForwardonly, CNO)
        If Not rs.Eof Then
            PRefNo = ""
            PType = ""
            rsAdm = db.OpenRemoteSet("Select * from Admlink Where 1<>1")
            Do While Not rs.Eof
                PID = tostr(rs.fields("ID"))
                PCode = tostr(rs.fields("TOC"))
                pRCode = tostr(rs.fields("RCode"))
                pCCY = tostr(rs.fields("Currency"))
                PDocNo = tostr(rs.fields("DocNo"))
                pComAcc = tostr(rs.fields("ComAcc"))
                pExGratiaF = toval(rs.fields("ExGratiaF"))
                If ExGratiaF Then pExGratiaF = ExGratiaF
                pSegment = Segment
                pBranch = Branch

                If PRefNo <> tostr(rs.fields("RefNo")) OrElse PType <> tostr(rs.fields("Type")) Then
                    PRefNo = tostr(rs.fields("RefNo"))
                    PType = tostr(rs.fields("Type"))
                    If PType = "RP" Then
                        pSubject = "Premium"
                    Else
                        pSubject = "Claim"
                    End If
                    If InStr("CPXPQSQPS1S2S3DCAF", PType) <> 0 Then
                        Dim rsT As RemoteSet
                        rsT = db.OpenRemoteSet("Select Top 1 R1.Statement from Reinsurance R1 Inner Join RPart R2 on (R2.RNO=R1.RNO and R2.ID='" & PID & "') Where CASE WHEN COALESCE(R2.DOCNO,'')='' THEN R1.DOCNO ELSE R2.DOCNO END='" & PRefNo & "'")
                        Statement = toval(rsT.fields("Statement"))
                    End If
                End If

                Select Case PType
                    Case "DI", "IR", "IC", "JP", "CF", "FO", "FP", "BA", "BB", "BO", "BC", "BP", "BD", "OP", "X1", "X2", "X3", "X4", "X5", "X6", "X7", "X8", "X9", "XX", "RP", "AP", "VT"
                        pADate = ADate
                        If rs.fields("Date") = rs.fields("BillDate") Then ' Default
                            pBillDate = PDate
                        Else
                            pBillDate = DateAdd(DateInterval.Day, DateDiff(DateInterval.Day, rs.fields("Date"), rs.fields("BillDate")), PDate)
                        End If
                        pPolicyNo = PolicyNo
                    Case Else
                        If DetailTreatyF Or toval(rs.fields("CashLossF")) Or ConsortiumF Or PType = "DC" Or PType = "CP" Or PType = "XP" Or PType = "AF" Or PType = "IT" Or PType = "IX" Then
                            pADate = ADate
                            pBillDate = PDate
                            PDocNo = DocNo
                            pPolicyNo = PolicyNo
                        Else
                            pADate = Last_date_of_period(ADate, 1)
                            pBillDate = Last_date_of_period(ADate, Statement)
                            PDocNo = PRefNo
                            pPolicyNo = PRefNo
                        End If
                End Select


                Dim LockedKey As String = ""
                Dim EditMode As Integer

                Select Case PType
                    Case "DI", "IR", "IC", "JP", "CF", "FO", "FP", "BA", "BB", "BO", "BC", "BP", "BD", "OP", "X1", "X2", "X3", "X4", "X5", "X6", "X7", "X8", "X9", "XX", "RP", "AP", "VT"
                        EditMode = AdEditAdd
                        AdmNo = db.GetIdentity("Admlink") + 1
                    Case Else ' Treaty
                        If DetailTreatyF Or toval(rs.fields("CashLossF")) Or ConsortiumF Or PType = "DC" Or PType = "CP" Or PType = "XP" Or PType = "AF" Or PType = "IT" Or PType = "IX" Then
                            EditMode = AdEditAdd
                            AdmNo = db.GetIdentity("Admlink") + 1
                        Else
                            Do While True
                                rsAdm = db.OpenQueryDef("QAdmLink", adOpenKeyset, PID, PCode, PType, pCCY, PRefNo, pADate, pBillDate, PDocNo, pSubject, pBranch, pSegment, pPolicyNo)
                                If rsAdm.Eof Then
                                    EditMode = AdEditAdd
                                    AdmNo = db.GetIdentity("Admlink") + 1
                                Else
                                    EditMode = AdEditInProgress
                                    AdmNo = toval(rsAdm.fields("AdmNo"))
                                End If
                                LockedKey = "ADMLINK_" & AdmNo
                                If db.GetLockedObject(LockedKey) Then
                                    Exit Do
                                Else
                                    System.Threading.Thread.Sleep(1000)
                                End If
                            Loop
                        End If
                End Select

                If EditMode = AdEditInProgress Then
                    rsAdm.Edit()
                Else
                    rsAdm.AddNew()
                    rsAdm.fields("AdmNo") = AdmNo
                    rsAdm.fields("ID") = PID
                    rsAdm.fields("CODE") = PCode
                    rsAdm.fields("TYPE") = PType
                    rsAdm.fields("Currency") = pCCY
                    rsAdm.fields("RefNo") = PRefNo
                    rsAdm.fields("DocNo") = PDocNo
                    rsAdm.fields("Date") = pADate
                    rsAdm.fields("BillDate") = pBillDate
                    rsAdm.fields("Subject") = pSubject
                    rsAdm.fields("Branch") = pBranch
                    rsAdm.fields("Segment") = pSegment
                    rsAdm.fields("A_PolicyNo") = pPolicyNo
                    rsAdm.fields("ComAcc") = pComAcc
                End If
                rsAdm.fields("RCode") = pRCode
                rsAdm.fields("VoucherF") = 0
                rsAdm.fields("CT") = CT
                rsAdm.fields("ASource") = ASource
                rsAdm.fields("BatchNo") = BatchNo
                rsAdm.fields("Source") = Source
                rsAdm.fields("MSCode") = MSCode
                rsAdm.fields("BizMapID") = BizMapID
                rsAdm.fields("AgentID") = AgentID
                rsAdm.fields("BrokerID") = BrokerID
                rsAdm.fields("CPAID") = CPAID
                rsAdm.fields("ISType") = ISType
                rsAdm.fields("A_ID") = AID
                rsAdm.fields("A_SDate") = SDate
                rsAdm.fields("A_EDate") = EDate
                rsAdm.fields("A_MO") = MO
                rsAdm.fields("A_RefNo") = CRefNo
                rsAdm.fields("Extra_1") = "" ' Must Blank
                rsAdm.fields("Extra_2") = Format(LossDate, "YYYY-MM-DD")
                rsAdm.fields("Extra_3") = IIf(toval(rs.fields("CashLossF")), "CASH CALL", tostr(rsAdm.fields("Extra_3")))
                rsAdm.fields("Remarks") = tostr(rs.fields("Remarks"))
                Select Case PType
                    Case "DI", "IR", "IC", "JP", "CF", "FO", "FP", "BA", "BB", "BO", "BC", "BP", "BD", "OP", "VT"
                        rsAdm.fields("Statement") = 0
                    Case "X1", "X2", "X3", "X4", "X5", "X6", "X7", "X8", "X9", "XX", "RP", "AP"
                        rsAdm.fields("Extra_4") = IIf(EventNo <> -1, EventName, "")
                        rsAdm.fields("Statement") = 0
                    Case Else
                        rsAdm.fields("Statement") = Statement
                End Select
                rsAdm.fields("Extra_5") = IIf(pExGratiaF, "Ex-Gratia", "")
                rsAdm.fields("Extra_6") = rs.fields("CodeExt")
                Dim BankAccount As String
                Dim BankName As String
                Dim Bank As String
                Dim BankBranch As String
                Dim AccountNo As String
                Get_BankAccount(PID, pCCY, Bank, BankBranch, AccountNo, BankAccount, BankName)
                rsAdm.fields("Bank") = Bank
                rsAdm.fields("BankBranch") = BankBranch
                rsAdm.fields("AccountNo") = AccountNo
                rsAdm.fields("BankAccount") = BankAccount
                rsAdm.fields("BankName") = BankName

                'Case "P"    ' Premium Reinstatement
                rsAdm.fields("Amount_1") = toval(rsAdm.fields("Amount_1")) + toval(rs.fields("Amount_1"))
                'Case "A"    ' Claim Amount
                rsAdm.fields("Amount_6") = toval(rsAdm.fields("Amount_6")) + toval(rs.fields("Amount_6"))
                'Case "E"    ' Deductible
                rsAdm.fields("Amount_7") = toval(rsAdm.fields("Amount_7")) + toval(rs.fields("Amount_7"))
                'Case "S"    ' Salvage
                rsAdm.fields("Amount_8") = toval(rsAdm.fields("Amount_8")) + toval(rs.fields("Amount_8"))
                'Case "L"    ' Cost
                rsAdm.fields("Amount_9") = toval(rsAdm.fields("Amount_9")) + toval(rs.fields("Amount_9"))
                'Case "R"    ' Subrogation
                rsAdm.fields("Amount_10") = toval(rsAdm.fields("Amount_10")) + toval(rs.fields("Amount_10"))
                'Case "V"    ' VAT
                rsAdm.fields("Amount_13") = toval(rsAdm.fields("Amount_13")) + toval(rs.fields("Amount_13"))
                'Case "T"    ' Tax Income
                rsAdm.fields("Amount_14") = toval(rsAdm.fields("Amount_14")) + toval(rs.fields("Amount_14"))
                'Case "F"    ' Fee
                rsAdm.fields("Amount_15") = toval(rsAdm.fields("Amount_15")) + toval(rs.fields("Amount_15"))
                'Case "D"    ' Duty
                rsAdm.fields("Amount_16") = toval(rsAdm.fields("Amount_16")) + toval(rs.fields("Amount_16"))
                'Case "I"    ' Claim Adjustment
                rsAdm.fields("Amount_17") = toval(rsAdm.fields("Amount_17")) + toval(rs.fields("Amount_17"))

                Dim Amount As Double

                rsAdm.fields("Amount_13") = RoundCCY(toval(rsAdm.fields("Amount_13")), pCCY, 1)
                rsAdm.fields("Amount_14") = RoundCCY(toval(rsAdm.fields("Amount_14")), pCCY, 1)

                Amount = toval(rsAdm.fields("Amount_1")) + toval(rsAdm.fields("Amount_4")) + toval(rsAdm.fields("Amount_5")) + toval(rsAdm.fields("Amount_6")) + toval(rsAdm.fields("Amount_7")) + toval(rsAdm.fields("Amount_8")) + toval(rsAdm.fields("Amount_9")) + toval(rsAdm.fields("Amount_10")) + toval(rsAdm.fields("Amount_15")) + toval(rsAdm.fields("Amount_16")) + toval(rsAdm.fields("Amount_17"))
                rsAdm.fields("Amount_11") = 0
                rsAdm.fields("Amount_12") = 0
                If PType = "RP" Then    ' Premium Reinstatement
                    rsAdm.fields("Amount_11") = -(Amount - RoundCCY(Amount, pCCY, RValue))
                Else
                    rsAdm.fields("Amount_12") = -(Amount - RoundCCY(Amount, pCCY, RValue))
                End If
                Amount = RoundCCY(Amount, pCCY, RValue) + toval(rsAdm.fields("Amount_13")) + toval(rsAdm.fields("Amount_14"))

                rsAdm.fields("Amount") = Amount
                If (RoundCCY(toval(rsAdm.fields("Amount")), pCCY, RValue) <> RoundCCY(toval(rsAdm.fields("Amount_11")) + toval(rsAdm.fields("Amount_12")) + toval(rsAdm.fields("Amount_13")) + toval(rsAdm.fields("Amount_14")) + toval(rsAdm.fields("Amount_18")), pCCY, RValue)) Or (toval(rsAdm.fields("Amount_14")) <> 0) Then
                    rsAdm.fields("WriteF") = 0
                Else
                    rsAdm.fields("WriteF") = 1
                End If

                rsAdm.fields("LUserID") = db_user
                rsAdm.fields("LDate") = Today.Date
                rsAdm.fields("LTime") = Time()
                If Not rsAdm.Update Then GoTo errmsg

                If LockedKey <> "" Then
                    If Not db.ReleaseLockedObject(LockedKey) Then GoTo errmsg
                End If

                If Not CashCallOnPartialPaymentF Then
                    If rsAdm.fields("Extra_3") = "CASH CALL" Then
                        If Not db.Execute("Update ClaAss Set AdmNo=" & AdmNo & ", Posted=1, Date='" & Format(ADate, "MM/DD/YYYY") & "', BillDate='" & Format(pBillDate, "MM/DD/YYYY") & "' from ClaAss Where AdmNo=-1 and CNO=" & CNO & " and ID='" & PID & "' and TOC='" & PCode & "' and Type='" & PType & "' and Currency='" & pCCY & "' and Refno='" & PRefNo & "' and cashlossF=1") Then GoTo errmsg
                    Else
                        If Not db.Execute("Update ClaAss Set AdmNo=" & AdmNo & ", Posted=1, Date='" & Format(ADate, "MM/DD/YYYY") & "', BillDate='" & Format(pBillDate, "MM/DD/YYYY") & "' from ClaAss Where AdmNo=-1 and CNO=" & CNO & " and ID='" & PID & "' and TOC='" & PCode & "' and Type='" & PType & "' and Currency='" & pCCY & "' and Refno='" & PRefNo & "' and cashlossF=0") Then GoTo errmsg
                    End If
                Else
                    If Not db.Execute("Update ClaAss Set AdmNo=" & AdmNo & ", Posted=1, Date='" & Format(ADate, "MM/DD/YYYY") & "', BillDate='" & Format(pBillDate, "MM/DD/YYYY") & "' from ClaAss Where AdmNo=-1 and CNO=" & CNO & " and ID='" & PID & "' and TOC='" & PCode & "' and Type='" & PType & "' and Currency='" & pCCY & "' and Refno='" & PRefNo & "'") Then GoTo errmsg
                End If
                rs.MoveNext()
            Loop
            rsAdm.CloseRemoteSet()
        End If
        rs.CloseRemoteSet()

        ' Adjust PNOMINAL_TAX
        rs = db.OpenRemoteSet("Select * from Admlink Where Exists (Select AdmNo from ClaAss Where Type in ('DI','OP') and Code in ('A','E','L') and ClaAss.AdmNo=Admlink.AdmNo and ClaAss.CNO=" & CNO & ")")
        Do While Not rs.Eof
            pCCY = rs.fields("Currency")
            Dim rsT As RemoteSet
            Dim SQL As String
            If rs.fields("Type") = "DI" Then
                SQL = " Select sum(PNOMINAL_VAT) as PNOMINAL_VAT, sum(PNOMINAL_TAX) as PNOMINAL_TAX, Cast(Max(Cast(TaxF as Int)) as Bit) as TaxF"
                SQL = SQL & " FROM "
                SQL = SQL & " ("
                SQL = SQL & " Select C1.CNO, C1.Payment as ID, C1.Currency, C2.RefNo, "
                SQL = SQL & " (Case When C2.CAmount=0 then -1 else 1 end)*(CASE WHEN C1.VAR<=C1.DECLARED THEN (C1.VATAMOUNT) ELSE (C1.DECLARED/C1.VAR) * (C1.VATAMOUNT) END)*(100-coalesce(Coinsurance.MShare,0))/100 as PNOMINAL_VAT, "
                SQL = SQL & " (Case When C2.CAmount=0 then -1 else 1 end)*(CASE WHEN C1.VAR<=C1.DECLARED THEN (C1.TAXAMOUNT) ELSE (C1.DECLARED/C1.VAR) * (C1.TAXAMOUNT) END)*(100-coalesce(Coinsurance.MShare,0))/100 as PNOMINAL_TAX, "
                SQL = SQL & " Case When C1.TaxAmount<>0 Then Cast(1 as Bit) Else Cast(0 as Bit) End as TaxF"
                SQL = SQL & " from Admlink A"
                SQL = SQL & " Inner Join ClaAss C2 on (C2.AdmNo=A.AdmNo and C2.Type='DI' and C2.Code='A')"
                SQL = SQL & " Inner Join Claim C3 on (C3.CNO=C2.CNO)"
                SQL = SQL & " Inner Join CLLOSS C1 on (C1.CNO=(Case When C2.CAmount<>0 Then C3.CNO else C3.pCNO end) and C1.Currency=C2.Currency and C1.Payment=C2.ID)"
                SQL = SQL & " Inner Join NOCTAB ON (NOCTAB.NOC=C1.NOC and NOCTAB.CodeExt=C2.CodeExt)"
                SQL = SQL & " Inner Join Claim C4 on (C4.CNO=C1.CNO)"
                SQL = SQL & " Inner Join Acceptance on (Acceptance.ANO=C3.ANO)"
                SQL = SQL & " Outer Apply (Select sum(Share) as MShare from Coinsurance WHere Coinsurance.CCollectionF=0 and Coinsurance.CNO=Acceptance.CNO) Coinsurance"
                SQL = SQL & " Where C1.Status='P' and C2.RefNo=(Case When C1.RefNO<>'' Then C1.RefNo else C4.RefNo end)"
                SQL = SQL & " and A.AdmNo=" & rs.fields("AdmNo")
                SQL = SQL & " "
                SQL = SQL & " Union All"
                SQL = SQL & " "
                SQL = SQL & " Select C1.CNO, C1.ID, C1.Currency, C2.RefNo, "
                SQL = SQL & " -(Case When C2.CAmount=0 then -1 else 1 end)*C1.TaxAmount as PNOMINAL_VAT, "
                SQL = SQL & " -(Case When C2.CAmount=0 then -1 else 1 end)*C1.TaxAmount as PNOMINAL_TAX, "
                SQL = SQL & " Case When C1.TaxAmount<>0 Then Cast(1 as Bit) Else Cast(0 as Bit) End as TaxF"
                SQL = SQL & " from CLDED C1, ClaAss C2, Claim C3, Claim C4, Admlink A"
                SQL = SQL & " Where C2.Type='DI' and C2.Code='E' and C2.CodeExt='' and C2.AdmNo=A.AdmNO "
                SQL = SQL & " and C3.CNO=C2.CNO and C1.CNO=(Case When C2.CAmount<>0 Then C3.CNO else C3.pCNO end) and C4.CNO=C1.CNO"
                SQL = SQL & " and C1.Currency=C2.Currency and C1.ID=C2.ID "
                SQL = SQL & " and C2.RefNo=(Case When C1.RefNO<>'' Then C1.RefNo else C4.RefNo end)"
                SQL = SQL & " and A.AdmNo=" & rs.fields("AdmNo")
                SQL = SQL & " ) C"
            Else    ' OP
                SQL = " Select sum(PNOMINAL_VAT) as PNOMINAL_VAT, sum(PNOMINAL_TAX) as PNOMINAL_TAX, Cast(Max(Cast(TaxF as Int)) as Bit) as TaxF"
                SQL = SQL & " FROM"
                SQL = SQL & " ("
                SQL = SQL & " Select Distinct C1.CNO, C1.ID, C1.Currency, C2.RefNo, "
                SQL = SQL & " (Case when C2.CAmount=0 then -1 else 1 end)*(Case When C1.VAT<>0 Then 1 else 0 end)*(Case When C3.ISType='L' and C1.ContributionF=1 and C1.CCOLLECTIONF=0 Then (100-R.MShare)/100 Else 1 End)*C1.GrossAmount as PNOMINAL_VAT, "
                SQL = SQL & " (Case when C2.CAmount=0 then -1 else 1 end)*(Case When (C1.TAX<>0) or (coalesce(T.TaxRate,0)<>0 and P.TaxF=1) Then 1 else 0 end)*(Case When C3.ISType='L' and C1.ContributionF=1 and C1.CCOLLECTIONF=0 Then (100-R.MShare)/100 Else 1 End)*C1.GrossAmount as PNOMINAL_TAX, "
                SQL = SQL & " Cast(1 as Bit) as TaxF"
                SQL = SQL & " from CLCOST C1, ClaAss C2, Claim C3, Claim C4, RArrHeader R, ADMLINK A Inner Join Profile P on (P.ID=A.ID) Left Join TaxType T on (T.TaxType=Case When A.Subject='OTHERS' or A.TaxType<>'' Then A.TaxType Else P.TaxType End)"
                SQL = SQL & " Where C2.Type='OP' and C2.Code='L' and C2.AdmNo=A.AdmNO "
                SQL = SQL & " and C3.CNO=C2.CNO and C1.CNO=(Case When C2.CAmount<>0 Then C3.CNO else C3.pCNO end) and C4.CNO=C1.CNO and R.ANO=C4.ANO"
                SQL = SQL & " and C1.Currency=C2.Currency and C1.ID=C2.ID "
                SQL = SQL & " and C2.RefNo=(Case When C1.RefNO<>'' Then C1.RefNo else C4.RefNo end)"
                SQL = SQL & " and A.AdmNo=" & rs.fields("AdmNo")
                'SQL = SQL & " "
                'SQL = SQL & " Union All"
                'SQL = SQL & " "
                'SQL = SQL & " Select Distinct C1.CNO, C1.Payment as ID, C1.Currency, C2.RefNo,"
                'SQL = SQL & " -(Case When C2.CAmount=0 then -1 else 1 end)*C1.VATAmount as PNOMINAL_VAT, "
                'SQL = SQL & " -(Case When C2.CAmount=0 then -1 else 1 end)*C1.TaxAmount as PNOMINAL_TAX				"
                'SQL = SQL & " from CLFD C1, ClaAss C2, Claim C3, Claim C4, ADMLINK A"
                'SQL = SQL & " Where C2.Type='OP' and C2.Code='F' and C2.AdmNo=A.AdmNo"
                'SQL = SQL & " and C3.CNO=C2.CNO and C1.CNO=(Case When C2.CAmount<>0 Then C3.CNO else C3.pCNO end) and C4.CNO=C1.CNO "
                'SQL = SQL & " and C1.Currency=C2.Currency and C1.Payment=C2.ID "
                'SQL = SQL & " and C2.RefNo=C4.RefNo"
                'SQL = SQL & " and A.AdmNo=" & rs.fields("AdmNo")
                'SQL = SQL & " "
                'SQL = SQL & " Union All"
                'SQL = SQL & " "
                'SQL = SQL & " Select Distinct C1.CNO, C1.ID as ID, C1.Currency, C2.RefNo,"
                'SQL = SQL & " -(Case When C2.CAmount=0 then -1 else 1 end)*C1.GrossAmount as PNOMINAL_VAT, "
                'SQL = SQL & " -(Case When C2.CAmount=0 then -1 else 1 end)*C1.GrossAmount as PNOMINAL_TAX	"
                'SQL = SQL & " from CLSAL C1, ClaAss C2, Claim C3, Claim C4, ADMLINK A"
                'SQL = SQL & " Where C2.Type='OP' and C2.Code='S' and C2.AdmNo=A.AdmNo"
                'SQL = SQL & " and C3.CNO=C2.CNO and C1.CNO=(Case When C2.CAmount<>0 Then C3.CNO else C3.pCNO end) and C4.CNO=C1.CNO "
                'SQL = SQL & " and C1.Currency=C2.Currency and C1.ID=C2.ID "
                'SQL = SQL & " and C2.RefNo=C1.CSType"
                'SQL = SQL & " and A.AdmNo=" & rs.fields("AdmNo")
                SQL = SQL & " ) C"
            End If
            rsT = db.OpenRemoteSet(SQL)
            If Not rsT.Eof Then
                rs.Edit()
                rs.fields("PNOMINAL_VAT") = -toval(rsT.fields("PNOMINAL_VAT"))
                rs.fields("PNOMINAL_TAX") = -toval(rsT.fields("PNOMINAL_TAX"))

                If TaxTableF AndAlso toval(rsT.fields("TaxF")) Then
                    Dim pTaxTableF As Boolean = TaxTableF
                    Dim TaxType As String = ""
                    Dim PNominal_Tax = toval(rs.fields("PNOMINAL_TAX"))
                    Dim TAX As Double = 0

                    If Not Calculate_Claim_VAT_TAX(pTaxTableF, rs.fields("ID"), rs.fields("Type"), pADate, pCCY, 0, PNominal_Tax, 0, TAX, TaxType, 0, 0, 0, 0) Then
                        StrMsg = "Failed in Calculating Vat/Tax !"
                        GoTo errmsg
                    End If

                    rs.fields("TaxTableF") = pTaxTableF
                    If pTaxTableF Then
                        rs.fields("Amount_18") = TAX - toval(rs.fields("Amount_14"))
                        rs.fields("Amount") = toval(rs.fields("Amount")) + toval(rs.fields("Amount_18"))
                        If (RoundCCY(toval(rs.fields("Amount")), pCCY, RValue) <> RoundCCY(toval(rs.fields("Amount_11")) + toval(rs.fields("Amount_12")) + toval(rs.fields("Amount_13")) + toval(rs.fields("Amount_14")) + toval(rs.fields("Amount_17")) + toval(rs.fields("Amount_18")), pCCY, RValue)) Or (PNominal_Tax <> 0) Or (TAX <> 0) Then
                            If Not Update_Tax_Table(rs.fields("ID"), pADate, pCCY, PNominal_Tax, TAX) Then
                                StrMsg = "Failed Inserting into Tax Table !"
                                GoTo errmsg
                            End If
                            rs.fields("WriteF") = 0
                        Else
                            rs.fields("WriteF") = 1
                            rs.fields("TaxTableF") = False
                            rs.fields("Amount") = 0
                            rs.fields("Amount_11") = 0
                            rs.fields("Amount_12") = 0
                            rs.fields("Amount_13") = 0
                            rs.fields("Amount_14") = 0
                            rs.fields("Amount_17") = 0
                            rs.fields("Amount_18") = 0
                        End If
                    End If
                End If

                If Not rs.Update Then GoTo errmsg
            End If
            rs.MoveNext()
        Loop
        rs.CloseRemoteSet()
        Claim_To_Adm = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Claim_To_Adm = False
    End Function

    Private Function Temporary_Approval(ByVal CNO As Long, ByVal ADate As Date) As Boolean
        Dim rsClaim As RemoteSet
        Dim rsCA As RemoteSet
        Dim rsIC As RemoteSet
        Dim rsRAr As RemoteSet
        Dim rsCAr As RemoteSet
        Dim rsFac As RemoteSet
        Dim rsCArDet As RemoteSet
        Dim rs As RemoteSet
        Dim ClaimNo As String
        Dim TOC As String
        Dim ANO As Long
        Dim PCNO As Long
        Dim RCNO As Long
        Dim ClaimType As String
        Dim LossDate As Date
        Dim ISType As String
        Dim PID As String
        Dim BillDate As Date
        Dim Branch As String
        Dim Claim As Double
        Dim Deductible As Double
        Dim Salvage As Double
        Dim Subrogation As Double
        Dim Cost As Double
        Dim RCost As Double
        Dim Share As Double
        Dim Limit As Double
        Dim Excess As Double
        Dim RefNo As String
        Dim CoverCNO As Long
        Dim PType As String
        Dim PPremium As Double
        Dim PClaim As Double
        Dim PDeductible As Double
        Dim PSalvage As Double
        Dim PSubrogation As Double
        Dim PCost As Double
        Dim pCCY As String = ""
        Dim Rate As Double
        Dim CashLossF As Boolean
        Dim MShare As Double
        Dim BizMapID As String
        Dim MSCode As String
        Dim Source As String
        Dim AName As String
        Dim EventNo As Long
        Dim Loss As Double
        Dim ERCost As Double        
        Dim EDeductible As Double
        Dim RSubrogation As Double
        Dim ERSubrogation As Double
        Dim RSalvage As Double
        Dim ERSalvage As Double
        Dim DocNo As String
        Dim CCYTO As String
        Dim RRate As Double
        Dim XOLReinstatementByAmountF As Boolean
        Dim CalculationRoundingF As Boolean
        Dim CashCallOnEstimateF As Boolean
        Dim CashCallOnGrossF As Boolean
        Dim RCode As String
        Dim TOR As String
        Dim OCNO As Long

        On Error GoTo errmsg

        rs = db.OpenRemoteSet("Select XOLReinstatementByAmountF, CalculationRoundingF from SysTab")
        XOLReinstatementByAmountF = toval(rs.fields("XOLReinstatementByAmountF"))
        CalculationRoundingF = toval(rs.fields("CalculationRoundingF"))

        rsClaim = db.OpenQueryDef("QClaim_1", adOpenForwardonly, CNO)
        ClaimNo = tostr(rsClaim.fields("ClaimNo"))
        TOC = tostr(rsClaim.fields("TOC"))
        ANO = toval(rsClaim.fields("ANO"))
        PCNO = toval(rsClaim.fields("PCNO"))
        ClaimType = tostr(rsClaim.fields("CType"))
        LossDate = todate(rsClaim.fields("LossDate"))
        Branch = tostr(rsClaim.fields("Branch"))
        ISType = tostr(rsClaim.fields("ISType"))
        RCNO = toval(rsClaim.fields("RCNO"))
        CoverCNO = toval(rsClaim.fields("CoverCNO"))
        AName = tostr(rsClaim.fields("AName"))
        BizMapID = tostr(rsClaim.fields("BizMapID"))
        MSCode = tostr(rsClaim.fields("MSCode"))
        Source = tostr(rsClaim.fields("Source"))
        EventNo = toval(rsClaim.fields("EventNo"))
        OCNO = toval(rsClaim.fields("OCNO"))
        CashCallOnEstimateF = toval(rsClaim.fields("CashCallOnEstimateF"))
        CashCallOnGrossF = toval(rsClaim.fields("CashCallOnGrossF"))
        MShare = 0
        DocNo = ClaimNo
        PType = "DI"

        If toval(rsClaim.fields("CSeqNo")) <> 0 Then
            DocNo = DocNo + "-" + tostr(rsClaim.fields("CSeqNo"))
        End If

        If Not (rsClaim.fields("CStatus") = "P") Then
            StrMsg = "Please Check Claim Status !"
            GoTo errmsg
        End If

        If Not db.Execute("Delete from ClaAss Where CNO=" & CNO) Then GoTo errmsg

        ' Create Temporary Table
        If Not db.Execute("Select * into #ClaAss from ClaAss Where 1<>1;Create unique index I_#ClaAss on #ClaAss(ACNO)") Then GoTo errmsg

        rsCA = db.OpenRemoteSet("Select * from #ClaAss Where 1<>1")
        rsIC = db.OpenQueryDef("QCCALC_1", adOpenForwardonly, CNO)
        rsRAr = db.OpenQueryDef("QRArrHeader", adOpenForwardonly, ANO)
        rsFac = db.OpenQueryDef("QClaimFacOut", adOpenForwardonly, CNO)
        rsCAr = db.OpenQueryDef("QCArrHeader", adOpenForwardonly, CNO)
        rsCArDet = db.OpenQueryDef("QCArrDetail", adOpenForwardonly, CNO)
        Do While Not rsIC.Eof And ClaimType <> "C"
            Rate = toval(rsIC.fields("Rate"))
            Share = toval(rsIC.fields("Share"))
            Limit = toval(rsIC.fields("Limit"))
            Excess = toval(rsIC.fields("Excess"))
            RCode = tostr(rsIC.fields("RCode"))
            TOR = tostr(rsIC.fields("TOR"))

            If Excess = 0 Then
                Loss = -toval(rsIC.fields("Loss")) * Share / 100
                Claim = -toval(rsIC.fields("Claim")) * Share / 100
                Deductible = toval(rsIC.fields("Deductible")) * Share / 100
                EDeductible = toval(rsIC.fields("EDeductible")) * Share / 100
                Salvage = toval(rsIC.fields("Salvage")) * Share / 100
                Subrogation = toval(rsIC.fields("Subrogation")) * Share / 100
                Cost = -toval(rsIC.fields("Cost")) * Share / 100

                RCost = -toval(rsIC.fields("Cost")) * Share / 100 - toval(rsIC.fields("RCost"))
                ERCost = -toval(rsIC.fields("ECost")) * Share / 100 - toval(rsIC.fields("ERCost"))

                RSubrogation = toval(rsIC.fields("Subrogation")) * Share / 100 + toval(rsIC.fields("RSubrogation"))
                ERSubrogation = toval(rsIC.fields("ESubrogation")) * Share / 100 + toval(rsIC.fields("ERSubrogation"))

                RSalvage = toval(rsIC.fields("Salvage")) * Share / 100 + toval(rsIC.fields("RSalvage"))
                ERSalvage = toval(rsIC.fields("ESalvage")) * Share / 100 + toval(rsIC.fields("ERSalvage"))

            Else
                Loss = (toval(rsIC.fields("Loss")) - toval(rsIC.fields("EDeductible")) - toval(rsIC.fields("ESalvage")) - toval(rsIC.fields("ESubrogation")) + toval(rsIC.fields("ECost")))
                Claim = (toval(rsIC.fields("Claim")) - toval(rsIC.fields("Deductible")) - toval(rsIC.fields("Salvage")) - toval(rsIC.fields("Subrogation")) + toval(rsIC.fields("Cost")))

                If Loss > Excess Then
                    Loss = Loss - Excess
                    If Loss > Limit Then
                        Loss = Limit
                    End If
                Else
                    Loss = 0
                End If

                If Claim > Excess Then
                    Claim = Claim - Excess
                    If Claim > Limit Then
                        Claim = Limit
                    End If
                Else
                    Claim = 0
                End If

                Loss = -Loss * Share / 100
                Claim = -Claim * Share / 100
                Deductible = 0
                EDeductible = 0
                Salvage = 0
                Subrogation = 0
                Cost = 0

                RCost = -toval(rsIC.fields("Cost")) * Share / 100 - toval(rsIC.fields("RCost"))
                ERCost = -toval(rsIC.fields("ECost")) * Share / 100 - toval(rsIC.fields("ERCost"))

                RSubrogation = toval(rsIC.fields("Subrogation")) * Share / 100 + toval(rsIC.fields("RSubrogation"))
                ERSubrogation = toval(rsIC.fields("ESubrogation")) * Share / 100 + toval(rsIC.fields("ERSubrogation"))

                RSalvage = toval(rsIC.fields("Salvage")) * Share / 100 + toval(rsIC.fields("RSalvage"))
                ERSalvage = toval(rsIC.fields("ESalvage")) * Share / 100 + toval(rsIC.fields("ERSalvage"))
            End If

            ' Get Reinsurance Currency Mapping
            If pCCY <> tostr(rsIC.fields("Currency")) Then
                pCCY = tostr(rsIC.fields("Currency"))
                rs = db.OpenQueryDef("QClaim_Rate", adOpenForwardonly, CNO, pCCY)
                CCYTO = IIf(tostr(rs.fields("CCYTO")) <> "", tostr(rs.fields("CCYTO")), pCCY)
                RRate = IIf(toval(rs.fields("CRate")) <> 0 And CCYTO.ToUpper <> pCCY.ToUpper, toval(rs.fields("CRate")), 1)
            End If

            ' Insurance Source (Inward Insurance or Inward Co-Insurance or Inward Treaty)
            If (ISType = "R" Or ISType = "C" Or ISType = "T") Then
                If ISType = "T" Then
                    rs = db.OpenQueryDef("QISource", adOpenForwardonly, CoverCNO)
                    If InStr("X1X2X3X4X5X6X7", rs.fields("RType")) > 0 Then 'Excess Of Loss Treaty
                        PType = "IX"  ' Inward Treaty Excess Of Loss
                    Else
                        PType = "IT"  ' Inward Treaty
                    End If
                Else
                    PType = "I" & ISType ' IR or IC
                End If
            End If

            ' Coinsurance Follower
            If (ISType = "L") Then
                MShare = 0
                rs = db.OpenQueryDef("QCoinsurance", adOpenForwardonly, CoverCNO)
                Do While Not rs.Eof
                    BillDate = ADate
                    RefNo = tostr(rs.fields("DocNo"))
                    PID = tostr(rs.fields("ID"))
                    If Not rs.fields("CCollectionF") Then
                        MShare = MShare + toval(rs.fields("Share"))
