                            rsAA.fields("AdmNo") = -1
                            rsAA.fields("Prorata") = toval(rsRA.fields("Prorata"))
                            rsAA.fields("PProrata") = FacProrata
                            rsAA.fields("AdjustableF") = AdjustableF
                            rsAA.fields("AdjMethod") = AdjMethod
                            rsAA.fields("RCode") = RCode
                            rsAA.fields("AType") = tostr(rsRA.fields("AType"))
                            rsAA.fields("NoRefundF") = (pNoRefundF Or FNoRefundF)
                            rsAA.fields("CommPoolF") = False
                            If rsAA.fields("AType") = "N" And rsAA.fields("Prorata") <> 0 Then
                                rsAA.fields("CAmount") = toval(rsAA.fields("CAmount")) * toval(rsAA.fields("Prorata"))
                                rsAA.fields("Amount_OC") = toval(rsAA.fields("Amount_OC")) * toval(rsAA.fields("Prorata"))
                                rsAA.fields("Amount") = toval(rsAA.fields("Amount")) * toval(rsAA.fields("Prorata"))
                                rsAA.fields("Prorata") = 0
                            End If
                            If Not rsAA.UpdateRow Then GoTo errmsg
                        End If


                        ' End Of Facultative Joint Placement

                        ' Apply Payor Discount for Type 'CF'
                        If FType = "CF" And (ISType = "I" Or ISType = "L") Then

                            If Not toval(rsRA.fields("NotApplyDiscountCFF")) Then
                                Discount = (Premium - AcqCost - PremiAdj) * (1 - (1 - GDiscount / 100) * (1 - NDiscount / 100) * (1 - PDiscount / 100) * (1 + SLoading / 100))
                                ' Discount Payor
                                If Discount <> 0 Then
                                    rsAA.AddNew()
                                    rsAA.fields("BizMapID") = BizMapID
                                    rsAA.fields("MSCode") = MSCode
                                    rsAA.fields("Source") = Source
                                    rsAA.fields("ANO") = ANO
                                    rsAA.fields("SDate") = FSDate
                                    rsAA.fields("EDate") = FEDate
                                    rsAA.fields("Type") = FType
                                    rsAA.fields("Code") = "O"
                                    rsAA.fields("ID") = tostr(rsRA.fields("ID"))
                                    rsAA.fields("REFNO") = tostr(rsRA.fields("SLIPNO"))
                                    rsAA.fields("POLICYNO") = PolicyNo
                                    rsAA.fields("DocNo") = DocNo
                                    rsAA.fields("DATE") = ADate
                                    rsAA.fields("BILLDATE") = BillDate
                                    rsAA.fields("TOC") = TOC
                                    rsAA.fields("Remarks") = AName
                                    rsAA.fields("CAmount") = Discount * FacProrata
                                    rsAA.fields("Amount_OC") = toval(rsAA.fields("CAmount")) * (1 + RProrata)
                                    rsAA.fields("Amount") = toval(rsAA.fields("CAmount")) * (1 + RProrata)
                                    rsAA.fields("Currency_OC") = CCode
                                    rsAA.fields("Currency") = CCode
                                    rsAA.fields("Rate") = 1
                                    rsAA.fields("AdmNo") = -1
                                    rsAA.fields("Prorata") = toval(rsRA.fields("Prorata"))
                                    rsAA.fields("PProrata") = FacProrata
                                    rsAA.fields("AdjustableF") = AdjustableF
                                    rsAA.fields("AdjMethod") = AdjMethod
                                    rsAA.fields("RCode") = RCode
                                    rsAA.fields("AType") = tostr(rsRA.fields("AType"))
                                    rsAA.fields("NoRefundF") = (pNoRefundF Or FNoRefundF)
                                    rsAA.fields("CommPoolF") = False
                                    If rsAA.fields("AType") = "N" And rsAA.fields("Prorata") <> 0 Then
                                        rsAA.fields("CAmount") = toval(rsAA.fields("CAmount")) * toval(rsAA.fields("Prorata"))
                                        rsAA.fields("Amount_OC") = toval(rsAA.fields("Amount_OC")) * toval(rsAA.fields("Prorata"))
                                        rsAA.fields("Amount") = toval(rsAA.fields("Amount")) * toval(rsAA.fields("Prorata"))
                                        rsAA.fields("Prorata") = 0
                                    End If
                                    If Not rsAA.UpdateRow Then GoTo errmsg
                                End If
                            End If

                            Ujroh = toval(rsIC.fields("Share")) / 100 * ((Gross * QTY) - TotalUpFee) / PProrata * toval(rsRA.fields("Share")) / 100 * toval(rsRA.fields("RShare")) / 100 * (UJrohPCT - toval(rsRA.fields("UJROHCEDANT"))) / 100
                            If Ujroh <> 0 Then
                                rsAA.AddNew()
                                rsAA.fields("BizMapID") = BizMapID
                                rsAA.fields("MSCode") = MSCode
                                rsAA.fields("Source") = Source
                                rsAA.fields("SDate") = todate(rsIC.fields("SDate"))
                                rsAA.fields("EDate") = todate(rsIC.fields("EDate"))
                                rsAA.fields("ANO") = ANO
                                rsAA.fields("Type") = PType
                                rsAA.fields("Code") = "U"
                                rsAA.fields("ID") = PID
                                rsAA.fields("REFNO") = RefNo
                                rsAA.fields("POLICYNO") = PolicyNo
                                rsAA.fields("DocNo") = DocNo
                                rsAA.fields("DATE") = ADate
                                rsAA.fields("BILLDATE") = BillDate
                                rsAA.fields("TOC") = TOC
                                rsAA.fields("Remarks") = AName
                                rsAA.fields("CAmount") = -Ujroh
                                rsAA.fields("Amount_OC") = toval(rsAA.fields("CAmount")) * (1 + RProrata)
                                rsAA.fields("Amount") = toval(rsAA.fields("CAmount")) * (1 + RProrata)
                                rsAA.fields("Currency_OC") = CCode
                                rsAA.fields("Currency") = CCode
                                rsAA.fields("Rate") = 1
                                rsAA.fields("AdmNo") = -1
                                rsAA.fields("PProrata") = PProrata
                                rsAA.fields("AdjustableF") = AdjustableF
                                rsAA.fields("AdjMethod") = AdjMethod
                                rsAA.fields("RCode") = RCode
                                rsAA.fields("AType") = AType
                                rsAA.fields("NoRefundF") = (pNoRefundF Or FNoRefundF)
                                rsAA.fields("CommPoolF") = False
                                If Not rsAA.UpdateRow Then GoTo errmsg

                                rsAA.AddNew()
                                rsAA.fields("BizMapID") = BizMapID
                                rsAA.fields("MSCode") = MSCode
                                rsAA.fields("Source") = Source
                                rsAA.fields("SDate") = todate(rsIC.fields("SDate"))
                                rsAA.fields("EDate") = todate(rsIC.fields("EDate"))
                                rsAA.fields("ANO") = ANO
                                rsAA.fields("Type") = PType
                                rsAA.fields("Code") = "P"
                                rsAA.fields("ID") = PID
                                rsAA.fields("REFNO") = RefNo
                                rsAA.fields("POLICYNO") = PolicyNo
                                rsAA.fields("DocNo") = DocNo
                                rsAA.fields("DATE") = ADate
                                rsAA.fields("BILLDATE") = BillDate
                                rsAA.fields("TOC") = TOC
                                rsAA.fields("Remarks") = AName
                                rsAA.fields("CAmount") = Ujroh
                                rsAA.fields("Amount_OC") = toval(rsAA.fields("CAmount")) * (1 + RProrata)
                                rsAA.fields("Amount") = toval(rsAA.fields("CAmount")) * (1 + RProrata)
                                rsAA.fields("Currency_OC") = CCode
                                rsAA.fields("Currency") = CCode
                                rsAA.fields("Rate") = 1
                                rsAA.fields("AdmNo") = -1
                                rsAA.fields("PProrata") = PProrata
                                rsAA.fields("AdjustableF") = AdjustableF
                                rsAA.fields("AdjMethod") = AdjMethod
                                rsAA.fields("RCode") = RCode
                                rsAA.fields("AType") = AType
                                rsAA.fields("NoRefundF") = (pNoRefundF Or FNoRefundF)
                                rsAA.fields("CommPoolF") = False
                                If Not rsAA.UpdateRow Then GoTo errmsg
                            End If

                        End If

                    End If
                    rsRA.MoveNext()
                Loop
                rsRA.CloseRemoteSet()

            End If
            ' End Of Reinsurance Processing (Treaty and Facultative)
            rsIC.MoveNext()
        Loop

        ' Finally
        If Not rsAA.Eof Then
            If Not rsAA.Update Then GoTo errmsg
        End If

        ' Get Current LANO
        LANO = toval(rsAcc.fields("LANO"))

        If AType = "E" Or AType = "C" Or AType = "A" Then
            If (NoRefundF <> 5 OrElse (AType = "C" AndAlso FeeDuty_LessThan_Premium_Refund(ANO))) Then
                If Not Make_Balance_AccAss(LANO, pANO, ANO, AType, RefNo, PSDate, ADate, BillDate, PDate, PPDate, CProrata, DocNo, PPeriod, NoRefundF, RefundType, EMethod, ISType, SplitDNCNF) Then GoTo errmsg
            End If
        End If

        ' Collateral Cash Deposit
        If (ISType = "I" Or ISType = "L") Then
            rs = db.OpenQueryDef("QACCCOLLATERALCASHDEPOSIT", adOpenForwardonly, ANO)
            Do While Not rs.Eof
                If toval(rs.fields("Nominal")) <> 0 Then
                    rsAA.AddNew()
                    rsAA.fields("BizMapID") = BizMapID
                    rsAA.fields("MSCode") = MSCode
                    rsAA.fields("Source") = Source
                    rsAA.fields("SDate") = PSDate
                    rsAA.fields("EDate") = PEDate
                    rsAA.fields("ANO") = ANO
                    rsAA.fields("ID") = rs.fields("ID")
                    rsAA.fields("Type") = "DR"  ' Deposit Receipt
                    rsAA.fields("Code") = "J"
                    rsAA.fields("CodeExt") = ""
                    rsAA.fields("REFNO") = RefNo
                    rsAA.fields("POLICYNO") = PolicyNo
                    rsAA.fields("DocNo") = DocNo
                    rsAA.fields("DATE") = ADate
                    rsAA.fields("BILLDATE") = BillDate
                    rsAA.fields("TOC") = TOC
                    rsAA.fields("Remarks") = AName
                    rsAA.fields("CAmount") = toval(rs.fields("Nominal"))
                    rsAA.fields("Amount_OC") = toval(rsAA.fields("CAmount"))
                    rsAA.fields("Amount") = toval(rsAA.fields("CAmount"))
                    rsAA.fields("Currency_OC") = tostr(rs.fields("Currency"))
                    rsAA.fields("Currency") = tostr(rs.fields("Currency"))
                    rsAA.fields("Rate") = 1
                    rsAA.fields("AdmNo") = -1
                    rsAA.fields("PProrata") = 1
                    rsAA.fields("AdjustableF") = 0
                    rsAA.fields("AdjMethod") = ""
                    rsAA.fields("DepositF") = True
                    If Not rsAA.Update Then GoTo errmsg


                    rsAA.AddNew()
                    rsAA.fields("BizMapID") = BizMapID
                    rsAA.fields("MSCode") = MSCode
                    rsAA.fields("Source") = Source
                    rsAA.fields("SDate") = PSDate
                    rsAA.fields("EDate") = PEDate
                    rsAA.fields("ANO") = ANO
                    rsAA.fields("ID") = rs.fields("ID")
                    rsAA.fields("Type") = "DP"  ' Deposit Payment
                    rsAA.fields("Code") = "J"
                    rsAA.fields("CodeExt") = ""
                    rsAA.fields("REFNO") = RefNo
                    rsAA.fields("POLICYNO") = PolicyNo
                    rsAA.fields("DocNo") = DocNo
                    rsAA.fields("DATE") = ADate
                    rsAA.fields("BILLDATE") = DateAdd(DateInterval.Day, 1, PEDate)  ' Last Policy Period + 1
                    rsAA.fields("TOC") = TOC
                    rsAA.fields("Remarks") = AName
                    rsAA.fields("CAmount") = -toval(rs.fields("Nominal"))
                    rsAA.fields("Amount_OC") = toval(rsAA.fields("CAmount"))
                    rsAA.fields("Amount") = toval(rsAA.fields("CAmount"))
                    rsAA.fields("Currency_OC") = tostr(rs.fields("Currency"))
                    rsAA.fields("Currency") = tostr(rs.fields("Currency"))
                    rsAA.fields("Rate") = 1
                    rsAA.fields("AdmNo") = -1
                    rsAA.fields("PProrata") = 1
                    rsAA.fields("AdjustableF") = 0
                    rsAA.fields("AdjMethod") = ""
                    rsAA.fields("DepositF") = True
                    If Not rsAA.Update Then GoTo errmsg
                End If
                rs.MoveNext()
            Loop
        End If

        ' Fee & Duty
        If (ISType = "I" Or ISType = "L" Or ISType = "C") Then
            Dim Amount As Double
            If (NoRefundF <> 5 OrElse (AType = "C" AndAlso FeeDuty_LessThan_Premium_Refund(ANO))) Then

                If LANO <> -1 Then
                    If OpenFlag Then
                        ' Alternate Payor
                        rs = db.OpenQueryDef("QAPayor", adOpenForwardonly, ANO)
                        If rs.Eof Then
                            rs = db.OpenQueryDef("QPayor", adOpenForwardonly, LANO)
                        End If
                    Else
                        rs = db.OpenQueryDef("QPayor", adOpenForwardonly, LANO)
                    End If
                Else
                    rs = db.OpenQueryDef("QPayor", adOpenForwardonly, ANO)
                End If

                PID = tostr(rs.fields("ID"))
                rs = db.OpenQueryDef("QFeeDuty", adOpenForwardonly, ANO)
                Do While Not rs.Eof
                    Amount = 0
                    If toval(rs.fields("Amount")) <> 0 Then
                        If Left(tostr(rs.fields("FDType")), 1) = "O" Then
                            Amount = -toval(rs.fields("Amount"))
                        Else
                            Amount = toval(rs.fields("Amount"))
                        End If
                    ElseIf toval(rs.fields("AmountPCT")) <> 0 Or toval(rs.fields("AMOUNTPCTBASED")) = 2 Then
                        If Left(tostr(rs.fields("FDType")), 1) = "O" Then
                            Amount = -Get_Fee_Amount_By_Percentage(ANO, rs.fields("Currency"), Left(tostr(rs.fields("FDType")), 1), toval(rs.fields("AmountPCT")), toval(rs.fields("AMOUNTPCTBASED")), toval(rs.fields("PolicyYear")))
                        Else
                            Amount = Get_Fee_Amount_By_Percentage(ANO, rs.fields("Currency"), Left(tostr(rs.fields("FDType")), 1), toval(rs.fields("AmountPCT")), toval(rs.fields("AMOUNTPCTBASED")), toval(rs.fields("PolicyYear")))
                        End If
                    End If

                    If Amount <> 0 Then
                        rsAA.AddNew()
                        rsAA.fields("BizMapID") = BizMapID
                        rsAA.fields("MSCode") = MSCode
                        rsAA.fields("Source") = Source
                        If toval(rs.fields("PolicyYear")) = 0 Then
                            rsAA.fields("SDate") = PSDate
                            rsAA.fields("EDate") = PEDate
                        Else
                            rsAA.fields("SDate") = DateAdd(DateInterval.Year, toval(rs.fields("PolicyYear")) - 1, PSDate)
                            rsAA.fields("EDate") = DateAdd(DateInterval.Year, toval(rs.fields("PolicyYear")), PSDate)
                        End If
                        rsAA.fields("ANO") = ANO

                        If rs.fields("ID") = "" Or rs.fields("ID") = "<Payor>" Then
                            rsAA.fields("ID") = PID
                        Else
                            rsAA.fields("ID") = rs.fields("ID")
                        End If
                        rsAA.fields("Type") = IIf(Left(tostr(rs.fields("FDType")), 1) = "O", "OP", PType)
                        rsAA.fields("Code") = IIf(Left(tostr(rs.fields("FDType")), 1) = "O", "F", Left(tostr(rs.fields("FDType")), 1))
                        rsAA.fields("CodeExt") = IIf(Len(tostr(rs.fields("FDType"))) > 1, Right(tostr(rs.fields("FDType")), 1), "")
                        rsAA.fields("REFNO") = RefNo
                        rsAA.fields("POLICYNO") = PolicyNo
                        rsAA.fields("DocNo") = DocNo
                        rsAA.fields("DATE") = ADate
                        rsAA.fields("BILLDATE") = BillDate
                        rsAA.fields("TOC") = TOC
                        rsAA.fields("Remarks") = AName
                        rsAA.fields("CAmount") = Amount
                        rsAA.fields("Amount_OC") = toval(rsAA.fields("CAmount"))
                        rsAA.fields("Amount") = toval(rsAA.fields("CAmount"))
                        rsAA.fields("Currency_OC") = tostr(rs.fields("Currency"))
                        rsAA.fields("Currency") = tostr(rs.fields("Currency"))
                        rsAA.fields("Rate") = 1
                        rsAA.fields("AdmNo") = -1
                        rsAA.fields("PProrata") = 1
                        rsAA.fields("AdjustableF") = 0
                        rsAA.fields("AdjMethod") = ""
                        If Not rsAA.Update Then GoTo errmsg

                        ' Option Contribute for Other Fee and Stamp Duty
                        If toval(rs.fields("ContributionF")) And Left(tostr(rs.fields("FDType")), 1) <> "F" And ISType = "L" Then
                            Dim rsCo As RemoteSet
                            rsCo = db.OpenQueryDef("QCoinsurance", adOpenForwardonly, CNO)
                            Do While Not rsCo.Eof
                                If rsCo.fields("PCollectionF") Then
                                    rsAA.AddNew()
                                    rsAA.fields("BizMapID") = BizMapID
                                    rsAA.fields("MSCode") = MSCode
                                    rsAA.fields("Source") = Source
                                    If toval(rs.fields("PolicyYear")) = 0 Then
                                        rsAA.fields("SDate") = PSDate
                                        rsAA.fields("EDate") = PEDate
                                    Else
                                        rsAA.fields("SDate") = DateAdd(DateInterval.Year, toval(rs.fields("PolicyYear")) - 1, PSDate)
                                        rsAA.fields("EDate") = DateAdd(DateInterval.Year, toval(rs.fields("PolicyYear")), PSDate)
                                    End If
                                    rsAA.fields("ANO") = ANO
                                    rsAA.fields("Type") = "CF"
                                    rsAA.fields("ID") = tostr(rsCo.fields("ID"))

                                    rsAA.fields("Code") = IIf(Left(tostr(rs.fields("FDType")), 1) = "O", "F", Left(tostr(rs.fields("FDType")), 1))
                                    rsAA.fields("CodeExt") = IIf(Len(tostr(rs.fields("FDType"))) > 1, Right(tostr(rs.fields("FDType")), 1), "")

                                    rsAA.fields("REFNO") = tostr(rsCo.fields("DocNo"))
                                    rsAA.fields("POLICYNO") = PolicyNo
                                    rsAA.fields("DocNo") = DocNo
                                    rsAA.fields("DATE") = ADate
                                    rsAA.fields("BILLDATE") = BillDate
                                    rsAA.fields("TOC") = TOC
                                    rsAA.fields("Remarks") = AName

                                    rsAA.fields("CAmount") = -Amount * toval(rsCo.fields("Share")) / 100
                                    rsAA.fields("Amount_OC") = toval(rsAA.fields("CAmount"))
                                    rsAA.fields("Amount") = toval(rsAA.fields("CAmount"))
                                    rsAA.fields("Currency_OC") = tostr(rs.fields("Currency"))
                                    rsAA.fields("Currency") = tostr(rs.fields("Currency"))

                                    rsAA.fields("Rate") = 1
                                    rsAA.fields("AdmNo") = -1
                                    rsAA.fields("PProrata") = 1
                                    rsAA.fields("AdjustableF") = 0
                                    rsAA.fields("AdjMethod") = ""
                                    If Not rsAA.Update Then GoTo errmsg
                                End If

                                ' Joint Placement
                                If rsCo.fields("JP") <> 0 Then
                                    rsAA.AddNew()
                                    rsAA.fields("BizMapID") = BizMapID
                                    rsAA.fields("MSCode") = MSCode
                                    rsAA.fields("Source") = Source
                                    If toval(rs.fields("PolicyYear")) = 0 Then
                                        rsAA.fields("SDate") = PSDate
                                        rsAA.fields("EDate") = PEDate
                                    Else
                                        rsAA.fields("SDate") = DateAdd(DateInterval.Year, toval(rs.fields("PolicyYear")) - 1, PSDate)
                                        rsAA.fields("EDate") = DateAdd(DateInterval.Year, toval(rs.fields("PolicyYear")), PSDate)
                                    End If
                                    rsAA.fields("ANO") = ANO
                                    rsAA.fields("Type") = "CF"
                                    rsAA.fields("ID") = tostr(rsCo.fields("ID"))

                                    rsAA.fields("Code") = IIf(Left(tostr(rs.fields("FDType")), 1) = "O", "F", Left(tostr(rs.fields("FDType")), 1))
                                    rsAA.fields("CodeExt") = IIf(Len(tostr(rs.fields("FDType"))) > 1, Right(tostr(rs.fields("FDType")), 1), "")

                                    rsAA.fields("REFNO") = tostr(rsCo.fields("DocNo"))
                                    rsAA.fields("POLICYNO") = PolicyNo

                                    rsAA.fields("DocNo") = DocNo
                                    rsAA.fields("DATE") = ADate
                                    rsAA.fields("BILLDATE") = BillDate
                                    rsAA.fields("TOC") = TOC
                                    rsAA.fields("Remarks") = AName

                                    rsAA.fields("CAmount") = Amount * toval(rsCo.fields("JP")) / 100
                                    rsAA.fields("Amount_OC") = toval(rsAA.fields("CAmount"))
                                    rsAA.fields("Amount") = toval(rsAA.fields("CAmount"))
                                    rsAA.fields("Currency_OC") = tostr(rs.fields("Currency"))
                                    rsAA.fields("Currency") = tostr(rs.fields("Currency"))

                                    rsAA.fields("Rate") = 1
                                    rsAA.fields("AdmNo") = -1
                                    rsAA.fields("PProrata") = 1
                                    rsAA.fields("AdjustableF") = 0
                                    rsAA.fields("AdjMethod") = ""
                                    If Not rsAA.Update Then GoTo errmsg
                                End If
                                rsCo.MoveNext()
                            Loop
                            rsCo.CloseRemoteSet()
                        End If
                    End If
                    rs.MoveNext()
                Loop
                rs.CloseRemoteSet()
            End If
        End If

        ' Close Remote Set
        rsIC.CloseRemoteSet()
        rsAA.CloseRemoteSet()
        rsAcc.CloseRemoteSet()

        ' Copy Temporary Table
        If Not CalculationRoundingF Then
            If Not db.Execute("insert into accass(TYPE,ANO,ID,CODE,CAmount,CURRENCY_OC,Amount_OC,Amount,RATE,CURRENCY,REFNO,DATE,TOC,POSTED,ADMNO,POLICYNO,BILLDATE,REMARKS,Prorata,SDate,EDate,PProrata,DocNo,AdjustableF,ADJMETHOD,RCODE,AType,NOREFUNDF,BizMapID,Source,MSCode,CommPoolF,DepositF,CodeExt) Select TYPE,ANO,ID,CODE,CAmount,CURRENCY_OC,Amount_OC,Amount,RATE,CURRENCY,REFNO,DATE,TOC,POSTED,ADMNO,POLICYNO,BILLDATE,REMARKS,Prorata,SDate,EDate,PProrata,DocNo,AdjustableF,ADJMETHOD,RCODE,AType,NOREFUNDF,BizMapID,Source,MSCode,CommPoolF,DepositF,CodeExt from #AccAss") Then GoTo errmsg
        Else
            If Not db.Execute("insert into accass(TYPE,ANO,ID,CODE,CAmount,CURRENCY_OC,Amount_OC,Amount,RATE,CURRENCY,REFNO,DATE,TOC,POSTED,ADMNO,POLICYNO,BILLDATE,REMARKS,Prorata,SDate,EDate,PProrata,DocNo,AdjustableF,ADJMETHOD,RCODE,AType,NOREFUNDF,BizMapID,Source,MSCode,CommPoolF,DepositF,CodeExt) Select TYPE,ANO,ID,CODE,CAmount,CURRENCY_OC,dbo.RoundCCY(Amount_OC, CURRENCY_OC) as Amount_OC,dbo.RoundCCY(Amount, CURRENCY) as Amount,RATE,CURRENCY,REFNO,DATE,TOC,POSTED,ADMNO,POLICYNO,BILLDATE,REMARKS,Prorata,SDate,EDate,PProrata,DocNo,AdjustableF,ADJMETHOD,RCODE,AType,NOREFUNDF,BizMapID,Source,MSCode,CommPoolF,DepositF,CodeExt from #AccAss") Then GoTo errmsg
        End If
        ' Drop Temporary Table
        If Not db.Execute("Drop table #AccAss") Then GoTo errmsg

        ' Adjustment Policy Deposit (not for cancel all)
        If AdjustmentPolicyDepositF AndAlso LANO <> -1 AndAlso OpenFlag AndAlso Not (AType = "C" And EMethod = "A") Then
            rsAA = db.OpenRemoteSet("Select * from AccAss Where 1<>1")

            rs = db.OpenQueryDef("QPOLICY_DEPOSIT", adOpenForwardonly, LANO)
            Do While Not rs.Eof
                Dim Total_Deposit As Double = toval(rs.fields("Total_Deposit"))
                Dim Currency As String = tostr(rs.fields("Currency"))
                If Total_Deposit > 0 Then
                    Dim Total_Premium As Double
                    Dim Deposit_Usage As Double
                    Dim Deposit_Remaining As Double

                    rsDetail = db.OpenQueryDef("QPOLICY_DEPOSIT_USAGE", adOpenForwardonly, ANO, Currency)
                    Deposit_Usage = toval(rsDetail.fields("Deposit_Usage"))
                    Deposit_Remaining = Total_Deposit - Deposit_Usage

                    rsDetail = db.OpenQueryDef("QPOLICY_DEPOSIT_CURRENT", adOpenForwardonly, ANO, Currency)
                    Do While Not rsDetail.Eof
                        Dim ExcRate As Double
                        If Currency.ToUpper <> rsDetail.fields("Currency").ToString.ToUpper Then
                            ExcRate = exchange_rate(rsDetail.fields("Currency"), ADate)
                        Else
                            ExcRate = 1
                        End If
                        Total_Premium = ExcRate * toval(rsDetail.fields("Total_Premium"))

                        If Deposit_Remaining - Total_Premium < 0 Then
                            Deposit_Usage = Deposit_Remaining
                            Deposit_Remaining = 0
                        Else
                            If (Deposit_Remaining - Total_Premium) <= Total_Deposit Then
                                Deposit_Usage = Deposit_Remaining - (Deposit_Remaining - Total_Premium)
                                Deposit_Remaining = Deposit_Remaining - Total_Premium
                            Else
                                Deposit_Usage = Deposit_Remaining - Total_Deposit
                                Deposit_Remaining = Total_Deposit
                            End If
                        End If

                        If Deposit_Usage <> 0 Then
                            rsAA.AddNew()
                            rsAA.fields("BizMapID") = BizMapID
                            rsAA.fields("MSCode") = MSCode
                            rsAA.fields("Source") = Source
                            rsAA.fields("SDate") = PSDate
                            rsAA.fields("EDate") = PEDate
                            rsAA.fields("ANO") = ANO
                            rsAA.fields("ID") = PID
                            rsAA.fields("Type") = PType
                            rsAA.fields("Code") = "J"
                            rsAA.fields("REFNO") = RefNo
                            rsAA.fields("POLICYNO") = PolicyNo
                            rsAA.fields("DocNo") = DocNo
                            rsAA.fields("DATE") = ADate
                            rsAA.fields("BILLDATE") = BillDate
                            rsAA.fields("TOC") = TOC
                            rsAA.fields("Remarks") = AName
                            rsAA.fields("CAmount") = -Deposit_Usage / ExcRate
                            rsAA.fields("Amount_OC") = toval(rsAA.fields("CAmount"))
                            rsAA.fields("Amount") = toval(rsAA.fields("CAmount"))
                            rsAA.fields("Currency_OC") = tostr(rsDetail.fields("Currency"))
                            rsAA.fields("Currency") = tostr(rsDetail.fields("Currency"))
                            rsAA.fields("Rate") = 1
                            rsAA.fields("AdmNo") = -1
                            rsAA.fields("PProrata") = 1
                            rsAA.fields("AdjustableF") = 0
                            rsAA.fields("AdjMethod") = ""
                            rsAA.fields("DepositF") = True
                            If Not rsAA.Update Then GoTo errmsg
                        End If
                        rsDetail.MoveNext()
                    Loop

                End If
                rs.MoveNext()
            Loop

            If ApplyReinsuranceDepositF Then
                rs = db.OpenQueryDef("QREINSURANCE_DEPOSIT", adOpenForwardonly, LANO)
                Do While Not rs.Eof
                    Dim Total_Deposit As Double = toval(rs.fields("Total_Deposit"))
                    Dim Currency As String = tostr(rs.fields("Currency"))
                    If Total_Deposit > 0 Then
                        Dim Total_Premium As Double
                        Dim Deposit_Usage As Double

                        rsDetail = db.OpenQueryDef("QREINSURANCE_DEPOSIT_USAGE", adOpenForwardonly, ANO, rs.fields("ID"), Currency, rs.fields("Type"), rs.fields("RefNo"))
                        Total_Premium = toval(rsDetail.fields("Total_Premium"))
                        Deposit_Usage = toval(rsDetail.fields("Deposit_Usage"))

                        If Deposit_Usage >= Total_Premium Then
                            Deposit_Usage = -(Deposit_Usage - Total_Premium)
                        Else
                            If Total_Deposit >= Total_Premium Then
                                Deposit_Usage = Total_Premium - Deposit_Usage
                            Else
                                Deposit_Usage = Total_Deposit - Deposit_Usage
                            End If
                        End If
                        If Deposit_Usage <> 0 Then
                            rsAA.AddNew()
                            rsAA.fields("BizMapID") = BizMapID
                            rsAA.fields("MSCode") = MSCode
                            rsAA.fields("Source") = Source
                            rsAA.fields("SDate") = PSDate
                            rsAA.fields("EDate") = PEDate
                            rsAA.fields("ANO") = ANO
                            rsAA.fields("ID") = rs.fields("ID")
                            rsAA.fields("Type") = rs.fields("Type")
                            rsAA.fields("Code") = "P"
                            rsAA.fields("REFNO") = rs.fields("RefNo")
                            rsAA.fields("POLICYNO") = PolicyNo
                            rsAA.fields("DocNo") = DocNo
                            rsAA.fields("DATE") = ADate
                            rsAA.fields("BILLDATE") = BillDate
                            rsAA.fields("TOC") = TOC
                            rsAA.fields("Remarks") = AName
                            rsAA.fields("CAmount") = Deposit_Usage * 100 / (100 - rs.fields("Comm"))
                            rsAA.fields("Amount_OC") = toval(rsAA.fields("CAmount"))
                            rsAA.fields("Amount") = toval(rsAA.fields("CAmount"))
                            rsAA.fields("Currency_OC") = tostr(rsDetail.fields("Currency"))
                            rsAA.fields("Currency") = tostr(rsDetail.fields("Currency"))
                            rsAA.fields("Rate") = 1
                            rsAA.fields("AdmNo") = -1
                            rsAA.fields("PProrata") = 1
                            rsAA.fields("AdjustableF") = 0
                            rsAA.fields("AdjMethod") = ""
                            rsAA.fields("DepositF") = True
                            If Not rsAA.Update Then GoTo errmsg

                            rsAA.AddNew()
                            rsAA.fields("BizMapID") = BizMapID
                            rsAA.fields("MSCode") = MSCode
                            rsAA.fields("Source") = Source
                            rsAA.fields("SDate") = PSDate
                            rsAA.fields("EDate") = PEDate
                            rsAA.fields("ANO") = ANO
                            rsAA.fields("ID") = rs.fields("ID")
                            rsAA.fields("Type") = rs.fields("Type")
                            rsAA.fields("Code") = "C"
                            rsAA.fields("REFNO") = rs.fields("RefNo")
                            rsAA.fields("POLICYNO") = PolicyNo
                            rsAA.fields("DocNo") = DocNo
                            rsAA.fields("DATE") = ADate
                            rsAA.fields("BILLDATE") = BillDate
                            rsAA.fields("TOC") = TOC
                            rsAA.fields("Remarks") = AName
                            rsAA.fields("CAmount") = -Deposit_Usage * rs.fields("Comm") / (100 - rs.fields("Comm"))
                            rsAA.fields("Amount_OC") = toval(rsAA.fields("CAmount"))
                            rsAA.fields("Amount") = toval(rsAA.fields("CAmount"))
                            rsAA.fields("Currency_OC") = tostr(rsDetail.fields("Currency"))
                            rsAA.fields("Currency") = tostr(rsDetail.fields("Currency"))
                            rsAA.fields("Rate") = 1
                            rsAA.fields("AdmNo") = -1
                            rsAA.fields("PProrata") = 1
                            rsAA.fields("AdjustableF") = 0
                            rsAA.fields("AdjMethod") = ""
                            rsAA.fields("DepositF") = True
                            If Not rsAA.Update Then GoTo errmsg
                        End If
                    End If
                    rs.MoveNext()
                Loop
            End If

            If ApplyCommissionDepositF Then
                rs = db.OpenQueryDef("QCOMMISSION_DEPOSIT", adOpenForwardonly, LANO)
                Do While Not rs.Eof
                    Dim Total_Deposit As Double = toval(rs.fields("Total_Deposit"))
                    Dim Currency As String = tostr(rs.fields("Currency"))
                    If Total_Deposit > 0 Then
                        Dim Total_Commission As Double
                        Dim Deposit_Usage As Double

                        rsDetail = db.OpenQueryDef("QCOMMISSION_DEPOSIT_USAGE", adOpenForwardonly, ANO, rs.fields("ID"), rs.fields("Type"), Currency)
                        Total_Commission = toval(rsDetail.fields("Total_Commission"))
                        Deposit_Usage = toval(rsDetail.fields("Deposit_Usage"))

                        If Deposit_Usage >= Total_Commission Then
                            Deposit_Usage = -(Deposit_Usage - Total_Commission)
                        Else
                            If Total_Deposit >= Total_Commission Then
                                Deposit_Usage = Total_Commission - Deposit_Usage
                            Else
                                Deposit_Usage = Total_Deposit - Deposit_Usage
                            End If
                        End If
                        If Deposit_Usage <> 0 Then
                            rsAA.AddNew()
                            rsAA.fields("BizMapID") = BizMapID
                            rsAA.fields("MSCode") = MSCode
                            rsAA.fields("Source") = Source
                            rsAA.fields("SDate") = PSDate
                            rsAA.fields("EDate") = PEDate
                            rsAA.fields("ANO") = ANO
                            rsAA.fields("ID") = rs.fields("ID")
                            rsAA.fields("Type") = rs.fields("Type")
                            rsAA.fields("Code") = "C"
                            rsAA.fields("REFNO") = RefNo
                            rsAA.fields("POLICYNO") = PolicyNo
                            rsAA.fields("DocNo") = DocNo
                            rsAA.fields("DATE") = ADate
                            rsAA.fields("BILLDATE") = BillDate
                            rsAA.fields("TOC") = TOC
                            rsAA.fields("Remarks") = AName
                            rsAA.fields("CAmount") = Deposit_Usage
                            rsAA.fields("Amount_OC") = toval(rsAA.fields("CAmount"))
                            rsAA.fields("Amount") = toval(rsAA.fields("CAmount"))
                            rsAA.fields("Currency_OC") = tostr(rsDetail.fields("Currency"))
                            rsAA.fields("Currency") = tostr(rsDetail.fields("Currency"))
                            rsAA.fields("Rate") = 1
                            rsAA.fields("AdmNo") = -1
                            rsAA.fields("PProrata") = 1
                            rsAA.fields("AdjustableF") = 0
                            rsAA.fields("AdjMethod") = ""
                            rsAA.fields("DepositF") = True
                            If Not rsAA.Update Then GoTo errmsg
                        End If
                    End If
                    rs.MoveNext()
                Loop
            End If

            rsAA.CloseRemoteSet()
        End If

        If Not TemporaryF Then
            If AType = "E" Or AType = "C" Or AType = "A" Then
                If AType <> "A" Then
                    ' Set Previous Acceptance Status to Closed

                    If EMethod <> "A" Then
                        If PSDate <> PDate Then
                            If Not db.Execute("Update Acceptance Set AStatus='C', CloseDate='" & Format(ADate, "MM/DD/YYYY") & "', CUserID='" & db_user & "', PPDate='" & Format(PDate, "MM/DD/YYYY") & "' Where AStatus<>'W' and ANO=" & pANO) Then GoTo errmsg
                        Else
                            ' Endorsement Period
                            If Not db.Execute("Update Acceptance Set AStatus='C', CloseDate='" & Format(ADate, "MM/DD/YYYY") & "', CUserID='" & db_user & "', PPDate=SDate Where AStatus<>'W' and ANO=" & pANO) Then GoTo errmsg
                        End If
                    Else
                        If Not db.Execute("Update Acceptance Set AStatus='C', CloseDate='" & Format(ADate, "MM/DD/YYYY") & "', CUserID='" & db_user & "', PPDate='" & Format(PDate, "MM/DD/YYYY") & "' Where PDate>='" & Format(PDate, "MM/DD/YYYY") & "' and AStatus<>'W' and ANO<>" & ANO & " and OANO=" & OANO) Then GoTo errmsg
                    End If
                    If AType = "C" Then
                        If Not db.Execute("Update A1 Set AdjustableF=1 from Acceptance A1, Acceptance A2, ICalc Where A2.AType='A' and A1.ANO=ICalc.SANO and ICalc.ANO=A2.ANO and A2.ANO=" & pANO) Then GoTo errmsg
                        If Not db.Execute("Update A1 Set AdjustableF=1 from Acceptance A1, Acceptance A2 Where A2.AType='A' and A1.ANO=A2.pANO and A2.ANO=" & pANO) Then GoTo errmsg
                    End If
                Else
                    If Not db.Execute("Update A1 Set AdjustableF=0 from Acceptance A1, Acceptance A2, ICalc Where A2.AType='A' and A1.ANO=ICalc.SANO and ICalc.ANO=A2.ANO and A2.ANO=" & ANO) Then GoTo errmsg
                    If Not db.Execute("Update A1 Set AdjustableF=0 from Acceptance A1, Acceptance A2 Where A2.AType='A' and A1.ANO=A2.pANO and A2.ANO=" & ANO) Then GoTo errmsg
                End If
            End If

            ' Update Renewal References
            If AType <> "A" And AType <> "C" And pANO <> -1 Then
                If Not db.Execute("Update Cover set pCNO=" & CNO & " from Acceptance, Cover Where Cover.CNO=Acceptance.CNO and Acceptance.RANO=" & pANO) Then GoTo errmsg
                If Not db.Execute("Update Acceptance set RANO=" & ANO & " from Acceptance, Cover Where Cover.CNO=Acceptance.CNO and Acceptance.RANO=" & pANO) Then GoTo errmsg
            End If

            ' Update Current Acceptance Status to Inforce
            If Not db.Execute("Update Acceptance set BulkF=" & IIf(Bulkf, 1, 0) & ", Ujroh=" & tovalSF(UJrohPCT) & ", BackDatedF=" & IIf(BackDatedF, 1, 0) & ", AStatus='I', AUserDate='" & Format(Today.Date, "MM/DD/YYYY") & "', AUserTime = '" & Time() & "', AUserID='" & br_Approval_user & "', ADate='" & Format(ADate, "MM/DD/YYYY") & "', PolicyNo='" & PolicyNo & "' where AStatus in ('W','T') and ANO=" & ANO) Then GoTo errmsg
            If db.RecordsAffected = 0 Then
                StrMsg = "Please Check Policy Data !"
                GoTo errmsg
            End If

            ' Update Indemnity
            If EMethod = "R" Then ' Reinstatement
                If Not db.Execute("Update ICover Set Estimate=0, Indemnity=0 Where ANO=" & ANO) Then GoTo errmsg
                If Not db.Execute("Update ICoverNOC Set Estimate=0, Indemnity=0 Where ANO=" & ANO) Then GoTo errmsg
            End If

            ' Update Facultative Status
            If Not db.Execute("Update RArrDet Set Status='A' Where Status='R' and ANO=" & ANO) Then GoTo errmsg

            If Not BackDatedF Then

                If (Not MasterFlag Or OpenFlag) And Not Bulkf Then
                    If RANO <> -1 Then
                        Dim Param(8) As Object
                        Param(8) = True ' Create Voucher
                        If Not Posting_SurplusCalculation(ADate, Param, RANO) Then GoTo errmsg
                    End If
                    If Not Production_To_Adm(ANO, LANO, Bulkf, DetailTreatyF, Voucher, SplitDNCNF) Then GoTo errmsg

                    rs = db.OpenRemoteSet("Select distinct Admlink.ID, TOC.COB, TOC.ConsortiumF, AccAss.CommPoolF, Admlink.TYPE, Admlink.CURRENCY, Admlink.REFNO, Admlink.DATE, Admlink.BILLDATE, Admlink.DOCNO, Admlink.Subject, Admlink.BRANCH, Admlink.Segment, Admlink.A_PolicyNo from AccAss, Admlink, TOC Where TOC.TOC=Admlink.Code and Admlink.VoucherF=0 and Admlink.AdmNo=AccAss.AdmNo and Admlink.WriteF=0 and AccAss.ANO=" & ANO)
                    Do While Not rs.Eof

                        Dim rsAdmNo As RemoteSet
                        Dim sAdmNo As String = ""
                        rsAdmNo = db.OpenRemoteSet("Select A.AdmNo from Admlink A, TOC T Where A.Code=T.TOC and A.VoucherF=0 and A.WriteF=0 and A.ID='" & rs.fields("ID") & "' and T.COB='" & rs.fields("COB") & "' and A.Type='" & rs.fields("Type") & "' and A.Currency='" & rs.fields("Currency") & "' and A.RefNo='" & rs.fields("RefNo") & "' and A.Date='" & Format(rs.fields("Date"), "MM/DD/YYYY") & "' and A.BillDate='" & Format(rs.fields("BillDate"), "MM/DD/YYYY") & "' and A.DocNo='" & rs.fields("DocNo") & "' and A.Subject='" & rs.fields("Subject") & "' and A.Branch='" & rs.fields("Branch") & "' and A.Segment='" & rs.fields("Segment") & "' and A.A_PolicyNo='" & rs.fields("A_PolicyNo") & "'")
                        If Not rsAdmNo.Eof Then
                            Do While Not rsAdmNo.Eof
                                If sAdmNo = "" Then
                                    sAdmNo = tostr(rsAdmNo.fields("AdmNo"))
                                Else
                                    sAdmNo = sAdmNo & "," & tostr(rsAdmNo.fields("AdmNo"))
                                End If
                                rsAdmNo.MoveNext()
                            Loop
                            If Not Production_To_Adm_Finalize(ANO, LANO, sAdmNo, , SplitDNCNF) Then GoTo errmsg
                            If Not toval(rs.fields("CommPoolF")) And (DetailTreatyF Or toval(rs.fields("ConsortiumF")) Or InStr("DIIRITIXICJPCFFOFPBBBABOBCBPBDOPDCCPXPAFDPDR", rs.fields("Type")) <> 0) Then
                                If Create_Voucher(sAdmNo, True) = "" Then GoTo errmsg
                            End If
                        End If

                        rs.MoveNext()
                    Loop
                End If

                ' Check Policy Holder Limit
                If AType = "N" Or AType = "E" Or AType = "C" Then
                    If PHolderLimitF Then
                        If Not db.Execute("QUpdate_PHolder_LimitUsage " & ANO) Then
                            StrMsg = "Updating Policy Holder Limit Usage Failed !"
                            GoTo errmsg
                        End If
                    End If
                End If
            End If

            ' Update References...

            ' Update Services
            rs = db.OpenRemoteSet("Select * from Service Where SType<>'Claim' and SStatus='P' and ANO=" & ANO)
            If Not rs.Eof Then
                rs.Edit()
                If rs.fields("PolicyNo") = "" Then
                    rs.fields("PolicyNo") = PolicyNo
                    rs.fields("CertificateNo") = CertificateNo
                End If
                rs.fields("SStatus") = "A"
                rs.fields("AUserDate") = Today.Date
                rs.fields("AUserID") = br_Approval_user
                rs.fields("AUserTime") = Time()
                If Not rs.Update Then GoTo errmsg
            End If

            ' Update Scheme Transactions
            If Not db.Execute("Update Scheme_Transaction Set Status='P' Where ANO=" & ANO) Then GoTo errmsg

            If AType <> "A" And AType <> "C" And pANO <> -1 Then
                ' Update Renewal References
                If Not db.Execute("Update Renewal Set ANO=" & ANO & ", PStatus='I' Where ANO=" & pANO) Then GoTo errmsg
            End If

            If RANO <> -1 Then
                If Not db.Execute("Update Renewal Set Status='P' Where NEWANO=" & ANO) Then GoTo errmsg
            End If

            ' Update Policy No in Conjunct Policy
            If AType = "N" And PolicyNo <> "" Then
                If Not db.Execute("Update Acceptance Set CPolicyNo='" & PolicyNo & "' from Acceptance Where CANO<>-1 and CANO=" & ANO) Then GoTo errmsg
            End If

            If AType = "E" AndAlso EMethod <> "T" Then
                rs = db.OpenRemoteSet("Select C.CNO, C.ANO from Claim C, Acceptance A1, Acceptance A2 Where A1.ANO=" & ANO & " and A2.OANO=A1.OANO and C.ANO=A2.ANO and C.LossDate>'" & Format(PDate, "MM/DD/YYYY") & "' and C.CType<>'C' and C.CStatus<>'R' and (C.CStatus<>'C' or C.PCstatus='A') and not exists (Select pCNO from Claim Where Claim.pCNO=C.CNO and Claim.CStatus<>'R') order By C.CNO")
                Do While Not rs.Eof
                    If rs.fields("ANO") <> ANO Then
                        If Not UpdateClaimPolicyReference(rs.fields("CNO"), rs.fields("ANO"), ANO) Then
                            StrMsg = "Can't Update Claim Policy Reference !"
                            GoTo errmsg
                        End If
                    End If
                    rs.MoveNext()
                Loop
            End If
        End If

        If AutoParsingFieldF Then
            If Not Parsing_AccCla(ANO) Then
                StrMsg = "Error Parsing TC !"
                GoTo errmsg
            End If
        End If

        Inforce = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Inforce = False
    End Function

    Private Function FeeDuty_LessThan_Premium_Refund(ByVal ANO) As Boolean
        Dim rs As RemoteSet
        Dim sql As String
        sql = "Select top 1 A.*"
        sql = sql & " from Premium_Calculation_Constant(" & ANO & ") P, ACCFD A "
        sql = sql & " Where A.ANO=P.ANO and A.Currency=P.Currency and -P.Premium>A.Amount"
        rs = db.OpenRemoteSet(sql)
        FeeDuty_LessThan_Premium_Refund = (Not rs.Eof)
    End Function
    Private Function Get_Effective_Cancellation_By_Payor_Schedule(ByVal ANO As Long, ByVal PDate As Date, ByVal EDate As Date) As Date
        Dim rs As RemoteSet
        rs = db.OpenRemoteSet("Select Top 1 P.InstLDate from Acceptance A Inner Join Payor_Schedule P on (P.ANO=A.ANO) Inner Join TOC on (TOC.TOC=A.TOC and TOC.NotApplyPayorScheduleOnRefundF=0) Where A.ANO=" & ANO & " and P.InstDate<='" & Format(PDate, "MM/DD/YYYY") & "' and P.InstLDate>'" & Format(PDate, "MM/DD/YYYY") & "' order by P.InstDate Desc")
        If Not rs.Eof Then
            If DateDiff(DateInterval.Day, rs.fields("InstLDate"), EDate) > 0 Then
                Get_Effective_Cancellation_By_Payor_Schedule = rs.fields("InstLDate")
            Else
                Get_Effective_Cancellation_By_Payor_Schedule = EDate
            End If
        Else
            Get_Effective_Cancellation_By_Payor_Schedule = PDate
        End If
    End Function
    Private Function Make_Balance_AccAss(ByVal LANO As Long, ByVal pANO As Long, ByVal ANO As Long, ByVal AType As String, ByVal RefNo As String, ByVal PSDate As Date, ByVal ADate As Date, ByVal BillDate As Date, ByVal P_PDate As Date, ByVal PPDate As Date, ByVal CProrata As Double, ByVal DocNo As String, ByVal PPeriod As Integer, ByVal NoRefundF As Integer, ByVal RefundType As String, ByVal EMethod As String, ByVal ISType As String, ByVal SplitDNCNF As Boolean) As Boolean
        Dim rs As RemoteSet
        Dim Prorata As Double
        Dim SDate As Date
        Dim EDate As Date
        Dim P_SDate As Date
        Dim P_EDate As Date
        Dim P_STime As String
        Dim P_ETime As String
        Dim EXCLUSIVEF As Boolean
        Dim pNoRefundF As Boolean
        Dim NoProrataF As Boolean
        Dim Amount As Double
        Dim CAmount As Double

        On Error GoTo errmsg
        Dim Type As String
        Dim Code As String
        Dim PDate As Date
        ' Reinsurance Effective Date
        Dim R_PDate As Date
        Dim CNO As Long
        Dim SQL As String = ""


        ' First Process the New One
        If AType = "E" Then ' Not for Adjustment
            If ANO <> LANO Then
                rs = db.OpenRemoteSet("Select A.CNO, A.ExclusiveF, A.SDate as PSDate, A.STime as PSTime, A.EDate as PEDate, A.ETime as PETime, R.PDate as R_PDate from Acceptance A, RArrHeader R Where R.ANO=A.ANO and A.ANO=" & ANO)
                P_SDate = rs.fields("PSDate")
                P_EDate = rs.fields("PEDate")
                P_STime = rs.fields("PSTime")
                P_ETime = rs.fields("PETime")
                R_PDate = rs.fields("R_PDate")
                CNO = rs.fields("CNO")
                EXCLUSIVEF = rs.fields("EXCLUSIVEF")

                SQL = ""
                SQL = SQL & " Declare @P_ANO int"
                SQL = SQL & " Select @P_ANO=" & ANO

                SQL = SQL & " Select AccAss.* "
                SQL = SQL & " from #AccAss  AccAss"
                SQL = SQL & " Where AccAss.AType<>'N' "
                SQL = SQL & " and AccAss.ANO=@P_ANO"
                SQL = SQL & " and Not ("
                SQL = SQL & " (AccAss.TYPE in ('DI','OP') AND AccAss.CODE IN ('F')) or "
                SQL = SQL & " (AccAss.TYPE in ('DI','IC') AND AccAss.CODE IN ('D')) or"
                SQL = SQL & " (AccAss.TYPE in ('CF') AND AccAss.CODE IN ('F','D') "
                SQL = SQL & " and exists ("
                SQL = SQL & " Select TOP 1 ACCFD.ANO"
                SQL = SQL & " from Acceptance"
                SQL = SQL & " Inner Join COINSURANCE on (Coinsurance.CNO=Acceptance.CNO)"
                SQL = SQL & " Inner Join ACCFD on (ACCFD.ANO=Acceptance.ANO And ACCFD.CONTRIBUTIONF = 1)"
                SQL = SQL & " Inner join FDTAB on (FDTAB.FDID=ACCFD.FDID AND Left(FDTAB.FDTYPE,1)<>'F')"
                SQL = SQL & " Where Acceptance.ANO = AccAss.ANO"
                SQL = SQL & " and COINSURANCE.ID=AccAss.ID and COINSURANCE.DOCNO=AccAss.REFNO AND COINSURANCE.PCOLLECTIONF=1 AND COINSURANCE.HF=0 AND COINSURANCE.HFAMOUNT=0"
                SQL = SQL & " )"
                SQL = SQL & " ) or"
                SQL = SQL & " (AccAss.Type in ('BB','BA','BC','BP','BD','BO')"
                SQL = SQL & " and exists ("
                SQL = SQL & " Select Top 1 coalesce(A5.NoProrataF, coalesce(A4.NoProrataF, coalesce(A6.NoProrataF, Cast(0 as Bit))))"
                SQL = SQL & " from Acceptance A3"
                SQL = SQL & " Outer Apply (Select NOPRORATAF from AccBS A4 Where A4.ANO=A3.ANO and A4.ID=AccAss.ID and A4.BSType=substring(AccAss.Type,2,1)) A4"
                SQL = SQL & " Outer Apply (Select NOPRORATAF from AAccBS A5 Where A5.ANO=A3.ANO and A5.ID=AccAss.ID and A5.BSType=substring(AccAss.Type,2,1)) A5"
                SQL = SQL & " Outer Apply (Select NOPRORATAF from AccBS A6 Where A6.ANO=A3.LANO and A6.ID=AccAss.ID and A6.BSType=substring(AccAss.Type,2,1)) A6"
                SQL = SQL & " Where A3.ANO=AccAss.ANO and coalesce(A5.NoProrataF, coalesce(A4.NoProrataF, coalesce(A6.NoProrataF, Cast(0 as Bit))))=1"
                SQL = SQL & " )"
                SQL = SQL & " )"
                SQL = SQL & " )"

                rs = db.OpenRemoteSet(SQL)
                Do While Not rs.Eof
                    SDate = rs.fields("SDate")
                    EDate = rs.fields("EDate")

                    Type = rs.fields("Type")
                    Code = rs.fields("Code")

                    ' Clean Cut
                    If InStr("CPXPDCQSQPS1S2S3AF", Type) <> 0 Then
                        If DateDiff(DateInterval.Day, P_PDate, R_PDate) > 0 Then
                            PDate = R_PDate
                        Else
                            PDate = P_PDate
                        End If
                    Else
                        PDate = P_PDate
                    End If

                    Prorata = 0
                    pNoRefundF = toval(rs.fields("NoRefundF"))
                    Prorata = CProrata

                    If DateDiff(DateInterval.Day, EDate, PDate) >= 0 Then
                        Prorata = 0
                    ElseIf DateDiff(DateInterval.Day, PDate, SDate) > 0 Then
                        Prorata = 1
                    Else
                        If Prorata = 0 Then
                            If Not EXCLUSIVEF AndAlso P_STime < P_ETime AndAlso EDate = P_EDate Then
                                Prorata = Calc_Prorata(PDate, DateAdd(DateInterval.Day, 1, EDate), SDate, DateAdd(DateInterval.Day, 1, EDate), PPeriod)
                            Else
                                Prorata = Calc_Prorata(PDate, EDate, SDate, EDate, PPeriod)
                            End If
                        End If
                        If NoRefundF = 1 Then Prorata = 0
                    End If

                    Select Case NoRefundF
                        Case 12
                            ' Refund Cancellation
                        Case 13
                            ' Conditional Refund
                            If InStr(RefundType, Type) = 0 Then Prorata = 0
                        Case Else
                            ' No Refund (Risk No Refund or Commission no Refund)
                            If pNoRefundF Then Prorata = 0
                            ' No Refund All
                            If NoRefundF = 2 Then Prorata = 0
                            ' No Refund for Ujroh
                            If NoRefundF = 3 And InStr("DIIC", Type) <> 0 And Code = "U" Then Prorata = 0
                            If NoRefundF = 3 And InStr("BBBABOBCBPBD", Type) <> 0 Then Prorata = 0
                            If NoRefundF = 3 And InStr("CPDCQSQPS1S2S3AFXPFOFPIRITIX", Type) <> 0 And Code = "F" Then Prorata = 0
                            ' Refund for Re Only
                            If NoRefundF = 4 And InStr("CPDCQSQPS1S2S3AFXPFOFP", Type) = 0 Then Prorata = 0
                            'Net Add/Refund (Commission Net To Premium), Move to function Production_to_adm
                            'If NoRefundF = 7 And InStr("BBBABOBCBPBD", Type) <> 0 Then
                            '    Type = IIf(ISType = "I" Or ISType = "L", "DI", IIf(ISType = "C", "IC", IIf(ISType = "R", "IR", "IT")))
                            '    Code = "P"
                            'End If
                    End Select

                    CAmount = toval(rs.fields("CAmount"))
                    Amount = toval(rs.fields("Amount_OC"))

                    If rs.fields("Prorata") <> 0 Then   ' Premium Overwrite
                        CAmount = CAmount * rs.fields("Prorata")
                        Amount = Amount * rs.fields("Prorata")
                    End If

                    rs.Edit()
                    rs.fields("Type") = Type
                    rs.fields("Code") = Code
                    rs.fields("Prorata") = Prorata
                    rs.fields("CAmount") = CAmount
                    Amount = Amount * Prorata
                    rs.fields("Amount_OC") = Amount
                    rs.fields("Amount") = Amount * toval(rs.fields("Rate"))
                    rs.fields("AType") = AType
                    If Not rs.UpdateRow Then GoTo errmsg
                    rs.MoveNext()
                Loop
                rs.MoveFirst()
                If Not rs.Eof Then
                    If Not rs.Update Then GoTo errmsg
                End If
            End If
        End If

        ' Second Process the Previous One
        Dim rsAA As RemoteSet
        If ANO <> LANO Then
            rsAA = db.OpenRemoteSet("Select * from #AccAss Where 1<>1")
        Else ' No Temporary from Inforce Master
            rsAA = db.OpenRemoteSet("Select * from AccAss Where 1<>1")
        End If
        If AType <> "A" And EMethod <> "A" Then  ' Not for Adjustment and Not Cancel All from Beginning
            If ANO <> LANO Then
                rs = db.OpenRemoteSet("Select Acceptance.PolicyNo, Acceptance.CertificateNo, TOC.ClaimDeductionRefundF, Acceptance.ExclusiveF, Acceptance.SDate as PSDate, Acceptance.STime as PSTime, Acceptance.EDate as PEDate, Acceptance.ETime as PETime from Acceptance, TOC Where TOC.TOC=Acceptance.TOC and Acceptance.ANO=" & pANO)
                P_SDate = rs.fields("PSDate")
                P_EDate = rs.fields("PEDate")
                P_STime = rs.fields("PSTime")
                P_ETime = rs.fields("PETime")
                EXCLUSIVEF = rs.fields("EXCLUSIVEF")
                Dim CPRefund As Double
                Dim CPFormula As String
                Dim PolicyNo As String = tostr(rs.fields("PolicyNo"))
                Dim CertificateNo As String = tostr(rs.fields("CertificateNo"))
                Dim ClaimDeductionRefundF As Boolean = toval(rs.fields("ClaimDeductionRefundF"))
                Dim LossRatio As Double = 0

                If AType = "C" AndAlso ClaimDeductionRefundF Then
                    Dim Claim_Paid As Double
                    Dim Gross_Premium As Double
                    Dim OS_Claim As Double
                    ' for Individual
                    rs = db.OpenQueryDef("CLAIM_PAID_BY_POLICY", adOpenForwardonly, PolicyNo, CertificateNo)
                    Claim_Paid = -toval(rs.fields("Claim_Paid"))
                    rs = db.OpenQueryDef("GROSS_PREMIUM_BY_POLICY", adOpenForwardonly, PolicyNo, CertificateNo)
                    Gross_Premium = toval(rs.fields("Gross_Premium"))
                    rs = db.OpenQueryDef("OS_CLAIM_BY_POLICY", adOpenForwardonly, PolicyNo, CertificateNo)
                    OS_Claim = toval(rs.fields("OS_Claim"))
                    If Gross_Premium <> 0 Then
                        LossRatio = (Claim_Paid + OS_Claim) / Gross_Premium * 100
                    Else
                        LossRatio = 0
                    End If
                End If
                rs = db.OpenQueryDef("Balance_Accass", adOpenForwardonly, pANO)
                Do While Not rs.Eof
                    SDate = rs.fields("SDate")
                    EDate = rs.fields("EDate")

                    Type = rs.fields("Type")
                    Code = rs.fields("Code")

                    If InStr("CPXPDCQSQPS1S2S3AF", Type) <> 0 Then
                        If DateDiff(DateInterval.Day, P_PDate, R_PDate) > 0 Then
                            PDate = R_PDate
                        Else
                            PDate = P_PDate
                        End If
                    Else
                        PDate = P_PDate
                    End If

                    Prorata = 0
                    NoProrataF = toval(rs.fields("NoProrataF"))
                    pNoRefundF = toval(rs.fields("NoRefundF"))
                    CPRefund = toval(rs.fields("CPRefund"))
                    CPFormula = tostr(rs.fields("CPFormula"))
                    If CPRefund = 0 Then CPRefund = 100
                    Prorata = CProrata

                    If rs.fields("AType") = "A" Then
                        ' Cancel Adjustment
                        Prorata = 1
                    ElseIf DateDiff(DateInterval.Day, EDate, PDate) >= 0 And DateDiff(DateInterval.Day, PDate, P_SDate) <= 0 And DateDiff(DateInterval.Day, PDate, P_EDate) >= 0 Then
                        Prorata = 0
                    ElseIf DateDiff(DateInterval.Day, PDate, SDate) > 0 And DateDiff(DateInterval.Day, PDate, P_SDate) <= 0 And DateDiff(DateInterval.Day, PDate, P_EDate) >= 0 Then
                        Prorata = 1
                        ' CP Refund Not Apply if risk is not inforced
                        CPRefund = 100
                    Else
                        If Prorata = 0 Then
                            If PSDate <> PDate Or NoRefundF = 6 Then
                                If AType = "C" Then
                                    If Not EXCLUSIVEF AndAlso P_STime < P_ETime AndAlso EDate = P_EDate Then
                                        Prorata = Calc_Prorata(Get_Effective_Cancellation_By_Payor_Schedule(ANO, PDate, DateAdd(DateInterval.Day, 1, EDate)), DateAdd(DateInterval.Day, 1, EDate), SDate, DateAdd(DateInterval.Day, 1, EDate), PPeriod)
                                    Else
                                        Prorata = Calc_Prorata(Get_Effective_Cancellation_By_Payor_Schedule(ANO, PDate, EDate), EDate, SDate, EDate, PPeriod)
                                    End If
                                Else
                                    If Not EXCLUSIVEF AndAlso P_STime < P_ETime AndAlso EDate = P_EDate Then
                                        Prorata = Calc_Prorata(PDate, DateAdd(DateInterval.Day, 1, EDate), SDate, DateAdd(DateInterval.Day, 1, EDate), PPeriod)
                                    Else
                                        Prorata = Calc_Prorata(PDate, EDate, SDate, EDate, PPeriod)
                                    End If
                                End If
                            Else
                                ' Endorsement Period
                                Prorata = 1
                            End If
                        End If
                        If NoRefundF = 1 Then Prorata = 0
                    End If

                    If Not NoProrataF Then
                        Select Case NoRefundF
                            Case 12
                                ' Refund Cancellation
                            Case 13
                                ' Conditional Refund
                                If InStr(RefundType, Type) = 0 Then Prorata = 0
                            Case Else
                                ' No Refund (Risk No Refund or Commission no Refund)
                                If pNoRefundF Then Prorata = 0
                                ' No Refund All
                                If NoRefundF = 2 Then Prorata = 0
                                ' No Refund for Ujroh
                                If NoRefundF = 3 And InStr("DIIC", Type) <> 0 And Code = "U" Then Prorata = 0
                                If NoRefundF = 3 And InStr("BBBABOBCBPBD", Type) <> 0 Then Prorata = 0
                                If NoRefundF = 3 And InStr("CPDCQSQPS1S2S3AFXPFOFPIRITIX", Type) <> 0 And Code = "F" Then Prorata = 0
                                ' Refund for Re Only
                                If NoRefundF = 4 And InStr("CPDCQSQPS1S2S3AFXPFOFP", Type) = 0 Then Prorata = 0
                                'Net Add/Refund (Commission Net To Premium), Move to function Production_to_adm
                                'If NoRefundF = 7 And InStr("BBBABOBCBPBD", Type) <> 0 Then
                                '    Type = IIf(ISType = "I" Or ISType = "L", "DI", IIf(ISType = "C", "IC", IIf(ISType = "R", "IR", "IT")))
                                '    Code = "P"
                                'End If

                                If AType = "C" Then
                                    If CProrata = 0 Then
                                        If CPFormula.ToUpper = "PRORATE SQ" Then
                                            Prorata = CPRefund / 100 * Prorata ^ 2
                                        Else
                                            Prorata = CPRefund / 100 * Prorata
                                        End If
                                    End If
                                    If Prorata <> 0 Then
                                        If (100 - LossRatio / Prorata) > 0 Then
                                            Prorata = Prorata * (100 - LossRatio / Prorata) / 100
                                        Else
                                            Prorata = 0
                                        End If
                                    End If
                                End If
                        End Select
                    Else
                        Prorata = 1
                    End If

                    If Prorata <> 0 Then
                        rsAA.AddNew()
                        db.backup_record(rs, rsAA)
                        rsAA.fields("ANO") = ANO
                        rsAA.fields("Type") = Type
                        rsAA.fields("Code") = Code
                        rsAA.fields("PProrata") = 0
                        If Not SplitDNCNF Then
                            rsAA.fields("DocNo") = DocNo
                            If InStr("DIICIRBBBABOBCBPBD", rsAA.fields("Type")) <> 0 Then
                                rsAA.fields("RefNo") = RefNo
                            End If
                        End If
                        If EMethod <> "S" Then  ' Not Restructuring
                            rsAA.fields("CAmount") = 0
                            rsAA.fields("Prorata") = Prorata
                            Amount = -toval(rs.fields("CAmount")) * Prorata
                            rsAA.fields("Amount_OC") = Amount
                            rsAA.fields("Amount") = Amount * toval(rs.fields("Rate"))
                        Else
                            rsAA.fields("CAmount") = toval(rs.fields("CAmount"))
                            rsAA.fields("Prorata") = 0
                            rsAA.fields("Amount_OC") = 0
                            rsAA.fields("Amount") = 0
                        End If
                        rsAA.fields("Posted") = 0
                        rsAA.fields("AdmNo") = -1
                        If DateDiff(DateInterval.Day, rsAA.fields("Date"), ADate) > 0 Or EMethod = "T" Then
                            rsAA.fields("Date") = ADate
                        End If
                        If DateDiff(DateInterval.Day, rsAA.fields("BillDate"), BillDate) > 0 Or EMethod = "T" Then
                            rsAA.fields("BillDate") = BillDate
                        End If
                        rsAA.fields("AType") = AType
                        If Not rsAA.UpdateRow Then GoTo errmsg
                    End If

                    rs.MoveNext()
                Loop
            End If
        Else
            rs = db.OpenQueryDef("Balance_Accass_Adjustment", adOpenForwardonly, ANO)
            Do While Not rs.Eof
                If AType = "A" And tostr(rs.fields("AdjMethod")) = "OVERLIMIT" Then
                    If InStr("FOFP", rs.fields("Type")) = 0 Or toval(rs.fields("ManualF")) Then
                        If CProrata <> 0 Then
                            Prorata = CProrata
                        Else
                            Prorata = 1
                        End If
                    Else
                        Prorata = 0
                    End If
                    Amount = -toval(rs.fields("CAmount")) * Prorata / IIf(rs.fields("PProrata") = 0, 1, rs.fields("PProrata"))
                Else
                    Prorata = toval(rs.fields("Prorata"))
                    Amount = -toval(rs.fields("Amount_OC"))
                End If

                If Amount <> 0 Then
                    rsAA.AddNew()
                    db.backup_record(rs, rsAA)
                    rsAA.fields("ANO") = ANO
                    rsAA.fields("CAmount") = 0
                    rsAA.fields("PProrata") = 0
                    If Not SplitDNCNF Then
                        rsAA.fields("DocNo") = DocNo
                        If InStr("DIICIRBBBABOBCBPBD", rsAA.fields("Type")) <> 0 Then
                            rsAA.fields("RefNo") = RefNo
                        End If
                    End If
                    rsAA.fields("Prorata") = Prorata
                    rsAA.fields("Amount_OC") = Amount
                    rsAA.fields("Amount") = Amount * toval(rs.fields("Rate"))
                    rsAA.fields("Posted") = 0
                    rsAA.fields("AdmNo") = -1
                    rsAA.fields("Date") = ADate
                    rsAA.fields("BillDate") = BillDate
                    rsAA.fields("AType") = AType
                    If Not rsAA.UpdateRow Then GoTo errmsg
                End If
                rs.MoveNext()
            Loop
        End If

        ' Finally
        If Not rsAA.Eof Then
            If Not rsAA.Update Then GoTo errmsg
        End If

        If AType = "A" Then
            If ANO <> LANO Then
                Dim OAmount As Double
                Dim rsAdj As RemoteSet
                Dim AdjLimit As Double

                ' Get Previous Acceptance Info
                rs = db.OpenRemoteSet("Select AType from Acceptance Where ANO=" & pANO)
                If tostr(rs.fields("AType")) = "C" Then ' Adjustment from Cancellation
                    AdjLimit = (1 / 2)
                Else
                    AdjLimit = (2 / 3)
                End If

                rs = db.OpenRemoteSet("Select ID, Type, Code, Currency, Max(TOC) as TOC, Max(PolicyNo) as PolicyNo, Max(Remarks) as Remarks, Min(SDate) as SDate, Max(EDate) as EDate, Max(RCode) as RCode, Max(RefNo) as RefNo, Max(DocNo) as DocNo, Max(BizMapID) as BizMapID, Max(MSCode) as MSCode, Max(Source) as Source, sum(-Amount) as Amount from #AccAss Where CAmount=0 and DepositF=0 and AdjustableF=1 and AdjMethod<>'OVERLIMIT' and ANO=" & ANO & " Group By ID, Type, Code, Currency ")
                Do While Not rs.Eof
                    OAmount = toval(rs.fields("Amount"))
                    If OAmount <> 0 Then
                        rsAdj = db.OpenRemoteSet("Select Max(TOC) as TOC, Max(PolicyNo) as PolicyNo, Max(Remarks) as Remarks, Min(SDate) as SDate, Max(EDate) as EDate, Max(RCode) as RCode, Max(RefNo) as RefNo, Max(DocNo) as DocNo, Max(BizMapID) as BizMapID, Max(MSCode) as MSCode, Max(Source) as Source, sum(Amount) as Amount from #AccAss Where DepositF=0 and AdjMethod<>'OVERLIMIT' and ANO=" & ANO & " and ID='" & tostr(rs.fields("ID")) & "' and Type='" & tostr(rs.fields("Type")) & "' and Code='" & tostr(rs.fields("Code")) & "' and Currency='" & tostr(rs.fields("Currency")) & "'")
                        If Not rsAdj.Eof Then
                            Amount = toval(rsAdj.fields("Amount"))

                            ' Refund Premium Not Bigger than One Third of Original Premium
                            If (OAmount + Amount) / OAmount < AdjLimit Then
                                Amount = -OAmount * (1 - AdjLimit) - Amount
                                rsAA.AddNew()
                                rsAA.fields("ANO") = ANO
                                rsAA.fields("ID") = tostr(rs.fields("ID"))
                                rsAA.fields("Type") = tostr(rs.fields("Type"))
                                rsAA.fields("Code") = tostr(rs.fields("Code"))
                                rsAA.fields("Currency") = tostr(rs.fields("Currency"))
                                rsAA.fields("Currency_OC") = tostr(rs.fields("Currency"))
                                rsAA.fields("Rate") = 1
                                rsAA.fields("CAmount") = 0
                                rsAA.fields("PProrata") = 0
                                rsAA.fields("Prorata") = 1
                                rsAA.fields("TOC") = tostr(rsAdj.fields("TOC"))
                                rsAA.fields("PolicyNo") = tostr(rsAdj.fields("PolicyNo"))
                                rsAA.fields("Remarks") = tostr(rsAdj.fields("Remarks"))
                                rsAA.fields("RCode") = tostr(rsAdj.fields("RCode"))
                                rsAA.fields("RefNo") = tostr(rsAdj.fields("RefNo"))
                                rsAA.fields("BizMapID") = tostr(rsAdj.fields("BizMapID"))
                                rsAA.fields("MSCode") = tostr(rsAdj.fields("MSCode"))
                                rsAA.fields("Source") = tostr(rsAdj.fields("Source"))
                                rsAA.fields("DocNo") = DocNo
                                If InStr("DIICIRBBBABOBCBPBD", rsAA.fields("Type")) <> 0 Then
                                    rsAA.fields("RefNo") = RefNo
                                End If
                                rsAA.fields("SDate") = todate(rsAdj.fields("SDate"))
                                rsAA.fields("EDate") = todate(rsAdj.fields("EDate"))
                                rsAA.fields("Amount_OC") = Amount
                                rsAA.fields("Amount") = Amount
                                rsAA.fields("Posted") = 0
                                rsAA.fields("AdmNo") = -1
                                rsAA.fields("Date") = ADate
                                rsAA.fields("BillDate") = BillDate
                                rsAA.fields("AType") = AType
                                If Not rsAA.Update Then GoTo errmsg
                            End If
                        End If
                    End If
                    rs.MoveNext()
                Loop

            End If
        End If
        rsAA.CloseRemoteSet()

        Make_Balance_AccAss = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Make_Balance_AccAss = False
    End Function
    Private Sub Reinsurance_Gross_Premium_Commission(ByVal ANO As Long, ByVal RID As String, ByVal ID As String, ByVal DocNo As String, ByVal CCode As String, ByVal SDate As Date, ByVal EDate As Date, ByVal RCode As String, ByVal Adjustable As Boolean, ByVal TSI As Double, ByVal PSDate As Date, ByRef Premium As Double, ByRef Commission As Double, ByRef Discount As Double, ByRef Fee As Double)
        Dim rs As RemoteSet
        rs = db.OpenQueryDef("QRCESSIONDET", adOpenForwardonly, ANO, RID, ID, DocNo, CCode, SDate, EDate, RCode, Adjustable, TSI, PSDate)
        Premium = toval(rs.fields("Premium"))
        Commission = toval(rs.fields("Commission"))
        Discount = toval(rs.fields("Discount"))
        Fee = toval(rs.fields("Fee"))
    End Sub

    Private Function First_Date_Of_Period(ByVal tdate As Date, ByVal Period As Integer) As Date
        Dim nMonth As Integer
        If Period <> 0 Then
            nMonth = ((Month(tdate) - 1) \ Period) * Period + 1
            First_Date_Of_Period = DateSerial(Year(tdate), nMonth, 1)
        Else
            First_Date_Of_Period = tdate
        End If
    End Function
    Private Function Last_date_of_period(ByVal tdate As Date, ByVal Period As Integer) As Date
        If Period <> 0 Then
            Last_date_of_period = DateAdd(DateInterval.Day, -1, DateAdd(DateInterval.Month, Period, First_Date_Of_Period(tdate, Period)))
        Else
            Last_date_of_period = tdate
        End If
    End Function

