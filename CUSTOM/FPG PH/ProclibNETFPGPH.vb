        OPFDID = tostr(rsTr.fields("OPFDID"))
        OPFee = toval(rsTr.fields("OPFee"))
        OPFeeAmount = toval(rsTr.fields("OPFeeAmount"))

        BlanketNo = tostr(rsTr.fields("BlanketNo"))
        NoRefundF = toval(rsTr.fields("NoRefundF"))
        Voucher = tostr(rsTr.fields("Voucher"))

