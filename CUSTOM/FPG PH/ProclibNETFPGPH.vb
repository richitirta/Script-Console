    Private Function RiskAssLimit(ByVal ANO As Long, ByVal RType As String, ByRef Holdf As Boolean, ByRef Message As String, ByRef RShare As Double, ByRef PLimit As Double) As Double
        Dim rs As RemoteSet
        Dim Limit As Double
        Dim i As Integer
        Dim StrMsg As String

        PLimit = 0
        Limit = 0
        RShare = 0
        StrMsg = ""
        rs = db.OpenQueryDef("QRISKASSLIMIT", adOpenForwardonly, ANO, RType)
        If Not rs.Eof Then
            Limit = toval(rs.fields("Limit")) / 100
            PLimit = toval(rs.fields("PLimit")) / 100
            RShare = toval(rs.fields("Share"))
            If toval(rs.fields("HoldF")) Then
                Holdf = True
                If tostr(rs.fields("HoldMessage")) <> "" Then
                    If Message <> "" Then Message = Message & Chr(13) & Chr(10)
                    Message = Message & tostr(rs.fields("HoldMessage"))
                End If

                rs = db.OpenRemoteSet("Select R.*, TOC.FLDTAG1, TOC.FLDTAG2, TOC.FLDTAG3, TOC.FLDTAG4, TOC.FLDTAG5, TOC.FLDTAG6, TOC.FLDTAG7, TOC.FLDTAG8, TOC.FLDTAG9, TOC.FLDTAG10, TOC.FLDTAG11, TOC.FLDTAG12, TOC.FLDTAG13, TOC.FLDTAG14, TOC.FLDTAG15 from RiskAss R, TOC Where TOC.TOC=R.TOC and R.RiskAss=" & toval(rs.fields("Riskass")))
                For i = 1 To 15
                    If tostr(rs.fields("FLDID" & i)) <> "" And (tostr(rs.fields("VALUEID" & i)) <> "" Or tostr(rs.fields("VALUEDESC" & i)) <> "") Then
                        If tostr(rs.fields("VALUEID" & i)) <> "" Then
                            StrMsg = StrMsg & tostr(rs.fields("FLDTAG" & i)) & "(" & tostr(rs.fields("FLDID" & i)) & ") : " & tostr(rs.fields("VALUEID" & i)) & "-" & tostr(rs.fields("VALUEDESC" & i))
                        Else
                            StrMsg = StrMsg & tostr(rs.fields("FLDTAG" & i)) & "(" & tostr(rs.fields("FLDID" & i)) & ") : " & tostr(rs.fields("VALUEDESC" & i))
                        End If
                        StrMsg = StrMsg & Chr(13) & Chr(10)
                    End If
                Next
                If StrMsg <> "" Then
                    If Message <> "" Then Message = Message & Chr(13) & Chr(10)
                    Message = Message & StrMsg
                End If
            End If
        End If
        RiskAssLimit = Limit
        rs.CloseRemoteSet()
    End Function
    Private Function CessionLimit(ByVal ANO As Long, ByRef Holdf As Boolean, ByRef Message As String, ByVal PctOurShare As Double, ByVal TSI As Double) As Double
        Dim NCoys As Integer
        Dim ISType As String
        Dim rs As RemoteSet

        rs = db.OpenRemoteSet("Select Cover.ISType from Cover, Acceptance Where Cover.CNO=Acceptance.CNO and Acceptance.ANO=" & ANO)
        ISType = tostr(rs.fields("ISType"))
        If ISType <> "I" Then

            rs = db.OpenQueryDef("Member_Coys", adOpenForwardonly, ANO)
            NCoys = toval(rs.fields("NCoys")) + 1
            If Not rs.Eof Then If ISType = "C" Then NCoys = NCoys + 1

            rs = db.OpenQueryDef("Treaty_Limit", adOpenForwardonly, ANO, PctOurShare, NCoys, TSI)
            CessionLimit = toval(rs.fields("Limit"))
            If toval(rs.fields("HoldF")) Then
                Holdf = True
                If Message <> "" Then Message = Message & Chr(13) & Chr(10)
                Select Case ISType
                    Case "I"
                        Message = Message & "Inward Facultative Cession."
                    Case "C"
                        Message = Message & "Inward Co Cession."
                    Case "L", "I"
                        Message = Message & "Direct Insured Cession"
                End Select
            End If
        Else
            CessionLimit = 100
        End If
        rs.CloseRemoteSet()
    End Function
    Private Function Get_minimum_Premium_By_Rate_Code(ByVal LANO As Long, ByVal RCode As String, ByVal Branch As String, ByVal TOC As String, ByVal CCY As String, ByVal SType As String, ByVal Source As String, ByVal SDate As Date, ByVal Prorata As Double, ByVal Portion As Double) As Double
        Dim rs As RemoteSet
        Dim mPremium As Double
        On Error GoTo errmsg

        mPremium = 0
        rs = db.OpenRemoteSet("Select Top 1 MPREMIUM FROM RCOVER WHERE ANO=" & LANO & " and Code='" & RCode & "' and '" & Format(SDate, "MM/DD/YYYY") & "' Between SDATE and EDATE and MPremium<>0")
        If rs.Eof Then
            rs = db.OpenRemoteSet("Select Top 1 MPremium, FPremiumF from RateMin Where Code='" & RCode & "' and (Source in ('<All>','') or Source ='" & Source & "') and (Branch in ('<All>','') or Branch='" & Branch & "') and (TOC in ('<All>','') or TOC='" & TOC & "') and Currency='" & CCY & "' and (SType='' or SType='" & SType & "') Order By Case When Branch in ('<All>','') Then 1 else 0 end, Case When TOC in ('<All>','') Then 1 else 0 end, Case When Source in ('<All>','') Then 1 else 0 end, MPremium")
            If toval(rs.fields("FPremiumF")) Then
                mPremium = toval(rs.fields("MPremium"))
            Else
                mPremium = toval(rs.fields("MPremium")) * Prorata
            End If
        Else
            mPremium = toval(rs.fields("MPremium")) * Prorata
        End If
        Get_minimum_Premium_By_Rate_Code = mPremium * Portion / 100
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Get_minimum_Premium_By_Rate_Code = mPremium
    End Function
    Private Function Get_minimum_Premium(ByVal TOC As String, ByVal TOPRO As String, ByVal Branch As String, ByVal BizMapID As String, ByVal CCY As String, ByVal Premium As Double, ByVal MinGrossPremium As Double) As Double
        Dim rs As RemoteSet
        Dim mPremium As Double
        On Error GoTo errmsg

        rs = db.OpenRemoteSet("Select Top 1 MPremium from BRRuleMin Where TOC='" & TOC & "' and (Branch='<All>' or Branch='" & Branch & "') and (BizMapID='<All>' or BizMapID='" & BizMapID & "') and (TOPRO='<All>' or TOPRO='" & TOPRO & "') and Currency='" & CCY & "' Order By MPremium")
        mPremium = toval(rs.fields("MPremium"))

        If mPremium <> 0 And mPremium > Premium Then Premium = mPremium
        If MinGrossPremium <> 0 And MinGrossPremium > Premium Then Premium = MinGrossPremium
        Get_minimum_Premium = Premium
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        Get_minimum_Premium = Premium
    End Function

