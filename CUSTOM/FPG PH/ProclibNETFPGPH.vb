    Private Function Get_RateCon(ByVal ANO As Long, ByVal Code As String, ByVal TSI As Double, Optional ByVal Unit As String = "C", Optional ByRef Loading As Double = 0, Optional ByRef TExcess As Double = 0, Optional ByRef PCTLOSS As Double = 0, Optional ByRef PCALC As String = "", Optional ByRef HoldF As Boolean = False, Optional ByRef HoldMessage As String = "", Optional ByVal pSDate As Object = Nothing, Optional ByRef CID As String = "", Optional ByRef SRate As Double = 0) As Double
        Dim rs As RemoteSet
        Dim RateLoadingF As Boolean
        Dim Rate As Double
        Dim SDate As Date
        If Unit = "" Then Unit = "C"
        If TSI = 0 Then TSI = 1
        If IsDate(pSDate) Then
            SDate = pSDate
        Else
            rs = db.OpenRemoteSet("Select SDate from Acceptance Where ANO=" & ANO)
            SDate = rs.fields("SDate")
        End If
        rs = db.OpenRemoteSet("Select Top 1 * from fn_RateCon(" & ANO & ",'" & Code & "'," & tovalSF(TSI) & ",'" & Format(SDate, "MM/DD/YYYY") & "') Where AllowedF=1")
        Code = tostr(rs.fields("Code"))
        RateLoadingF = toval(rs.fields("RateLoadingF"))
        Rate = toval(rs.fields("Rate"))
        Loading = toval(rs.fields("Loading")) / 100
        TExcess = toval(rs.fields("TExcess"))
        PCTLOSS = toval(rs.fields("PCTLOSS"))
        PCALC = tostr(rs.fields("PCALC"))
        If TSI <> 0 And Unit = "F" Then
            ' To Flat Rate
            Rate = Round(TSI * Rate / 100, 2)
        ElseIf Unit = "M" Then
            ' To Mile
            Rate = Rate * 10
        End If
        If toval(rs.fields("ProgressiveF")) AndAlso TSI > toval(rs.fields("MaxTSI")) Then Rate = 0
        If Loading = 0 Then Loading = 1
        If RateLoadingF Then
            Loading = Loading * Get_RateLoading(ANO, Code, SDate, TSI, HoldF, HoldMessage, CID, , SRate)
            If TSI <> 0 And Unit = "F" Then
                ' To Flat Rate
                SRate = Round(TSI * SRate / 100, 2)
            ElseIf Unit = "M" Then
                ' To Mile
                SRate = SRate * 10
            End If
        End If
        Get_RateCon = Rate
    End Function
