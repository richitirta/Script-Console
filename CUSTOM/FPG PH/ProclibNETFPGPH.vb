                    rsCA.fields("Source") = Source
                    rsCA.fields("CNO") = CNO
                    rsCA.fields("Type") = IIf(Left(tostr(rs.fields("FDType")), 1) = "O", "OP", IIf(ISType = "I", "DI", IIf(ISType = "R", "IR", "IC")))
                    rsCA.fields("Code") = "V"
                    rsCA.fields("CodeExt") = IIf(Len(tostr(rs.fields("FDType"))) > 1, Right(tostr(rs.fields("FDType")), 1), "")
                    rsCA.fields("ID") = IIf(tostr(rs.fields("Payment")) = "<Payor>", tostr(rsClaim.fields("Payment")), tostr(rs.fields("Payment")))
                    rsCA.fields("RefNo") = tostr(rsClaim.fields("RefNo"))
                    rsCA.fields("DocNo") = DocNo
                    rsCA.fields("ClaimNo") = ClaimNo
                    rsCA.fields("Date") = ADate
                    rsCA.fields("BillDate") = ADate
                    rsCA.fields("TOC") = TOC
                    rsCA.fields("Remarks") = AName
                    rsCA.fields("CAmount") = toval(rs.fields("VAT"))
                    rsCA.fields("Amount_OC") = toval(rsCA.fields("CAmount"))
                    rsCA.fields("Amount") = toval(rsCA.fields("CAmount"))
                    rsCA.fields("Rate") = 1
                    rsCA.fields("AdmNo") = -1
