            Case "RELEASECLAREGAMOUNT"
                Call_Process_Execute = ReleaseClaRegAmount(toval(Param1))
                If Call_Process_Execute = True Then Process_OK = True
            Case "CREATE_VOUCHER"
                Call_Process_Execute = Create_Voucher(tostr(Param1), toval(Param2), toval(Param3), todate(Param4), toval(Param5))
                If Call_Process_Execute <> "" Then Process_OK = True
            Case "POSTING_SURPLUSCALCULATION"
