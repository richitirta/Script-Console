                    If Not rsAA.Update Then GoTo errmsg

                    rs.MoveNext()
                Loop
            End If
        End If

        rs.CloseRemoteSet()
        rsAA.CloseRemoteSet()

        If AType = "C" And EMethod = "A" Then ' Cancel All
            If Not Make_Balance_AccAss(ANO, pANO, ANO, AType, RefNo, PSDate, ADate, BillDate, PDate, PPDate, CProrata, DocNo, PPeriod, NoRefundF, RefundType, EMethod, ISType, SplitDNCNF) Then GoTo errmsg
        End If

        If Not TemporaryF Then
            ' Immediately Posting to Adm
            If Not BackDatedF Then
                If Not Production_To_Adm(ANO, ANO, , True, Voucher, SplitDNCNF) Then GoTo errmsg

                ' Posting to Admlink Detail Acceptance
                rs = db.OpenRemoteSet("Select ANO, RANO from Acceptance Where LANO =" & ANO & " and ANO<>lANO", adOpenForwardonly)
                Do While Not rs.Eof
                    ' Immediately Posting to Adm
                    If rs.fields("RANO") <> -1 Then
                        Dim Param(8) As Object
                        Param(8) = False ' Create Voucher
                        If Not Posting_SurplusCalculation(ADate, Param, rs.fields("RANO")) Then GoTo errmsg
                    End If
                    If Not Production_To_Adm(rs.fields("ANO"), ANO, , DetailTreatyF, Voucher, SplitDNCNF) Then GoTo errmsg
                    rs.MoveNext()
                Loop
                rs.CloseRemoteSet()

                If Not OpenFlag Then
                    rs = db.OpenRemoteSet("Select Max(AccAss.ANO) as ANO, Admlink.ID, TOC.COB, TOC.ConsortiumF, AccAss.CommPoolF, Admlink.TYPE, Admlink.CURRENCY, Admlink.REFNO, Admlink.DATE, Admlink.BILLDATE, Admlink.DOCNO, Admlink.Subject, Admlink.BRANCH, Admlink.Segment, Admlink.A_PolicyNo from Admlink, AccAss, Acceptance, TOC Where TOC.TOC=Admlink.Code and Admlink.Admno=AccAss.AdmNo and Admlink.WriteF=0 and AccAss.ANO=Acceptance.ANO and Admlink.VoucherF=0 and Acceptance.LANO=" & ANO & " Group By Admlink.ID, TOC.COB, TOC.ConsortiumF, AccAss.CommPoolF, Admlink.TYPE, Admlink.CURRENCY, Admlink.REFNO, Admlink.DATE, Admlink.BILLDATE, Admlink.DOCNO, Admlink.Subject, Admlink.BRANCH, Admlink.Segment, Admlink.A_PolicyNo")
                Else
                    rs = db.OpenRemoteSet("Select Max(AccAss.ANO) as ANO, Admlink.ID, TOC.COB, TOC.ConsortiumF, AccAss.CommPoolF, Admlink.TYPE, Admlink.CURRENCY, Admlink.REFNO, Admlink.DATE, Admlink.BILLDATE, Admlink.DOCNO, Admlink.Subject, Admlink.BRANCH, Admlink.Segment, Admlink.A_PolicyNo from Admlink, AccAss, TOC Where TOC.TOC=Admlink.Code and Admlink.AdmNo=AccAss.AdmNo and Admlink.WriteF=0 and Admlink.VoucherF=0 and AccAss.ANO=" & ANO & " Group by Admlink.ID, TOC.COB, TOC.ConsortiumF, AccAss.CommPoolF, Admlink.TYPE, Admlink.CURRENCY, Admlink.REFNO, Admlink.DATE, Admlink.BILLDATE, Admlink.DOCNO, Admlink.Subject, Admlink.BRANCH, Admlink.Segment, Admlink.A_PolicyNo")
                End If
                Do While Not rs.Eof

                    Dim rsAdmNo As RemoteSet
                    Dim sAdmNo As String = ""
                    rsAdmNo = db.OpenRemoteSet("Select A.AdmNo from Admlink A, TOC T Where A.Code=T.TOC and A.VoucherF=0 and A.WriteF=0 and A.ID='" & rs.fields("ID") & "' and T.COB='" & rs.fields("COB") & "' and A.Type='" & rs.fields("Type") & "' and A.Currency='" & rs.fields("Currency") & "' and A.RefNo='" & rs.fields("RefNo") & "' and A.Date='" & Format(rs.fields("Date"), "MM/DD/YYYY") & "' and A.BillDate='" & Format(rs.fields("BillDate"), "MM/DD/YYYY") & "' and A.DocNo='" & rs.fields("DocNo") & "' and A.Subject='" & rs.fields("Subject") & "' and A.Branch='" & rs.fields("Branch") & "' and A.Segment='" & rs.fields("Segment") & "' and A.A_PolicyNo='" & rs.fields("A_PolicyNo") & "'")
                    If Not rsAdmNo.Eof Then
                        Do While Not rsAdmNo.Eof
                            If sAdmNo = "" Then
                                sAdmNo = tostr(rsAdmNo.fields("AdmNo"))
                            Else
                                sAdmNo = sAdmNo & "," & tostr(rsAdmNo.fields("AdmNo"))
                            End If
                            rsAdmNo.MoveNext()
                        Loop
                        If Not Production_To_Adm_Finalize(rs.fields("ANO"), ANO, sAdmNo, , SplitDNCNF) Then GoTo errmsg
                        If Not toval(rs.fields("CommPoolF")) And (OpenFlag Or DetailTreatyF Or toval(rs.fields("ConsortiumF")) Or InStr("DIIRITIXICJPCFFOFPBBBABOBCBPBDOPDCCPXPAFDPDR", rs.fields("Type")) <> 0) Then
                            If Create_Voucher(sAdmNo, True) = "" Then GoTo errmsg
                        End If
                    End If
                    rs.MoveNext()
                Loop

                If RANO <> -1 Then
                    rs = db.OpenRemoteSet("Select Distinct A1.AdmNo from AccSurplus A1, Acceptance A2, Admlink A3 where A3.AdmNo=A1.AdmNo and A3.VoucherF=0 and A1.ANO=A2.RANO and A1.Status='P' and A2.LANO=" & ANO)
                    Do While Not rs.Eof
                        If Create_Voucher(rs.fields("AdmNo"), True) = "" Then GoTo errmsg
                        rs.MoveNext()
                    Loop
                End If
            End If

            If AType <> "N" And AType <> "A" And pANO <> -1 Then
                ' Update Previous Status
                If EMethod <> "A" Then
                    If Not db.Execute("Update Acceptance set Astatus='C', CloseDate='" & Format(ADate, "MM/DD/YYYY") & "', CUserID='" & db_user & "' where ANO=" & pANO) Then GoTo errmsg
                Else
                    If Not db.Execute("Update Acceptance Set AStatus='C', CloseDate='" & Format(ADate, "MM/DD/YYYY") & "', CUserID='" & db_user & "', PPDate='" & Format(PDate, "MM/DD/YYYY") & "' Where PDate>='" & Format(PDate, "MM/DD/YYYY") & "' and AStatus<>'W' and LANO=ANO and ANO<>" & ANO & " and OANO=" & OANO) Then GoTo errmsg
                End If

                'Update Link from Detail Acceptance
                If Not db.Execute("Update A set LANO=" & ANO & " from Acceptance A where LANO=" & pANO & " and LANO<>ANO and AStatus='I' and Not Exists (Select PANO from Acceptance Where Acceptance.PANO=A.ANO)") Then GoTo errmsg

                'Carry Forward Certificate Number from Previous Cover
                If Not db.Execute("Update Cover Set CertNum=pCover.CertNum from Cover, Cover pCover Where Cover.CertNum<pCover.CertNum and pCover.CNO=Cover.pCNO and Cover.ASource='MKT' and Cover.CNO=" & CNO) Then GoTo errmsg
            End If

            If AType = "A" Then
                If Not db.Execute("Update Acceptance Set AdjustableF=0 from Acceptance Where Acceptance.ANO=" & pANO) Then GoTo errmsg
            End If

            ' Update Services
            rs = db.OpenRemoteSet("Select * from Service Where SType<>'Claim' and SStatus='P' and ANO=" & ANO)
            If Not rs.Eof Then
                rs.Edit()
                If rs.fields("PolicyNo") = "" Then
                    rs.fields("PolicyNo") = PolicyNo
                    rs.fields("CertificateNo") = ""
                End If
                rs.fields("SStatus") = "A"
                rs.fields("AUserID") = br_Approval_user
                rs.fields("AUserDate") = Today.Date
                rs.fields("AUserTime") = Time()
                If Not rs.Update Then GoTo errmsg
            End If

            ' Update Renewal References
            If AType <> "A" And AType <> "C" And pANO <> -1 Then
                If Not db.Execute("Update Cover set pCNO=" & CNO & " from Acceptance, Cover Where Cover.CNO=Acceptance.CNO and Acceptance.RANO=" & pANO) Then GoTo errmsg
                If Not db.Execute("Update Acceptance set RANO=" & ANO & " from Acceptance, Cover Where Cover.CNO=Acceptance.CNO and Acceptance.RANO=" & pANO) Then GoTo errmsg
            End If

            ' Update Facultative Status
            If Not db.Execute("Update RArrDet Set Status='A' Where Status='R' and ANO=" & ANO) Then GoTo errmsg

            If AType <> "A" And AType <> "C" And pANO <> -1 Then
                ' Update Renewal References
                If Not db.Execute("Update Renewal Set ANO=" & ANO & ", PStatus='I' Where ANO=" & pANO) Then GoTo errmsg
            End If

            If RANO <> -1 Then
                If Not db.Execute("Update Renewal Set Status='P' Where NEWANO=" & ANO) Then GoTo errmsg
            End If

            ' Update Policy No in Conjunct Policy
            If AType = "N" And PolicyNo <> "" Then
                If Not db.Execute("Update Acceptance Set CPolicyNo='" & PolicyNo & "' from Acceptance Where CANO<>-1 and CANO=" & ANO) Then GoTo errmsg
            End If

            'Set Current status
            If Not db.Execute("Update Acceptance Set Source='" & Source & "', BackDatedF=" & IIf(BackDatedF, 1, 0) & ", AStatus='I', AUserDate='" & Format(Today.Date, "MM/DD/YYYY") & "', AUserTime='" & Time() & "', AUserID='" & br_Approval_user & "', ADate='" & Format(ADate, "MM/DD/YYYY") & "',PolicyNo='" & PolicyNo & "' Where AStatus in ('W','T') and ANO=" & ANO) Then GoTo errmsg
            If db.RecordsAffected = 0 Then
                StrMsg = "Please Check Policy Data !"
                GoTo errmsg
            End If
        End If

        If AutoParsingFieldF Then
            If Not Parsing_AccCla(ANO) Then
                StrMsg = "Error Parsing TC !"
                GoTo errmsg
            End If
        End If

        InforceMaster = True
        Exit Function
errmsg:
        StrMsg = StrError(StrMsg)
        InforceMaster = False
    End Function
    Private Function Temporary_Inforce(ByVal ANO As Long, Optional ByVal ESeqNo As Long = 0, Optional ByVal EESeqNo As Long = 0, Optional ByVal br_Approval_user As String = "", Optional ByVal BackDatedF As Boolean = False, Optional ByVal pADate As Object = "", Optional ByVal pBillDate As Object = "", Optional ByVal Bulkf As Boolean = False, Optional ByVal PolicyNo As String = "", Optional ByVal MDocNo As String = "", Optional ByVal MAName As String = "", Optional ByVal TemporaryF As Boolean = False) As Boolean
        Temporary_Inforce = Inforce(ANO, br_Approval_user, BackDatedF, pADate, "", ESeqNo, EESeqNo, pBillDate, Bulkf, PolicyNo, MDocNo, MAName, True)
    End Function
    Private Sub GetReinsuranceAdjustmentAmount(ByVal ANO As Long, ByVal TOC As String, ByRef QAdjAmount As Double, ByRef SP1AdjAmount As Double, ByRef SP2AdjAmount As Double, ByRef SP3AdjAmount As Double, ByRef AAdjAmount As Double)
        Dim rsRA As RemoteSet
        Dim rsAdj As RemoteSet
        Dim rs As RemoteSet
        Dim Saldo As Double
        Dim SaldoAdj As Double
        Dim Share As Double
        Dim ShareAdj As Double
        Dim i As Integer

        QAdjAmount = 0
        SP1AdjAmount = 0
        SP2AdjAmount = 0
        SP3AdjAmount = 0
        AAdjAmount = 0

        rsRA = db.OpenQueryDef("QRArrHeader", adOpenForwardonly, ANO)
        rsAdj = db.OpenRemoteSet("Select I1.Qty, I1.UValue as AdjAmount, I2.Amount from ICoverDet I1, ICover I2 Where I1.INO=I2.INO and I1.UValue>I2.Amount and I1.ANO=" & ANO)

        Do While Not rsAdj.Eof
            For i = 1 To rsAdj.fields("QTY")
                Saldo = rsAdj.fields("Amount") * (rsRA.fields("PCTShare") - rsRA.fields("MShare")) / 100
                SaldoAdj = rsAdj.fields("AdjAmount") * (rsRA.fields("PCTShare") - rsRA.fields("MShare")) / 100

                ' Quota Share
                If tostr(rsRA.fields("QID")) <> "" Then
                    rs = db.OpenRemoteSet("Select R2.Limit, R1.Share from Reinsurance R1, ReClass R2 Where R2.RNO=R1.RNO and R2.TOC='" & TOC & "' and R1.RID='" & tostr(rsRA.fields("QID")) & "'")
                    Share = rs.fields("Limit")
                    ShareAdj = rs.fields("Limit")
                    If ShareAdj > SaldoAdj Then
                        ShareAdj = SaldoAdj
                    End If
                    If Share > Saldo Then
                        Share = Saldo
                    End If
                    If ShareAdj > Share Then
                        QAdjAmount = QAdjAmount + (ShareAdj - Share) * rs.fields("Share") / 100
                    End If
                    Saldo = Saldo - Share
                    SaldoAdj = SaldoAdj - ShareAdj
                End If

                ' Surplus #1
                If tostr(rsRA.fields("SP1ID")) <> "" Then
                    rs = db.OpenRemoteSet("Select R2.Limit, R1.Share from Reinsurance R1, ReClass R2 Where R2.RNO=R1.RNO and R2.TOC='" & TOC & "' and R1.RID='" & tostr(rsRA.fields("SP1ID")) & "'")
                    Share = rs.fields("Limit")
                    ShareAdj = rs.fields("Limit")
                    If ShareAdj > SaldoAdj Then
                        ShareAdj = SaldoAdj
                    End If
                    If Share > Saldo Then
                        Share = Saldo
                    End If
                    If ShareAdj > Share Then
                        SP1AdjAmount = SP1AdjAmount + (ShareAdj - Share)
                    End If
                    Saldo = Saldo - Share
                    SaldoAdj = SaldoAdj - ShareAdj
                End If

                ' Surplus #2
                If tostr(rsRA.fields("SP2ID")) <> "" Then
                    rs = db.OpenRemoteSet("Select R2.Limit, R1.Share from Reinsurance R1, ReClass R2 Where R2.RNO=R1.RNO and R2.TOC='" & TOC & "' and R1.RID='" & tostr(rsRA.fields("SP2ID")) & "'")
                    Share = rs.fields("Limit")
                    ShareAdj = rs.fields("Limit")
                    If ShareAdj > SaldoAdj Then
                        ShareAdj = SaldoAdj
                    End If
                    If Share > Saldo Then
                        Share = Saldo
                    End If
                    If ShareAdj > Share Then
                        SP2AdjAmount = SP2AdjAmount + (ShareAdj - Share)
                    End If
                    Saldo = Saldo - Share
                    SaldoAdj = SaldoAdj - ShareAdj
                End If

                ' Surplus #3
                If tostr(rsRA.fields("SP3ID")) <> "" Then
                    rs = db.OpenRemoteSet("Select R2.Limit, R1.Share from Reinsurance R1, ReClass R2 Where R2.RNO=R1.RNO and R2.TOC='" & TOC & "' and R1.RID='" & tostr(rsRA.fields("SP3ID")) & "'")
                    Share = rs.fields("Limit")
                    ShareAdj = rs.fields("Limit")
                    If ShareAdj > SaldoAdj Then
                        ShareAdj = SaldoAdj
                    End If
                    If Share > Saldo Then
                        Share = Saldo
                    End If
                    If ShareAdj > Share Then
                        SP2AdjAmount = SP2AdjAmount + (ShareAdj - Share)
                    End If
                    Saldo = Saldo - Share
                    SaldoAdj = SaldoAdj - ShareAdj
                End If

                ' Auto Fac
                If tostr(rsRA.fields("AID")) <> "" Then
                    rs = db.OpenRemoteSet("Select R2.Limit, R1.Share from Reinsurance R1, ReClass R2 Where R2.RNO=R1.RNO and R2.TOC='" & TOC & "' and R1.RID='" & tostr(rsRA.fields("AID")) & "'")
                    Share = rs.fields("Limit")
                    ShareAdj = rs.fields("Limit")
                    If ShareAdj > SaldoAdj Then
                        ShareAdj = SaldoAdj
                    End If
                    If Share > Saldo Then
                        Share = Saldo
                    End If
                    If ShareAdj > Share Then
                        AAdjAmount = AAdjAmount + (ShareAdj - Share) * rs.fields("Share") / 100
                    End If
                    Saldo = Saldo - Share
                    SaldoAdj = SaldoAdj - ShareAdj
                End If
            Next

            rsAdj.MoveNext()
        Loop

    End Sub
    Private Function UpdateClaimPolicyReference(ByVal CNO As Long, ByVal ANO As Long, ByVal NewANO As Long) As Boolean
        Try
            Dim rs As RemoteSet
            ' Update Accumulated Claim Indemnity in Previous Interest Cover
            Dim rsI As RemoteSet
            rs = db.OpenRemoteSet("Select INO, NOC, sum(Estimate/Rate) as Estimate, sum(Amount/Rate) as Indemnity from CLLoss Where CNO=" & CNO & " Group By CLLoss.INO, CLLoss.NOC")
            Do While Not rs.Eof
                rsI = db.OpenRemoteSet("Select * from ICover Where INO=" & toval(rs.fields("INO")))
                If Not rsI.Eof Then
                    rsI.Edit()
                    rsI.fields("Estimate") = toval(rsI.fields("Estimate")) - toval(rs.fields("Estimate"))
                    rsI.fields("Indemnity") = toval(rsI.fields("Indemnity")) - toval(rs.fields("Indemnity"))
                    If Not rsI.Update Then Throw New Exception(rsI.ErrDesc)
                End If

                rsI = db.OpenRemoteSet("Select * from ICoverNOC Where INO=" & toval(rs.fields("INO")) & " and NOC='" & tostr(rs.fields("NOC")) & "'")
                If Not rsI.Eof Then
                    rsI.Edit()
                    rsI.fields("Estimate") = toval(rsI.fields("Estimate")) - toval(rs.fields("Estimate"))
                    rsI.fields("Indemnity") = toval(rsI.fields("Indemnity")) - toval(rs.fields("Indemnity"))
                    If Not rsI.Update Then Throw New Exception(rsI.ErrDesc)
                End If

                rs.MoveNext()
            Loop

            ' Adjust Claim Policy/Certificate Reference
            If Not db.Execute("Update Claim Set ANO=" & NewANO & " from Claim Where CNO=" & CNO) Then Throw New Exception(db.ErrDesc)

            ' Adjust Loss Item Interest Reference
            If Not db.Execute("UPDATE C Set INO=I2.INO from ICover I1, ICover I2, Acceptance A, CLLOSS C Where C.CNO=" & CNO & " And I1.ANO = " & ANO & " And I2.ANO = " & NewANO & " And C.INO = I1.INO and I1.TOI=I2.TOI and cast(I1.Remark as varchar(256))=Cast(I2.Remark as varchar(256)) and I1.Currency=I2.Currency and I1.SI=I2.SI and I1.Amount=I2.Amount and I1.Total=I2.Total") Then Throw New Exception(db.ErrDesc)

            ' Adjust Salvage Interest Reference
            If Not db.Execute("UPDATE C Set INO=I2.INO from ICover I1, ICover I2, Acceptance A, CLSAL C Where C.CNO=" & CNO & " And I1.ANO = " & ANO & " And I2.ANO = " & NewANO & " And C.INO = I1.INO and I1.TOI=I2.TOI and cast(I1.Remark as varchar(256))=Cast(I2.Remark as varchar(256)) and I1.Currency=I2.Currency and I1.SI=I2.SI and I1.Amount=I2.Amount and I1.Total=I2.Total") Then Throw New Exception(db.ErrDesc)

            ' Adjust Claim Document Check List
            If Not db.Execute("UPDATE C Set INO=I2.INO from ICover I1, ICover I2, Acceptance A, CDOCLIST C Where C.CNO=" & CNO & " And I1.ANO = " & ANO & " And I2.ANO = " & NewANO & " And C.INO = I1.INO and I1.TOI=I2.TOI and cast(I1.Remark as varchar(256))=Cast(I2.Remark as varchar(256)) and I1.Currency=I2.Currency and I1.SI=I2.SI and I1.Amount=I2.Amount and I1.Total=I2.Total") Then Throw New Exception(db.ErrDesc)

            ' Adjust Claim Information
            If Not db.Execute("UPDATE C Set INO=I2.INO from ICover I1, ICover I2, Acceptance A, CLINFO C Where C.CNO=" & CNO & " And I1.ANO = " & ANO & " And I2.ANO = " & NewANO & " And C.INO = I1.INO and I1.TOI=I2.TOI and cast(I1.Remark as varchar(256))=Cast(I2.Remark as varchar(256)) and I1.Currency=I2.Currency and I1.SI=I2.SI and I1.Amount=I2.Amount and I1.Total=I2.Total") Then Throw New Exception(db.ErrDesc)

            ' Adjust Claim Register Salvage Item
            If Not db.Execute("UPDATE C Set INO=I2.INO from ICover I1, ICover I2, Acceptance A, CLSALITEM C Where C.CNO=" & CNO & " And I1.ANO = " & ANO & " And I2.ANO = " & NewANO & " And C.INO = I1.INO and I1.TOI=I2.TOI and cast(I1.Remark as varchar(256))=Cast(I2.Remark as varchar(256)) and I1.Currency=I2.Currency and I1.SI=I2.SI and I1.Amount=I2.Amount and I1.Total=I2.Total") Then Throw New Exception(db.ErrDesc)

            ' Update Accumulated Claim Indemnity in Current Interest Cover
            rs = db.OpenRemoteSet("Select INO, NOC, sum(Estimate/Rate) as Estimate, sum(Amount/Rate) as Indemnity from CLLoss Where CNO=" & CNO & " Group By CLLoss.INO, CLLoss.NOC")
            Do While Not rs.Eof
                rsI = db.OpenRemoteSet("Select * from ICover Where INO=" & toval(rs.fields("INO")))
                If Not rsI.Eof Then
                    rsI.Edit()
                    rsI.fields("Estimate") = toval(rsI.fields("Estimate")) + toval(rs.fields("Estimate"))
                    rsI.fields("Indemnity") = toval(rsI.fields("Indemnity")) + toval(rs.fields("Indemnity"))
                    If Not rsI.Update Then Throw New Exception(rsI.ErrDesc)
                End If

                rsI = db.OpenRemoteSet("Select * from ICoverNOC Where INO=" & toval(rs.fields("INO")) & " and NOC='" & tostr(rs.fields("NOC")) & "'")
                If Not rsI.Eof Then
                    rsI.Edit()
                    rsI.fields("Estimate") = toval(rsI.fields("Estimate")) + toval(rs.fields("Estimate"))
                    rsI.fields("Indemnity") = toval(rsI.fields("Indemnity")) + toval(rs.fields("Indemnity"))
                    If Not rsI.Update Then Throw New Exception(rsI.ErrDesc)
                End If

                rs.MoveNext()
            Loop

            UpdateClaimPolicyReference = True
        Catch ex As Exception
            StrMsg = ex.Message
            UpdateClaimPolicyReference = False
        End Try
    End Function
    Private Function Inforce(ByVal ANO As Long, Optional ByVal br_Approval_user As String = "", Optional ByVal BackDatedF As Boolean = False, Optional ByVal pADate As Object = "", Optional ByVal Voucher As String = "", Optional ByVal ESeqNo As Long = 0, Optional ByVal EESeqNo As Long = 0, Optional ByVal pBillDate As Object = "", Optional ByVal Bulkf As Boolean = False, Optional ByVal PolicyNo As String = "", Optional ByVal MDocNo As String = "", Optional ByVal MAName As String = "", Optional ByVal TemporaryF As Boolean = False, Optional ByVal MRefNo As String = "", Optional ByVal ERSeqNo As Long = 0) As Boolean
        Dim rs As RemoteSet
        Dim rsAcc As RemoteSet
        Dim pANO As Long
        Dim OCNO As Long
        Dim OANO As Long
        Dim RANO As Long
        Dim CNO As Long
        Dim AType As String
        Dim ADate As Date
        Dim BillDate As Date
        Dim PDate As Date
        Dim PPDate As Date
        Dim Branch As String
        Dim RefNo As String
        Dim RegNo As String
        Dim CProrata As Double
        Dim MasterFlag As Boolean
        Dim Renewal As Integer
        Dim AName As String
        Dim PSDate As Date
        Dim PEDate As Date
        Dim QTY As Integer
        Dim PPeriod As Integer
        Dim NoRefundF As Integer
        Dim RefundType As String
        Dim pNoRefundF As Boolean
        Dim dNoRefundF As Boolean
        Dim BizMapID As String
        Dim MSCode As String
        Dim CT As String
        Dim DueByEffectiveF As Boolean
        Dim DetailTreatyF As Boolean
        Dim UjrohShariaF As Boolean
        Dim PHolderLimitF As Boolean
        Dim AdjustmentPolicyDepositF As Boolean
        Dim ApplyReinsuranceDepositF As Boolean
        Dim ApplyCommissionDepositF As Boolean
        Dim AutoParsingFieldF As Boolean
        Dim EMethod As String
        Dim Separator As String
        Dim AStatus As String
        Dim Source As String
        Dim sDiscount As Double
        Dim UJrohPCT As Double
        Dim NumCCY As Integer
        Dim TOC As String
        Dim SplitDNCNF As Boolean = False
        Dim VATSubsidiesF As Boolean
        Dim CalculationRoundingF As Boolean

        On Error GoTo errmsg

        ' Update Current Acceptance Status to Temporary Inforce
        If Not db.Execute("Update Acceptance set AStatus='T', RUserID=Case When AStatus='T' Then RUserID else '" & db_user & "' end, RUserDate=Case When AStatus='T' Then RUserDate else '" & Format(Today.Date, "MM/DD/YYYY") & "' end, RUserTime=Case When AStatus='T' Then RUserTime else '" & Time() & "' end where AStatus in ('W','T') and ANO=" & ANO) Then GoTo errmsg
        If db.RecordsAffected = 0 Then
            StrMsg = "Please Check Policy Data !"
            GoTo errmsg
        End If

        If Not ReleaseAccRegAmount(ANO, True) Then GoTo errmsg

        rs = db.OpenRemoteSet("Select DueByEffectiveF, DetailTreatyF, UjrohShariaF, PHolderLimitF, AdjustmentPolicyDepositF, ApplyReinsuranceDepositF, ApplyCommissionDepositF, VATSubsidiesF, CalculationRoundingF from SysTab", adOpenForwardonly)
        DueByEffectiveF = toval(rs.fields("DueByEffectiveF"))
        DetailTreatyF = toval(rs.fields("DetailTreatyF"))
        UjrohShariaF = toval(rs.fields("UjrohShariaF"))
        PHolderLimitF = toval(rs.fields("PHolderLimitF"))
        AdjustmentPolicyDepositF = rs.fields("AdjustmentPolicyDepositF")
        ApplyReinsuranceDepositF = toval(rs.fields("ApplyReinsuranceDepositF"))
        ApplyCommissionDepositF = toval(rs.fields("ApplyCommissionDepositF"))
        VATSubsidiesF = toval(rs.fields("VATSubsidiesF"))
        CalculationRoundingF = toval(rs.fields("CalculationRoundingF"))

        rsAcc = db.OpenRemoteSet("Select OANO, PANO, RANO, CNO, ATYPE, NOREFUNDF, RefundType, EMethod, BizMapID, MSCode, Source, CT, TOC, AStatus, ADate, AName, PDate, PPDate, SDate, EDate, Branch, RefNo, RegNo, Renewal, LANO, DIscount, AUserID, Qty, ESeqNo, EESeqNo, ERSeqNo, PolicyNo, Ujroh, CertificateNo, CPCT, SplitDNCNF from Acceptance Where ANO=" & ANO)
        OANO = toval(rsAcc.fields("OANO"))
        pANO = toval(rsAcc.fields("PANO"))
        RANO = toval(rsAcc.fields("RANO"))
        CNO = toval(rsAcc.fields("CNO"))
        AType = tostr(rsAcc.fields("AType"))
        NoRefundF = toval(rsAcc.fields("NoRefundF"))
        RefundType = tostr(rsAcc.fields("RefundType"))
        EMethod = tostr(rsAcc.fields("EMethod"))
        BizMapID = tostr(rsAcc.fields("BizMapID"))
        MSCode = tostr(rsAcc.fields("MSCode"))
        Source = tostr(rsAcc.fields("Source"))
        CT = tostr(rsAcc.fields("CT"))
        TOC = tostr(rsAcc.fields("TOC"))
        SplitDNCNF = toval(rsAcc.fields("SplitDNCNF"))
        AStatus = tostr(rsAcc.fields("AStatus"))
        If Not (AStatus = "W" Or AStatus = "T") Then
            StrMsg = "Please Check Policy Data Status !"
            GoTo errmsg
        End If

        If IsDate(pADate) Then
            ADate = pADate
        Else
            ADate = todate(rsAcc.fields("ADate"))
        End If

        ' Change the BillDate Here !
        If AType <> "A" Then ' Not Adjustment 
            If IsDate(pBillDate) Then
                BillDate = pBillDate
            Else
                If DueByEffectiveF Then
                    BillDate = todate(rsAcc.fields("PDate"))
                Else
                    BillDate = ADate
                End If
            End If
        Else
            BillDate = ADate
        End If

        AName = IIf(MAName = "", tostr(rsAcc.fields("AName")), MAName)
        PDate = todate(rsAcc.fields("PDate"))
        PPDate = todate(rsAcc.fields("PPDate"))
        PSDate = todate(rsAcc.fields("SDate"))
        PEDate = todate(rsAcc.fields("EDate"))
        Branch = tostr(rsAcc.fields("Branch"))
        RefNo = IIf(MRefNo = "", tostr(rsAcc.fields("RefNo")), MRefNo)
        RegNo = tostr(rsAcc.fields("RegNo"))
        Renewal = toval(rsAcc.fields("Renewal"))
        MasterFlag = (toval(rsAcc.fields("LANO")) <> -1)
        sDiscount = toval(rsAcc.fields("Discount"))

        If br_Approval_user = "" Then
            br_Approval_user = rsAcc.fields("AUserID")
        End If
        QTY = IIf(toval(rsAcc.fields("Qty")) = 0, 1, toval(rsAcc.fields("Qty")))

        Dim VoyageF As Boolean
        Dim OpenFlag As Boolean
        Dim DocNo As String
        Dim rsAA As RemoteSet
        Dim rsIC As RemoteSet
        Dim rsRA As RemoteSet
        Dim rsDetail As RemoteSet

        Dim PID As String
        Dim PDiscount As Double
        Dim PType As String
        Dim PolicyType As String
        Dim ISType As String
        Dim BSTYPE As String
        Dim Gross As Double
        Dim Premium As Double
        Dim Ujroh As Double
        Dim Commission As Double
        Dim Discount As Double
        Dim UpFee As Double
        Dim FDiscount As Double ' Rate Discount (Ex. Fleet Discount)
        Dim FLoading As Double ' Rate Loading
        Dim GDiscount As Double ' Group Discount
        Dim NDiscount As Double ' No Claim Bonus Discount
        Dim SLoading As Double  ' Surcharge Loading
        Dim SDate As Date
        Dim EDate As Date
        Dim CCode As String = ""
        Dim RCode As String
        Dim Prorata As Integer
        Dim PProrata As Double
        Dim RProrata As Double
        Dim AdjustableF As Boolean
        Dim AdjMethod As String
        Dim MShare As Double
        Dim PShare As Double
        Dim Share As Double
        Dim Fee As Double
        Dim SType As String

        rs = db.OpenRemoteSet("Select Voyage, OpenFlag, PolicyType, ISType, OCNO, PPeriod, Prorata from Cover Where CNO=" & CNO)
        VoyageF = toval(rs.fields("Voyage"))
        OpenFlag = toval(rs.fields("OpenFlag"))
        PolicyType = tostr(rs.fields("PolicyType"))
        ISType = tostr(rs.fields("ISType"))
        OCNO = toval(rs.fields("OCNO"))
        PPeriod = toval(rs.fields("PPeriod"))    ' Prorata Basis
        Prorata = toval(rs.fields("Prorata"))    ' Daily Basis Prorata
        rs.CloseRemoteSet()

        rs = db.OpenRemoteSet("Select AutoParsingFieldF from TOC Where TOC='" & TOC & "'")
        AutoParsingFieldF = rs.fields("AutoParsingFieldF")
        rs.CloseRemoteSet()

        MShare = 0

        If Not MasterFlag Then
            SType = "S"
        ElseIf OpenFlag Then
            SType = "O"
        Else
            SType = "M"
        End If
        If Not MasterFlag Or (OpenFlag And Not Bulkf) Then
            ESeqNo = toval(rsAcc.fields("ESeqNo"))
            EESeqNo = toval(rsAcc.fields("EESeqNo"))
            ERSeqNo = toval(rsAcc.fields("ERSeqNo"))
            PolicyNo = tostr(rsAcc.fields("PolicyNo"))
        End If

        If UjrohShariaF Then
            UJrohPCT = toval(rsAcc.fields("Ujroh"))
        Else
            UJrohPCT = 0
        End If
        If UJrohPCT = 0 Then UjrohShariaF = False

        If Not TemporaryF Then
            If PolicyNo = "" Then
                Dim BAlias As String
                Dim TAlias As String = ""
                Dim POL_AutoNum As String = ""
                Dim Prefix As String
                Dim InFix As String

                BAlias = Get_Branch_Alias_By_TOC(Branch, TOC, TAlias, POL_AutoNum)
                rs = db.OpenRemoteSet("Select P.Prefix, P.InFix, P.Separator, P.BranchDigit, P.TOCDigit, P.CTDigit, P.CheckDigitF, I.Prefix as IPrefix, I.InFix as IInFix from ISType I Left Join PolicyType P on (P.PolicyType='" & PolicyType & "') Where I.ISType='" & ISType & "'")
                Separator = tostr(rs.fields("Separator"))
                Prefix = IIf(tostr(rs.fields("Prefix")) <> "", tostr(rs.fields("Prefix")), tostr(rs.fields("IPrefix")))
                InFix = IIf(tostr(rs.fields("InFix")) <> "", tostr(rs.fields("InFix")), tostr(rs.fields("IInFix")))
                If Not rs.Eof Then
                    If BAlias = Branch Then
                        PolicyNo = db.GetNextDocNo(POL_AutoNum, ADate, IIf(Prefix <> "", Prefix & Separator, "") & IIf(toval(rs.fields("BranchDigit")) <> 0, Mid(BAlias, 1, toval(rs.fields("BranchDigit"))) & Separator, "") & IIf(toval(rs.fields("CTDigit")) <> 0, Mid(CT, 1, toval(rs.fields("CTDigit"))) & Separator, "") & IIf(InFix <> "", InFix & Separator, "") & IIf(toval(rs.fields("TOCDigit")) <> 0, Mid(TAlias, 1, toval(rs.fields("TOCDigit"))) & Separator, ""))
                    Else
                        PolicyNo = db.GetNextDocNo(POL_AutoNum, ADate, IIf(Prefix <> "", Prefix & Separator, "") & BAlias)
                    End If
                Else
                    PolicyNo = db.GetNextDocNo(POL_AutoNum, ADate, BAlias & Mid(TAlias, 1, 2))
                End If
                If PolicyNo = "" Then
                    StrMsg = "Generate Policy No. Failed !"
                    GoTo errmsg
                End If
                If toval(rs.fields("CheckDigitF")) Then PolicyNo = PolicyNo & CheckDigit(PolicyNo)
            End If
        End If
        Dim CertificateNo As String
        CertificateNo = tostr(rsAcc.fields("CertificateNo"))

        If MDocNo = "" Then
            If OpenFlag And Not Bulkf Then
                DocNo = PolicyNo + "-" + CertificateNo
            Else
                DocNo = PolicyNo
            End If

            If ESeqNo <> 0 Then
                DocNo = DocNo + "-" + tostr(ESeqNo) + "/" + tostr(EESeqNo)
                If ERSeqNo <> 0 Then
                    DocNo = DocNo + "/" + tostr(ERSeqNo)
                End If
            End If
        Else
            DocNo = MDocNo
        End If

        If OpenFlag And Bulkf Then
            RefNo = PolicyNo
        End If

        CProrata = toval(rsAcc.fields("CPCT")) / 100
        If VoyageF And CProrata = 0 Then
            CProrata = 1
        End If

        ' Calculating Account Assignment
        ' First Delete Existing Data
        If Not db.Execute("Delete from AccAss Where ANO=" & ANO) Then GoTo errmsg

        ' Create Temporary Table
        If Not db.Execute("Select * into #AccAss from AccAss Where 1<>1;Create unique index I_#ACCASS on #ACCASS(ACNO)") Then GoTo errmsg

        rsAA = db.OpenRemoteSet("Select * from #AccAss Where 1<>1")
        rs = db.OpenRemoteSet("Select Count(*) NumCCY from PCalc Where ANO=" & ANO)
        NumCCY = rs.fields("NumCCY")
        rsIC = db.OpenQueryDef("QPCalc_ACCASS", adOpenForwardonly, ANO)

        ' Default Values
        PType = "DI"
        BSTYPE = ""
        Dim SANO As Long
        Dim LANO As Long
        Dim Rate As Double
        Dim TSI As Double
        Dim CCYTO As String
        Dim RRate As Double

        Do While Not rsIC.Eof And AType <> "C"
            PProrata = toval(rsIC.fields("PProrata"))
            Gross = toval(rsIC.fields("Gross"))
            RProrata = IIf(Gross <> 0, toval(rsIC.fields("Reinstatement")) / Gross, 0)
            FDiscount = toval(rsIC.fields("Discount"))
            FLoading = toval(rsIC.fields("Loading"))
            RCode = tostr(rsIC.fields("Code"))
            SDate = todate(rsIC.fields("SDate"))
            EDate = todate(rsIC.fields("EDate"))
            AdjustableF = toval(rsIC.fields("AdjustableF"))
            AdjMethod = tostr(rsIC.fields("AdjMethod"))
            SANO = toval(rsIC.fields("SANO"))
            LANO = toval(rsIC.fields("LANO"))
            Rate = toval(rsIC.fields("Rate"))
            TSI = toval(rsIC.fields("TSI"))
            pNoRefundF = toval(rsIC.fields("NoRefundF"))

            ' Get Reinsurance Currency Mapping
            If CCode <> tostr(rsIC.fields("Currency")) Then
                CCode = tostr(rsIC.fields("Currency"))
                rs = db.OpenQueryDef("QReinsurance_Rate", adOpenForwardonly, ANO, CCode)
                CCYTO = IIf(tostr(rs.fields("CCYTO")) <> "", tostr(rs.fields("CCYTO")), CCode)
                RRate = IIf(toval(rs.fields("Rate")) <> 0 And CCYTO.ToUpper <> CCode.ToUpper, toval(rs.fields("Rate")), 1)
            End If

            Premium = toval(rsIC.fields("Share")) / 100 * Gross * QTY

            If LANO <> -1 Then
                ' Alternate Payor
                rs = db.OpenQueryDef("QAPayor", adOpenForwardonly, SANO)
                If rs.Eof Then
                    rs = db.OpenQueryDef("QPayor", adOpenForwardonly, LANO)
                    If LANO <> -1 Then
                        rsDetail = db.OpenQueryDef("QPayorDet", adOpenForwardonly, LANO, RCode, DateDiff(DateInterval.Month, PSDate, todate(rsIC.fields("SDate"))) \ 12 + 1)
                    Else
                        rsDetail = db.OpenQueryDef("QPayorDet", adOpenForwardonly, SANO, RCode, DateDiff(DateInterval.Month, PSDate, todate(rsIC.fields("SDate"))) \ 12 + 1)
                    End If
                Else
                    rsDetail = db.OpenQueryDef("QAPayorDet", adOpenForwardonly, SANO, RCode, DateDiff(DateInterval.Month, PSDate, todate(rsIC.fields("SDate"))) \ 12 + 1)
                End If
            Else
                rs = db.OpenQueryDef("QPayor", adOpenForwardonly, SANO)
                If LANO <> -1 Then
                    rsDetail = db.OpenQueryDef("QPayorDet", adOpenForwardonly, LANO, RCode, DateDiff(DateInterval.Month, PSDate, todate(rsIC.fields("SDate"))) \ 12 + 1)
                Else
                    rsDetail = db.OpenQueryDef("QPayorDet", adOpenForwardonly, SANO, RCode, DateDiff(DateInterval.Month, PSDate, todate(rsIC.fields("SDate"))) \ 12 + 1)
                End If
            End If

            PID = tostr(rs.fields("ID"))
            GDiscount = toval(rs.fields("GDiscount"))
            NDiscount = toval(rs.fields("NDiscount"))
            PDiscount = toval(rs.fields("Discount"))
            SLoading = toval(rs.fields("SLoading"))
            dNoRefundF = toval(rs.fields("NoRefundF"))


            If PDiscount = 0 Then
                If NumCCY = 1 Then
                    ' in Original Currency
                    PDiscount = toval(rs.fields("DiscAmount")) / rsIC.RecordCount * QTY / (Gross * (1 - GDiscount / 100) * (1 - NDiscount / 100)) * 100
                Else
                    PDiscount = toval(rs.fields("DiscAmount")) / rsIC.RecordCount / Rate * QTY / (Gross * (1 - GDiscount / 100) * (1 - NDiscount / 100)) * 100
                End If
            End If

            If Not rsDetail.Eof Then
                PDiscount = toval(rsDetail.fields("Discount"))
                If toval(rsDetail.fields("NoGDiscountF")) Then
                    GDiscount = 0
                End If
                If PDiscount = 0 Then
                    If NumCCY = 1 Then
                        ' in Original Currency
                        PDiscount = toval(rsDetail.fields("DiscAmount")) * QTY / (Gross * (1 - GDiscount / 100) * (1 - NDiscount / 100)) * 100
                    Else
                        PDiscount = toval(rsDetail.fields("DiscAmount")) / Rate * QTY / (Gross * (1 - GDiscount / 100) * (1 - NDiscount / 100)) * 100
                    End If
                End If
                dNoRefundF = toval(rsDetail.fields("NoRefundF"))
            End If

            rs.CloseRemoteSet()

            Dim CommI As Double = 0   ' Commission Inward

            ' Insurance Source (Inward Facultative or Inward Coinsurance or Inward Treaty)
            If (ISType = "R" Or ISType = "C" Or ISType = "T") Then
                rs = db.OpenQueryDef("QISource", adOpenForwardonly, CNO)
                If Not rs.Eof Then
                    If ISType = "T" Then
                        If InStr("X1X2X3X4X5X6X7", rs.fields("RType")) > 0 Then 'Excess Of Loss Treaty
                            PType = "IX"  ' Inward Treaty Excess Of Loss
                        Else
                            PType = "IT"  ' Inward Treaty
                        End If
                    Else
                        PType = "I" & ISType ' IR or IC
                    End If
                    If UjrohShariaF Then
                        Ujroh = Premium * toval(rs.fields("UJROHCEDANT")) / 100
                    Else
                        Ujroh = 0
                    End If
                    ' Premium
                    If Premium <> 0 Then
                        rsAA.AddNew()
                        rsAA.fields("BizMapID") = BizMapID
                        rsAA.fields("MSCode") = MSCode
                        rsAA.fields("Source") = Source
                        rsAA.fields("SDate") = todate(rsIC.fields("SDate"))
                        rsAA.fields("EDate") = todate(rsIC.fields("EDate"))
                        rsAA.fields("ANO") = ANO
                        rsAA.fields("Type") = PType
                        rsAA.fields("Code") = "P"
                        rsAA.fields("ID") = PID
                        rsAA.fields("REFNO") = RefNo
                        rsAA.fields("POLICYNO") = PolicyNo
                        rsAA.fields("DocNo") = DocNo
                        rsAA.fields("DATE") = ADate
                        rsAA.fields("BILLDATE") = BillDate
                        rsAA.fields("TOC") = TOC
                        rsAA.fields("Remarks") = AName
                        rsAA.fields("CAmount") = IIf(UjrohShariaF, IIf(PType = "IC", Premium - Ujroh, Premium), Premium * (100 - toval(rs.fields("UJROHCEDANT"))) / 100)
                        rsAA.fields("Amount_OC") = IIf(UjrohShariaF, IIf(PType = "IC", Premium - Ujroh, Premium), Premium * (100 - toval(rs.fields("UJROHCEDANT"))) / 100) * (1 + RProrata)
                        rsAA.fields("Amount") = IIf(UjrohShariaF, IIf(PType = "IC", Premium - Ujroh, Premium), Premium * (100 - toval(rs.fields("UJROHCEDANT"))) / 100) * (1 + RProrata)
                        rsAA.fields("Currency_OC") = CCode
                        rsAA.fields("Currency") = CCode
                        rsAA.fields("Rate") = 1
                        rsAA.fields("AdmNo") = -1
                        rsAA.fields("PProrata") = PProrata
                        rsAA.fields("AdjustableF") = AdjustableF
                        rsAA.fields("AdjMethod") = AdjMethod
                        rsAA.fields("RCode") = RCode
                        rsAA.fields("AType") = AType
                        rsAA.fields("NoRefundF") = pNoRefundF
                        rsAA.fields("CommPoolF") = False
                        If Not rsAA.UpdateRow Then GoTo errmsg
                    End If

                    ' Ujroh
                    If Ujroh <> 0 Then
                        rsAA.AddNew()
                        rsAA.fields("BizMapID") = BizMapID
                        rsAA.fields("MSCode") = MSCode
                        rsAA.fields("Source") = Source
                        rsAA.fields("SDate") = todate(rsIC.fields("SDate"))
                        rsAA.fields("EDate") = todate(rsIC.fields("EDate"))
                        rsAA.fields("ANO") = ANO
                        rsAA.fields("Type") = PType
                        rsAA.fields("Code") = "U"
                        rsAA.fields("ID") = PID
                        rsAA.fields("REFNO") = RefNo
                        rsAA.fields("POLICYNO") = PolicyNo
                        rsAA.fields("DocNo") = DocNo
                        rsAA.fields("DATE") = ADate
                        rsAA.fields("BILLDATE") = BillDate
                        rsAA.fields("TOC") = TOC
                        rsAA.fields("Remarks") = AName
