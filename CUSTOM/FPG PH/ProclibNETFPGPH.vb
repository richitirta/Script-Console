                        End If
                    End If
                    If DateDiff(DateInterval.Day, pEDate, EDate) < 0 Then
                        pEDate = EDate
                    End If

                    rsd.fields("EDate") = pEDate
                    lEDate = pEDate

                    ' Annualized Rate
                    If toval(rss.fields("RateLower")) <> 0 Or toval(rss.fields("Rate")) <> 0 Or toval(rsTr.fields(rss.fields("Rate_Source"))) <> 0 Then
