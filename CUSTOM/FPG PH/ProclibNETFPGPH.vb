                            rsCA.fields("Code") = "L"  ' Cost
                            rsCA.fields("ID") = PID
                            rsCA.fields("RefNo") = RefNo
                            rsCA.fields("DocNo") = DocNo
                            rsCA.fields("ClaimNo") = ClaimNo
                            rsCA.fields("Date") = ADate
                            rsCA.fields("BillDate") = BillDate
                            rsCA.fields("TOC") = TOC
                            rsCA.fields("Remarks") = AName
                            rsCA.fields("CAmount") = Cost * toval(rs.fields("JP")) / 100
                            rsCA.fields("Amount_OC") = toval(rsCA.fields("CAmount"))
                            rsCA.fields("Amount") = toval(rsCA.fields("CAmount"))
                            rsCA.fields("Rate") = 1
                            rsCA.fields("AdmNo") = -1
                            rsCA.fields("RCode") = RCode
                            rsCA.fields("TOR") = TOR
                            rsCA.fields("Currency_OC") = pCCY
                            rsCA.fields("Currency") = pCCY
                            If Not rsCA.UpdateRow Then GoTo errmsg
                        End If

                        If Deductible <> 0 Then
                            rsCA.AddNew()
                            rsCA.fields("BizMapID") = BizMapID
                            rsCA.fields("MSCode") = MSCode
                            rsCA.fields("Source") = Source
                            rsCA.fields("CNO") = CNO
