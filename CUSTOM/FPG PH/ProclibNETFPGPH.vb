                    If toval(rs.fields("DRegNo")) > 0 Then
                        RegNo = toval(GetAccRegAmount(REGID, FLDID, VALUEID, RYear, "D", Amount / (PctShare / 100 * PCTLOSS / 100 * (100 - MShare) / 100), TAmount / (PctShare / 100 * PCTLOSS / 100)))
