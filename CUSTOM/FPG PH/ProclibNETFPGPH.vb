                                    Rate = (toval(rss.fields("RateLower")) * (toval(rss.fields("Upper")) - (UMonth + PMonth)) + toval(rss.fields("Rate")) * (12 - (toval(rss.fields("Upper")) - (UMonth + PMonth)))) / 12
                                    RateMax = Rate
                                Else
                                    ' Average Rate
                                    Rate = toval(rss.fields("RateLower"))
                                    RateMax = toval(rss.fields("Rate"))
                                End If
                            ElseIf toval(rss.fields("RateLower")) <> 0 Then
                                Rate = toval(rss.fields("RateLower"))
                                RateMax = Rate
                            Else
                                Rate = toval(rss.fields("Rate"))
                                RateMax = Rate
                            End If
                            Rate = 12 / (rss.fields("Upper") - rss.fields("Lower") + 1) * Rate
                            RateMax = 12 / (rss.fields("Upper") - rss.fields("Lower") + 1) * RateMax
                        Else    ' in Days
                            If PCalc = "N" Then
                                Rate = rss.fields("Rate")
                                RateMax = Rate
                            Else
                                If Prorata = 0 Then
                                    Rate = DateDiff(DateInterval.Day, pSDate, DateAdd(DateInterval.Month, 12, pSDate)) / (rss.fields("Upper") - rss.fields("Lower") + 1) * rss.fields("Rate")
                                    RateMax = Rate
                                Else
                                    Rate = Prorata / (rss.fields("Upper") - rss.fields("Lower") + 1) * rss.fields("Rate")
                                    RateMax = Rate
                                End If
                            End If
                        End If
                    Else
                        Rate = toval(rsSC.fields("Rate")) / (1 + IRate / 100) ^ (DateDiff(DateInterval.Month, SDate, pSDate) \ 12)
                        RateMax = Rate
                    End If
                    If GrossUpF Then
                        Rate = Rate * GrossUpRate
                        RateMax = RateMax * GrossUpRate
                    End If

                    If PCalc = "N" Then ' No Prorate
                        Rate = toval(rsd.fields("Rate")) + Rate
                        RateMax = toval(rsd.fields("RateMax")) + RateMax
                    Else
