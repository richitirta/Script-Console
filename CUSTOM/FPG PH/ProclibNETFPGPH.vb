    Private Function Claim_Cession(ByVal CNO As Long, Optional ByVal ReAllocF As Boolean = False) As Boolean
        Dim rs As RemoteSet
        Dim rsR As RemoteSet
        Dim LossDate As Date
        Dim OurShare As Double
        Dim PrevOurShare As Double
        Dim Estimate As Double
        Dim ANO As Long
        Dim MShare As Double
        Dim PCTShare As Double
        Dim Saldo As Double
        Dim Limit As Double
        Dim Share As Double
        Dim RAmount As Double
        Dim Excess As Double
        Dim TExcess As Double
        Dim TAccumulation As Double
        Dim TDeductible As Double
        Dim ExcessType As Integer
        Dim ManualF As Boolean
        Dim i As Integer
        Dim RYear As Integer

        Dim CashCallOnPartialPaymentF As Boolean
        Dim CashCallOnEstimateF As Boolean
        Dim CashCallOnGrossF As Boolean

        On Error GoTo errmsg

        rs = db.OpenQueryDef("CLVIEW06a", adOpenForwardonly, CNO)
        ANO = toval(rs.fields("ANO"))
        LossDate = todate(rs.fields("LossDate"))
        Limit = toval(rs.fields("Limit"))
        Excess = toval(rs.fields("Excess"))
        Estimate = toval(rs.fields("Estimate")) - toval(rs.fields("EDeductible")) + toval(rs.fields("ECost")) - toval(rs.fields("ESalvage")) - toval(rs.fields("ESubrogation"))
        OurShare = toval(rs.fields("OurShare")) - toval(rs.fields("Deductible")) + toval(rs.fields("Cost")) - toval(rs.fields("Salvage")) - toval(rs.fields("Subrogation"))
        PrevOurShare = toval(rs.fields("PrevOurShare")) - toval(rs.fields("PrevDeductible")) + toval(rs.fields("PrevCost")) - toval(rs.fields("PrevSalvage")) - toval(rs.fields("PrevSubrogation"))
        PCTShare = toval(rs.fields("PCTShare"))
        CashCallOnPartialPaymentF = toval(rs.fields("CashCallOnPartialPaymentF"))
        CashCallOnEstimateF = toval(rs.fields("CashCallOnEstimateF"))
        CashCallOnGrossF = toval(rs.fields("CashCallOnGrossF"))

        If Excess <> 0 Then
            If Estimate > Excess Then
                Estimate = Estimate - Excess
                If Estimate > Limit Then
                    Estimate = Limit
                End If
            Else
                Estimate = 0
            End If
            If OurShare > Excess Then
                OurShare = OurShare - Excess
                If OurShare > Limit Then
                    OurShare = Limit
                End If
            Else
                OurShare = 0
            End If
            Estimate = Estimate * toval(rs.fields("Rate"))
            OurShare = OurShare * toval(rs.fields("Rate"))
        Else
            Estimate = 0
            OurShare = 0
            Do While Not rs.Eof
                Estimate = Estimate + ((toval(rs.fields("Estimate")) - toval(rs.fields("EDeductible")) + toval(rs.fields("ECost")) - toval(rs.fields("ESalvage")) - toval(rs.fields("ESubrogation"))) * PCTShare / 100 + toval(rs.fields("ERCost")) - toval(rs.fields("ERSubrogation")) - toval(rs.fields("ERSalvage"))) * toval(rs.fields("Rate"))
                OurShare = OurShare + ((toval(rs.fields("OurShare")) - toval(rs.fields("Deductible")) + toval(rs.fields("Cost")) - toval(rs.fields("Salvage")) - toval(rs.fields("Subrogation"))) * PCTShare / 100 + toval(rs.fields("RCost")) - toval(rs.fields("RSubrogation")) - toval(rs.fields("RSalvage"))) * toval(rs.fields("Rate"))
                rs.MoveNext()
            Loop
        End If
        rs.CloseRemoteSet()

        Dim RLimit As Double
        Dim TLimit As Double
        rs = db.OpenQueryDef("QClaimRiskAssLimit", adOpenForwardonly, ANO, "XX", LossDate)
        RLimit = toval(rs.fields("Limit")) / 100
        If RLimit = 0 Then RLimit = 1

        Dim SP1Amount As Double
        Dim SP2Amount As Double
        Dim SP3Amount As Double
        Dim CID As String
        Dim XPID As String
        Dim DID As String
        Dim QID As String
        Dim SP1ID As String
        Dim SP2ID As String
        Dim SP3ID As String
        Dim AID As String
        Dim CShare As Double
        Dim DShare As Double
        Dim QShare As Double
        Dim XPShare As Double
        Dim SP1Share As Double
        Dim SP2Share As Double
        Dim SP3Share As Double
        Dim AShare As Double
        Dim FShare As Double
        Dim EFShare As Double
        Dim FAmount As Double
        Dim EFAmount As Double
        Dim TAmount As Double
        Dim QSRet As Double

        rsR = db.OpenQueryDef("QRArrHeader", adOpenForwardonly, ANO)
        CShare = toval(rsR.fields("CShare"))
        DShare = toval(rsR.fields("DShare"))
        QShare = toval(rsR.fields("QShare"))
        XPShare = toval(rsR.fields("XPShare"))
        SP1Share = toval(rsR.fields("SP1Share"))
        SP2Share = toval(rsR.fields("SP2Share"))
        SP3Share = toval(rsR.fields("SP3Share"))
        AShare = toval(rsR.fields("AShare"))
        FShare = toval(rsR.fields("FShare"))
        QSRet = toval(rsR.fields("QSRet"))
        TAmount = toval(rsR.fields("TAmount"))
        CID = tostr(rsR.fields("CID"))
        XPID = tostr(rsR.fields("XPID"))
        DID = tostr(rsR.fields("DID"))
        QID = tostr(rsR.fields("QID"))
        SP1ID = tostr(rsR.fields("SP1ID"))
        SP2ID = tostr(rsR.fields("SP2ID"))
        SP3ID = tostr(rsR.fields("SP3ID"))
        AID = tostr(rsR.fields("AID"))

        If CShare <> 0 Then
            rs = db.OpenQueryDef("QClaimRCession", adOpenForwardonly, CID, CNO)
            CShare = CShare * toval(rs.fields("RPortion")) / 100
        End If

        If DShare <> 0 Then
            rs = db.OpenQueryDef("QClaimRCession", adOpenForwardonly, DID, CNO)
            DShare = DShare * toval(rs.fields("RPortion")) / 100
        End If

        If QShare <> 0 Then
            rs = db.OpenQueryDef("QClaimRCession", adOpenForwardonly, QID, CNO)
            QShare = QShare * toval(rs.fields("RPortion")) / 100
        End If

        If XPShare <> 0 Then
            rs = db.OpenQueryDef("QClaimRCession", adOpenForwardonly, XPID, CNO)
            XPShare = XPShare * toval(rs.fields("RPortion")) / 100
        End If

        If SP1Share <> 0 Then
            rs = db.OpenQueryDef("QClaimRCession", adOpenForwardonly, SP1ID, CNO)
            SP1Share = SP1Share * toval(rs.fields("RPortion")) / 100
        End If

        If SP2Share <> 0 Then
            rs = db.OpenQueryDef("QClaimRCession", adOpenForwardonly, SP2ID, CNO)
            SP2Share = SP2Share * toval(rs.fields("RPortion")) / 100
        End If

        If SP3Share <> 0 Then
            rs = db.OpenQueryDef("QClaimRCession", adOpenForwardonly, SP3ID, CNO)
            SP3Share = SP3Share * toval(rs.fields("RPortion")) / 100
        End If

        If AShare <> 0 Then
            rs = db.OpenQueryDef("QClaimRCession", adOpenForwardonly, AID, CNO)
            AShare = AShare * toval(rs.fields("RPortion")) / 100
        End If

        FShare = 0
        FAmount = 0

        EFShare = 0
        EFAmount = 0

        Dim FQAmount As Double = 0
        Dim FSP1Amount As Double = 0
        Dim FSP2Amount As Double = 0
        Dim FSP3Amount As Double = 0
        Dim FAAmount As Double = 0

        Dim EFQAmount As Double = 0
        Dim EFSP1Amount As Double = 0
        Dim EFSP2Amount As Double = 0
        Dim EFSP3Amount As Double = 0
        Dim EFAAmount As Double = 0

        Dim TFAmount As Double
        Dim FRShare As Double = 0
        Dim FRAmount As Double = 0
        Dim EFRShare As Double = 0
        Dim EFRAmount As Double = 0
        rs = db.OpenQueryDef("QCLAIMFACOUT", adOpenForwardonly, CNO)
        Do While Not rs.Eof
            FShare = (rs.fields("Share") + rs.fields("JPShare"))
            If FShare <> 0 Then
                If OurShare <> 0 Then
                    If rs.fields("Excess") <> 0 Or rs.fields("Limit") <> 0 Then
                        If OurShare > rs.fields("Excess") Then
                            If OurShare > rs.fields("Limit") + rs.fields("Excess") Then
                                TFAmount = rs.fields("Limit") * TAmount / rs.fields("Limit") * FShare / 100 * toval(rs.fields("RShare")) / 100
                            Else
                                TFAmount = (OurShare - rs.fields("Excess")) * TAmount / rs.fields("Limit") * FShare / 100 * toval(rs.fields("RShare")) / 100
                            End If
                        Else
                            TFAmount = 0
                        End If
                    Else
                        If OurShare * FShare / 100 * toval(rs.fields("RShare")) / 100 > toval(rs.fields("Retention")) Then
                            TFAmount = (OurShare * FShare / 100 * toval(rs.fields("RShare")) / 100 - toval(rs.fields("Retention")))
                            FRAmount = FRAmount + toval(rs.fields("Retention"))
                        Else
                            TFAmount = 0
                            FRAmount = FRAmount + OurShare * FShare / 100 * toval(rs.fields("RShare")) / 100
                        End If
                    End If
                    TFAmount = TFAmount * rs.fields("Share") / FShare

                    FAmount = FAmount + TFAmount
                    Select Case rs.fields("RType")
                        Case "QS", "QP"
                            FQAmount = FQAmount + TFAmount
                        Case "S1"
                            FSP1Amount = FSP1Amount + TFAmount
                        Case "S2"
                            FSP2Amount = FSP2Amount + TFAmount
                        Case "S3"
                            FSP3Amount = FSP3Amount + TFAmount
                        Case "AF"
                            FAAmount = FAAmount + TFAmount
                    End Select
                End If

                If Estimate <> 0 Then
                    If rs.fields("Excess") <> 0 Or rs.fields("Limit") <> 0 Then
                        If Estimate > rs.fields("Excess") Then
                            If Estimate > rs.fields("Limit") + rs.fields("Excess") Then
                                TFAmount = rs.fields("Limit") * TAmount / rs.fields("Limit") * FShare / 100 * toval(rs.fields("RShare")) / 100
                            Else
                                TFAmount = (Estimate - rs.fields("Excess")) * TAmount / rs.fields("Limit") * FShare / 100 * toval(rs.fields("RShare")) / 100
                            End If
                        Else
                            TFAmount = 0
                        End If
                    Else
                        If Estimate * FShare / 100 * toval(rs.fields("RShare")) / 100 > toval(rs.fields("Retention")) Then
                            TFAmount = (Estimate * rs.fields("Share") / 100 * toval(rs.fields("RShare")) / 100 - toval(rs.fields("Retention")))
                            EFRAmount = EFRAmount + toval(rs.fields("Retention"))
                        Else
                            TFAmount = 0
                            EFRAmount = EFRAmount + Estimate * rs.fields("Share") / 100 * toval(rs.fields("RShare")) / 100
                        End If
                    End If

                    TFAmount = TFAmount * rs.fields("Share") / FShare
                    EFAmount = EFAmount + TFAmount
                    Select Case rs.fields("RType")
                        Case "QS", "QP"
                            EFQAmount = EFQAmount + TFAmount
                        Case "S1"
                            EFSP1Amount = EFSP1Amount + TFAmount
                        Case "S2"
                            EFSP2Amount = EFSP2Amount + TFAmount
                        Case "S3"
                            EFSP3Amount = EFSP3Amount + TFAmount
                        Case "AF"
                            EFAAmount = EFAAmount + TFAmount
                    End Select
                End If
            End If

            rs.MoveNext()
        Loop

        If OurShare <> 0 Then
            FShare = FAmount / OurShare * 100
            FRShare = FRAmount / OurShare * 100
        End If

        If Estimate <> 0 Then
            EFShare = EFAmount / Estimate * 100
            EFRShare = EFRAmount / Estimate * 100
        End If

        SP1Amount = SP1Share / 100 * OurShare
        SP2Amount = SP2Share / 100 * OurShare
        SP3Amount = SP3Share / 100 * OurShare
        MShare = toval(rsR.fields("MShare"))

        Dim rShare As Double
        Dim ShortFall As Double
        rShare = GetReinsuranceParticipantShare(SP1ID)
        If rShare = 0 Then rShare = 100
        ShortFall = (100 - rShare) / 100 * (SP1Amount + SP2Amount + SP3Amount)
        If rShare <> 100 Then
            If Not Claim_Cession_XOLShortFall(CNO, rsR.fields("RDate"), RLimit, ShortFall, OurShare) Then
                StrMsg = "Failed in ShortFall XOL Cession !"
                GoTo errmsg
            End If
        End If

        rs = db.OpenQueryDef("QCArrHeader", adOpenKeyset, CNO)
        ManualF = toval(rs.fields("ManualF"))
        ' First UnRelease the Accumulation Register
        If rs.fields("Status") = "A" Then
            If Not UnReleaseClaRegAmount(CNO) Then GoTo errmsg
            ' Re-Open Data
            rs = db.OpenQueryDef("QCArrHeader", adOpenKeyset, CNO)
        End If

        rs.Edit()
        rs.fields("CAmount") = CShare / 100 * OurShare
        rs.fields("DAmount") = DShare / 100 * OurShare
        rs.fields("XPAmount") = XPShare / 100 * OurShare
        rs.fields("QAmount") = QShare / 100 * OurShare
        rs.fields("SP1Amount") = SP1Amount
        rs.fields("SP2Amount") = SP2Amount
        rs.fields("SP3Amount") = SP3Amount
        rs.fields("AAmount") = AShare / 100 * OurShare
        rs.fields("FAmount") = FShare / 100 * OurShare
        rs.fields("FRShare") = FRShare
        rs.fields("FRAmount") = FRShare / 100 * OurShare

        rs.fields("ECAmount") = CShare / 100 * Estimate
        rs.fields("EDAmount") = DShare / 100 * Estimate
        rs.fields("EXPAmount") = XPShare / 100 * Estimate
        rs.fields("EQAmount") = QShare / 100 * Estimate
        rs.fields("ESP1Amount") = SP1Share / 100 * Estimate
        rs.fields("ESP2Amount") = SP2Share / 100 * Estimate
        rs.fields("ESP3Amount") = SP3Share / 100 * Estimate
        rs.fields("EAAmount") = AShare / 100 * Estimate
        rs.fields("EFAmount") = EFShare / 100 * Estimate
        rs.fields("EFRShare") = EFRShare
        rs.fields("EFRAmount") = EFRShare / 100 * Estimate

        rs.fields("FQAmount") = FQAmount
        rs.fields("FSP1Amount") = FSP1Amount
        rs.fields("FSP2Amount") = FSP2Amount
        rs.fields("FSP3Amount") = FSP3Amount
        rs.fields("FAAmount") = FAAmount

        rs.fields("EFQAmount") = EFQAmount
        rs.fields("EFSP1Amount") = EFSP1Amount
        rs.fields("EFSP2Amount") = EFSP2Amount
        rs.fields("EFSP3Amount") = EFSP3Amount
        rs.fields("EFAAmount") = EFAAmount

        rs.fields("Limit") = RLimit

        ' Starting for Risk Based XOL
        ' Calculation for Indemnity Amount
        rShare = MShare + CShare + DShare + QShare + XPShare + SP1Share + SP2Share + SP3Share + AShare + FShare

        ' Exclude Facultative Retention
        Saldo = OurShare - OurShare * (rShare) / 100 - FRAmount
        RAmount = Saldo

        Dim CRAmount As Double
        Dim CERAmount As Double
        Dim CXLAmount(6) As Double
        Dim CXLEAmount(6) As Double

        rsR = db.OpenQueryDef("QGetConjunctionClaimXOLCession", adOpenKeyset, CNO)
        CRAmount = toval(rsR.fields("RAmount"))
        CERAmount = toval(rsR.fields("ERAmount"))
        For i = 1 To 7
            CXLAmount(i - 1) = toval(rsR.fields("XL" & i & "Amount"))
            CXLEAmount(i - 1) = toval(rsR.fields("XL" & i & "EAmount"))
        Next

        ' Excess from Conjunction Claim
        TExcess = CRAmount
        ExcessType = 0 ' Normal from Gross Retention
        For i = 1 To 7
            rsR = db.OpenQueryDef("Claim_Cession", adOpenForwardonly, CNO, LossDate, "X" & i, ReAllocF)
            If Not rsR.Eof AndAlso (tostr(rsR.fields("Category")) = "R" Or tostr(rsR.fields("Category")) = "P") AndAlso OurShare <> 0 Then
                If Not ManualF Then
                    If toval(rsR.fields("ExcessType")) = 1 And ExcessType = 0 Then
                        Saldo = Saldo + rs.fields("QAmount")
                        RAmount = RAmount + rs.fields("QAmount")
                        ExcessType = 1
                    End If

                    TLimit = IIf(toval(rsR.fields("AssessmentF")), RLimit, 1)

                    Dim Deductible As Double
                    Dim A_Deductible As Double
                    Dim Aggregate As Double
                    Dim A_Aggregate As Double
                    Deductible = toval(rsR.fields("Deductible"))
                    A_Deductible = toval(rsR.fields("A_Deductible"))
                    Aggregate = toval(rsR.fields("Aggregate"))
                    A_Aggregate = toval(rsR.fields("A_Aggregate"))

                    If toval(rsR.fields("ExcessType")) = 2 Then ' Excess from Full Value
                        Excess = toval(rsR.fields("Excess")) * (100 - rShare) / 100
                    Else
                        Excess = toval(rsR.fields("Excess"))
                    End If
                    Dim dExcess As Double
                    dExcess = Excess * (1 - TLimit)
                    Excess = Excess * TLimit

                    Excess = Excess - TExcess
                    Excess = IIf(Excess > 0, Excess, 0)

                    If Excess > Saldo Then Excess = Saldo
                    Saldo = Saldo - Excess

                    TAccumulation = 0
                    Limit = rsR.fields("Limit") + dExcess - TAccumulation

                    ' Minus Conjunction Claim
                    Limit = Limit - CXLAmount(i - 1)

                    Limit = IIf(Limit > 0, Limit, 0)
                    If Saldo > Limit Then
                        Share = Limit
                    Else
                        Share = Saldo
                    End If

                    ' Aggregate Deductible after Excess
                    If Deductible <> 0 Then ' Deductible Applied
                        If Deductible >= A_Deductible Then
                            If Share > (Deductible - A_Deductible) Then
                                TDeductible = (Deductible - A_Deductible)
                            Else
                                TDeductible = Share
                            End If
                        Else
                            TDeductible = 0
                        End If
                        A_Deductible = A_Deductible + TDeductible
                        Share = Share - TDeductible
                    Else
                        TDeductible = 0
                    End If

                    If Aggregate <> 0 Then ' Annual Aggregate Applied
                        If Share > (Aggregate - A_Aggregate) Then
                            Share = (Aggregate - A_Aggregate)
                        End If
                    End If

                    rs.fields("XL" & i & "ID") = tostr(rsR.fields("RID"))
                    rs.fields("XL" & i & "Share") = toval(Share / OurShare * 100)
                    rs.fields("XL" & i & "Amount") = Share
                    rs.fields("XL" & i & "Deductible") = A_Deductible - toval(rsR.fields("A_Deductible"))

                    TExcess = TExcess + Excess + Share + CXLAmount(i - 1) + TAccumulation
                Else
                    Share = rs.fields("XL" & i & "Amount")
                    rs.fields("XL" & i & "Share") = toval(Share / OurShare * 100)
                End If
                Saldo = Saldo - Share
                RAmount = RAmount - Share
            Else
                If Not ManualF Then
                    If Not rsR.Eof AndAlso (tostr(rsR.fields("Category")) = "R" Or tostr(rsR.fields("Category")) = "P") Then
                        rs.fields("XL" & i & "ID") = tostr(rsR.fields("RID"))
                    Else
                        rs.fields("XL" & i & "ID") = ""
                    End If
                End If
                rs.fields("XL" & i & "Share") = 0
                rs.fields("XL" & i & "Amount") = 0
                rs.fields("XL" & i & "Deductible") = 0
            End If
        Next i
        rs.fields("TShare") = 100
        rs.fields("TAmount") = OurShare
        rs.fields("MShare") = MShare
        rs.fields("MAmount") = OurShare * MShare / 100
        rs.fields("QXOLAmount") = 0

        If ExcessType = 1 Then
            rShare = GetReinsuranceShare(QID)
            rs.fields("QXOLAmount") = -(rs.fields("QAmount") - RAmount * rShare / 100)
            RAmount = RAmount - (rs.fields("QAmount") + rs.fields("QXOLAmount"))
        End If
        rs.fields("RAmount") = RAmount
        If OurShare <> 0 Then
            rs.fields("Retention") = toval(RAmount / OurShare * 100)
            rs.fields("QXOLShare") = toval(toval(rs.fields("QXOLAmount")) / OurShare * 100)
        Else
            rs.fields("Retention") = 0
            rs.fields("QXOLShare") = 0
        End If

        Dim XLExcess As Double = 0

        Saldo = toval(rs.fields("RAmount"))
        RAmount = Saldo

        RYear = 0
        TExcess = XLExcess + ClaRegAmount(CNO, "EX", RYear)
        ExcessType = 0 ' Normal from Gross Retention
        For i = 1 To 7
            rsR = db.OpenQueryDef("Claim_Cession", adOpenForwardonly, CNO, LossDate, "X" & i, ReAllocF)
            If Not rsR.Eof AndAlso (tostr(rsR.fields("Category")) = "C" Or tostr(rsR.fields("Category")) = "E") AndAlso OurShare <> 0 Then
                If Not ManualF Then
                    If RYear = 0 Then
                        RYear = toval(rsR.fields("RYear"))
                        TExcess = XLExcess + ClaRegAmount(CNO, "EX", RYear)
                    End If
                    If toval(rsR.fields("ExcessType")) = 1 And ExcessType = 0 Then
                        Saldo = Saldo + rs.fields("QAmount")
                        RAmount = RAmount + rs.fields("QAmount")
                        TExcess = TExcess + ClaRegAmountExcessQS(CNO, RYear)
                        ExcessType = 1
                    End If

                    TLimit = IIf(toval(rsR.fields("AssessmentF")), RLimit, 1)

                    Dim Deductible As Double
                    Dim A_Deductible As Double
                    Dim Aggregate As Double
                    Dim A_Aggregate As Double
                    Deductible = toval(rsR.fields("Deductible"))
                    A_Deductible = toval(rsR.fields("A_Deductible"))
                    Aggregate = toval(rsR.fields("Aggregate"))
                    A_Aggregate = toval(rsR.fields("A_Aggregate"))

                    Excess = toval(rsR.fields("Excess"))

                    Dim dExcess As Double
                    dExcess = Excess * (1 - TLimit)
                    Excess = Excess * TLimit

                    Excess = Excess - TExcess
                    Excess = IIf(Excess > 0, Excess, 0)
                    If Excess > Saldo Then Excess = Saldo
                    Saldo = Saldo - Excess

                    TAccumulation = ClaRegAmount(CNO, "X" & i, RYear)
                    Limit = rsR.fields("Limit") + dExcess - TAccumulation
                    Limit = IIf(Limit > 0, Limit, 0)
                    If Saldo > Limit Then
                        Share = Limit
                    Else
                        Share = Saldo
                    End If

                    ' Aggregate Deductible after Excess
                    If Deductible <> 0 Then ' Deductible Applied
                        If Deductible >= A_Deductible Then
                            If Share > (Deductible - A_Deductible) Then
                                TDeductible = (Deductible - A_Deductible)
                            Else
                                TDeductible = Share
                            End If
                        Else
                            TDeductible = 0
                        End If
                        A_Deductible = A_Deductible + TDeductible
                        Share = Share - TDeductible
                    Else
                        TDeductible = 0
                    End If

                    If Aggregate <> 0 Then ' Annual Aggregate Applied
                        If Share > (Aggregate - A_Aggregate) Then
                            Share = (Aggregate - A_Aggregate)
                        End If
                    End If

                    rs.fields("XL" & i & "ID") = tostr(rsR.fields("RID"))
                    rs.fields("XL" & i & "Share") = toval(Share / OurShare * 100)
                    rs.fields("XL" & i & "Amount") = Share
                    rs.fields("XL" & i & "Deductible") = A_Deductible - toval(rsR.fields("A_Deductible"))

                    TExcess = TExcess + Excess + Share + TAccumulation
                Else
                    Share = rs.fields("XL" & i & "Amount")
                    rs.fields("XL" & i & "Share") = toval(Share / OurShare * 100)
                End If
                Saldo = Saldo - Share
                RAmount = RAmount - Share
            Else
                If Not rsR.Eof AndAlso (tostr(rsR.fields("Category")) = "C" Or tostr(rsR.fields("Category")) = "E") Then
                    rs.fields("XL" & i & "ID") = tostr(rsR.fields("RID"))
                    rs.fields("XL" & i & "Share") = 0
                    rs.fields("XL" & i & "Amount") = 0
                    rs.fields("XL" & i & "Deductible") = 0
                End If
            End If
        Next i
        rs.fields("TShare") = 100
        rs.fields("TAmount") = OurShare
        rs.fields("MShare") = MShare
        rs.fields("MAmount") = OurShare * MShare / 100
        rs.fields("QXOLAmount") = 0
        rs.fields("XLExcess") = XLExcess

        If ExcessType = 1 Then
            rShare = GetReinsuranceShare(QID)
            rs.fields("QXOLAmount") = -(rs.fields("QAmount") - RAmount * rShare / 100)
            RAmount = RAmount - (rs.fields("QAmount") + rs.fields("QXOLAmount"))
        End If
        rs.fields("RAmount") = RAmount
        If OurShare <> 0 Then
            rs.fields("Retention") = toval(RAmount / OurShare * 100)
            rs.fields("QXOLShare") = toval(toval(rs.fields("QXOLAmount")) / OurShare * 100)
        Else
            rs.fields("Retention") = 0
            rs.fields("QXOLShare") = 0
        End If

        ' Calculation for Estimate Amount
        rsR = db.OpenQueryDef("QRArrHeader", adOpenForwardonly, ANO)
        rShare = MShare + CShare + DShare + QShare + XPShare + SP1Share + SP2Share + SP3Share + AShare + EFShare

        ' Exclude Facultative Retention
        Saldo = Estimate - Estimate * (rShare) / 100 - EFRAmount
        RAmount = Saldo

        ' Excess from Conjunction Claim
        TExcess = CERAmount
        ExcessType = 0 ' Normal from Gross Retention
        For i = 1 To 7
            rsR = db.OpenQueryDef("Claim_Cession", adOpenForwardonly, CNO, LossDate, "X" & i, ReAllocF)
            If Not rsR.Eof AndAlso (tostr(rsR.fields("Category")) = "R" Or tostr(rsR.fields("Category")) = "P") AndAlso Estimate <> 0 Then
                If Not ManualF Then
                    If toval(rsR.fields("ExcessType")) = 1 And ExcessType = 0 Then
                        Saldo = Saldo + rs.fields("EQAmount")
                        RAmount = RAmount + rs.fields("EQAmount")
                        ExcessType = 1
                    End If
                    TLimit = IIf(toval(rsR.fields("AssessmentF")), RLimit, 1)
                    Dim Deductible As Double
                    Dim A_Deductible As Double
                    Dim Aggregate As Double
                    Dim A_Aggregate As Double
                    Deductible = toval(rsR.fields("Deductible"))
                    A_Deductible = toval(rsR.fields("A_EDeductible"))
                    Aggregate = toval(rsR.fields("Aggregate"))
                    A_Aggregate = toval(rsR.fields("A_EAggregate"))

                    If toval(rsR.fields("ExcessType")) = 2 Then ' Excess from Full Value
                        Excess = toval(rsR.fields("Excess")) * (100 - rShare) / 100
                    Else
                        Excess = toval(rsR.fields("Excess"))
                    End If
                    Dim dExcess As Double
                    dExcess = Excess * (1 - TLimit)
                    Excess = Excess * TLimit
                    Excess = Excess - TExcess
                    Excess = IIf(Excess > 0, Excess, 0)

                    If Excess > Saldo Then Excess = Saldo
                    Saldo = Saldo - Excess

                    TAccumulation = 0
                    Limit = rsR.fields("Limit") + dExcess - TAccumulation

                    ' Minus Conjunction Claim
                    Limit = Limit - CXLEAmount(i - 1)

                    Limit = IIf(Limit > 0, Limit, 0)
                    If Saldo > Limit Then
                        Share = Limit
                    Else
                        Share = Saldo
                    End If

                    ' Aggregate Deductible and Annual Aggregate not Applied
                    'If Deductible <> 0 Then ' Deductible Applied
                    '    If Deductible >= A_Deductible Then
                    '        If Share > (Deductible - A_Deductible) Then
                    '            TDeductible = (Deductible - A_Deductible)
                    '        Else
                    '            TDeductible = Share
                    '        End If
                    '    Else
                    '        TDeductible = 0
                    '    End If
                    '    A_Deductible = A_Deductible + TDeductible
                    '    Share = Share - TDeductible
                    'Else
                    '    TDeductible = 0
                    'End If

                    'If Aggregate <> 0 Then ' Annual Aggregate Applied
                    '    If Share > (Aggregate - A_Aggregate) Then
                    '        Share = (Aggregate - A_Aggregate)
                    '    End If
                    'End If

                    rs.fields("XL" & i & "ID") = tostr(rsR.fields("RID"))
                    rs.fields("XL" & i & "EShare") = toval(Share / Estimate * 100)
                    rs.fields("XL" & i & "EAmount") = Share
                    rs.fields("XL" & i & "EDeductible") = A_Deductible - toval(rsR.fields("A_EDeductible"))

                    TExcess = TExcess + Excess + Share + CXLEAmount(i - 1) + TAccumulation
                Else
                    Share = rs.fields("XL" & i & "EAmount")
                    rs.fields("XL" & i & "EShare") = toval(Share / Estimate * 100)
                End If
                Saldo = Saldo - Share
                RAmount = RAmount - Share
            Else
                If Not ManualF Then
                    If Not rsR.Eof AndAlso (tostr(rsR.fields("Category")) = "R" Or tostr(rsR.fields("Category")) = "P") Then
                        rs.fields("XL" & i & "ID") = tostr(rsR.fields("RID"))
                    Else
                        rs.fields("XL" & i & "ID") = ""
                    End If
                End If
                rs.fields("XL" & i & "EShare") = 0
                rs.fields("XL" & i & "EAmount") = 0
                rs.fields("XL" & i & "EDeductible") = 0
            End If
        Next i
        rs.fields("ETShare") = 100
        rs.fields("ETAmount") = Estimate
        rs.fields("EMAmount") = Estimate * MShare / 100
        rs.fields("QXOLEAmount") = 0

        If ExcessType = 1 Then
            rShare = GetReinsuranceShare(QID)
            rs.fields("QXOLEAMOUNT") = -(rs.fields("EQAmount") - RAmount * rShare / 100)
            RAmount = RAmount - (rs.fields("EQAmount") + rs.fields("QXOLEAmount"))
        End If
        rs.fields("ERAmount") = RAmount

        If Estimate <> 0 Then
            rs.fields("ERetention") = toval(RAmount / Estimate * 100)
            rs.fields("QXOLESHARE") = toval(toval(rs.fields("QXOLEAMOUNT")) / Estimate * 100)
        Else
            rs.fields("ERetention") = 0
            rs.fields("QXOLESHARE") = 0
        End If

        Dim XLEExcess As Double = 0

        Saldo = toval(rs.fields("ERAmount"))
        RAmount = Saldo

        RYear = 0
        TExcess = XLEExcess + ClaRegEAmount(CNO, "EX", RYear)
        ExcessType = 0 ' Normal from Gross Retention
        For i = 1 To 7
            rsR = db.OpenQueryDef("Claim_Cession", adOpenForwardonly, CNO, LossDate, "X" & i, ReAllocF)
            If Not rsR.Eof AndAlso (tostr(rsR.fields("Category")) = "C" Or tostr(rsR.fields("Category")) = "E") AndAlso Estimate <> 0 Then
                If Not ManualF Then
                    If RYear = 0 Then
                        RYear = toval(rsR.fields("RYear"))
                        TExcess = XLEExcess + ClaRegEAmount(CNO, "EX", RYear)
                    End If
                    If toval(rsR.fields("ExcessType")) = 1 And ExcessType = 0 Then
                        Saldo = Saldo + rs.fields("EQAmount")
                        RAmount = RAmount + rs.fields("EQAmount")
                        TExcess = TExcess + ClaRegEAmountExcessQS(CNO, RYear)
                        ExcessType = 1
                    End If

                    TLimit = IIf(toval(rsR.fields("AssessmentF")), RLimit, 1)

                    Dim Deductible As Double
                    Dim A_Deductible As Double
                    Dim Aggregate As Double
                    Dim A_Aggregate As Double
                    Deductible = toval(rsR.fields("Deductible"))
                    A_Deductible = toval(rsR.fields("A_EDeductible"))
                    Aggregate = toval(rsR.fields("Aggregate"))
                    A_Aggregate = toval(rsR.fields("A_EAggregate"))

                    Excess = toval(rsR.fields("Excess"))

                    Dim dExcess As Double
                    dExcess = Excess * (1 - TLimit)
                    Excess = Excess * TLimit

                    Excess = Excess - TExcess
                    Excess = IIf(Excess > 0, Excess, 0)
                    If Excess > Saldo Then Excess = Saldo
                    Saldo = Saldo - Excess

                    TAccumulation = ClaRegEAmount(CNO, "X" & i, RYear)
                    Limit = rsR.fields("Limit") + dExcess - TAccumulation
                    Limit = IIf(Limit > 0, Limit, 0)
                    If Saldo > Limit Then
                        Share = Limit
                    Else
                        Share = Saldo
                    End If

                    ' Aggregate Deductible and Annual Aggregate not Applied
                    'If Deductible <> 0 Then ' Deductible Applied
                    '    If Deductible >= A_Deductible Then
                    '        If Share > (Deductible - A_Deductible) Then
                    '            TDeductible = (Deductible - A_Deductible)
                    '        Else
                    '            TDeductible = Share
                    '        End If
                    '    Else
                    '        TDeductible = 0
                    '    End If
                    '    A_Deductible = A_Deductible + TDeductible
                    '    Share = Share - TDeductible
                    'Else
                    '    TDeductible = 0
                    'End If

                    'If Aggregate <> 0 Then ' Annual Aggregate Applied
                    '    If Share > (Aggregate - A_Aggregate) Then
                    '        Share = (Aggregate - A_Aggregate)
                    '    End If
                    'End If

                    rs.fields("XL" & i & "ID") = tostr(rsR.fields("RID"))
                    rs.fields("XL" & i & "EShare") = toval(Share / Estimate * 100)
                    rs.fields("XL" & i & "EAmount") = Share
                    rs.fields("XL" & i & "EDeductible") = A_Deductible - toval(rsR.fields("A_Deductible"))

                    TExcess = TExcess + Excess + Share + TAccumulation
                Else
                    Share = rs.fields("XL" & i & "EAmount")
                    rs.fields("XL" & i & "EShare") = toval(Share / Estimate * 100)
                End If
                Saldo = Saldo - Share
                RAmount = RAmount - Share
            Else
                If Not rsR.Eof AndAlso (tostr(rsR.fields("Category")) = "C" Or tostr(rsR.fields("Category")) = "E") Then
                    rs.fields("XL" & i & "ID") = tostr(rsR.fields("RID"))
                    rs.fields("XL" & i & "EShare") = 0
                    rs.fields("XL" & i & "EAmount") = 0
                    rs.fields("XL" & i & "EDeductible") = 0
                End If
            End If
        Next i
        rs.fields("ETShare") = 100
        rs.fields("ETAmount") = Estimate
        rs.fields("EMAmount") = Estimate * MShare / 100
        rs.fields("QXOLEAmount") = 0
        rs.fields("XLEExcess") = XLEExcess

        If ExcessType = 1 Then
            rShare = GetReinsuranceShare(QID)
            rs.fields("QXOLEAMOUNT") = -(rs.fields("EQAmount") - RAmount * rShare / 100)
            RAmount = RAmount - (rs.fields("EQAmount") + rs.fields("QXOLEAmount"))
        End If
        rs.fields("ERAmount") = RAmount

        If Estimate <> 0 Then
            rs.fields("ERetention") = toval(RAmount / Estimate * 100)
            rs.fields("QXOLESHARE") = toval(toval(rs.fields("QXOLEAMOUNT")) / Estimate * 100)
        Else
            rs.fields("ERetention") = 0
            rs.fields("QXOLESHARE") = 0
        End If

        Dim HoldF As Boolean
        Dim Message As String = ""
        HoldF = False
        If rs.fields("AAmount") <> 0 Then
            HoldF = True
            Message = Message & "Please Check Auto Facultative Cession !" & vbCrLf
