        rs.CloseRemoteSet()

        If (CStatus = "R") And PCNO <> -1 Then
            If Not UnReleaseClaRegAmount(PCNO) Then GoTo errmsg
        End If

        rs = db.OpenQueryDef("QCARRHEADER", adOpenKeyset, CNO)
        If tostr(rs.fields("Status")) = "R" And ClaimType <> "C" Then
