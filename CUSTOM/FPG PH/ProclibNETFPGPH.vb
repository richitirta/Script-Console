            If toval(rsTAX.fields("TAXF")) Then
                If TaxType = "PASAL21" Or TaxType = "PASAL23" Or TaxType = "PASAL26" Or TaxType = "PASAL4" Then
                    If TaxRate <> 0 Then
                        If AccruedTax = 0 Then
                            If TaxType = "PASAL21" Then
                                Dim TaxCCYRate As Double
                                TaxCCYRate = Tax_Rate(pCCY, pDate)
                                If TaxTableF Then
                                    Dim TAmount As Double
                                    Dim TTax As Double

                                    ' TAmount and TTax already in Base Currency
                                    Get_Tax_Table(PID, pDate, TAmount, TTax)

                                    'Looking at Progressive Table
                                    TaxIncome = -(TAmount + TaxCCYRate * Nominal_TAX) * (100 - TaxDiscount) / 100 - NTaxIncome * (DateDiff(DateInterval.Month, DateSerial(Year(pDate), 1, 1), pDate) + 1)
                                    If TaxIncome < 0 Then TaxIncome = 0

                                    'TaxIncome = -(TAmount + TaxCCYRate * Nominal_TAX) * (100 - TaxDiscount) / 100

                                    TAX = Calc_Tax_Amount(rsTAX.fields("Currency"), pDate, -TaxIncome, TaxPCT, 1) - TTax
                                    TAX = TAX / TaxCCYRate
                                Else
                                    'Looking at Progressive Table
                                    TaxIncome = -(TaxCCYRate * Nominal_TAX) * (100 - TaxDiscount) / 100
                                    TAX = Calc_Tax_Amount(rsTAX.fields("Currency"), pDate, -TaxIncome, TaxPCT, 1)
                                    TAX = TAX / TaxCCYRate
                                End If
                            Else
                                TAX = Nominal_TAX * -TaxRate / 100 * TaxPCT / 100
                                TaxTableF = False
                            End If
                        Else
                            TAX = Nominal_TAX * -AccruedTax / 100 * TaxPCT / 100
                            TaxTableF = False
                        End If
                    Else
                        TAX = Nominal_TAX * -AccruedTax / 100 * TaxPCT / 100
                        ' Return False Tax Table Flag
                        TaxTableF = False
