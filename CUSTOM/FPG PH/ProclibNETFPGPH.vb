                If Not rsDst1.Update Then GoTo errmsg

                If Not db.Execute("Delete from FPartDet Where ANO=" & ANO & " and FID='" & rsDst1.fields("FID") & "'") Then GoTo errmsg
                If Not db.Execute("Delete from FSecurity Where ANO=" & ANO & " and FID='" & rsDst1.fields("FID") & "'") Then GoTo errmsg
                If Not db.Execute("Delete from FDeductible Where ANO=" & ANO & " and FID='" & rsDst1.fields("FID") & "'") Then GoTo errmsg
