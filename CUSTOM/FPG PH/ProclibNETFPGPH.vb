    Private Function Member_List(ByVal ANO As Long) As String
        Dim rs As Remoteset
        Dim i As Integer
        Dim str As String
        Dim Share As Double
        Dim ISType As String
        Dim Company As String
        On Error GoTo ErrMessage
        rs = db.OpenRemoteSet("Select ISType  From Cover, Acceptance Where Cover.CNO=Acceptance.CNO and Acceptance.ANO=" & ANO)
        ISType = rs.fields("ISType")
        If ISType = "L" Or ISType = "I" Then
            i = 2
        Else
            i = 3
        End If
        rs = db.OpenRemoteSet("Select * from SysTab")
        Company = rs.fields("Company")

        str = ""
        rs = db.OpenRemoteSet("Select Profile.Name, Profile.Salutation, Coinsurance.Share From Acceptance, Coinsurance, Profile Where Coinsurance.CNO=Acceptance.CNO and Profile.ID=Coinsurance.ID and Acceptance.ANO=" & ANO)
        Do While Not rs.Eof
            str = str & "\par " & Format(i, "##") & ". " & tostr(rs.fields("Salutation")) & " " & tostr(rs.fields("Name")) & " " & Format(toval(rs.fields("Share")), "##0.00") & "% (Member)"
            Share = Share + toval(rs.fields("Share"))
            i = i + 1
            rs.MoveNext()
        Loop
        If ISType = "L" Or ISType = "I" Then  ' as Leader
            str = "\par " & "1. " & Company & " " & Format(100 - Share, "##0.00") & "% (Leader)" & str
        Else    ' as Member
            rs = db.OpenRemoteSet("Select Profile.Name, Profile.Salutation, ISource.Share From Acceptance, ISource, Profile Where ISource.CNO=Acceptance.CNO and Profile.ID=ISource.ID and Acceptance.ANO=" & ANO)
            str = "\par " & "2. " & Company & " " & Format(rs.fields("Share"), "##0.00") & "% (Member)" & str
            str = "\par " & "1. " & tostr(rs.fields("Salutation")) & " " & tostr(rs.fields("Name")) & " " & Format(100 - (rs.fields("Share") + Share), "##0.00") & "% (Leader)" & str
        End If

        Member_List = str
        Exit Function
ErrMessage:
        Member_List = ""
    End Function

    Public Function Premium_Instalment(ByVal ANO As Long) As String
        Dim str As String
        Dim rs As Remoteset
        Dim rsI As Remoteset
        Dim i As Integer
        Dim IPRemium As Double = 0
        Dim Premium As Double = 0
        Dim TIPremium As Double = 0
        Dim FeeDuty As Double = 0

        On Error GoTo ErrMessage
        str = ""
        rsI = db.OpenRemoteSet("Select * from APayor Where ANO=" & ANO)
        If rsI.Eof Then
            rsI = db.OpenRemoteSet("Select Payor.* from Payor, Acceptance Where (Payor.ANO=Acceptance.LANO or Payor.ANO=Acceptance.ANO) and Acceptance.ANO=" & ANO)
        End If
        If Not rsI.Eof Then
            rs = db.OpenQueryDef("View05L1", adOpenKeyset, ANO)
            Do While Not rs.Eof
                Premium = toval(rs.fields("Premium")) - toval(rs.fields("Discount"))
                FeeDuty = toval(rs.fields("FeeDuty"))
                If FeeDuty < 0 Then FeeDuty = 0
                For i = 1 To rsI.fields("Installment")
                    IPRemium = RoundCCY(Premium * rsI.fields("IPCT_" & i) / 100, rs.fields("Currency"))
                    If i = 1 Then
                        str = str & "\par " & "Angsuran Ke-" & i & "..." & Format(rsI.fields("IDate_" & i), "dd mmm yyyy") & "..." & rs.fields("Currency") & ". " & Format(IPRemium + FeeDuty, "###,###,##0.00")
                    ElseIf i < rsI.fields("Installment") Then
                        str = str & "\par " & "Angsuran Ke-" & i & "..." & Format(rsI.fields("IDate_" & i), "dd mmm yyyy") & "..." & rs.fields("Currency") & ". " & Format(IPRemium, "###,###,##0.00")
                    Else
                        str = str & "\par " & "Angsuran Ke-" & i & "..." & Format(rsI.fields("IDate_" & i), "dd mmm yyyy") & "..." & rs.fields("Currency") & ". " & Format(Premium - TIPremium, "###,###,##0.00")
                    End If
                    TIPremium = TIPremium + IPRemium
                Next i

                str = str & "\par "
                rs.MoveNext()
            Loop
        End If

        Premium_Instalment = str
        Exit Function
ErrMessage:
        Premium_Instalment = ""
    End Function
