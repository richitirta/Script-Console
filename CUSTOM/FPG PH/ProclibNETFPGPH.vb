                        rsd.fields("PCTLoss") = toval(rss.fields("PCTLOSS"))
                        rsd.fields("PADDITION") = toval(rss.fields("PADDITION"))
                        rsd.fields("Discount") = toval(rss.fields("Discount"))
                        rsd.fields("NoRefundF") = toval(rss.fields("NoRefundF"))
                        rsd.fields("Loading") = Loading
                        rsd.fields("SDate") = pSDate
                        rsd.fields("NCDate") = pSDate
                        rsd.fields("NoRefundF") = toval(rss.fields("NoRefundF"))
                        rsd.fields("InclAddInterestF") = toval(rsSC.fields("InclAddInterestF"))
                    End If

                    If sPeriod <> 1 Then    ' Not in Days
                        If (UMonth + PMonth) <= rss.fields("Upper") And Not RoundUpDF Then
                            If Day(SDate) <> Day(EDate) Then
                                pEDate = EDate
                                If DateDiff(DateInterval.Month, pEDate, DateAdd(DateInterval.Month, toval((UMonth / 12) * 12, 0), SDate)) < 0 Then
                                    pEDate = DateAdd(DateInterval.Month, toval((UMonth / 12) * 12, 0), SDate)
                                End If
                            Else
                                pEDate = DateAdd(DateInterval.Month, toval((UMonth / 12) * 12, 0), SDate)
                            End If
                        Else
                            pEDate = DateAdd(DateInterval.Month, rss.fields("Upper") - PMonth, SDate)
